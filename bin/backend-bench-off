#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
self="$repo_dir/bin/backend-bench-off"
models_dir="${BENCH_MODELS:-$HOME/bench-models}"
results_dir="${BENCH_RESULTS:-$HOME/bench-results}"
ollama_url="${OLLAMA_HOST:-http://localhost:11434}"
case "$ollama_url" in http://*|https://*) ;; *) ollama_url="http://$ollama_url" ;; esac
omlx_port="${BENCH_OMLX_PORT:-8100}"
vllm_port="${BENCH_VLLM_PORT:-8200}"
llama_port="${BENCH_LLAMA_PORT:-8300}"
server_timeout="${BENCH_SERVER_TIMEOUT:-900}"
cooldown_seconds="${BENCH_COOLDOWN:-60}"
replay_dir="${BENCH_REPLAY_DIR-$HOME/.claude-ollama/proxy/record}"
replay_limit="${BENCH_REPLAY_LIMIT:-30}"
refresh_seconds=5
omlx_service_port=8000
omlx_api_key=local-bench
context_tokens=65536
prefix_tokens=(20000 60000)
tool_trials=5
warmup_prefix_tokens=1000
ollama_draft_tokens=4
side_model=qwen3-4b-cc
mtp_suffix=-mtp
gguf_suffix=-gguf
servers="ollama ollama-mtp omlx omlx-mtp vllm-mlx vllm-mlx-mtp llama-server llama-server-mtp"
vllm_mlx_version=0.4.1
vllm_args=(--continuous-batching --use-paged-cache --enable-auto-tool-choice --tool-call-parser qwen --reasoning-parser qwen3)
llama_draft_tokens=2
llama_args=(-c "$context_tokens" -ngl 99 -fa on -b 2048 -ub 2048 -ctk q8_0 -ctv q8_0 -np 1 --jinja
  --cache-ram 8192 --ctx-checkpoints 128 --checkpoint-min-step 128 --metrics)
report_page="$results_dir/bench-off.html"
server_pid=""
sampler_pid=""
sampler_file=""
renderer_pid=""
unit_server=""
unit_model=""
unit_weights=""
unit_file=""
unit_log=""
server_log=""
unit_step=""
unit_peak=null
unit_mtp=null
omlx_mtp_on=0

usage() {
  cat <<EOF
usage: backend-bench-off <command>

  install       brew install oMLX and llama.cpp, uv tool install vllm-mlx $vllm_mlx_version
  download      download the bench weights into \$BENCH_MODELS ($models_dir)
  all           bench every model on every server below, model by model,
                streaming results into $report_page
  ollama        bench every model on the running Ollama ($ollama_url)
  ollama-mtp    the same on the MTP weights, with draft_num_predict $ollama_draft_tokens (MTP on)
  omlx          start oMLX on port $omlx_port, bench every model, stop it
  omlx-mtp      the same on the MTP weights, with mtp_enabled on (MTP on)
  vllm-mlx      start vllm-mlx on port $vllm_port per model, bench, stop it
  vllm-mlx-mtp  the same on the MTP weights, with --enable-mtp (MTP on)
  llama-server  start llama.cpp's llama-server on port $llama_port per model on
                the pinned GGUF weights, with the Mac settings, bench, stop it
  llama-server-mtp  the same with --spec-type draft-mtp (MTP on)
  run SERVER MODEL  bench one model on one server
  report        rebuild the page from the results so far

Models: $(bench_models)
Environment: BENCH_MODELS, BENCH_RESULTS, BENCH_COOLDOWN (seconds between runs,
$cooldown_seconds), BENCH_OMLX_PORT ($omlx_port), BENCH_VLLM_PORT ($vllm_port),
BENCH_LLAMA_PORT ($llama_port), BENCH_SERVER_TIMEOUT ($server_timeout),
BENCH_REPLAY_DIR (recorded bodies replayed through prefix-ab, empty turns it off,
$replay_dir), BENCH_REPLAY_LIMIT ($replay_limit), VLLM_MLX_EXTRA_ARGS, LLAMA_SERVER_EXTRA_ARGS
EOF
}

say() {
  printf 'backend-bench-off: %s\n' "$*" >&2
}

die() {
  unit_step="$*"
  say "$*"
  exit 1
}

step() {
  unit_step="$1"
  say "$unit_server $unit_model: $1"
}

require() {
  command -v "$1" >/dev/null 2>&1 || die "$1 not found ($2)"
}

bench_models() {
  echo qwen3.6-35b qwen3.8-27b
}

model_repo() {
  case "$1" in
    qwen3.6-35b) echo mlx-community/Qwen3.6-35B-A3B-4bit ;;
    qwen3.6-35b-mtp) echo Jundot/Qwen3.6-35B-A3B-oQ4e-mtp ;;
    qwen3.8-27b) echo mlx-community/Qwen3.8-27B-4bit ;;
    qwen3.8-27b-mtp) echo Jundot/Qwen3.8-27B-oQ4e-mtp ;;
    "$side_model") echo mlx-community/Qwen3-4B-4bit ;;
    *) gguf_spec "$1" | awk '{ print $1 }' ;;
  esac
}

gguf_spec() {
  case "$1" in
    qwen3.6-35b-gguf) echo unsloth/Qwen3.6-35B-A3B-GGUF a483e9e6cbd595906af30beda3187c2663a1118c Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf ;;
    qwen3.6-35b-gguf-mtp) echo unsloth/Qwen3.6-35B-A3B-MTP-GGUF 5bc3e238d916f48a861bac2f8a1990a0e9b7e98d Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf ;;
    qwen3.8-27b-gguf) echo unsloth/Qwen3.8-27B-GGUF 4ca720788d1e01f1bff70c033e0d0028fd02e502 Qwen3.8-27B-UD-Q4_K_XL.gguf MTP/mtp-Qwen3.8-27B-Q4_0.gguf ;;
  esac
}

gguf_files() {
  gguf_spec "$1" | cut -d' ' -f3-
}

gguf_main_file() {
  gguf_spec "$1" | awk '{ print $3 }'
}

gguf_draft_file() {
  gguf_spec "$1" | awk '{ print $4 }'
}

is_gguf() {
  [ -n "$(gguf_spec "$1")" ]
}

is_mtp_server() {
  case "$1" in *"$mtp_suffix") return 0 ;; esac
  return 1
}

is_llama_server() {
  [ "${1%"$mtp_suffix"}" = llama-server ]
}

gguf_weights_for() {
  local mtp_weights="$2$gguf_suffix$mtp_suffix"
  if is_mtp_server "$1" && is_gguf "$mtp_weights"; then
    echo "$mtp_weights"
  else
    echo "$2$gguf_suffix"
  fi
}

weights_for() {
  if is_llama_server "$1"; then
    gguf_weights_for "$1" "$2"
  elif is_mtp_server "$1"; then
    echo "$2$mtp_suffix"
  else
    echo "$2"
  fi
}

all_weights() {
  local model
  for model in $(bench_models); do
    printf '%s %s ' "$model" "$model$mtp_suffix"
    printf '%s ' "$(gguf_weights_for llama-server "$model")"
    if is_gguf "$model$gguf_suffix$mtp_suffix"; then
      printf '%s ' "$model$gguf_suffix$mtp_suffix"
    fi
  done
}

is_known() {
  case " $2 " in *" $1 "*) return 0 ;; esac
  return 1
}

is_downloaded() {
  local file
  if ! is_gguf "$1"; then
    [ -f "$models_dir/$1/config.json" ]
    return
  fi
  for file in $(gguf_files "$1"); do
    [ -f "$models_dir/$1/$file" ] || return 1
  done
}

download_model() {
  local spec=()
  if is_downloaded "$1"; then
    say "$1 already in $models_dir"
    return 0
  fi
  if is_gguf "$1"; then
    read -r -a spec <<<"$(gguf_spec "$1")"
    hf download "${spec[0]}" "${spec[@]:2}" --revision "${spec[1]}" --local-dir "$models_dir/$1"
    return
  fi
  hf download "$(model_repo "$1")" --local-dir "$models_dir/$1"
}

download_models() {
  local name
  require hf "curl -LsSf https://hf.co/cli/install.sh | bash -s"
  mkdir -p "$models_dir"
  for name in $(all_weights) "$side_model"; do
    download_model "$name"
  done
}

require_weights() {
  is_downloaded "$1" || die "$1 missing in $models_dir: run backend-bench-off download"
}

require_models() {
  local name
  for name in $(all_weights); do
    require_weights "$name"
  done
}

install_servers() {
  brew install llama.cpp
  require brew "https://brew.sh"
  require uv "brew install uv"
  brew tap jundot/omlx https://github.com/jundot/omlx
  brew install jundot/omlx/omlx
  uv tool install "vllm-mlx==$vllm_mlx_version"
}

memory_used_gb() {
  command -v vm_stat >/dev/null 2>&1 || return 0
  vm_stat | awk '
    /page size of/ { size = $8 }
    /Pages active|Pages wired down|Pages occupied by compressor/ { gsub(/\./, "", $NF); pages += $NF }
    END { if (size) printf "%.1f\n", pages * size / 1e9 }'
}

power_source() {
  pmset -g batt 2>/dev/null | sed -n "s/^Now drawing from '\(.*\)'.*/\1/p" | grep . || echo unknown
}

low_power_mode() {
  pmset -g 2>/dev/null | awk '/lowpowermode/ { on = ($2 == 1) } END { print (on ? "true" : "false") }'
}

record_peak() {
  local used
  used="$(memory_used_gb)"
  [ -n "$used" ] || return 0
  awk -v used="$used" -v peak="$(cat "$sampler_file")" 'BEGIN { exit !(used + 0 > peak + 0) }' &&
    echo "$used" >"$sampler_file"
}

start_sampler() {
  sampler_file="$(mktemp)"
  echo null >"$sampler_file"
  command -v vm_stat >/dev/null 2>&1 || return 0
  echo 0 >"$sampler_file"
  while :; do
    record_peak || true
    sleep 1
  done &
  sampler_pid=$!
}

stop_sampler() {
  if [ -n "$sampler_pid" ]; then
    kill "$sampler_pid" 2>/dev/null || true
    wait "$sampler_pid" 2>/dev/null || true
    record_peak || true
  fi
  sampler_pid=""
  cat "$sampler_file"
  rm -f "$sampler_file"
}

start_server() {
  "$@" >>"$server_log" 2>&1 &
  server_pid=$!
}

stop_server() {
  [ -n "$server_pid" ] || return 0
  kill "$server_pid" 2>/dev/null || true
  wait "$server_pid" 2>/dev/null || true
  server_pid=""
}

served_ids() {
  curl -sf -m 5 -H "Authorization: Bearer $2" "$1/v1/models" | jq -r '.data[].id'
}

require_free_port() {
  if served_ids "$1" local >/dev/null 2>&1; then
    die "something already answers on $1; stop it first"
  fi
}

wait_for_server() {
  local url="$1" token="$2" waited=0
  until served_ids "$url" "$token" >/dev/null 2>&1; do
    kill -0 "$server_pid" 2>/dev/null || die "the server exited before it was ready"
    [ "$waited" -lt "$server_timeout" ] || die "the server was not ready after ${server_timeout}s"
    sleep 2
    waited=$((waited + 2))
  done
}

require_served() {
  local url="$1" token="$2" ids
  ids="$(served_ids "$url" "$token")"
  printf '%s\n' "$ids" | grep -qxF "$unit_weights" ||
    die "$url does not serve $unit_weights; it lists: $(printf '%s' "$ids" | tr '\n' ' ')"
}

render_report_quietly() {
  "$repo_dir/bin/backend-bench-report" "$results_dir" >/dev/null 2>&1 || true
}

ollama_version() {
  ollama --version 2>/dev/null | awk 'NF { version = $NF } END { print (version ? version : "unknown") }'
}

omlx_version() {
  brew list --versions omlx 2>/dev/null | awk '{ print $2 }' | grep . || echo unknown
}

vllm_mlx_installed_version() {
  uv tool list 2>/dev/null | awk '$1 == "vllm-mlx" { print $2 }' | grep . || echo unknown
}

server_version() {
  case "${1%"$mtp_suffix"}" in
    ollama) ollama_version ;;
    omlx) omlx_version ;;
    vllm-mlx) vllm_mlx_installed_version ;;
    llama-server) llama_server_version ;;
  esac
}

llama_server_version() {
  llama-server --version 2>&1 | sed -n 's/^version: //p' | head -n 1 | grep . || echo unknown
}

write_meta() {
  jq -c -n --arg server "$unit_server" --arg model "$unit_model" --arg weights "$unit_weights" \
    --arg version "$(server_version "$unit_server")" --arg repo "$(model_repo "$unit_weights")" \
    --arg power "$(power_source)" --argjson low "$(low_power_mode)" \
    --argjson memory "$(memory_used_gb | grep . || echo null)" \
    '{type: "meta", server: $server, version: $version, model: $model, weights: $weights, repo: $repo,
      conditions: {power: $power, low_power_mode: $low, memory_before_gb: $memory}}' >>"$unit_file"
}

log_tail() {
  {
    tail -n 15 "$unit_log"
    [ ! -s "$server_log" ] || tail -n 15 "$server_log"
  } 2>/dev/null || true
}

unload_ollama_models() {
  command -v ollama >/dev/null 2>&1 || return 0
  ollama ps 2>/dev/null | awk 'NR > 1 && NF { print $1 }' | while read -r name; do
    ollama stop "$name" >>"$unit_log" 2>&1 || true
  done
}

omlx_set_mtp() {
  local enabled="$1" response code body
  response="$(curl -s -m 30 -X PUT -H "Authorization: Bearer $omlx_api_key" -H 'Content-Type: application/json' \
    -d "{\"mtp_enabled\": $enabled}" -w '\n%{http_code}' \
    "http://127.0.0.1:$omlx_port/admin/api/models/$unit_weights/settings" || true)"
  code="${response##*$'\n'}"
  body="${response%$'\n'*}"
  case "$code" in
    2??) ;;
    *) die "oMLX refused mtp_enabled $enabled for $unit_weights: $body" ;;
  esac
}

turn_off_omlx_mtp() {
  [ "$omlx_mtp_on" = 1 ] || return 0
  omlx_mtp_on=0
  (omlx_set_mtp false) >>"$unit_log" 2>&1 || true
}

finish_unit() {
  local status=$?
  trap - EXIT
  turn_off_omlx_mtp
  stop_server
  [ -z "$sampler_pid" ] || kill "$sampler_pid" 2>/dev/null || true
  case "$unit_server" in
    ollama*) ollama stop "bench-$unit_weights" >>"$unit_log" 2>&1 || true ;;
  esac
  unload_ollama_models
  if [ "$status" -eq 0 ]; then
    jq -c -n --argjson peak "$unit_peak" --argjson mtp "$unit_mtp" \
      '{type: "end", status: "done", peak_memory_gb: $peak, mtp: $mtp}' >>"$unit_file"
    say "$unit_server $unit_model: done"
  else
    jq -c -n --arg error "$unit_step" --arg tail "$(log_tail)" \
      '{type: "end", status: "failed", peak_memory_gb: null, mtp: null, error: $error, log_tail: $tail}' >>"$unit_file"
    say "$unit_server $unit_model: failed while $unit_step (log: $unit_log)"
  fi
  render_report_quietly
  exit "$status"
}

has_replay_bodies() {
  local body
  [ -n "$replay_dir" ] || return 1
  for body in "$replay_dir"/*.json; do
    [ -f "$body" ] && return 0
  done
  return 1
}

replay_sessions() {
  local url="$1" model_id="$2" token="$3" unload_kind="$4" report
  has_replay_bodies || return 0
  step "replaying recorded sessions"
  if report="$("$repo_dir/bin/prefix-ab" --record "$replay_dir" --model "$model_id" --base-url "$url" \
    --auth-token "$token" --unload "$unload_kind" --limit "$replay_limit" --json 2>>"$unit_log")" &&
    printf '%s\n' "$report" | jq -c '{type: "replay", requests: (.requests | length), basis: .basis, verbatim: .mean.verbatim, stabilized: .mean.stabilized}' >>"$unit_file" 2>>"$unit_log"; then
    return 0
  fi
  echo '{"type": "replay", "error": "prefix-ab failed; see the unit log"}' >>"$unit_file"
}

measure() {
  local url="$1" model_id="$2" token="$3" unload_kind="$4"
  step "loading the model with a short warm-up request"
  "$repo_dir/bin/messages-bench" --base-url "$url" --model "$model_id" --auth-token "$token" \
    --prefix-tokens "$warmup_prefix_tokens" --tool-trials 0 --json >/dev/null 2>>"$unit_log"
  step "measuring"
  start_sampler
  "$repo_dir/bin/messages-bench" --base-url "$url" --model "$model_id" --auth-token "$token" \
    --prefix-tokens "${prefix_tokens[@]}" --tool-trials "$tool_trials" --jsonl >>"$unit_file" 2>>"$unit_log"
  unit_peak="$(stop_sampler)"
  replay_sessions "$url" "$model_id" "$token" "$unload_kind"
}

ollama_modelfile() {
  printf 'FROM %s\nPARAMETER num_ctx %s\n' "$models_dir/$unit_weights" "$context_tokens"
  if is_mtp_server "$unit_server"; then
    printf 'PARAMETER draft_num_predict %s\n' "$ollama_draft_tokens"
  fi
}

ensure_ollama_model() {
  local modelfile
  ollama show "bench-$unit_weights" >/dev/null 2>&1 && return 0
  step "importing $unit_weights into Ollama"
  modelfile="$(mktemp)"
  ollama_modelfile >"$modelfile"
  ollama create "bench-$unit_weights" -f "$modelfile" >>"$unit_log" 2>&1
  rm -f "$modelfile"
}

bench_ollama_unit() {
  require ollama "brew install ollama"
  step "checking Ollama"
  curl -sf -m 2 "$ollama_url/api/version" >/dev/null 2>&1 ||
    die "Ollama not reachable at $ollama_url (brew services start ollama)"
  ensure_ollama_model
  measure "$ollama_url" "bench-$unit_weights" ollama ollama
  if is_mtp_server "$unit_server"; then
    unit_mtp="$(jq -c -n --arg detail "draft_num_predict $ollama_draft_tokens; Ollama exposes no acceptance count" \
      '{active: null, detail: $detail}')"
  fi
}

omlx_serve_args() {
  printf '%s\n' serve --headless --model-dir "$models_dir" --api-key "$omlx_api_key"
  if omlx serve --help 2>/dev/null | grep -q -- '--port'; then
    printf '%s\n' --port "$omlx_port"
  fi
}

omlx_mtp_status() {
  local line verdict='{"active": null, "detail": "no oMLX MTP log line found"}'
  while IFS= read -r line; do
    case "$line" in
      *'Lightning MTP is inactive for '*"$unit_weights"*)
        verdict='{"active": false, "detail": "oMLX log: Lightning MTP inactive"}' ;;
      *'Speculative backend selected for '*"$unit_weights"*'active)'*)
        verdict='{"active": true, "detail": "oMLX log: Lightning MTP active"}' ;;
    esac
  done < <(grep -F "$unit_weights" "$server_log" 2>/dev/null || true)
  echo "$verdict"
}

bench_omlx_unit() {
  local url="http://127.0.0.1:$omlx_port" args=() line
  require omlx "backend-bench-off install"
  require_free_port "$url"
  while IFS= read -r line; do
    args+=("$line")
  done < <(omlx_serve_args)
  step "starting oMLX"
  start_server env "OMLX_PORT=$omlx_port" omlx "${args[@]}"
  wait_for_server "$url" "$omlx_api_key"
  require_served "$url" "$omlx_api_key"
  if is_mtp_server "$unit_server"; then
    step "turning MTP on for $unit_weights"
    omlx_set_mtp true
    omlx_mtp_on=1
  fi
  measure "$url" "$unit_weights" "$omlx_api_key" none
  if is_mtp_server "$unit_server"; then
    unit_mtp="$(omlx_mtp_status)"
  fi
}

vllm_mtp_status() {
  local status
  if ! status="$(curl -sf -m 5 "$1/v1/status")"; then
    echo '{"active": null, "detail": "vllm-mlx /v1/status unreachable"}'
    return 0
  fi
  printf '%s' "$status" | jq -c '
    if .mtp.enabled != true then
      {active: false, detail: "vllm-mlx /v1/status: MTP not enabled"}
    else
      {active: (.mtp.accepted > 0), detail: "accepted \(.mtp.accepted) of attempted \(.mtp.attempted) drafts, acceptance \((.mtp.acceptance_rate * 100 | round))%"}
    end'
}

bench_vllm_mlx_unit() {
  local url="http://127.0.0.1:$vllm_port" extra=() mtp_args=()
  require vllm-mlx "backend-bench-off install"
  require_free_port "$url"
  read -r -a extra <<<"${VLLM_MLX_EXTRA_ARGS:-}"
  if is_mtp_server "$unit_server"; then
    step "extracting the MTP head of $unit_weights"
    "$repo_dir/bin/extract-mtp-weights" "$models_dir/$unit_weights" >>"$unit_log" 2>&1
    mtp_args=(--enable-mtp)
  fi
  step "starting vllm-mlx"
  start_server vllm-mlx serve "$models_dir/$unit_weights" --host 127.0.0.1 --port "$vllm_port" \
    --served-model-name "$unit_weights" "${vllm_args[@]}" ${mtp_args[@]+"${mtp_args[@]}"} ${extra[@]+"${extra[@]}"}
  wait_for_server "$url" local
  measure "$url" "$unit_weights" local none
  if is_mtp_server "$unit_server"; then
    unit_mtp="$(vllm_mtp_status "$url")"
  fi
}

llama_mtp_status() {
  local line
  line="$(grep -F 'draft acceptance rate' "$server_log" 2>/dev/null | tail -n 1 || true)"
  if [ -z "$line" ]; then
    echo '{"active": null, "detail": "no llama-server draft acceptance line found"}'
    return 0
  fi
  printf '%s\n' "$line" | sed -n 's/.*( *\([0-9]*\) accepted \/ *\([0-9]*\) generated).*/\1 \2/p' |
    jq -c -R 'split(" ") | map(tonumber) | {accepted: .[0], drafted: .[1]} |
      {active: (.accepted > 0),
       detail: "accepted \(.accepted) of \(.drafted) drafted tokens, acceptance \(if .drafted > 0 then (.accepted * 100 / .drafted | round) else 0 end)%"}'
}

llama_mtp_args() {
  local draft
  is_mtp_server "$unit_server" || return 0
  printf '%s\n' --spec-type draft-mtp --spec-draft-n-max "$llama_draft_tokens"
  draft="$(gguf_draft_file "$unit_weights")"
  [ -z "$draft" ] || printf '%s\n' --spec-draft-model "$models_dir/$unit_weights/$draft"
}

bench_llama_unit() {
  local url="http://127.0.0.1:$llama_port" extra=() mtp_args=() line
  require llama-server "backend-bench-off install"
  require_free_port "$url"
  read -r -a extra <<<"${LLAMA_SERVER_EXTRA_ARGS:-}"
  while IFS= read -r line; do
    mtp_args+=("$line")
  done < <(llama_mtp_args)
  step "starting llama-server"
  start_server llama-server -m "$models_dir/$unit_weights/$(gguf_main_file "$unit_weights")" --alias "$unit_weights" \
    --host 127.0.0.1 --port "$llama_port" "${llama_args[@]}" ${mtp_args[@]+"${mtp_args[@]}"} ${extra[@]+"${extra[@]}"}
  wait_for_server "$url" local
  measure "$url" "$unit_weights" local llama-slots
  if is_mtp_server "$unit_server"; then
    unit_mtp="$(llama_mtp_status)"
  fi
}

run_unit() {
  unit_server="$1"
  unit_model="$2"
  is_known "$unit_server" "$servers" || { usage >&2; exit 2; }
  is_known "$unit_model" "$(bench_models)" || { usage >&2; exit 2; }
  unit_weights="$(weights_for "$unit_server" "$unit_model")"
  unit_file="$results_dir/$unit_server--$unit_model.jsonl"
  unit_log="$results_dir/logs/$unit_server--$unit_model.log"
  server_log="$results_dir/logs/$unit_server--$unit_model.server.log"
  mkdir -p "$results_dir/logs"
  : >"$unit_file"
  : >"$unit_log"
  : >"$server_log"
  trap finish_unit EXIT
  write_meta
  step "preparing"
  require_weights "$unit_weights"
  unload_ollama_models
  case "${unit_server%"$mtp_suffix"}" in
    ollama) bench_ollama_unit ;;
    omlx) bench_omlx_unit ;;
    vllm-mlx) bench_vllm_mlx_unit ;;
    llama-server) bench_llama_unit ;;
  esac
}

write_plan() {
  jq -n --arg servers "$servers" --arg models "$(bench_models)" --arg prefixes "${prefix_tokens[*]}" \
    --argjson trials "$tool_trials" --argjson finished "$1" \
    '{servers: ($servers | split(" ")), models: ($models | split(" ")),
      prefix_tokens: ($prefixes | split(" ") | map(tonumber)), tool_trials: $trials, finished: $finished}' \
    >"$results_dir/plan.json"
}

reset_results() {
  mkdir -p "$results_dir"
  rm -rf "$results_dir/logs" "$results_dir/raw"
  rm -f "$results_dir"/*.jsonl "$results_dir"/*.json "$report_page"
}

start_renderer() {
  while :; do
    render_report_quietly
    sleep "$refresh_seconds"
  done &
  renderer_pid=$!
}

stop_renderer() {
  [ -n "$renderer_pid" ] || return 0
  kill "$renderer_pid" 2>/dev/null || true
  wait "$renderer_pid" 2>/dev/null || true
  renderer_pid=""
}

open_page() {
  say "results: $report_page"
  if [ -t 1 ] && command -v open >/dev/null 2>&1; then
    open "$report_page"
  fi
}

cool_down() {
  [ "$cooldown_seconds" -gt 0 ] || return 0
  say "cooling down for ${cooldown_seconds}s so every run starts at the same temperature"
  sleep "$cooldown_seconds"
}

warn_about_omlx_service() {
  if curl -sf -m 2 "http://127.0.0.1:$omlx_service_port/v1/models" >/dev/null 2>&1; then
    say "something answers on port $omlx_service_port (the oMLX service?); stop it with 'brew services stop omlx' so it holds no memory"
  fi
}

run_units() {
  local pairs="$1" pair failed="" first=1
  for pair in $pairs; do
    [ "$first" = 1 ] || cool_down
    first=0
    "$self" run "${pair%%/*}" "${pair#*/}" || failed="$failed $pair"
  done
  printf '%s\n' "$failed"
}

model_major_pairs() {
  local model server
  for model in $(bench_models); do
    for server in $servers; do
      printf '%s/%s\n' "$server" "$model"
    done
  done
}

server_pairs() {
  local model
  for model in $(bench_models); do
    printf '%s/%s\n' "$1" "$model"
  done
}

finish_runs() {
  "$repo_dir/bin/backend-bench-report" "$results_dir"
  [ -z "$1" ] || die "failed:$1 (logs in $results_dir/logs)"
}

run_all() {
  local failed
  require_models
  warn_about_omlx_service
  reset_results
  write_plan false
  render_report_quietly
  open_page
  start_renderer
  failed="$(run_units "$(model_major_pairs)")"
  write_plan true
  stop_renderer
  finish_runs "$failed"
}

run_server() {
  mkdir -p "$results_dir"
  finish_runs "$(run_units "$(server_pairs "$1")")"
}

cleanup() {
  stop_renderer
}

main() {
  case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    install) install_servers; exit ;;
  esac
  require jq "brew install jq"
  case "${1:-}" in
    download) download_models ;;
    run) [ $# -eq 3 ] || { usage >&2; exit 2; }; run_unit "$2" "$3" ;;
    all) trap cleanup EXIT; run_all ;;
    report) "$repo_dir/bin/backend-bench-report" "$results_dir" ;;
    *)
      is_known "${1:-}" "$servers" || { usage >&2; exit 2; }
      trap cleanup EXIT
      run_server "$1"
      ;;
  esac
}

main "$@"
