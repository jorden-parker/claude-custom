#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
profile_dir="${OLLAMA_PROFILE_DIR:-$repo_dir/ollama}"
sizes_file="$profile_dir/sizes.json"
embedding_file="$profile_dir/embedding.json"
digests_file="$profile_dir/model-digests.json"
weights_dir="${CLAUDE_OLLAMA_WEIGHTS_DIR:-$HOME/.claude-ollama/weights}"
sha_cache="${CLAUDE_OLLAMA_SHA_CACHE:-$HOME/.claude-ollama/cache/weights-sha256.tsv}"
hf_endpoint="${HF_ENDPOINT:-https://huggingface.co}"
profiles_bin="${OLLAMA_PROFILES_BIN:-$repo_dir/bin/ollama-profiles}"
embedding_name=embedding

usage() {
  cat >&2 <<'EOF'
usage: ollama-models list | prune [--yes] | prune --yes --only FILE... | outdated [SIZE...] | pin SIZE [--revision REV]
  list      show each file in the weights folder as pinned, mismatch, candidate, orphan or partial
  prune     remove orphan and partial files (asks unless --yes)
  prune --yes --only FILE...  remove just the named files that are still prunable
  outdated [SIZE...]  compare each pinned revision (or the named sizes, or embedding) with the repo's main:
                      current or behind, a behind line followed by its fix command
  pin       write the repo's main revision (or REV) into ollama/sizes.json and its LFS sha256 into
            ollama/model-digests.json, then run bin/ollama-profiles
EOF
  exit 2
}

gguf_specs() {
  jq -r 'to_entries[] | select(.value.gguf) | "\(.key) \(.value.gguf.repo) \(.value.gguf.revision) \(.value.gguf.file)"' "$sizes_file"
  [ -f "$embedding_file" ] || return 0
  jq -r --arg name "$embedding_name" '.gguf // empty | "\($name) \(.repo) \(.revision) \(.file)"' "$embedding_file"
}

spec_of() {
  gguf_specs | awk -v name="$1" '$1 == name { print; found = 1 } END { exit found ? 0 : 1 }'
}

pin_of_file() {
  local file="$1" name repo revision spec_file
  while read -r name repo revision spec_file; do
    if [ "$spec_file" = "$file" ]; then
      jq -r --arg key "$repo/$spec_file" '.[$key] // empty' "$digests_file"
      return 0
    fi
  done < <(gguf_specs)
  return 1
}

file_stamp() {
  stat -f '%z %m' "$1" 2>/dev/null || stat -c '%s %Y' "$1"
}

cached_sha256() {
  [ -f "$sha_cache" ] || return 1
  awk -F '\t' -v path="$1" -v stamp="$2" '$1 == path && $2 == stamp { print $3; found = 1 } END { exit found ? 0 : 1 }' "$sha_cache"
}

remember_sha256() {
  local kept
  mkdir -p "$(dirname "$sha_cache")"
  kept="$([ -f "$sha_cache" ] && awk -F '\t' -v path="$1" '$1 != path' "$sha_cache" || true)"
  { [ -z "$kept" ] || printf '%s\n' "$kept"; printf '%s\t%s\t%s\n' "$1" "$2" "$3"; } > "$sha_cache.tmp"
  mv "$sha_cache.tmp" "$sha_cache"
}

file_sha256() {
  local stamp sha
  stamp="$(file_stamp "$1")"
  if sha="$(cached_sha256 "$1" "$stamp")"; then
    printf '%s\n' "$sha"
    return 0
  fi
  sha="$(shasum -a 256 "$1" | cut -c1-64)"
  remember_sha256 "$1" "$stamp" "$sha"
  printf '%s\n' "$sha"
}

class_of() {
  local file="$1" pin
  case "$file" in
    *.part) echo partial; return 0 ;;
    *.next) echo candidate; return 0 ;;
  esac
  if pin="$(pin_of_file "$file")"; then
    if [ -n "$pin" ] && [ "$(file_sha256 "$weights_dir/$file")" = "$pin" ]; then
      echo pinned
    else
      echo mismatch
    fi
  else
    echo orphan
  fi
}

weight_files() {
  [ -d "$weights_dir" ] || return 0
  find "$weights_dir" -mindepth 1 -maxdepth 1 -type f ! -name '.*' -exec basename {} \; | LC_ALL=C sort
}

classified_files() {
  local file
  while IFS= read -r file; do
    printf '%s %s\n' "$(class_of "$file")" "$file"
  done < <(weight_files)
}

list_files() {
  classified_files | while read -r class file; do
    printf '%-12s %s\n' "$class" "$file"
  done
}

prunable_files() {
  classified_files | awk '$1 == "orphan" || $1 == "partial" { print $2 }'
}

confirmed() {
  local answer=""
  printf 'Remove these files? [y/N] ' >&2
  read -r answer || true
  [ "$answer" = y ] || [ "$answer" = yes ]
}

remove_files() {
  local file
  for file in "$@"; do
    rm -f "$weights_dir/$file"
  done
}

prune_files() {
  local files
  files="$(prunable_files)"
  if [ -z "$files" ]; then
    echo "nothing to prune"
    return 0
  fi
  printf '%s\n' "$files"
  if [ "${1:-}" != --yes ] && ! confirmed; then
    echo "ollama-models: nothing removed" >&2
    return 1
  fi
  local -a names
  while IFS= read -r file; do names+=("$file"); done <<<"$files"
  remove_files "${names[@]}"
}

prune_only() {
  local name prunable removable=()
  prunable="$(prunable_files)"
  for name in "$@"; do
    if grep -Fxq -- "$name" <<<"$prunable"; then
      removable+=("$name")
    else
      echo "skipped $name (not prunable)"
    fi
  done
  if [ "${#removable[@]}" -eq 0 ]; then
    echo "nothing to prune"
    return 0
  fi
  printf '%s\n' "${removable[@]}"
  remove_files "${removable[@]}"
}

prune_command() {
  local yes=""
  if [ "${1:-}" = --yes ]; then
    yes=--yes
    shift
  fi
  if [ "${1:-}" = --only ]; then
    [ "$yes" = --yes ] && [ "$#" -ge 2 ] || usage
    shift
    prune_only "$@"
  else
    prune_files "$yes"
  fi
}

main_revision() {
  curl -sf -m 30 "$hf_endpoint/api/models/$1/revision/main" | jq -er '.sha // empty'
}

lfs_sha256() {
  curl -sf -m 30 "$hf_endpoint/api/models/$1/tree/$2" |
    jq -er --arg file "$3" 'first(.[] | select(.path == $file) | .lfs.oid // empty)'
}

behind_fix() {
  if [ "$1" = "$embedding_name" ]; then
    printf '     fix: bin/ollama-models pin %s\n' "$1"
  else
    printf '     fix: bin/model-upgrade %s\n' "$1"
  fi
}

behind_count=0

outdated_line() {
  local spec name repo revision file latest
  if ! spec="$(spec_of "$1")"; then
    printf 'unknown  %s (not a size in ollama/sizes.json)\n' "$1"
    return 1
  fi
  read -r name repo revision file <<<"$spec"
  latest="$(main_revision "$repo")" || { printf 'unknown  %s (no revision at %s)\n' "$name" "$hf_endpoint"; return 0; }
  if [ "$latest" = "$revision" ]; then
    printf 'current  %s\n' "$name"
    return 0
  fi
  printf 'behind   %s (%s → %s)\n' "$name" "${revision:0:12}" "${latest:0:12}"
  behind_fix "$name"
  behind_count=$((behind_count + 1))
  return 1
}

outdated_command() {
  local name status=0
  if [ $# -eq 0 ]; then
    while IFS= read -r name; do outdated_line "$name" || status=1; done < <(gguf_specs | cut -d' ' -f1)
  else
    for name in "$@"; do outdated_line "$name" || status=1; done
  fi
  if [ "$behind_count" -gt 0 ]; then
    printf '%s behind: run the fix lines above, then commit ollama/sizes.json and ollama/model-digests.json\n' "$behind_count"
  fi
  return "$status"
}

save_json() {
  printf '%s\n' "$2" > "$1"
}

write_revision() {
  if [ "$1" = "$embedding_name" ]; then
    save_json "$embedding_file" "$(jq --arg revision "$2" '.gguf.revision = $revision' "$embedding_file")"
  else
    save_json "$sizes_file" "$(jq --arg size "$1" --arg revision "$2" '.[$size].gguf.revision = $revision' "$sizes_file")"
  fi
}

pin_command() {
  local target="${1:-}" revision="" spec name repo file sha
  [ -n "$target" ] || usage
  shift
  if [ "${1:-}" = --revision ]; then
    [ -n "${2:-}" ] || usage
    revision="$2"
  fi
  spec="$(spec_of "$target")" || { echo "ollama-models: $target has no gguf in ollama/sizes.json or ollama/embedding.json" >&2; return 1; }
  read -r name repo _ file <<<"$spec"
  if [ -z "$revision" ]; then
    revision="$(main_revision "$repo")" || { echo "ollama-models: $hf_endpoint has no main revision for $repo" >&2; return 1; }
  fi
  [[ "$revision" =~ ^[0-9a-f]{40}$ ]] || { echo "ollama-models: $revision is not a commit sha" >&2; return 1; }
  sha="$(lfs_sha256 "$repo" "$revision" "$file")" || { echo "ollama-models: $repo at $revision lists no LFS sha256 for $file" >&2; return 1; }
  write_revision "$name" "$revision"
  save_json "$digests_file" "$(jq --arg key "$repo/$file" --arg sha "$sha" '.[$key] = $sha' "$digests_file")"
  "$profiles_bin" >&2
  echo "$name $revision $sha"
}

case "${1:-}" in
  list) list_files ;;
  prune) shift; prune_command "$@" ;;
  outdated) shift; outdated_command "$@" ;;
  pin) shift; pin_command "$@" ;;
  *) usage ;;
esac
