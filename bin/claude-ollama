#!/bin/bash
launch_path="$PATH"
PATH=/usr/bin:/bin:/usr/sbin:/sbin
set -euo pipefail

repo_dir="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
profile_dir="$repo_dir/ollama"
go_dir="$repo_dir/go"
picker_binary="$go_dir/cmd/model-picker/model-picker"
default_size=27b
tools="Bash,Read,Edit,Write,Skill,TaskStop"
embedding_model="${CODE_SEARCH_MODEL:-qwen3-embedding:0.6b}"
ollama_url="${OLLAMA_HOST:-http://localhost:11434}"
case "$ollama_url" in http://*|https://*) ;; *) ollama_url="http://$ollama_url" ;; esac
keep_alive="${CLAUDE_OLLAMA_KEEP_ALIVE:-30m}"
ollama_agent="${CLAUDE_OLLAMA_AGENT:-$repo_dir/bin/ollama-agent}"
gguf_inspect="${CLAUDE_OLLAMA_GGUF_INSPECT:-$repo_dir/bin/gguf-inspect}"
sandbox_runtime="$HOME/.local/share/claude-custom/sandbox-runtime/node_modules/.bin/srt"
session_config_dir="$HOME/.claude-ollama"
qwen_home="$session_config_dir/qwen"
sandbox_policy="$session_config_dir/sandbox-policy.json"
append_prompt="$session_config_dir/append-prompt.md"
fetch_domains_file="${XDG_CONFIG_HOME:-$HOME/.config}/claude-custom/fetch-domains"
gh_repos_file="${XDG_CONFIG_HOME:-$HOME/.config}/claude-custom/gh-repos"
command_rules_file="${XDG_CONFIG_HOME:-$HOME/.config}/claude-custom/command-rules"
gh_repo_pattern='^[A-Za-z0-9][A-Za-z0-9-]*/([A-Za-z0-9_][A-Za-z0-9._-]*|\*)$'
fetch_settings="$session_config_dir/fetch-settings.json"
fetch_domain_pattern='^([a-z0-9]([a-z0-9-]*[a-z0-9])?\.)+[a-z][a-z0-9-]*[a-z0-9]$'
review_log_dir="${PR_REVIEW_LOG_DIR:-$HOME/.local/share/claude-custom/reviews}"
console_state_dir="${CLAUDE_CONSOLE_STATE_DIR:-$HOME/.local/share/claude-custom/console}"
launcher_log="$console_state_dir/launcher.log"
launcher_log_max_bytes=1048576
launcher_log_open=""
github_keychain_item=claude-ollama-github
shortcut_cli="$HOME/.local/share/claude-custom/shortcut-cli/node_modules/.bin/short"
raw_terminal_mode=(-brkint -icrnl -inpck -istrip -ixon cs8 -echo -icanon -iexten -isig min 1 time 0)
saved_terminal_mode=""

configured_sizes() {
  local settings size
  for settings in "$profile_dir"/settings.*.json; do
    size="${settings##*/settings.}"
    size="${size%.json}"
    if is_configured_size "$size"; then
      printf '%s\n' "$size"
    fi
  done
}

is_configured_size() {
  [ -f "$profile_dir/settings.$1.json" ] && [ -f "$profile_dir/Modelfile.$1" ]
}

binary_is_current() {
  local dir="$1" binary="$2"
  [ -x "$binary" ] || return 1
  [ -z "$(find "$dir" \( -name '*.go' -o -name 'go.mod' -o -name 'go.sum' \) -newer "$binary" -print -quit)" ]
}

ensure_built() {
  local module_dir="$1" binary="$2" package="$3" label="$4" hint="${5:-}"
  binary_is_current "$module_dir" "$binary" && return 0
  if ! command -v go >/dev/null 2>&1; then
    echo "$label: needs Go 1.26+ (https://go.dev/dl) to build $binary$hint" >&2
    return 1
  fi
  (cd "$module_dir" && go build -o "$binary" "$package") >&2
}

pick_size() {
  ensure_built "$go_dir" "$picker_binary" ./cmd/model-picker claude-ollama "; or pass a size: $(configured_sizes | tr '\n' ' ')" || exit 1
  "$picker_binary" "$profile_dir" || exit 130
}

choose_size() {
  if [ -t 0 ] && [ -t 2 ]; then
    pick_size
  else
    printf '%s\n' "$default_size"
  fi
}

base_model() {
  sed -n 's/^FROM //p' "$profile_dir/Modelfile.$size"
}

modelfile_num_ctx() {
  sed -n 's/^PARAMETER num_ctx //p' "$profile_dir/Modelfile.$size"
}

installed_num_ctx() {
  ollama show "$1" --parameters 2>/dev/null | awk '$1 == "num_ctx" { print $2 }'
}

refresh_num_ctx() {
  local name="$1" wanted="$2" modelfile
  [ "$(installed_num_ctx "$name")" = "$wanted" ] && return 0
  echo "claude-ollama: recreating $name with num_ctx $wanted" >&2
  modelfile="$(mktemp -t claude-ollama-modelfile.XXXXXX)"
  printf 'FROM %s\nPARAMETER num_ctx %s\n' "$name" "$wanted" > "$modelfile"
  ollama create "$name" -f "$modelfile"
  rm -f "$modelfile"
}

profile_context_tokens() {
  jq -r .env.CLAUDE_CODE_MAX_CONTEXT_TOKENS "$profile_dir/settings.$size.json"
}

pinned_digest() {
  jq -r --arg name "$1" '.[$name] // empty' "$profile_dir/model-digests.json"
}

installed_digest() {
  curl -sf -m 5 "$ollama_url/api/tags" |
    jq -r --arg name "$1" '.models[]? | select(.name == $name or .name == ($name + ":latest")) | .digest'
}

check_pin() {
  local name="$1" actual="$2" pin
  pin="$(pinned_digest "$name")"
  [ -z "$pin" ] || [ "$actual" = "$pin" ] && return 0
  echo "claude-ollama: $name has digest ${actual:-none}, but ollama/model-digests.json pins $pin; remove it with 'ollama rm $name' and relaunch, or update the pin" >&2
  return 1
}

verify_pulled() {
  check_pin "$1" "$(installed_digest "$1")"
}

verify_installed() {
  local actual
  actual="$(installed_digest "$1")"
  [ -z "$actual" ] || check_pin "$1" "$actual"
}

verify_installed_models() {
  local name
  for name in "$(base_model)" "$embedding_model"; do
    verify_installed "$name" || exit 1
  done
}

gguf_source() {
  jq -r --arg size "$size" '.[$size].gguf // empty | "\(.repo) \(.revision)"' "$profile_dir/sizes.json"
}

is_gguf_base() {
  case "$(base_model)" in
    ./weights/*.gguf) return 0 ;;
    *) return 1 ;;
  esac
}

import_gguf() {
  local base source repo revision name file part pin actual created=0
  base="$(base_model)"
  source="$(gguf_source)"
  pin="$(pinned_digest "$base")"
  if [ -z "$source" ] || [ -z "$pin" ]; then
    echo "claude-ollama: $base needs a pinned source in sizes.json and a digest in model-digests.json; refusing to download" >&2
    return 1
  fi
  read -r repo revision <<<"$source"
  name="${base##*/}"
  file="$profile_dir/${base#./}"
  part="$file.part"
  mkdir -p "$profile_dir/weights"
  echo "claude-ollama: downloading $repo/$name (pinned $revision)" >&2
  if ! curl -fL --retry 3 -C - -o "$part" "https://huggingface.co/$repo/resolve/$revision/$name"; then
    echo "claude-ollama: the download of $name stopped; run the same command again to resume it" >&2
    return 1
  fi
  actual="$(shasum -a 256 "$part" | cut -d' ' -f1)"
  if [ "$actual" != "$pin" ]; then
    echo "claude-ollama: $name has sha256 $actual, but ollama/model-digests.json pins $pin; not importing" >&2
    rm -f "$part"
    return 1
  fi
  if ! "$gguf_inspect" "$part" >&2; then
    echo "claude-ollama: $name failed inspection; not importing" >&2
    rm -f "$part"
    return 1
  fi
  mv "$part" "$file"
  (cd "$profile_dir" && ollama create "$model" -f "Modelfile.$size") && created=1
  rm -f "$file"
  [ "$created" = 1 ]
}

ensure_model() {
  if ollama show "$model" >/dev/null 2>&1; then
    refresh_num_ctx "$model" "$(modelfile_num_ctx)"
    return
  fi
  if is_gguf_base; then
    import_gguf || exit 1
    return
  fi
  ollama pull "$(base_model)"
  verify_pulled "$(base_model)" || exit 1
  ollama create "$model" -f "$profile_dir/Modelfile.$size"
}

ensure_embedding_model() {
  ollama show "$embedding_model" >/dev/null 2>&1 && return 0
  ollama pull "$embedding_model" ||
    echo "claude-ollama: could not pull $embedding_model; semantic_search will fail until you run claude-ollama and pick 'Set up embedding model'" >&2
}

prepare_embedding() {
  ollama show "$embedding_model" >/dev/null 2>&1 && exit 0
  exec ollama pull "$embedding_model"
}

mcp_config() {
  printf '{"mcpServers":{"code-search":{"command":"python3","args":["%s"]},"repo":{"command":"python3","args":["%s"]},"dev":{"command":"python3","args":["%s"]}}}' \
    "$repo_dir/shared/mcp/code-search.py" "$repo_dir/shared/mcp/repo-tools.py" "$repo_dir/shared/mcp/dev-server.py"
}

warm_model() {
  command -v curl >/dev/null 2>&1 || return 0
  curl -s -o /dev/null -m 2 -X POST "$ollama_url/api/generate" \
    -d "{\"model\":\"$model\",\"keep_alive\":\"$keep_alive\"}" >/dev/null 2>&1 &
}

server_max_loaded_models() {
  running_server_env 2>/dev/null | sed -n 's/^OLLAMA_MAX_LOADED_MODELS=//p' | head -n 1
}

embedding_model_fits() {
  local cap
  cap="$(server_max_loaded_models)"
  [ -n "$cap" ] && [ "$cap" -ge 2 ] 2>/dev/null
}

allow_search_embeddings() {
  embedding_model_fits || return 0
  export CODE_SEARCH_EMBED=1
}

warm_embedding_model() {
  embedding_model_fits || return 0
  command -v curl >/dev/null 2>&1 || return 0
  curl -s -o /dev/null -m 30 -X POST "$ollama_url/api/embed" \
    -d "{\"model\":\"$embedding_model\",\"input\":\"warm up\",\"keep_alive\":\"$keep_alive\"}" >/dev/null 2>&1
}

warm_search_index() {
  [ -z "${CLAUDE_OLLAMA_NO_INDEX:-}" ] || return 0
  git rev-parse --show-toplevel >/dev/null 2>&1 || return 0
  nohup python3 "$repo_dir/shared/mcp/code-search.py" --index --watch-pid "$$" >/dev/null 2>&1 &
}

sandbox_wanted() {
  [ "${CLAUDE_OLLAMA_SANDBOX:-1}" != 0 ]
}

require_sandbox_runtime() {
  [ -x "$sandbox_runtime" ] && return 0
  echo "claude-ollama: sandbox-runtime is missing; run claude-custom install" >&2
  exit 1
}

restore_terminal() {
  stty "$saved_terminal_mode"
}

run_in_raw_terminal() {
  [ -t 0 ] || exec "$@"
  saved_terminal_mode="$(stty -g)"
  trap restore_terminal EXIT
  trap 'exit 129' HUP
  trap 'exit 143' TERM
  stty "${raw_terminal_mode[@]}"
  "$@"
}

rotate_launcher_log() {
  [ -f "$launcher_log" ] || return 0
  [ "$(wc -c < "$launcher_log")" -gt "$launcher_log_max_bytes" ] || return 0
  mv -f "$launcher_log" "$launcher_log.1"
}

start_launcher_log() {
  (umask 077; mkdir -p "$console_state_dir" && chmod 700 "$console_state_dir") || return 0
  rotate_launcher_log
  (umask 077; : >> "$launcher_log") || return 0
  exec 3>&2 2> >(tee -a "$launcher_log" >&2)
  launcher_log_open=1
  echo "claude-ollama: launch $size in $(pwd -P) at $(date -u +%Y-%m-%dT%H:%M:%SZ)" >&2
}

stop_launcher_log() {
  echo "claude-ollama: starting $1" >&2
  [ -n "$launcher_log_open" ] || return 0
  exec 2>&3 3>&-
}

git_common_dir() {
  git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true
}

item_replacement_dir() {
  local user_temp
  user_temp="$(getconf DARWIN_USER_TEMP_DIR 2>/dev/null || true)"
  [ -n "$user_temp" ] && echo "${user_temp%/}/TemporaryItems"
}

project_root() {
  git rev-parse --show-toplevel 2>/dev/null || pwd -P
}

real_folder() {
  (cd -P "$1" 2>/dev/null && pwd -P)
}

real_file() {
  local path="$1" link
  while [ -L "$path" ]; do
    link="$(readlink "$path")"
    case "$link" in
      /*) path="$link" ;;
      *) path="$(dirname "$path")/$link" ;;
    esac
  done
  printf '%s/%s\n' "$(real_folder "$(dirname "$path")")" "$(basename "$path")"
}

enclosing_repo_root() {
  local folder
  folder="$(pwd -P)"
  while [ -n "$folder" ]; do
    [ -e "$folder/.git" ] && break
    folder="${folder%/*}"
  done
  printf '%s\n' "${folder:-$(pwd -P)}"
}

session_writable_folders() {
  local folder
  for folder in "$(enclosing_repo_root)" "$session_config_dir"; do
    real_folder "$folder"
  done
  [ -n "${path_is_safe:-}" ] || return 0
  for folder in "$(project_root)" "$(git_common_dir)" "$(item_replacement_dir)"; do
    [ -n "$folder" ] && real_folder "$folder"
  done
  return 0
}

session_can_write() {
  local folder
  while IFS= read -r folder; do
    case "$1/" in
      "$folder"/*) return 0 ;;
    esac
  done < <(session_writable_folders)
  return 1
}

safe_path() {
  local entry folder safe=""
  local IFS=:
  for entry in $launch_path; do
    case "$entry" in
      /*) ;;
      *) continue ;;
    esac
    folder="$(real_folder "$entry")" || continue
    session_can_write "$folder" && continue
    safe="${safe:+$safe:}$entry"
  done
  printf '%s\n' "$safe"
}

trusted_command() {
  local found resolved
  found="$(command -v "$1" 2>/dev/null)" || return 1
  resolved="$(real_file "$found")"
  if session_can_write "$(dirname "$resolved")"; then
    echo "claude-ollama: not using $found: the session can write there" >&2
    return 1
  fi
  printf '%s\n' "$resolved"
}

require_plain_project_root() {
  local root
  root="$(project_root)"
  case "$root" in
    *'*'* | *'?'* | *'['*)
      echo "claude-ollama: $root has glob characters (*?[]), which would break the sandbox's write rules" >&2
      exit 1
      ;;
  esac
}

cmux_broker_wanted() {
  [ "${CLAUDE_OLLAMA_CMUX:-}" = 0 ] && return 1
  case "${CMUX_SOCKET_PATH:-}" in
    /*) [ -S "$CMUX_SOCKET_PATH" ] && trusted_command cmux >/dev/null ;;
    *) return 1 ;;
  esac
}

wait_for_socket() {
  local attempts=0
  while [ "$attempts" -lt 75 ]; do
    [ -S "$1" ] && return 0
    sleep 0.2
    attempts=$((attempts + 1))
  done
  return 1
}

start_cmux_broker() {
  cmux_broker_wanted || return 0
  cmux_broker_socket="$session_config_dir/cmux-broker.$$.sock"
  rm -f "$cmux_broker_socket"
  nohup "$profile_dir/cmux/broker.py" --socket "$cmux_broker_socket" \
    --cmux "$(trusted_command cmux)" --watch-pid "$$" >/dev/null 2>&1 &
  if wait_for_socket "$cmux_broker_socket"; then
    export CLAUDE_OLLAMA_CMUX_BROKER="$cmux_broker_socket"
  else
    cmux_broker_socket=""
    echo "claude-ollama: the cmux browser is off for this session: the browser could not be locked to localhost (run claude-ollama browser-check)" >&2
  fi
}

github_repo_slug() {
  local remote
  remote="$(git -C "$(project_root)" remote get-url origin 2>/dev/null)" || return 0
  case "$remote" in
    https://github.com/*) remote="${remote#https://github.com/}" ;;
    git@github.com:*) remote="${remote#git@github.com:}" ;;
    *) return 0 ;;
  esac
  printf '%s' "${remote%.git}"
}

ssh_origin_fix() {
  local remote slug
  remote="$(git -C "$(project_root)" remote get-url origin 2>/dev/null)" || return 0
  case "$remote" in
    git@github.com:*|ssh://*) ;;
    *) return 0 ;;
  esac
  slug="$(github_repo_slug)"
  echo "git remote set-url origin https://github.com/${slug:-OWNER/NAME}.git"
}

warn_ssh_origin() {
  local fix
  fix="$(ssh_origin_fix)"
  [ -n "$fix" ] || return 0
  echo "claude-ollama: origin is an SSH remote; sandboxed pushes need HTTPS: $fix" >&2
}

check_ssh_origin() {
  local fix
  fix="$(ssh_origin_fix)"
  [ -n "$fix" ] || return 0
  report warn "origin is an SSH remote; sandboxed pushes need HTTPS: $fix"
}

gh_repo_allow_flags() {
  local line repo
  [ -r "$gh_repos_file" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    repo="$(printf '%s' "$line" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
    [ -n "$repo" ] || continue
    if [[ ! "$repo" =~ $gh_repo_pattern ]]; then
      echo "claude-ollama: ignoring gh repo '$repo' (expected owner/name or owner/*)" >&2
      continue
    fi
    printf -- '--allow-repo\n%s\n' "$repo"
  done < "$gh_repos_file"
}

start_gh_broker() {
  local gh token allow_flags=()
  gh="$(trusted_command gh)" || return 0
  token="$(gh_login_token)" || return 0
  gh_broker_socket="$session_config_dir/gh-broker.$$.sock"
  rm -f "$gh_broker_socket"
  while IFS= read -r flag; do allow_flags+=("$flag"); done < <(gh_repo_allow_flags)
  GH_TOKEN="$token" nohup "$profile_dir/gh/broker.py" --socket "$gh_broker_socket" --gh "$gh" \
    --repo "$(github_repo_slug)" --watch-pid "$$" --rules "$command_rules_file" \
    --approve-with "$profile_dir/approve-dialog" ${allow_flags[@]+"${allow_flags[@]}"} >/dev/null 2>&1 &
  if wait_for_socket "$gh_broker_socket"; then
    export CLAUDE_OLLAMA_GH_BROKER="$gh_broker_socket"
  else
    gh_broker_socket=""
    echo "claude-ollama: GitHub reads are off for this session: the gh broker did not start" >&2
  fi
}

shortcut_config_dirs() {
  printf '%s\n' "${XDG_CONFIG_HOME:-$HOME/.config}/shortcut-cli" "$HOME/.config/shortcut-cli" \
    "$HOME/.config/clubhouse-cli" "$HOME/.clubhouse-cli"
  [ -z "${XDG_DATA_HOME:-}" ] || printf '%s\n' "$XDG_DATA_HOME/.config/shortcut-cli"
}

shortcut_command() {
  if [ -x "$shortcut_cli" ]; then
    printf '%s\n' "$shortcut_cli"
    return 0
  fi
  trusted_command short
}

start_shortcut_broker() {
  local short
  short="$(shortcut_command)" || return 0
  shortcut_broker_socket="$session_config_dir/shortcut-broker.$$.sock"
  rm -f "$shortcut_broker_socket"
  nohup "$profile_dir/shortcut/broker.py" --socket "$shortcut_broker_socket" --short "$short" \
    --watch-pid "$$" --rules "$command_rules_file" --approve-with "$profile_dir/approve-dialog" >/dev/null 2>&1 &
  if wait_for_socket "$shortcut_broker_socket"; then
    export CLAUDE_OLLAMA_SHORTCUT_BROKER="$shortcut_broker_socket"
  else
    shortcut_broker_socket=""
    echo "claude-ollama: short is off for this session: the Shortcut broker did not start" >&2
  fi
}

write_sandbox_policy() {
  local protected_policy_path="$sandbox_policy"
  jq --arg repo "$repo_dir" --arg config "$session_config_dir" --arg policy "$protected_policy_path" --arg git "$(git_common_dir)" \
    --arg items "$(item_replacement_dir)" --arg root "$(project_root)" --arg cmux_broker "${cmux_broker_socket:-}" --arg gh_broker "${gh_broker_socket:-}" \
    --arg shortcut_broker "${shortcut_broker_socket:-}" \
    --arg reviews "$review_log_dir" --arg console_state "$console_state_dir" --arg fetch_settings "$fetch_settings" \
    --arg rules "$command_rules_file" --arg rules_dir "$(dirname "$command_rules_file")" \
    --argjson shortcut_configs "$(shortcut_config_dirs | jq -R . | jq -s 'unique')" \
    --argjson fetch_domains "$(printf '%s' "${launch_fetch_domains:-}" | fetch_domains_json)" \
    --argjson config_sources '["CLAUDE.md", "skills", "settings.json", "settings.local.json", "commands", "agents", "plugins", "rules", "output-styles", "keybindings.json", ".config.json", "append-prompt.md"]' \
    --arg qwen_home "$qwen_home" \
    --argjson qwen_sources '["settings.json", "QWEN.md", "system.md", ".env", "skills", "agents", "extensions", "rules", "commands", "hooks", "mcpApprovals.json"]' '
    ($git | if . == "" then [] else [.] end) as $git_dirs
    | ($items | if . == "" then [] else [.] end) as $item_dirs
    | .filesystem.allowWrite += [$config] + $item_dirs + $git_dirs
    | .filesystem.denyWrite += [$repo, $policy, $rules, $rules_dir, {path: "\($root)/.claude", literal: true}, "\($root)/**/.claude", "\($root)/**/.claude/**", {path: "\($root)/.qwen", literal: true}, "\($root)/**/.qwen", "\($root)/**/.qwen/**"]
        + ["\($config)/gh-broker.*.sock", "\($config)/cmux-broker.*.sock", "\($config)/shortcut-broker.*.sock"]
        + [$config_sources[] as $source | "\($config)/\($source)"]
        + [$qwen_sources[] as $source | "\($qwen_home)/\($source)"]
        + [$git_dirs[] | "\(.)/hooks", "\(.)/config"]
    | .filesystem.denyRead += [$reviews, $console_state] + $shortcut_configs
    | ([$cmux_broker, $gh_broker, $shortcut_broker] | map(select(. != ""))) as $broker_sockets
    | if $broker_sockets == [] then . else .network.allowUnixSockets = $broker_sockets | .filesystem.denyWrite += $broker_sockets end
    | if ($fetch_domains | length) == 0 then . else
        .network.allowedDomains += $fetch_domains
        | .network.tlsTerminate.excludeDomains += $fetch_domains
        | .filesystem.denyWrite += [$fetch_settings]
      end
  ' "$profile_dir/sandbox.json" > "$sandbox_policy"
}

fetch_domains() {
  local line domain seen=" "
  [ -r "$fetch_domains_file" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    domain="$(printf '%s' "$line" | tr '[:upper:]' '[:lower:]' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
    [ -n "$domain" ] || continue
    if [[ ! "$domain" =~ $fetch_domain_pattern ]]; then
      echo "claude-ollama: ignoring fetch domain '$domain' (expected a hostname like docs.python.org)" >&2
      continue
    fi
    case "$seen" in *" $domain "*) continue ;; esac
    seen="$seen$domain "
    printf '%s\n' "$domain"
  done < "$fetch_domains_file"
}

fetch_domains_json() {
  jq -R . | jq -sc .
}

fetch_domains_label() {
  local domains
  domains="$(printf '%s' "${launch_fetch_domains:-}" | paste -sd' ' -)"
  echo "${domains:-none}"
}

write_fetch_settings() {
  local domains_json target
  rm -f "$fetch_settings"
  [ -n "${launch_fetch_domains:-}" ] || return 0
  domains_json="$(printf '%s' "$launch_fetch_domains" | fetch_domains_json)"
  target="$(mktemp "$fetch_settings.XXXXXX")"
  jq --argjson domains "$domains_json" '
    .permissions.deny = ((.permissions.deny - ["WebFetch"])
      + ["WebFetch(domain:localhost)", "WebFetch(domain:127.0.0.1)", "WebFetch(domain:0.0.0.0)", "WebFetch(domain:[::1])"])
    | .permissions.allow += [$domains[] | "WebFetch(domain:\(.))"]
    | .skipWebFetchPreflight = true
  ' "$settings_file" > "$target"
  mv -f "$target" "$fetch_settings"
}

launch_settings_file() {
  if [ -n "${launch_fetch_domains:-}" ]; then echo "$fetch_settings"; else echo "$settings_file"; fi
}

launch_tools() {
  if [ -n "${launch_fetch_domains:-}" ]; then echo "$tools,WebFetch"; else echo "$tools"; fi
}

prepare_session_config() {
  mkdir -p "$session_config_dir/tmp"
  if [ -f "$HOME/.claude/CLAUDE.md" ]; then
    cp "$HOME/.claude/CLAUDE.md" "$session_config_dir/CLAUDE.md"
  fi
  rebuild_session_state
  copy_user_skills
}

cleaned_session_state() {
  local taken="$1"
  if [ ! -L "$taken" ] && [ -s "$taken" ] &&
    jq -e --arg root "$(project_root)" -f "$profile_dir/session-state.jq" "$taken" 2>/dev/null; then
    return 0
  fi
  echo '{"hasCompletedOnboarding":true}'
}

rebuild_session_state() {
  local session_state="$session_config_dir/.claude.json" taken rebuilt
  taken="$(mktemp "$session_state.XXXXXX")"
  mv -f "$session_state" "$taken" 2>/dev/null || true
  rebuilt="$(mktemp "$session_state.XXXXXX")"
  cleaned_session_state "$taken" > "$rebuilt"
  rm -f "$taken"
  mv -f "$rebuilt" "$session_state"
}

copy_user_skills() {
  rm -rf "$session_config_dir/skills"
  [ -d "$HOME/.claude/skills" ] || return 0
  cp -RL "$HOME/.claude/skills" "$session_config_dir/skills"
}

github_token() {
  security find-generic-password -s "$github_keychain_item" -w 2>/dev/null
}

gh_login_token() {
  gh auth token --hostname github.com 2>/dev/null
}

store_push_token() {
  local page="https://github.com/settings/personal-access-tokens/new?name=claude-ollama-push&description=git+push+from+claude-ollama+sessions&expires_in=90&metadata=read&contents=write&pull_requests=write"
  echo "claude-ollama: create the push token in your browser, choose its repositories, then paste it below"
  echo "$page"
  open "$page" 2>/dev/null || true
  security add-generic-password -U -s "$github_keychain_item" -a "$USER" -w || exit 1
  echo "claude-ollama: stored the push token in the keychain item $github_keychain_item"
}

setup_github_tokens() {
  case "${1:-}" in
    push|'') store_push_token ;;
    *) echo "usage: claude-ollama github-token [push]" >&2; exit 2 ;;
  esac
  exit 0
}

github_basic_auth() {
  local token
  token="$(github_token)" || return 0
  printf 'x-access-token:%s' "$token" | base64 | tr -d '\n'
}

claude_command() {
  if sandbox_wanted; then
    printf '%s -s %s -- %s ' "$sandbox_runtime" "$sandbox_policy" "$profile_dir/sandbox-entry"
  fi
  printf 'claude --settings %s --system-prompt-file %s --append-system-prompt-file %s --strict-mcp-config --mcp-config %s --model %s --tools %s' \
    "$(launch_settings_file)" "$profile_dir/system-prompt.md" "$append_prompt" "$(mcp_config)" "$model" "$(launch_tools)"
}

sandbox_label() {
  if sandbox_wanted; then
    echo on
  else
    echo off
  fi
}

write_append_prompt() {
  if sandbox_wanted; then
    cat "$profile_dir/CLAUDE.local.md" "$profile_dir/CLAUDE.sandbox.md" > "$append_prompt"
  else
    cat "$profile_dir/CLAUDE.local.md" > "$append_prompt"
  fi
}

launch_sandboxed() {
  unset GH_TOKEN GITHUB_TOKEN
  warn_ssh_origin
  start_shortcut_broker
  unset SHORTCUT_API_TOKEN SHORTCUT_URL_SLUG SHORTCUT_MENTION_NAME CLUBHOUSE_API_TOKEN
  write_sandbox_policy
  GH_BASIC="$(github_basic_auth)"
  export GH_BASIC
  export CLAUDE_OLLAMA_SESSION_PATH="$launch_path"
  stop_launcher_log "$1"
  run_in_raw_terminal "$sandbox_runtime" -s "$sandbox_policy" -- "$profile_dir/sandbox-entry" "$@"
  exit
}

print_config() {
  echo "size: $size"
  echo "model: $model"
  echo "base: $(base_model)"
  echo "embedding model: $embedding_model"
  echo "num_ctx: $(modelfile_num_ctx)"
  echo "max context tokens: $(profile_context_tokens)"
  echo "settings: $(launch_settings_file)"
  echo "fetch domains: $(fetch_domains_label)"
  echo "tools: $(launch_tools)"
  echo "sandbox: $(sandbox_label)"
  echo "command: $(claude_command)"
}

require_qwen() {
  command -v qwen >/dev/null 2>&1 && return 0
  echo "claude-ollama: qwen is missing (brew install qwen-code)" >&2
  exit 1
}

qwen_args() {
  printf '%s\n' --auth-type openai --openai-base-url "$ollama_url/v1" --openai-api-key ollama -m "$model" --approval-mode auto-edit --mcp-config "$(mcp_config)"
}

qwen_command() {
  if sandbox_wanted; then
    printf '%s -s %s -- %s ' "$sandbox_runtime" "$sandbox_policy" "$profile_dir/sandbox-entry"
  fi
  printf 'qwen %s' "$(qwen_args | tr '\n' ' ' | sed 's/ $//')"
}

create_qwen_home() {
  mkdir -p "$qwen_home/skills" "$qwen_home/agents" "$qwen_home/extensions" "$qwen_home/rules" "$qwen_home/commands" "$qwen_home/hooks"
}

write_qwen_settings() {
  jq --arg model "$model" --arg base_url "$ollama_url/v1" --argjson context "$(modelfile_num_ctx)" '
    .model.name = $model
    | .modelProviders.openai[0].id = $model
    | .modelProviders.openai[0].name = "\($model) (Ollama)"
    | .modelProviders.openai[0].baseUrl = $base_url
    | .modelProviders.openai[0].generationConfig.contextWindowSize = $context
  ' "$profile_dir/qwen-settings.template.json" > "$qwen_home/settings.json"
}

write_qwen_context() {
  if sandbox_wanted; then
    cat "$repo_dir/shared/preferences/PREFERENCES.md" "$profile_dir/QWEN.local.md" "$profile_dir/CLAUDE.sandbox.md" > "$qwen_home/QWEN.md"
  else
    cat "$repo_dir/shared/preferences/PREFERENCES.md" "$profile_dir/QWEN.local.md" > "$qwen_home/QWEN.md"
  fi
}

print_qwen_config() {
  echo "harness: qwen"
  echo "size: $size"
  echo "model: $model"
  echo "base: $(base_model)"
  echo "num_ctx: $(modelfile_num_ctx)"
  echo "context window: $(modelfile_num_ctx)"
  echo "qwen home: $qwen_home"
  echo "settings template: $profile_dir/qwen-settings.template.json"
  echo "sandbox: $(sandbox_label)"
  echo "command: $(qwen_command)"
}

launch_qwen() {
  local launch_args=()
  while IFS= read -r arg; do launch_args+=("$arg"); done < <(qwen_args)
  unset OPENAI_API_KEY OPENAI_BASE_URL OPENAI_MODEL QWEN_MODEL QWEN_SANDBOX QWEN_RUNTIME_DIR SANDBOX
  export QWEN_HOME="$qwen_home"
  export QWEN_USAGE_STATISTICS_ENABLED=false
  export QWEN_CODE_MODELS_DEV_REFRESH=off
  create_qwen_home
  write_qwen_settings
  write_qwen_context
  if sandbox_wanted; then
    export SANDBOX=claude-ollama
    export NODE_OPTIONS="--require \"$profile_dir/qwen-raw-mode.cjs\" --require \"$profile_dir/qwen-dir-watch.cjs\"${NODE_OPTIONS:+ $NODE_OPTIONS}"
    launch_sandboxed qwen "${launch_args[@]}" "$@"
  fi
  echo "claude-ollama: sandbox OFF (CLAUDE_OLLAMA_SANDBOX=0): the session runs as you, with your gh, short, git credentials and env" >&2
  stop_launcher_log qwen
  PATH="$launch_path"
  exec qwen "${launch_args[@]}" "$@"
}

report() {
  printf '%-4s %s\n' "$1" "$2"
  [ "$1" != fail ]
}

check_model_present() {
  local label="$1" name="$2" fix="$3" level="${4:-fail}"
  if ollama show "$name" >/dev/null 2>&1; then
    report ok "$label $name"
  else
    report "$level" "$label $name missing ($fix)"
  fi
}

check_digest() {
  local name="$1" actual pin
  actual="$(installed_digest "$name")"
  pin="$(pinned_digest "$name")"
  [ -n "$actual" ] && [ -n "$pin" ] || return 0
  if [ "$actual" = "$pin" ]; then
    report ok "digest $name matches its pin"
  else
    report fail "digest $name is $actual, not the pinned $pin (ollama rm $name, then relaunch)"
  fi
}

check_digests() {
  local name status=0
  for name in "$(base_model)" "$embedding_model"; do
    check_digest "$name" || status=1
  done
  return "$status"
}

check_context_sizes() {
  local ctx tokens
  ctx="$(modelfile_num_ctx)"
  tokens="$(profile_context_tokens)"
  if [ "$ctx" = "$tokens" ]; then
    report ok "num_ctx $ctx matches CLAUDE_CODE_MAX_CONTEXT_TOKENS"
  else
    report fail "num_ctx $ctx differs from CLAUDE_CODE_MAX_CONTEXT_TOKENS $tokens"
  fi
}

hook_names() {
  jq -r '.hooks[]?[]?.hooks[]?.command' "$profile_dir/settings.$size.json" |
    sed -n 's#.*/shared/hooks/##p' | sort -u
}

check_hooks_present() {
  local hook status=0
  while IFS= read -r hook; do
    if [ -x "$repo_dir/shared/hooks/$hook" ]; then
      report ok "hook $hook present"
    else
      report fail "hook $hook missing or not executable in shared/hooks"
      status=1
    fi
  done < <(hook_names)
  return "$status"
}

check_reachable() {
  if curl -sf -m 2 "$ollama_url/api/version" >/dev/null 2>&1; then
    report ok "ollama reachable at $ollama_url"
  else
    report fail "ollama not reachable at $ollama_url (brew services start ollama)"
  fi
}

running_server_env() {
  local pid
  pid="$(pgrep -x ollama | head -n 1)" || true
  [ -n "$pid" ] || return 1
  if [ -r "/proc/$pid/environ" ]; then
    tr '\0' '\n' < "/proc/$pid/environ"
  else
    ps -Eo command -p "$pid" | tr ' ' '\n'
  fi
}

check_server_env() {
  local env_lines wanted status=0
  if ! env_lines="$(running_server_env)"; then
    report fail "ollama server not running (brew services start ollama)"
    return 1
  fi
  while IFS= read -r wanted; do
    [ -n "$wanted" ] || continue
    if printf '%s\n' "$env_lines" | grep -qxF "$wanted"; then
      report ok "server env $wanted"
    else
      report fail "server env $wanted not set on the running server"
      status=1
    fi
  done < "$profile_dir/server.env"
  [ "$status" -eq 0 ] || echo "     fix: claude-custom agent -apply"
  return "$status"
}

wait_for_server() {
  local tries=50
  while [ "$tries" -gt 0 ]; do
    curl -fs -o /dev/null -m 1 "$ollama_url/api/version" 2>/dev/null && return 0
    sleep 0.2
    tries=$((tries - 1))
  done
  echo "claude-ollama: ollama is not answering at $ollama_url yet" >&2
}

apply_server_env() {
  check_server_env >/dev/null 2>&1 && return 0
  echo "claude-ollama: the Ollama server lacks ollama/server.env values; applying them" >&2
  if "$ollama_agent" -apply >&2; then
    wait_for_server
  else
    echo "claude-ollama: could not apply server.env; set it up with: claude-custom agent" >&2
  fi
}

managed_settings="${CLAUDE_OLLAMA_MANAGED_SETTINGS:-/Library/Application Support/ClaudeCode/managed-settings.json}"

check_model_allowed() {
  if ! [ -r "$managed_settings" ] || ! jq -e 'has("availableModels")' "$managed_settings" >/dev/null 2>&1; then
    report ok "no managed availableModels restricts $model"
  elif jq -e --arg model "$model" '.availableModels | index($model) != null' "$managed_settings" >/dev/null; then
    report ok "managed availableModels allows $model"
  else
    report warn "managed availableModels lacks $model (ask your admin to add it; Claude Code substitutes a [1m] variant)"
  fi
}

check_sandbox() {
  if ! sandbox_wanted; then
    report warn "sandbox off (CLAUDE_OLLAMA_SANDBOX=0); unset it to sandbox the session"
    return 0
  fi
  report ok "sandbox on (CLAUDE_OLLAMA_SANDBOX=0 turns it off)"
  check_ssh_origin
  check_sandbox_runtime
}

check_sandbox_runtime() {
  if [ -x "$sandbox_runtime" ]; then
    report ok "sandbox-runtime installed"
  else
    report fail "sandbox-runtime missing (run claude-custom install)"
  fi
}

check_fetch_domains() {
  local domains
  domains="$(fetch_domains | paste -sd' ' -)"
  if [ -n "$domains" ]; then
    report ok "web fetch on for: $domains"
  else
    report ok "web fetch off (no domains in $fetch_domains_file)"
  fi
}

check_shortcut() {
  local short
  if short="$(shortcut_command)"; then
    report ok "short (Shortcut CLI) found: $short"
  else
    report warn "short (Shortcut CLI) missing (run claude-custom install)"
  fi
}

check_github_token() {
  if github_token >/dev/null; then
    report ok "GitHub token in the keychain item $github_keychain_item"
  else
    report warn "no GitHub token in the keychain item $github_keychain_item (git push from the session will fail; run claude-ollama github-token push)"
  fi
}

check_gh_login() {
  if trusted_command gh >/dev/null && gh_login_token >/dev/null; then
    report ok "gh logged in to github.com (the session's GitHub tools use it through the broker)"
  else
    report warn "gh is not logged in to github.com (the session's GitHub tools will be missing; run gh auth login)"
  fi
}

check_command_rules() {
  local allowed denied
  if [ ! -r "$command_rules_file" ]; then
    report ok "command rules: none ($command_rules_file); writes ask in a dialog"
    return 0
  fi
  allowed="$(grep -c '^allow[[:space:]]' "$command_rules_file" || true)"
  denied="$(grep -c '^deny[[:space:]]' "$command_rules_file" || true)"
  report ok "command rules: $allowed allow, $denied deny ($command_rules_file)"
}

doctor() {
  local status=0
  report ok "jq on PATH"
  check_model_present model "$model" "run claude-ollama $size to pull and create it" || status=1
  check_model_present "embedding model" "$embedding_model" "pick 'Set up embedding model' in claude-ollama" || status=1
  check_digests || status=1
  check_context_sizes || status=1
  check_hooks_present || status=1
  check_reachable || status=1
  check_server_env || status=1
  check_sandbox || status=1
  check_fetch_domains
  if sandbox_wanted; then
    check_github_token
    check_shortcut
  fi
  check_gh_login
  check_command_rules
  check_model_allowed
  exit "$status"
}

plist_log_path() {
  local plist="$HOME/Library/LaunchAgents/$1.plist"
  [ -f "$plist" ] || return 0
  sed -n 's|.*<key>StandardOutPath</key><string>\(.*\)</string>.*|\1|p' "$plist" | head -n 1
}

brew_log_path() {
  echo "${HOMEBREW_PREFIX:-/opt/homebrew}/var/log/ollama.log"
}

running_ollama_label() {
  command -v launchctl >/dev/null 2>&1 || return 0
  launchctl list 2>/dev/null | awk '$1 ~ /^[0-9]+$/ && ($3 == "local.ollama" || $3 == "sh.brew.ollama" || $3 == "homebrew.mxcl.ollama") { print $3; exit }'
}

running_log_path() {
  local label path
  label="$(running_ollama_label)"
  [ -n "$label" ] || return 0
  path="$(plist_log_path "$label")"
  if [ -z "$path" ] && [ "$label" != local.ollama ]; then
    path="$(brew_log_path)"
  fi
  echo "$path"
}

server_log_path() {
  local candidate
  for candidate in "$(running_log_path)" "$(plist_log_path local.ollama)" "$(brew_log_path)" "$HOME/.ollama/logs/server.log"; do
    if [ -n "$candidate" ] && [ -f "$candidate" ]; then
      echo "$candidate"
      return 0
    fi
  done
  return 1
}

follow_logs() {
  local lines=50 path
  if ! path="$(server_log_path)"; then
    echo "claude-ollama: no Ollama log found (LaunchAgent, Homebrew service or app); a server started with 'ollama serve' logs to its own terminal" >&2
    exit 1
  fi
  if [ "${1:-}" = --path ]; then
    echo "$path"
    exit 0
  fi
  if [ "${1:-}" = -n ] && [ -n "${2:-}" ]; then
    lines="$2"
  fi
  echo "claude-ollama: following $path" >&2
  exec tail -n "$lines" -F "$path"
}

remove_console_files() {
  rm -f "${web_url_file:-}" "${console_token_file:-}"
}

reviews_build_needed() {
  local web_dir="$1" build_marker="$1/.next/BUILD_ID"
  [ -f "$build_marker" ] || return 0
  [ -n "$(find "$web_dir/src" "$web_dir/package.json" "$web_dir/pnpm-lock.yaml" "$web_dir"/next.config.* -newer "$build_marker" 2>/dev/null)" ]
}

console_install_needed() {
  local web_dir="$1" install_marker="$1/node_modules/.modules.yaml"
  [ -f "$install_marker" ] || return 0
  [ "$web_dir/pnpm-lock.yaml" -nt "$install_marker" ]
}

serve_console() {
  local command_name="$1" label="$2" page="$3" port=8765 web_dir url page_url token project_dir
  project_dir="$(pwd -P)"
  shift 3
  while [ $# -gt 0 ]; do
    case "$1" in
      --port)
        port="${2:-}"
        shift 2 || shift
        ;;
      *)
        echo "claude-ollama $command_name: unknown argument: $1" >&2
        exit 2
        ;;
    esac
  done
  case "$port" in
    ''|*[!0-9]*)
      echo "claude-ollama $command_name: --port needs a number" >&2
      exit 2
      ;;
  esac
  if ! command -v pnpm >/dev/null 2>&1; then
    echo "claude-ollama: pnpm is required for the reviews page (brew install pnpm)" >&2
    exit 1
  fi
  web_dir="${CLAUDE_OLLAMA_WEB_DIR:-$repo_dir/web/console}"
  if console_install_needed "$web_dir"; then
    pnpm --dir "$web_dir" install --frozen-lockfile || exit 1
  fi
  if reviews_build_needed "$web_dir"; then
    pnpm --dir "$web_dir" build || exit 1
  fi
  token="$(od -An -N24 -tx1 /dev/urandom | tr -d ' \n')"
  url="http://127.0.0.1:$port/?token=$token"
  page_url="http://127.0.0.1:$port$page?token=$token"
  mkdir -p "$review_log_dir"
  web_url_file="$review_log_dir/.web-url"
  (umask 077; rm -f "$web_url_file"; printf '%s\n' "$url" > "$web_url_file")
  console_token_file="$console_state_dir/tokens/$port"
  (umask 077; mkdir -p "$console_state_dir"; chmod 700 "$console_state_dir"; rm -f "$console_state_dir/token"; mkdir -p "$console_state_dir/tokens"; chmod 700 "$console_state_dir/tokens"; rm -f "$console_token_file"; printf '%s\n' "$token" > "$console_token_file")
  trap remove_console_files EXIT INT TERM
  echo "claude-ollama: $label at $page_url"
  CONSOLE_TOKEN_FILE="$console_token_file" CLAUDE_CUSTOM_HOME="$repo_dir" CLAUDE_CONSOLE_STATE_DIR="$console_state_dir" CLAUDE_CUSTOM_CHANGE_SOURCE=console CONSOLE_PROJECT_DIR="$project_dir" \
    pnpm --dir "$web_dir" exec next start -H 127.0.0.1 -p "$port"
  exit 0
}

case "${1:-}" in
  -h|--help)
    echo "usage: claude-ollama [size] [claude args...]"
    echo "qwen [size] [qwen args...]: launch Qwen Code (brew install qwen-code) on the size's model, in the same sandbox, with the same MCP servers"
    echo "qwen --print-config [size]: print the resolved settings and the qwen command"
    echo "sizes: $(configured_sizes | tr '\n' ' ' | sed 's/ $//')"
    echo "no size: pick one in a menu (or $default_size without a terminal)"
    echo "sandbox: on by default (sandbox-runtime); CLAUDE_OLLAMA_SANDBOX=0 claude-ollama ... runs the session as you"
    echo "doctor [size]: check models, context sizes, hooks, Ollama and the server env"
    echo "--print-config [size]: print the resolved settings and the claude command"
    echo "logs [-n LINES|--path]: follow the Ollama server log (LaunchAgent, Homebrew service or app), or print its path"
    echo "review [size] PR [--post]: review a pull request with the size's model, one file per request"
    echo "ui [--port N]: serve the console (runs, health, logs, models, reviews) at http://127.0.0.1:8765/"
    echo "reviews [--port N]: serve live and past reviews at http://127.0.0.1:8765/"
    echo "github-token [push]: create the git push token in the browser and store it in the keychain"
    echo "fetch domains: list hostnames in ~/.config/claude-custom/fetch-domains to give sessions WebFetch for them"
    echo "prepare [size]: pull or import the size's model and stop, without starting claude"
    echo "prepare-embedding: pull the semantic_search embedding model and stop, without starting claude"
    echo "speed-check: check thinking is off and bench the GGUF sizes against the MLX ones, then print a verdict"
    echo "thinking-check: check thinking is off on the MLX sizes and print PASS or FAIL"
    echo "browser-check: prove the session browser stays on localhost (run from a cmux terminal)"
    exit 0 ;;
esac

run_browser_check() {
  if [ -z "${CMUX_SOCKET_PATH:-}" ] || ! command -v cmux >/dev/null 2>&1; then
    echo "claude-ollama browser-check: run this from a cmux terminal" >&2
    exit 1
  fi
  exec python3 "$repo_dir/ollama/cmux/broker.py" --self-test --cmux "$(command -v cmux)"
}

PATH="$(safe_path)"
path_is_safe=1
PATH="$(safe_path)"

harness=claude
mode=launch
case "${1:-}" in
  doctor) mode=doctor; shift ;;
  browser-check) mode=browser-check; shift ;;
  --print-config) mode=print-config; shift ;;
  logs) mode=logs; shift ;;
  prepare-embedding) mode=prepare-embedding; shift ;;
  review) mode=review; shift ;;
  ui) mode=ui; shift ;;
  reviews) mode=reviews; shift ;;
  github-token) mode=github-token; shift ;;
  prepare) mode=prepare; shift ;;
  qwen)
    harness=qwen
    shift
    case "${1:-}" in --print-config) mode=print-config; shift ;; esac ;;
  speed-check) exec "${CLAUDE_OLLAMA_SPEED_CHECK:-$repo_dir/bin/speed-check}" "${@:2}" ;;
  thinking-check) exec "${CLAUDE_OLLAMA_SPEED_CHECK:-$repo_dir/bin/speed-check}" --thinking-only ;;
esac

[ "$mode" != logs ] || follow_logs "$@"
[ "$mode" != prepare-embedding ] || prepare_embedding
[ "$mode" != ui ] || serve_console ui console / "$@"
[ "$mode" != reviews ] || serve_console reviews reviews /reviews "$@"
[ "$mode" != github-token ] || setup_github_tokens "$@"
[ "$mode" != browser-check ] || run_browser_check

if ! command -v jq >/dev/null 2>&1; then
  echo "claude-ollama: jq is required (brew install jq)" >&2
  exit 1
fi

review_target=""
if [ "$mode" = review ]; then
  if [ $# -eq 0 ]; then
    echo "claude-ollama review: a pull request number, URL or branch is required" >&2
    exit 2
  fi
  review_target="${!#}"
  set -- "${@:1:$#-1}"
fi

run_review() {
  local target="$1"
  shift
  ensure_model
  warm_model
  exec "${CLAUDE_OLLAMA_REVIEWER:-$repo_dir/bin/pr-review-local}" --model "$model" --base-url "$ollama_url" "$@" "$target"
}

if [ $# -gt 0 ] && is_configured_size "$1"; then
  size="$1"
  shift
else
  case "${1:-}" in
    ''|-*) ;;
    *) shift ;;
  esac
  size="$(choose_size)"
fi

model="$(jq -r .model "$profile_dir/settings.$size.json")"
settings_file="$profile_dir/settings.$size.json"

case "$mode" in
  print-config)
    if [ "$harness" = qwen ]; then
      print_qwen_config
    else
      launch_fetch_domains="$(fetch_domains)"
      print_config
    fi
    exit 0 ;;
  doctor) doctor ;;
  review) run_review "$review_target" "$@" ;;
  prepare) ensure_model; exit 0 ;;
esac

start_launcher_log
if sandbox_wanted; then
  require_sandbox_runtime
  require_plain_project_root
fi
[ "$harness" != qwen ] || require_qwen
apply_server_env
ensure_model
ensure_embedding_model
verify_installed_models
allow_search_embeddings
warm_embedding_model
warm_search_index
warm_model

unset ANTHROPIC_API_KEY ANTHROPIC_MODEL CLAUDE_OLLAMA_CMUX_BROKER CLAUDE_OLLAMA_GH_BROKER CLAUDE_OLLAMA_SHORTCUT_BROKER CLAUDE_OLLAMA_SESSION_PATH
export CLAUDE_CUSTOM_HOME="$repo_dir"
prepare_session_config
start_cmux_broker
start_gh_broker
export CLAUDE_CONFIG_DIR="$session_config_dir"
export CLAUDE_CODE_TMPDIR="$session_config_dir/tmp"
if [ "$harness" = qwen ]; then
  launch_qwen "$@"
fi
launch_fetch_domains="$(fetch_domains)"
write_fetch_settings
write_append_prompt
claude_args=(
  --settings "$(launch_settings_file)"
  --system-prompt-file "$profile_dir/system-prompt.md"
  --append-system-prompt-file "$append_prompt"
  --strict-mcp-config
  --mcp-config "$(mcp_config)"
  --model "$model"
  --tools "$(launch_tools)"
)
if sandbox_wanted; then
  launch_sandboxed claude "${claude_args[@]}" "$@"
fi
echo "claude-ollama: sandbox OFF (CLAUDE_OLLAMA_SANDBOX=0): the session runs as you, with your gh, short, git credentials and env" >&2
stop_launcher_log claude
PATH="$launch_path"
exec claude "${claude_args[@]}" "$@"
