#!/bin/bash
set -euo pipefail

repo_dir="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
. "$repo_dir/bin/lib/size-profile.sh"
. "$repo_dir/bin/lib/ollama-server.sh"
. "$repo_dir/bin/lib/memory-fit.sh"
. "$repo_dir/bin/lib/nvm-node.sh"
. "$repo_dir/bin/lib/session-logs.sh"
. "$repo_dir/bin/lib/cmux-terminal.sh"
doctor_bin="${CLAUDE_OLLAMA_DOCTOR_BIN:-$repo_dir/bin/claude-ollama-doctor}"
qwen_bin="${CLAUDE_OLLAMA_QWEN_BIN:-$repo_dir/bin/claude-ollama-qwen}"
go_dir="$repo_dir/go"
picker_binary="$go_dir/cmd/model-picker/model-picker"
default_size=27b
tools="Bash,Read,Edit,Write,Skill,TaskStop"
keep_alive="${CLAUDE_OLLAMA_KEEP_ALIVE:-30m}"
ollama_agent="${CLAUDE_OLLAMA_AGENT:-$repo_dir/bin/ollama-agent}"
gguf_inspect="${CLAUDE_OLLAMA_GGUF_INSPECT:-$repo_dir/bin/gguf-inspect}"
drafts_dir="$session_config_dir/drafts"
relaunch_root="$session_config_dir/relaunch"
relaunch_dir="$relaunch_root/$$"
claude_pid=""
relaunch_args=()
relaunch_note=""
relaunch_prompt=""
relaunch_percent=""
heartbeat_pid=""
ladder_rung=""
ladder_context=""
ladder_reason=""
session_rung=""
fit_embed_off=""
append_prompt="$session_config_dir/append-prompt.md"
proxy_port_file="$session_config_dir/proxy.port"
proxy_record_dir="$session_config_dir/proxy/record"
proxy_url=""
review_log_dir="${PR_REVIEW_LOG_DIR:-$HOME/.local/share/claude-custom/reviews}"
console_port=8765
launcher_log="$console_state_dir/launcher.log"
launcher_log_max_bytes=1048576
launcher_log_open=""
telemetry_log_max_bytes=1048576

binary_is_current() {
  local dir="$1" binary="$2"
  [ -x "$binary" ] || return 1
  [ -z "$(find "$dir" \( -name '*.go' -o -name 'go.mod' -o -name 'go.sum' \) -newer "$binary" -print -quit)" ]
}

ensure_built() {
  local module_dir="$1" binary="$2" package="$3" label="$4" hint="${5:-}"
  binary_is_current "$module_dir" "$binary" && return 0
  if ! command -v go >/dev/null 2>&1; then
    echo "$label: needs Go 1.26+ (https://go.dev/dl) to build $binary$hint" >&2
    return 1
  fi
  (cd "$module_dir" && go build -o "$binary" "$package") >&2
}

pick_size() {
  ensure_built "$go_dir" "$picker_binary" ./cmd/model-picker claude-ollama "; or pass a size: $(configured_sizes | tr '\n' ' ')" || exit 1
  "$picker_binary" "$profile_dir" || exit 130
}

choose_size() {
  if [ -t 0 ] && [ -t 2 ]; then
    pick_size
  else
    printf '%s\n' "$default_size"
  fi
}

installed_parameters_match() {
  local installed key value
  installed="$(ollama show "$1" --parameters 2>/dev/null)"
  while read -r key value; do
    [ "$(printf '%s\n' "$installed" | awk -v key="$key" '$1 == key { print $2 }')" = "$value" ] || return 1
  done <<EOF
$(modelfile_parameters)
EOF
}

refresh_parameters() {
  local name="$1" modelfile
  installed_parameters_match "$name" && return 0
  echo "claude-ollama: recreating $name with $(modelfile_parameters | tr '\n' ' ' | sed 's/ $//')" >&2
  modelfile="$(mktemp -t claude-ollama-modelfile.XXXXXX)"
  { printf 'FROM %s\n' "$name"; modelfile_parameters | sed 's/^/PARAMETER /'; } > "$modelfile"
  ollama create "$name" -f "$modelfile"
  rm -f "$modelfile"
}

check_pin() {
  local name="$1" actual="$2" pin
  pin="$(pinned_digest "$name")"
  [ -z "$pin" ] || [ "$actual" = "$pin" ] && return 0
  echo "claude-ollama: $name has digest ${actual:-none}, but ollama/model-digests.json pins $pin; remove it with 'ollama rm $name' and relaunch, or run bin/model-upgrade SIZE to test the new base and print the pin command" >&2
  return 1
}

verify_pulled() {
  check_pin "$1" "$(installed_digest "$1")"
}

verify_installed() {
  local actual
  actual="$(installed_digest "$1")"
  [ -z "$actual" ] || check_pin "$1" "$actual"
}

verify_installed_models() {
  local name
  for name in $(pinned_models); do
    verify_installed "$name" || exit 1
  done
}

gguf_source() {
  jq -r --arg size "$size" '.[$size].gguf // empty | "\(.repo) \(.revision)"' "$profile_dir/sizes.json"
}

is_gguf_base() {
  case "$(base_model)" in
    ./weights/*.gguf) return 0 ;;
    *) return 1 ;;
  esac
}

import_gguf() {
  local base source repo revision name file part pin actual created=0
  base="$(base_model)"
  source="$(gguf_source)"
  pin="$(pinned_digest "$base")"
  if [ -z "$source" ] || [ -z "$pin" ]; then
    echo "claude-ollama: $base needs a pinned source in sizes.json and a digest in model-digests.json; refusing to download" >&2
    return 1
  fi
  read -r repo revision <<<"$source"
  name="${base##*/}"
  file="$profile_dir/${base#./}"
  part="$file.part"
  mkdir -p "$profile_dir/weights"
  echo "claude-ollama: downloading $repo/$name (pinned $revision)" >&2
  if ! curl -fL --retry 3 -C - -o "$part" "https://huggingface.co/$repo/resolve/$revision/$name"; then
    echo "claude-ollama: the download of $name stopped; run the same command again to resume it" >&2
    return 1
  fi
  actual="$(shasum -a 256 "$part" | cut -d' ' -f1)"
  if [ "$actual" != "$pin" ]; then
    echo "claude-ollama: $name has sha256 $actual, but ollama/model-digests.json pins $pin; not importing" >&2
    rm -f "$part"
    return 1
  fi
  if ! "$gguf_inspect" "$part" >&2; then
    echo "claude-ollama: $name failed inspection; not importing" >&2
    rm -f "$part"
    return 1
  fi
  mv "$part" "$file"
  (cd "$profile_dir" && ollama create "$model" -f "Modelfile.$size") && created=1
  rm -f "$file"
  [ "$created" = 1 ]
}

ensure_model() {
  if ollama show "$model" >/dev/null 2>&1; then
    refresh_parameters "$model"
    return
  fi
  if is_gguf_base; then
    import_gguf || exit 1
  else
    ollama pull "$(base_model)"
    verify_pulled "$(base_model)" || exit 1
    ollama create "$model" -f "$profile_dir/Modelfile.$size"
  fi
  refresh_parameters "$model"
}

ensure_embedding_model() {
  ollama show "$embedding_model" >/dev/null 2>&1 && return 0
  ollama pull "$embedding_model" ||
    echo "claude-ollama: could not pull $embedding_model; semantic_search will fail until you run claude-ollama and pick 'Set up embedding model'" >&2
}

prepare_embedding() {
  ollama show "$embedding_model" >/dev/null 2>&1 && exit 0
  exec ollama pull "$embedding_model"
}

warm_model() {
  command -v curl >/dev/null 2>&1 || return 0
  curl -s -o /dev/null -m 2 -X POST "$ollama_url/api/generate" \
    -d "{\"model\":\"$model\",\"keep_alive\":\"$keep_alive\"}" >/dev/null 2>&1 &
}

embeddings_wanted() {
  [ -z "$fit_embed_off" ] && embedding_model_fits
}

allow_search_embeddings() {
  if [ -n "$fit_embed_off" ]; then
    export CODE_SEARCH_EMBED=0
    return 0
  fi
  embedding_model_fits || return 0
  export CODE_SEARCH_EMBED=1
}

warm_embedding_model() {
  embeddings_wanted || return 0
  command -v curl >/dev/null 2>&1 || return 0
  curl -s -o /dev/null -m 30 -X POST "$ollama_url/api/embed" \
    -d "{\"model\":\"$embedding_model\",\"input\":\"warm up\",\"keep_alive\":\"$keep_alive\"}" >/dev/null 2>&1
}

acquire_lease() {
  lease_on || return 0
  "$lease_bin" acquire "$@" --pid "$$"
}

release_session_lease() {
  lease_on || return 0
  "$lease_bin" release session --pid "$$" >/dev/null 2>&1 || true
}

session_num_ctx() {
  if [ -n "$ladder_context" ]; then echo "$ladder_context"; else modelfile_num_ctx; fi
}

claim_session() {
  lease_on || return 0
  acquire_lease session --model "$model" --num-ctx "$(session_num_ctx)" --rung "$session_rung" || exit 3
  trap end_launch EXIT
}

record_session_rung() {
  acquire_lease session --model "$model" --num-ctx "$(session_num_ctx)" --rung "$session_rung" >/dev/null 2>&1 || true
}

measure_fit() {
  local fit_error
  fit_error="$(mktemp)"
  if ! fit_result="$(run_fit "$@" 2>"$fit_error")"; then
    echo "claude-ollama: memory fit: unknown ($(head -n 1 "$fit_error"))" >&2
    rm -f "$fit_error"
    return 1
  fi
  rm -f "$fit_error"
  read_fit "$fit_result"
}

lower_context_of() {
  local lower
  lower="$(jq -r --argjson current "$1" '[.[] | .context | select(. < $current)] | max // empty' "$profile_dir/sizes.json" 2>/dev/null)"
  if [ -n "$lower" ]; then echo "$lower"; return; fi
  awk -v current="$1" 'BEGIN { rounded = int(current * 0.75 / 1024) * 1024; print (rounded < 16384 ? 16384 : rounded) }'
}

start_without_embeddings() {
  fit_embed_off=1
  session_rung=embeddings-off
  echo "claude-ollama: ladder embeddings-off: does not fit with the embedding model ($(fit_shortfall) short)" >&2
  measure_fit "$(modelfile_num_ctx)" "" || return 1
  fit_fits "$fit_result"
}

start_on_lower_context() {
  ladder_rung=context-down
  ladder_context="$(lower_context_of "$(modelfile_num_ctx)")"
  session_rung=context-down
  echo "claude-ollama: ladder context-down: does not fit at num_ctx $(modelfile_num_ctx) ($(fit_shortfall) short); starting at $ladder_context" >&2
  measure_fit "$ladder_context" "" || return 1
  fit_fits "$fit_result" || echo "claude-ollama: memory fit: still $(fit_shortfall) short at num_ctx $ladder_context with the embeddings off" >&2
}

check_memory_fit() {
  local embedding="" fit_result
  fit_on || return 0
  ! embedding_model_fits || embedding="$embedding_model"
  measure_fit "$(modelfile_num_ctx)" "$embedding" || return 0
  echo "claude-ollama: memory fit: $(fit_summary)" >&2
  fit_fits "$fit_result" && return 0
  if [ -n "$embedding" ]; then
    start_without_embeddings && return 0
  fi
  start_on_lower_context || true
}

start_heartbeat() {
  lease_on || return 0
  nohup "$lease_bin" heartbeat --watch-pid "$$" --fast-marker "$(relaunch_signal path heartbeat-fast)" >/dev/null 2>&1 &
  heartbeat_pid=$!
}

stop_heartbeat() {
  [ -z "$heartbeat_pid" ] || kill "$heartbeat_pid" 2>/dev/null || true
}

end_launch() {
  stop_heartbeat
  release_session_lease
  remove_relaunch_dir
  remove_composed_settings
}

leased_indexer() {
  if lease_on && embeddings_wanted; then
    cat <<'SH'
"$1" acquire embedding --model "$2" --pid $$ >/dev/null 2>&1 || export CODE_SEARCH_EMBED=0
exec python3 "$3" --index --watch-pid "$4"
SH
  else
    cat <<'SH'
exec python3 "$3" --index --watch-pid "$4"
SH
  fi
}

warm_search_index() {
  [ -z "${CLAUDE_OLLAMA_NO_INDEX:-}" ] || return 0
  git rev-parse --show-toplevel >/dev/null 2>&1 || return 0
  nohup sh -c "$(leased_indexer)" indexer "$lease_bin" "$embedding_model" "$repo_dir/shared/mcp/code-search.py" "$$" >/dev/null 2>&1 &
}

ladder_bin() {
  echo "${CLAUDE_OLLAMA_LADDER_BIN:-$profile_dir/incidents/ladder.py}"
}

ladder_rung_args() {
  [ -z "$fit_embed_off" ] || printf -- '--rung\nembeddings-off\n'
  [ -z "$ladder_context" ] || printf -- '--rung\ncontext-down\n'
}

start_ladder() {
  local rung_args=()
  [ "${CLAUDE_OLLAMA_LADDER:-}" = 0 ] && return 0
  [ -n "${CLAUDE_OLLAMA_INCIDENTS_FILE:-}" ] || return 0
  while IFS= read -r arg; do rung_args+=("$arg"); done < <(ladder_rung_args)
  nohup "$(ladder_bin)" --incidents "$CLAUDE_OLLAMA_INCIDENTS_FILE" --relaunch-dir "$relaunch_dir" \
    --watch-pid "$$" --context "$(modelfile_num_ctx)" --model "$model" --embedding "$embedding_model" \
    --lease-bin "$lease_bin" ${rung_args[@]+"${rung_args[@]}"} >/dev/null 2>&1 &
}

rotate_launcher_log() {
  [ -f "$launcher_log" ] || return 0
  [ "$(wc -c < "$launcher_log")" -gt "$launcher_log_max_bytes" ] || return 0
  mv -f "$launcher_log" "$launcher_log.1"
}

telemetry_unsafe_path() {
  local path="$1"
  if [ -L "${path%/*}" ]; then
    printf '%s\n' "${path%/*}"
  elif [ -L "$path" ] || { [ -e "$path" ] && [ ! -f "$path" ]; }; then
    printf '%s\n' "$path"
  fi
}

telemetry_warn_unsafe() {
  echo "claude-ollama: telemetry: $1 is a symlink or not a regular file; telemetry off" >&2
}

console_telemetry_log_path() {
  local path unsafe
  path="$(telemetry_log_path)"
  [ -n "$path" ] || return 0
  unsafe="$(telemetry_unsafe_path "$path")"
  if [ -n "$unsafe" ]; then
    telemetry_warn_unsafe "$unsafe"
    return 0
  fi
  printf '%s\n' "$path"
}

prepare_telemetry_log() {
  local path unsafe
  path="$(telemetry_log_path)"
  [ -n "$path" ] || return 0
  unsafe="$(telemetry_unsafe_path "$path")"
  if [ -n "$unsafe" ]; then
    telemetry_warn_unsafe "$unsafe"
    return 1
  fi
  (umask 077; mkdir -p "${path%/*}") || return 0
  if [ -f "$path" ] && [ "$(wc -c < "$path")" -gt "$telemetry_log_max_bytes" ]; then
    mv -f "$path" "$path.1"
  fi
}

start_launcher_log() {
  (umask 077; mkdir -p "$console_state_dir" && chmod 700 "$console_state_dir") || return 0
  rotate_launcher_log
  (umask 077; : >> "$launcher_log") || return 0
  exec 3>&2 2> >(tee -a "$launcher_log" >&2)
  launcher_log_open=1
  echo "claude-ollama: launch $size in $(pwd -P) at $(date -u +%Y-%m-%dT%H:%M:%SZ)" >&2
}

stop_launcher_log() {
  echo "claude-ollama: starting $1" >&2
  [ -n "$launcher_log_open" ] || return 0
  exec 2>&3 3>&-
}

prepare_drafts_dir() {
  (umask 077; mkdir -p "$drafts_dir")
  chmod 700 "$drafts_dir"
  export CLAUDE_OLLAMA_DRAFTS_DIR="$drafts_dir"
}

draft_browser_args() {
  if in_cmux_terminal; then
    printf '%s\n' --cmux "$(command -v cmux)"
  else
    printf '%s\n' --open /usr/bin/open
  fi
}

start_draft_opener() {
  [ "${CLAUDE_OLLAMA_OPEN_DRAFTS:-}" = 0 ] && return 0
  local browser_args=()
  while IFS= read -r arg; do
    browser_args+=("$arg")
  done < <(draft_browser_args)
  nohup "${CLAUDE_OLLAMA_DRAFT_OPENER:-$profile_dir/drafts/opener.py}" --drafts "$drafts_dir" --watch-pid "$$" \
    --console-url "http://127.0.0.1:$console_port" --token-file "$console_state_dir/tokens/$console_port" \
    --pages "$console_state_dir/open-drafts" --start-console "$repo_dir/bin/claude-ollama" \
    "${browser_args[@]}" >/dev/null 2>&1 &
}

incident_log_args() {
  local log
  log="$(server_log_path)" || return 0
  printf '%s\n' --log "$log"
}

start_incident_watcher() {
  [ "${CLAUDE_OLLAMA_INCIDENTS:-}" = 0 ] && return 0
  local incidents_dir="$console_state_dir/incidents" incidents_file log_args=()
  incidents_file="$incidents_dir/$(date -u +%Y%m%d-%H%M%S)-$$.jsonl"
  (umask 077; mkdir -p "$incidents_dir" && chmod 700 "$incidents_dir" && printf '%s\n' "$incidents_file" > "$incidents_dir/current") || return 0
  while IFS= read -r arg; do
    log_args+=("$arg")
  done < <(incident_log_args)
  export CLAUDE_OLLAMA_INCIDENTS_FILE="$incidents_file"
  nohup "$(incident_watcher)" ${log_args[@]+"${log_args[@]}"} \
    --model "$model" --out "$incidents_file" --watch-pid "$$" \
    --transcripts "$session_config_dir/projects" >/dev/null 2>&1 &
}

start_beacon_writer() {
  [ "${CLAUDE_OLLAMA_BEACON:-}" = 0 ] && return 0
  nohup "$repo_dir/bin/sync-fingerprint" --out "$(launch_beacon_file)" >/dev/null 2>&1 &
}

fetch_domains_label() {
  local domains
  domains="$(printf '%s' "${launch_fetch_domains:-}" | paste -sd' ' -)"
  echo "${domains:-none}"
}

messages_proxy() {
  echo "${CLAUDE_OLLAMA_PROXY_BIN:-$repo_dir/bin/messages-proxy}"
}

wait_for_proxy_port() {
  for _ in $(seq 50); do
    [ -s "$proxy_port_file" ] && return 0
    sleep 0.1
  done
  return 1
}

start_messages_proxy() {
  [ "${CLAUDE_OLLAMA_PROXY:-}" = 0 ] && return 0
  local upstream port
  upstream="$(jq -r '.env.ANTHROPIC_BASE_URL // empty' "$launch_settings")"
  [ -n "$upstream" ] || return 0
  rm -f "$proxy_port_file"
  local proxy_mode_args=()
  [ "${CLAUDE_OLLAMA_PROXY_RECORD:-}" != 1 ] || proxy_mode_args=(--record "$proxy_record_dir")
  [ "${CLAUDE_OLLAMA_PROXY_STABILIZE:-}" != 1 ] || proxy_mode_args+=(--stabilize)
  nohup "$(messages_proxy)" --upstream "$upstream" --port 0 --port-file "$proxy_port_file" \
    --log "$(proxy_log_dir)/requests.jsonl" --watch-pid "$$" ${proxy_mode_args[@]+"${proxy_mode_args[@]}"} >/dev/null 2>&1 &
  if ! wait_for_proxy_port; then
    echo "claude-ollama: messages proxy did not start; claude talks to $upstream directly" >&2
    return 0
  fi
  port="$(tr -cd '0-9' < "$proxy_port_file")"
  proxy_url="http://127.0.0.1:$port"
  compose_launch_settings
}

base_tools() {
  if [ -n "${launch_fetch_domains:-}" ]; then echo "$tools,WebFetch"; else echo "$tools"; fi
}

launch_tools() {
  "$profile_overlay" tools "$(base_tools)" "$profile_file"
}

seed_session_state() {
  local session_state="$session_config_dir/.claude.json"
  [ -s "$session_state" ] || echo '{"hasCompletedOnboarding":true}' > "$session_state"
}

prepare_session_config() {
  mkdir -p "$session_config_dir/tmp"
  if [ -f "$HOME/.claude/CLAUDE.md" ]; then
    cp "$HOME/.claude/CLAUDE.md" "$session_config_dir/CLAUDE.md"
  fi
  seed_session_state
  copy_user_skills
  copy_vendored_skills
}

copy_user_skills() {
  rm -rf "$session_config_dir/skills"
  [ -d "$HOME/.claude/skills" ] || return 0
  cp -RL "$HOME/.claude/skills" "$session_config_dir/skills"
}

copy_vendored_skills() {
  mkdir -p "$session_config_dir/skills"
  for skill_dir in "$profile_dir"/skills/*/; do
    skill_dir="${skill_dir%/}"
    target="$session_config_dir/skills/${skill_dir##*/}"
    [ -e "$target" ] || cp -R "$skill_dir" "$target"
  done
}

claude_command() {
  printf 'claude --settings %s --system-prompt-file %s --append-system-prompt-file %s --strict-mcp-config --mcp-config %s --model %s --tools %s' \
    "$launch_settings" "$profile_dir/system-prompt.md" "$append_prompt" "$(mcp_config)" "$model" "$(launch_tools)"
}

write_append_prompt() {
  cat "$profile_dir/CLAUDE.local.md" > "$append_prompt"
  cmux_tools_on && cat "$profile_dir/CLAUDE.cmux.md" >> "$append_prompt"
  return 0
}

relaunch_signal() {
  python3 "$repo_dir/shared/relaunch_dir.py" --dir "$relaunch_dir" "$@"
}

remove_relaunch_dir() {
  rm -rf "$relaunch_dir"
}

prepare_relaunch_dir() {
  relaunch_dir="$(python3 "$repo_dir/shared/relaunch_dir.py" prepare --root "$relaunch_root" --pid "$$")"
  [ -z "$fit_embed_off" ] || relaunch_signal raise embed-off
  trap end_launch EXIT
  export CLAUDE_OLLAMA_RELAUNCH_DIR="$relaunch_dir"
}

read_relaunch_sentinel() {
  local request
  request="$(relaunch_signal take relaunch)" || request=""
  relaunch_note="$(jq -r '.note // empty' <<< "$request" 2>/dev/null)"
  relaunch_prompt="$(jq -r '.prompt // empty' <<< "$request" 2>/dev/null)"
  relaunch_percent="$(jq -r '.percent // empty' <<< "$request" 2>/dev/null)"
}

relaunch_tokens() {
  [ -n "$relaunch_percent" ] || return 0
  jq -n --arg percent "$relaunch_percent" --arg context "$(profile_context_tokens)" \
    '(($percent | tonumber) * ($context | tonumber) / 100) | floor' 2>/dev/null || true
}

append_incident() {
  local file="${CLAUDE_OLLAMA_INCIDENTS_FILE:-}"
  [ -n "$file" ] && [ -d "${file%/*}" ] || return 0
  set -- --file "$file" --cause "$1" --detail "$2" ${3:+--tokens "$3"} ${4:+--rule "$4"}
  python3 "$repo_dir/ollama/incidents/incident_log.py" append "$@" || true
}

record_relaunch_incident() {
  append_incident relaunched "$relaunch_note" "$(relaunch_tokens)"
}

announce_relaunch() {
  local at="${relaunch_percent:+ at $relaunch_percent%}" next="relaunching claude"
  [ -z "$relaunch_prompt" ] || next="resuming \"$relaunch_prompt\""
  echo "claude-ollama: context budget reached$at: handoff saved, $next" >&2
}

terminate_claude() {
  [ -z "$claude_pid" ] || kill -TERM "$claude_pid" 2>/dev/null || true
}

wait_for_claude() {
  local status=0
  while :; do
    wait "$claude_pid" && return 0 || status=$?
    kill -0 "$claude_pid" 2>/dev/null || return "$status"
  done
}

run_claude() {
  "$repo_dir/shared/sandbox-env" claude "$@" <&0 &
  claude_pid=$!
  relaunch_signal claude-pid "$claude_pid"
  trap terminate_claude INT TERM
  wait_for_claude
}

ends_with_prompt() {
  local count=$#
  [ "$count" -gt 0 ] || return 1
  case "${!count}" in
    -*) return 1 ;;
  esac
  [ "$count" -eq 1 ] && return 0
  local before=$((count - 1))
  case "${!before}" in
    -*) return 1 ;;
    *) return 0 ;;
  esac
}

set_relaunch_args() {
  relaunch_args=("$@")
  if ends_with_prompt "$@"; then
    unset "relaunch_args[${#relaunch_args[@]}-1]"
  fi
  case "$relaunch_prompt" in
    ''|-*) relaunch_args+=(/handoff) ;;
    *) relaunch_args+=("/handoff $relaunch_prompt") ;;
  esac
}

set_ladder_args() {
  relaunch_args=("$@")
  if ends_with_prompt "$@"; then
    unset "relaunch_args[${#relaunch_args[@]}-1]"
  fi
  case " ${relaunch_args[*]:-} " in
    *" --continue "*|*" -c "*) ;;
    *) relaunch_args+=(--continue) ;;
  esac
}

read_ladder_file() {
  local request
  request="$(relaunch_signal take ladder)" || request=""
  ladder_rung="$(jq -r '.rung // empty' <<< "$request" 2>/dev/null)"
  ladder_context="$(jq -r '.context // empty' <<< "$request" 2>/dev/null)"
  ladder_reason="$(jq -r '.reason // empty' <<< "$request" 2>/dev/null)"
}

apply_ladder() {
  read_ladder_file
  [ -n "$ladder_rung" ] || return 0
  session_rung="$ladder_rung"
  echo "claude-ollama: ladder $ladder_rung: $ladder_reason" >&2
  [ -z "$ladder_context" ] || { compose_launch_settings && build_claude_args; }
  record_session_rung
}

remaining_rung() {
  if [ -n "$ladder_context" ]; then echo context-down
  elif relaunch_signal has embed-off; then echo embeddings-off
  fi
}

restore_embeddings() {
  relaunch_signal lower embed-off
  fit_embed_off=""
  unset CODE_SEARCH_EMBED
  allow_search_embeddings
}

restore_context() {
  ladder_rung=""
  ladder_context=""
  compose_launch_settings
  build_claude_args
}

apply_ladder_up() {
  local request rung reason
  request="$(relaunch_signal take ladder-up)" || request=""
  rung="$(jq -r '.rung // empty' <<< "$request" 2>/dev/null)"
  reason="$(jq -r '.reason // empty' <<< "$request" 2>/dev/null)"
  case "$rung" in
    embeddings-off) restore_embeddings ;;
    context-down) restore_context ;;
    *) return 0 ;;
  esac
  echo "claude-ollama: ladder up: $rung recovered ($reason)" >&2
  append_incident recovered "$rung: $reason" "" ladder/up
  session_rung="$(remaining_rung)"
  record_session_rung
}

honour_embed_off() {
  relaunch_signal has embed-off || return 0
  export CODE_SEARCH_EMBED=0
}

relaunch_pending() {
  relaunch_signal has relaunch || relaunch_signal has ladder
}

prepare_relaunch() {
  ! relaunch_signal has ladder || apply_ladder
  if relaunch_signal has relaunch; then
    read_relaunch_sentinel
    announce_relaunch
    record_relaunch_incident
    set_relaunch_args "$@"
    ! relaunch_signal has ladder-up || apply_ladder_up
  else
    set_ladder_args "$@"
  fi
  honour_embed_off
}

launch_claude() {
  if [ "${CLAUDE_OLLAMA_RELAUNCH:-}" = 0 ]; then
    exec "$repo_dir/shared/sandbox-env" claude "${claude_args[@]}" "$@"
  fi
  prepare_relaunch_dir
  start_heartbeat
  start_ladder
  local status=0
  run_claude "${claude_args[@]}" "$@" || status=$?
  while relaunch_pending; do
    prepare_relaunch "$@"
    status=0
    run_claude "${claude_args[@]}" "${relaunch_args[@]}" || status=$?
  done
  exit "$status"
}

cmux_tools_on() {
  [ "${CLAUDE_OLLAMA_CMUX:-}" != 0 ] && in_cmux_terminal
}

print_config() {
  echo "size: $size"
  echo "model: $model"
  echo "base: $(base_model)"
  echo "embedding model: $embedding_model"
  echo "num_ctx: $(modelfile_num_ctx)"
  echo "max context tokens: $(profile_context_tokens)"
  echo "max output tokens: $(profile_output_tokens)"
  echo "context headroom: $(context_headroom) (reserve $(summary_reserve))"
  local layer_labels
  layer_labels="$(settings_layer_labels)"
  echo "settings: $settings_file${layer_labels:+ + $layer_labels}"
  echo "fetch domains: $(fetch_domains_label)"
  echo "profile: $profile_file"
  echo "overrides: $(profile_summary)"
  echo "tools: $(launch_tools)"
  echo "command: $(claude_command)"
}

require_qwen() {
  command -v qwen >/dev/null 2>&1 && return 0
  echo "claude-ollama: qwen is missing (brew install qwen-code)" >&2
  exit 1
}

wait_for_server() {
  local tries=50
  while [ "$tries" -gt 0 ]; do
    curl -fs -o /dev/null -m 1 "$ollama_url/api/version" 2>/dev/null && return 0
    sleep 0.2
    tries=$((tries - 1))
  done
  echo "claude-ollama: ollama is not answering at $ollama_url yet" >&2
}

apply_server_env() {
  local missing
  missing="$(missing_server_env 2>/dev/null)" && [ -z "$missing" ] && return 0
  echo "claude-ollama: the Ollama server lacks ollama/server.env values; applying them" >&2
  if "$ollama_agent" -apply >&2; then
    wait_for_server
  else
    echo "claude-ollama: could not apply server.env; set it up with: claude-custom agent" >&2
  fi
}

report_tool_budget() {
  run_tool_budget "$@"
  exit "$?"
}

explain_last_bad_run() {
  exec "${CLAUDE_OLLAMA_WHY_BIN:-$profile_dir/incidents/why.py}" \
    --proxy-log "$(proxy_log_dir)/requests.jsonl" --incidents-dir "$console_state_dir/incidents" "$@"
}

follow_logs() {
  local lines=50 path
  if ! path="$(server_log_path)"; then
    echo "claude-ollama: no Ollama log found (LaunchAgent, Homebrew service or app); a server started with 'ollama serve' logs to its own terminal" >&2
    exit 1
  fi
  if [ "${1:-}" = --path ]; then
    echo "$path"
    exit 0
  fi
  if [ "${1:-}" = -n ] && [ -n "${2:-}" ]; then
    lines="$2"
  fi
  echo "claude-ollama: following $path" >&2
  exec tail -n "$lines" -F "$path"
}

console_answers() {
  curl -s -o /dev/null --max-time 2 "http://127.0.0.1:$1/health"
}

remove_console_files() {
  console_answers "${served_port:-}" && return 0
  rm -f "${web_url_file:-}" "${console_token_file:-}"
}

new_console_token() {
  od -An -N24 -tx1 /dev/urandom | tr -d ' \n'
}

write_console_token_file() {
  local port="$1" token="$2"
  console_token_file="$console_state_dir/tokens/$port"
  (umask 077; mkdir -p "$console_state_dir"; chmod 700 "$console_state_dir"; rm -f "$console_state_dir/token"; mkdir -p "$console_state_dir/tokens"; chmod 700 "$console_state_dir/tokens"; rm -f "$console_token_file"; printf '%s\n' "$token" > "$console_token_file")
}

write_console_files() {
  local port="$1" token="$2"
  mkdir -p "$review_log_dir"
  web_url_file="$review_log_dir/.web-url"
  (umask 077; rm -f "$web_url_file"; printf '%s\n' "http://127.0.0.1:$port/?token=$token" > "$web_url_file")
  write_console_token_file "$port" "$token"
}

show_running_console() {
  local port="$1" label="$2" page="$3" token
  token="$(cat "$console_state_dir/tokens/$port" 2>/dev/null || true)"
  if [ -z "$token" ]; then
    token="$(new_console_token)"
    write_console_token_file "$port" "$token"
  fi
  echo "claude-ollama: $label already running at http://127.0.0.1:$port$page?token=$token"
}

reviews_build_needed() {
  local web_dir="$1" build_marker="$1/.next/BUILD_ID"
  [ -f "$build_marker" ] || return 0
  [ -n "$(find "$web_dir/src" "$web_dir/package.json" "$web_dir/pnpm-lock.yaml" "$web_dir"/next.config.* -newer "$build_marker" 2>/dev/null)" ]
}

console_install_needed() {
  local web_dir="$1" install_marker="$1/node_modules/.modules.yaml"
  [ -f "$install_marker" ] || return 0
  [ "$web_dir/pnpm-lock.yaml" -nt "$install_marker" ]
}

serve_console() {
  local command_name="$1" label="$2" page="$3" port="$console_port" web_dir page_url token project_dir
  project_dir="$(pwd -P)"
  shift 3
  while [ $# -gt 0 ]; do
    case "$1" in
      --port)
        port="${2:-}"
        shift 2 || shift
        ;;
      *)
        echo "claude-ollama $command_name: unknown argument: $1" >&2
        exit 2
        ;;
    esac
  done
  case "$port" in
    ''|*[!0-9]*)
      echo "claude-ollama $command_name: --port needs a number" >&2
      exit 2
      ;;
  esac
  if console_answers "$port"; then
    show_running_console "$port" "$label" "$page"
    exit 0
  fi
  if ! command -v pnpm >/dev/null 2>&1; then
    echo "claude-ollama: pnpm is required for the reviews page (brew install pnpm)" >&2
    exit 1
  fi
  web_dir="${CLAUDE_OLLAMA_WEB_DIR:-$repo_dir/web/console}"
  if console_install_needed "$web_dir"; then
    pnpm --dir "$web_dir" install --frozen-lockfile || exit 1
  fi
  if reviews_build_needed "$web_dir"; then
    pnpm --dir "$web_dir" build || exit 1
  fi
  token="$(new_console_token)"
  served_port="$port"
  page_url="http://127.0.0.1:$port$page?token=$token"
  write_console_files "$port" "$token"
  trap remove_console_files EXIT INT TERM
  echo "claude-ollama: $label at $page_url"
  CONSOLE_TOKEN_FILE="$console_token_file" CLAUDE_CUSTOM_HOME="$repo_dir" CLAUDE_CONSOLE_STATE_DIR="$console_state_dir" CLAUDE_CUSTOM_CHANGE_SOURCE=console CONSOLE_PROJECT_DIR="$project_dir" CLAUDE_TOOL_TELEMETRY="$(console_telemetry_log_path)" \
    pnpm --dir "$web_dir" exec next start -H 127.0.0.1 -p "$port"
  exit 0
}

case "${1:-}" in
  -h|--help)
    echo "usage: claude-ollama [size] [claude args...]"
    echo "qwen [size] [qwen args...]: launch Qwen Code (brew install qwen-code) on the size's model, in macOS Seatbelt with ollama/qwen-sandbox.sb, with the same MCP servers"
    echo "qwen --print-config [size]: print the resolved settings and the qwen command"
    echo "qwen doctor [size]: check qwen, the model, context sizes, the settings template and Ollama"
    echo "sizes: $(configured_sizes | tr '\n' ' ' | sed 's/ $//')"
    echo "no size: pick one in a menu (or $default_size without a terminal)"
    echo "sandbox: Bash runs in Claude Code's sandbox (cmux, gh, short and git push run outside it, each after a prompt)"
    echo "doctor [size]: check models, context sizes, hooks, Ollama, the server env and the launch beacon"
    echo "--print-config [size]: print the resolved settings and the claude command"
    echo "logs [-n LINES|--path]: follow the Ollama server log (LaunchAgent, Homebrew service or app), or print its path"
    echo "why [--since MINUTES] [--json]: name the most likely cause of the last bad run from the proxy log and the incidents, with one fix"
    echo "tool-budget [--since DAYS] [--json]: rank each tool schema's bytes per request against its calls from the proxy and telemetry logs, and suggest which to drop"
    echo "rescue [size] [--out FILE] [--since MINUTES]: write one redacted markdown report (doctor, config, logs, incidents, proxy stats) to paste into a bug report"
    echo "review [size] PR [--post]: review a pull request with the size's model, one file per request"
    echo "mock-spike [size] [--runs N] [--brief NAME]...: measure how well the size's model streams json-render mockup patches"
    echo "task-eval [size] [--task NAME]... [--runs N] [--json]: time the size's model from prompt to a green test on the eval/tasks coding tasks"
    echo "prefix-ab [size] [--limit N] [--json]: replay the recorded prompts verbatim and stabilised and report the cache gain"
    echo "ui [--port N]: serve the console (runs, health, logs, models, reviews) at http://127.0.0.1:8765/"
    echo "reviews [--port N]: serve live and past reviews at http://127.0.0.1:8765/"
    echo "fetch domains: list hostnames in ~/.config/claude-custom/fetch-domains to give sessions WebFetch for them"
    echo "prepare [size]: pull or import the size's model and stop, without starting claude"
    echo "prepare-embedding: pull the semantic_search embedding model and stop, without starting claude"
    echo "speed-check: check thinking is off and bench the GGUF sizes against the MLX ones, then print a verdict"
    echo "thinking-check: check thinking is off on the MLX sizes and print PASS or FAIL"
    exit 0 ;;
esac

harness=claude
mode=launch
case "${1:-}" in
  doctor) mode=doctor; shift ;;
  rescue) mode=rescue; shift ;;
  --print-config) mode=print-config; shift ;;
  logs) mode=logs; shift ;;
  why) mode=why; shift ;;
  tool-budget) mode=tool-budget; shift ;;
  prepare-embedding) mode=prepare-embedding; shift ;;
  review) mode=review; shift ;;
  mock-spike) mode=mock-spike; shift ;;
  task-eval) mode=task-eval; shift ;;
  prefix-ab) mode='prefix-ab'; shift ;;
  ui) mode=ui; shift ;;
  reviews) mode=reviews; shift ;;
  prepare) mode=prepare; shift ;;
  qwen)
    harness=qwen
    shift
    case "${1:-}" in
      --print-config) mode=print-config; shift ;;
      doctor) mode=doctor; shift ;;
    esac ;;
  speed-check) acquire_lease speed-check --exclusive || exit 3; exec "${CLAUDE_OLLAMA_SPEED_CHECK:-$repo_dir/bin/speed-check}" "${@:2}" ;;
  thinking-check) acquire_lease speed-check --exclusive || exit 3; exec "${CLAUDE_OLLAMA_SPEED_CHECK:-$repo_dir/bin/speed-check}" --thinking-only ;;
esac

[ "$mode" != logs ] || follow_logs "$@"
[ "$mode" != why ] || explain_last_bad_run "$@"
[ "$mode" != tool-budget ] || report_tool_budget "$@"
[ "$mode" != prepare-embedding ] || prepare_embedding
[ "$mode" != ui ] || serve_console ui console / "$@"
[ "$mode" != reviews ] || serve_console reviews reviews /reviews "$@"

if ! command -v jq >/dev/null 2>&1; then
  echo "claude-ollama: jq is required (brew install jq)" >&2
  exit 1
fi

review_target=""
if [ "$mode" = review ]; then
  if [ $# -eq 0 ]; then
    echo "claude-ollama review: a pull request number, URL or branch is required" >&2
    exit 2
  fi
  review_target="${!#}"
  set -- "${@:1:$#-1}"
fi

run_review() {
  local target="$1"
  shift
  acquire_lease review --model "$model" || exit 3
  ensure_model
  warm_model
  exec "${CLAUDE_OLLAMA_REVIEWER:-$repo_dir/bin/pr-review-local}" --model "$model" --base-url "$ollama_url" "$@" "$target"
}

rescue_bin() {
  echo "${CLAUDE_OLLAMA_RESCUE_BIN:-$profile_dir/rescue.py}"
}

run_rescue() {
  local env_file status=0
  env_file="$(mktemp "${TMPDIR:-/tmp}/claude-ollama-rescue-env.XXXXXX")"
  running_server_env > "$env_file" 2>/dev/null || true
  "$(rescue_bin)" --launcher "$repo_dir/bin/claude-ollama" --size "$size" \
    --fingerprint-bin "$repo_dir/bin/sync-fingerprint" --lease-bin "$lease_bin" \
    --session-dir "$session_config_dir" --state-dir "$console_state_dir" \
    --ollama-url "$ollama_url" --server-env "$env_file" "$@" || status=$?
  rm -f "$env_file"
  exit "$status"
}

run_mock_spike() {
  acquire_lease mock-spike --model "$model" || exit 3
  ensure_model
  warm_model
  exec "${CLAUDE_OLLAMA_MOCK_SPIKE:-$repo_dir/bin/mock-spike}" --model "$model" --base-url "$ollama_url" "$@"
}

run_task_eval() {
  acquire_lease task-eval --model "$model" || exit 3
  ensure_model
  warm_model
  exec "${CLAUDE_OLLAMA_TASK_EVAL:-$repo_dir/bin/task-eval}" "$size" --launcher "$repo_dir/bin/claude-ollama" "$@"
}

run_prefix_ab() {
  acquire_lease prefix-ab --model "$model" || exit 3
  exec "${CLAUDE_OLLAMA_PREFIX_AB:-$repo_dir/bin/prefix-ab}" --record "$proxy_record_dir" --model "$model" --base-url "$ollama_url" "$@"
}

if [ $# -gt 0 ] && is_configured_size "$1"; then
  size="$1"
  shift
else
  case "${1:-}" in
    ''|-*) ;;
    *) shift ;;
  esac
  size="$(choose_size)"
fi

use_size "$size"
model="$(size_model)"
load_profile

case "$mode" in
  print-config)
    [ "$harness" != qwen ] || exec "$qwen_bin" --print-config "$size"
    launch_fetch_domains="$(fetch_domains)"
    use_throwaway_settings
    compose_launch_settings
    print_config
    exit 0 ;;
  doctor) if [ "$harness" = qwen ]; then exec "$qwen_bin" doctor "$size"; else exec "$doctor_bin" "$size"; fi ;;
  rescue) run_rescue "$@" ;;
  review) run_review "$review_target" "$@" ;;
  mock-spike) run_mock_spike "$@" ;;
  task-eval) run_task_eval "$@" ;;
  prefix-ab) run_prefix_ab "$@" ;;
  prepare) ensure_model; exit 0 ;;
esac

start_launcher_log
use_nvm_node
[ "$harness" != qwen ] || require_qwen
apply_server_env
ensure_model
ensure_embedding_model
verify_installed_models
check_memory_fit
claim_session
allow_search_embeddings
warm_embedding_model
warm_search_index
warm_model

unset ANTHROPIC_API_KEY ANTHROPIC_MODEL CLAUDE_OLLAMA_DRAFTS_DIR
export CLAUDE_CUSTOM_HOME="$repo_dir"
if [ -n "$(telemetry_log_path)" ] && prepare_telemetry_log; then
  CLAUDE_TOOL_TELEMETRY="$(telemetry_log_path)"
  export CLAUDE_TOOL_TELEMETRY
else
  unset CLAUDE_TOOL_TELEMETRY
fi
prepare_session_config
prepare_drafts_dir
start_draft_opener
start_incident_watcher
start_beacon_writer
export CLAUDE_CONFIG_DIR="$session_config_dir"
export CLAUDE_CODE_TMPDIR="$session_config_dir/tmp"
if [ "$harness" = qwen ]; then
  stop_launcher_log qwen
  exec "$qwen_bin" launch "$size" "$@"
fi
launch_fetch_domains="$(fetch_domains)"
prepare_launch_settings_dir
compose_launch_settings
start_messages_proxy
write_append_prompt
build_claude_args() {
  claude_args=(
    --settings "$launch_settings"
    --system-prompt-file "$profile_dir/system-prompt.md"
    --append-system-prompt-file "$append_prompt"
    --strict-mcp-config
    --mcp-config "$(mcp_config)"
    --model "$model"
    --tools "$(launch_tools)"
  )
}
build_claude_args
stop_launcher_log claude
launch_claude "$@"
