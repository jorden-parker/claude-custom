#!/usr/bin/env bash
set -euo pipefail

profile_dir="$(cd "$(dirname "$(readlink -f "$0")")/../ollama" && pwd)"
sizes="27b 35b"
size=27b

case "${1:-}" in
  -h|--help)
    echo "usage: claude-ollama [size] [claude args...]"
    echo "sizes: $sizes"
    exit 0 ;;
  27b|35b) size="$1"; shift ;;
esac

case "$size" in
  27b|35b) tools="Bash,Read,Edit,Write,Glob,Grep"; extra_flags=() ;;
esac

ensure_model() {
  local modelfile="$profile_dir/Modelfile.$size"
  local name base
  name="$(jq -r .model "$profile_dir/settings.$size.json")"
  ollama show "$name" >/dev/null 2>&1 && return 0
  base="$(sed -n 's/^FROM //p' "$modelfile")"
  ollama pull "$base"
  ollama create "$name" -f "$modelfile"
}

ensure_model

unset ANTHROPIC_API_KEY
exec claude \
  --settings "$profile_dir/settings.$size.json" \
  --append-system-prompt-file "$profile_dir/CLAUDE.$size.md" \
  --strict-mcp-config \
  --tools "$tools" \
  ${extra_flags[@]+"${extra_flags[@]}"} \
  "$@"
