#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
profile_dir="$repo_dir/ollama"
picker_dir="$repo_dir/model-picker-tui"
default_size=27b
tools="Bash,Read,Edit,Write,Agent"
embedding_model="${CODE_SEARCH_MODEL:-qwen3-embedding:0.6b}"
require_side_model=0
ollama_url="${OLLAMA_HOST:-http://localhost:11434}"
case "$ollama_url" in http://*|https://*) ;; *) ollama_url="http://$ollama_url" ;; esac
keep_alive="${CLAUDE_OLLAMA_KEEP_ALIVE:-30m}"

configured_sizes() {
  local settings size
  for settings in "$profile_dir"/settings.*.json; do
    size="${settings##*/settings.}"
    size="${size%.json}"
    if is_configured_size "$size"; then
      printf '%s\n' "$size"
    fi
  done
}

is_configured_size() {
  [ -f "$profile_dir/settings.$1.json" ] && [ -f "$profile_dir/Modelfile.$1" ]
}

binary_is_current() {
  local dir="$1" binary="$2"
  [ -x "$binary" ] || return 1
  [ -z "$(find "$dir" \( -name '*.go' -o -name 'go.mod' -o -name 'go.sum' \) -newer "$binary" -print -quit)" ]
}

ensure_built() {
  local dir="$1" binary="$2" label="$3" hint="${4:-}"
  binary_is_current "$dir" "$binary" && return 0
  if ! command -v go >/dev/null 2>&1; then
    echo "$label: needs Go 1.26+ (https://go.dev/dl) to build $binary$hint" >&2
    return 1
  fi
  (cd "$dir" && go build -o "$(basename "$binary")" .) >&2
}

pick_size() {
  ensure_built "$picker_dir" "$picker_dir/model-picker" claude-ollama "; or pass a size: $(configured_sizes | tr '\n' ' ')" || exit 1
  "$picker_dir/model-picker" "$profile_dir" || exit 130
}

choose_size() {
  if [ -t 0 ] && [ -t 2 ]; then
    pick_size
  else
    printf '%s\n' "$default_size"
  fi
}

base_model() {
  sed -n 's/^FROM //p' "$profile_dir/Modelfile.$size"
}

modelfile_num_ctx() {
  sed -n 's/^PARAMETER num_ctx //p' "$profile_dir/Modelfile.$size"
}

profile_context_tokens() {
  jq -r .env.CLAUDE_CODE_MAX_CONTEXT_TOKENS "$profile_dir/settings.$size.json"
}

ensure_model() {
  local modelfile="$profile_dir/Modelfile.$size"
  ollama show "$model" >/dev/null 2>&1 && return 0
  ollama pull "$(base_model)"
  ollama create "$model" -f "$modelfile"
}

ensure_embedding_model() {
  ollama show "$embedding_model" >/dev/null 2>&1 && return 0
  ollama pull "$embedding_model" ||
    echo "claude-ollama: could not pull $embedding_model; semantic_search will fail until you run claude-ollama and pick 'Set up embedding model'" >&2
}

side_model_name() {
  jq -r .env.ANTHROPIC_DEFAULT_HAIKU_MODEL "$profile_dir/settings.$size.json"
}

fallback_settings_file() {
  local derived
  derived="$(mktemp -t claude-ollama-settings.XXXXXX)"
  jq --arg main "$model" '
    .env.CLAUDE_CODE_SUBAGENT_MODEL = $main
    | .env.ANTHROPIC_DEFAULT_HAIKU_MODEL = $main
    | .modelOverrides |= with_entries(.value = $main)
  ' "$profile_dir/settings.$size.json" > "$derived"
  printf '%s\n' "$derived"
}

ensure_side_model() {
  local name
  name="$(side_model_name)"
  ollama show "$name" >/dev/null 2>&1 && return 0
  if [ "$require_side_model" = 1 ]; then
    echo "claude-ollama: side model $name missing; run claude-ollama and pick 'Set up side model'" >&2
    exit 1
  fi
  echo "claude-ollama: side model $name missing; subagents use $model this session (pick 'Set up side model' in claude-ollama to fix)" >&2
  return 1
}

mcp_config() {
  printf '{"mcpServers":{"code-search":{"command":"python3","args":["%s"]}}}' \
    "$repo_dir/shared/mcp/code-search.py"
}

warm_model() {
  command -v curl >/dev/null 2>&1 || return 0
  curl -s -o /dev/null -m 2 -X POST "$ollama_url/api/generate" \
    -d "{\"model\":\"$model\",\"keep_alive\":\"$keep_alive\"}" >/dev/null 2>&1 &
}

warm_search_index() {
  [ -z "${CLAUDE_OLLAMA_NO_INDEX:-}" ] || return 0
  git rev-parse --show-toplevel >/dev/null 2>&1 || return 0
  nohup python3 "$repo_dir/shared/mcp/code-search.py" --index >/dev/null 2>&1 &
}

claude_command() {
  printf 'claude --settings %s --system-prompt-file %s --append-system-prompt-file %s --strict-mcp-config --mcp-config %s --model %s --tools %s' \
    "$settings_file" "$profile_dir/system-prompt.md" "$profile_dir/CLAUDE.$size.md" "$(mcp_config)" "$model" "$tools"
}

print_config() {
  echo "size: $size"
  echo "model: $model"
  echo "base: $(base_model)"
  echo "side model: $(side_model_name)"
  echo "embedding model: $embedding_model"
  echo "num_ctx: $(modelfile_num_ctx)"
  echo "max context tokens: $(profile_context_tokens)"
  echo "settings: $settings_file"
  echo "tools: $tools"
  echo "command: $(claude_command)"
}

report() {
  printf '%-4s %s\n' "$1" "$2"
  [ "$1" != fail ]
}

check_model_present() {
  local label="$1" name="$2" fix="$3" level="${4:-fail}"
  if ollama show "$name" >/dev/null 2>&1; then
    report ok "$label $name"
  else
    report "$level" "$label $name missing ($fix)"
  fi
}

check_context_sizes() {
  local ctx tokens
  ctx="$(modelfile_num_ctx)"
  tokens="$(profile_context_tokens)"
  if [ "$ctx" = "$tokens" ]; then
    report ok "num_ctx $ctx matches CLAUDE_CODE_MAX_CONTEXT_TOKENS"
  else
    report fail "num_ctx $ctx differs from CLAUDE_CODE_MAX_CONTEXT_TOKENS $tokens"
  fi
}

hook_names() {
  jq -r '.hooks[]?[]?.hooks[]?.command' "$profile_dir/settings.$size.json" |
    sed -n 's#.*/shared/hooks/##p' | sort -u
}

check_hooks_present() {
  local hook status=0
  while IFS= read -r hook; do
    if [ -x "$repo_dir/shared/hooks/$hook" ]; then
      report ok "hook $hook present"
    else
      report fail "hook $hook missing or not executable in shared/hooks"
      status=1
    fi
  done < <(hook_names)
  return "$status"
}

check_reachable() {
  if curl -sf -m 2 "$ollama_url/api/version" >/dev/null 2>&1; then
    report ok "ollama reachable at $ollama_url"
  else
    report fail "ollama not reachable at $ollama_url (brew services start ollama)"
  fi
}

running_server_env() {
  local pid
  pid="$(pgrep -x ollama | head -n 1)" || true
  [ -n "$pid" ] || return 1
  if [ -r "/proc/$pid/environ" ]; then
    tr '\0' '\n' < "/proc/$pid/environ"
  else
    ps -Eo command -p "$pid" | tr ' ' '\n'
  fi
}

check_server_env() {
  local env_lines wanted status=0
  if ! env_lines="$(running_server_env)"; then
    report fail "ollama server not running (brew services start ollama)"
    return 1
  fi
  while IFS= read -r wanted; do
    [ -n "$wanted" ] || continue
    if printf '%s\n' "$env_lines" | grep -qxF "$wanted"; then
      report ok "server env $wanted"
    else
      report fail "server env $wanted not set on the running server"
      status=1
    fi
  done < "$profile_dir/server.env"
  return "$status"
}

managed_settings="${CLAUDE_OLLAMA_MANAGED_SETTINGS:-/Library/Application Support/ClaudeCode/managed-settings.json}"

check_model_allowed() {
  if ! [ -r "$managed_settings" ] || ! jq -e 'has("availableModels")' "$managed_settings" >/dev/null 2>&1; then
    report ok "no managed availableModels restricts $model"
  elif jq -e --arg model "$model" '.availableModels | index($model) != null' "$managed_settings" >/dev/null; then
    report ok "managed availableModels allows $model"
  else
    report warn "managed availableModels lacks $model (ask your admin to add it; Claude Code substitutes a [1m] variant)"
  fi
}

doctor() {
  local status=0
  report ok "jq on PATH"
  check_model_present model "$model" "run claude-ollama $size to pull and create it" || status=1
  check_model_present "side model" "$(side_model_name)" "pick 'Set up side model' in claude-ollama" warn || status=1
  check_model_present "embedding model" "$embedding_model" "pick 'Set up embedding model' in claude-ollama" || status=1
  check_context_sizes || status=1
  check_hooks_present || status=1
  check_reachable || status=1
  check_server_env || status=1
  check_model_allowed
  exit "$status"
}

case "${1:-}" in
  -h|--help)
    echo "usage: claude-ollama [size] [claude args...]"
    echo "sizes: $(configured_sizes | tr '\n' ' ' | sed 's/ $//')"
    echo "no size: pick one in a menu (or $default_size without a terminal)"
    echo "--require-side-model: exit 1 instead of using the main model for subagents"
    echo "doctor [size]: check models, context sizes, hooks, Ollama and the server env"
    echo "--print-config [size]: print the resolved settings and the claude command"
    exit 0 ;;
esac

mode=launch
case "${1:-}" in
  doctor) mode=doctor; shift ;;
  --print-config) mode=print-config; shift ;;
esac

if ! command -v jq >/dev/null 2>&1; then
  echo "claude-ollama: jq is required (brew install jq)" >&2
  exit 1
fi

while [ "${1:-}" = --require-side-model ]; do
  require_side_model=1
  shift
done

if [ $# -gt 0 ] && is_configured_size "$1"; then
  size="$1"
  shift
else
  case "${1:-}" in
    ''|-*) ;;
    *) shift ;;
  esac
  size="$(choose_size)"
fi

while [ "${1:-}" = --require-side-model ]; do
  require_side_model=1
  shift
done

model="$(jq -r .model "$profile_dir/settings.$size.json")"
settings_file="$profile_dir/settings.$size.json"

case "$mode" in
  print-config) print_config; exit 0 ;;
  doctor) doctor ;;
esac

ensure_model
ensure_embedding_model
warm_search_index
ensure_side_model || settings_file="$(fallback_settings_file)"
warm_model

unset ANTHROPIC_API_KEY ANTHROPIC_MODEL
export CLAUDE_CUSTOM_HOME="$repo_dir"
exec claude \
  --settings "$settings_file" \
  --system-prompt-file "$profile_dir/system-prompt.md" \
  --append-system-prompt-file "$profile_dir/CLAUDE.$size.md" \
  --strict-mcp-config \
  --mcp-config "$(mcp_config)" \
  --model "$model" \
  --tools "$tools" \
  "$@"
