#!/usr/bin/env python3
import argparse
import html
import json
import sys
from dataclasses import dataclass, field
from pathlib import Path

REPORT_NAME = "bench-off.html"
PLAN_NAME = "plan.json"
FINALS_NAME = "finals.json"
BASELINE = "ollama"
MTP_SUFFIX = "-mtp"
NO_MTP_SUFFIX = "-nomtp"
VARIANT_SUFFIXES = (MTP_SUFFIX, NO_MTP_SUFFIX, "-ngram", "-q8kv", "-src")
SCREEN = "screen"
DEEP = "deep"
DEFAULT_STAGES = (SCREEN, DEEP)
LEGACY_STAGE = DEEP
MTP_ACTIVE_WORDS = {True: "yes", False: "no", None: "unverified"}
NO_VALUE = "–"
WARM_TTFT_CUT = 0.20
DECODE_GAIN = 0.20
REPLAY_POINTS_FLOOR = 5.0
WEIGHTS_FLOOR = 0.90
FINALS_SECONDS_CUT = 0.15
BYTES_PER_GB = 1e9
REFRESH_SECONDS = 5
AC_POWER = "AC Power"
LOWER_IS_BETTER = "lower"
HIGHER_IS_BETTER = "higher"
DONE = "done"
CACHED = "cached"
FAILED = "failed"
GATE_FAILED = "gate-failed"
LOST = "lost"
RUNNING = "running"
WAITING = "waiting"
NOT_RUN = "not run"
GATE_PASSED = "passed"
JUDGED_STATUSES = (DONE, CACHED)
STOPPED_STATUSES = (FAILED, GATE_FAILED, LOST)
FINISHED_STATUSES = JUDGED_STATUSES + STOPPED_STATUSES
LOGGED_STATUSES = (FAILED, GATE_FAILED)
PASS = "pass"
FAIL = "fail"
STYLE = """
:root { --bg: #ffffff; --fg: #1d1d1f; --muted: #6e6e73; --line: #d2d2d7; --best: #e3f5e1;
  --pass: #1a7f37; --fail: #c62828; --head: #f5f5f7; --warn-bg: #fff4e5; --run: #0b63c5; }
@media (prefers-color-scheme: dark) {
  :root { --bg: #161618; --fg: #f5f5f7; --muted: #a1a1a6; --line: #3a3a3c; --best: #1f3a24;
    --pass: #4ac26b; --fail: #ff6b6b; --head: #222225; --warn-bg: #3a2a10; --run: #6cb4ff; } }
body { background: var(--bg); color: var(--fg); margin: 0 auto; max-width: 1600px;
  padding: 24px 16px; font: 14px/1.45 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
h1 { margin: 0 0 4px; } h2 { margin: 32px 0 4px; }
.muted { color: var(--muted); }
.headline { font-size: 20px; font-weight: 600; margin: 16px 0; }
.warning { background: var(--warn-bg); padding: 8px 12px; border-radius: 6px; }
.scroll { overflow-x: auto; }
table { border-collapse: collapse; margin-top: 12px; font-variant-numeric: tabular-nums; }
th, td { border-bottom: 1px solid var(--line); padding: 5px 7px; text-align: right; min-width: 88px;
  max-width: 180px; overflow-wrap: break-word; }
th:first-child, td:first-child { text-align: left; position: sticky; left: 0; background: var(--bg); min-width: 170px; }
thead th { background: var(--head); }
thead tr:first-child th { text-align: center; border-left: 2px solid var(--line); }
td.best { background: var(--best); font-weight: 600; }
td.pass, td.done { color: var(--pass); font-weight: 600; }
td.fail { color: var(--fail); font-weight: 600; }
td.running { color: var(--run); font-weight: 600; }
td.baseline, td.waiting { color: var(--muted); }
details { margin-top: 8px; } pre { overflow-x: auto; background: var(--head); padding: 8px; }
"""


class ReportError(Exception):
    pass


@dataclass
class Unit:
    server: str
    model: str
    stage: str = LEGACY_STAGE
    version: str = ""
    weights: str = ""
    weights_bytes: float | None = None
    repo: str = ""
    conditions: dict = field(default_factory=dict)
    gate: dict | None = None
    runs: list = field(default_factory=list)
    tool_calls: dict | None = None
    status: str = RUNNING
    reason: str = ""
    peak_memory_gb: float | None = None
    error: str = ""
    log_tail: str = ""
    mtp: dict | None = None
    replay: dict | None = None


@dataclass
class Plan:
    servers: list
    models: list
    prefix_tokens: list
    finished: bool
    stages: list
    finalists: list


@dataclass
class Table:
    model: str
    stage: str
    units: list


@dataclass
class Row:
    label: str
    values: list
    better: str | None
    digits: int


def parse_args(argv):
    parser = argparse.ArgumentParser(description="Render bench-off results side by side as one HTML page.")
    parser.add_argument("results_dir", type=Path)
    parser.add_argument("--output", type=Path)
    parser.add_argument("--headline", dest="headline_only", action="store_true")
    return parser.parse_args(argv)


def apply_meta(unit, line):
    unit.version = line.get("version", "")
    unit.weights = line.get("weights", "")
    unit.weights_bytes = line.get("weights_bytes")
    unit.repo = line.get("repo", "")
    unit.conditions = line.get("conditions", {})
    unit.stage = line.get("stage") or unit.stage


def apply_end(unit, line):
    unit.status = line.get("status", FAILED)
    unit.reason = line.get("reason") or ""
    unit.peak_memory_gb = line.get("peak_memory_gb")
    unit.error = line.get("error", "")
    unit.log_tail = line.get("log_tail", "")
    unit.mtp = line.get("mtp")


def apply_line(unit, line):
    kind = line.get("type")
    if kind == "meta":
        apply_meta(unit, line)
    elif kind == "gate":
        unit.gate = line
    elif kind == "run":
        unit.runs.append(line)
    elif kind == "tool_calls":
        unit.tool_calls = {"parsed": line["parsed"], "trials": line["trials"]}
    elif kind == "replay":
        unit.replay = line
    elif kind == "end":
        apply_end(unit, line)


def parse_lines(path):
    lines = []
    for text in path.read_text(encoding="utf-8").splitlines():
        try:
            lines.append(json.loads(text))
        except json.JSONDecodeError:
            continue
    return lines


def unit_identity(path):
    parts = path.stem.split("--")
    if len(parts) >= 3 and parts[-1] in DEFAULT_STAGES:
        return parts[0], "--".join(parts[1:-1]), parts[-1]
    server, model = path.stem.split("--", 1)
    return server, model, LEGACY_STAGE


def load_unit(path):
    server, model, stage = unit_identity(path)
    unit = Unit(server=server, model=model, stage=stage)
    for line in parse_lines(path):
        apply_line(unit, line)
    return unit


def load_plan(results_dir):
    path = results_dir / PLAN_NAME
    if not path.exists():
        return None
    data = json.loads(path.read_text(encoding="utf-8"))
    return Plan(
        servers=data["servers"],
        models=data["models"],
        prefix_tokens=data.get("prefix_tokens", []),
        finished=data.get("finished", False),
        stages=data.get("stages") or list(DEFAULT_STAGES),
        finalists=data.get("finalists") or [],
    )


def load_finals(results_dir):
    path = results_dir / FINALS_NAME
    if not path.exists():
        return None
    try:
        finals = json.loads(path.read_text(encoding="utf-8"))
        return finals if isinstance(finals.get("models"), dict) else None
    except (OSError, ValueError, AttributeError) as error:
        print(f"backend-bench-report: ignoring {path}: {error}", file=sys.stderr)
        return None


def load_units(results_dir):
    units = map(load_unit, sorted(results_dir.glob("*--*.jsonl")))
    return {(unit.server, unit.model, unit.stage): unit for unit in units}


def ordered_unique(values):
    return list(dict.fromkeys(values))


def server_family(server):
    for suffix in VARIANT_SUFFIXES:
        if server.endswith(suffix):
            return server.removesuffix(suffix)
    return server


def grouped_by_family(servers):
    families = ordered_unique(map(server_family, servers))
    return sorted(servers, key=lambda server: (families.index(server_family(server)), servers.index(server)))


def unplanned_order(server):
    return (server != BASELINE, server_family(server), server)


def stage_servers(plan, stage, found_servers):
    if plan and stage == DEEP and plan.finalists:
        planned = [BASELINE, *plan.finalists]
    else:
        planned = plan.servers if plan else []
    extra = sorted(set(found_servers) - set(planned), key=unplanned_order)
    return grouped_by_family(ordered_unique(planned + extra))


def table_keys(plan, units):
    models = ordered_unique((plan.models if plan else []) + sorted({model for _, model, _ in units}))
    stages = ordered_unique((plan.stages if plan else list(DEFAULT_STAGES)) + sorted({stage for _, _, stage in units}))
    present = {(model, stage) for _, model, stage in units}
    return [(model, stage) for model in models for stage in stages if (model, stage) in present]


def placeholder(server, model, stage, plan):
    status = WAITING if plan and not plan.finished else NOT_RUN
    return Unit(server=server, model=model, stage=stage, status=status)


def build_table(plan, units, model, stage):
    found = [server for server, unit_model, unit_stage in units if (unit_model, unit_stage) == (model, stage)]
    servers = stage_servers(plan, stage, found)
    cells = [units.get((server, model, stage)) or placeholder(server, model, stage, plan) for server in servers]
    return Table(model, stage, cells)


def build_tables(plan, units):
    return [build_table(plan, units, model, stage) for model, stage in table_keys(plan, units)]


def run_value(unit, prefix_tokens, scenario, key):
    for run in unit.runs:
        if run["prefix_tokens"] == prefix_tokens and run["scenario"] == scenario:
            return run.get(key)
    return None


def prefix_sizes(units):
    return sorted({run["prefix_tokens"] for unit in units for run in unit.runs})


def table_prefix_sizes(units, plan):
    return prefix_sizes(units) or sorted(plan.prefix_tokens if plan else [])


def short_tokens(prefix_tokens):
    return f"{prefix_tokens // 1000}k" if prefix_tokens >= 1000 else str(prefix_tokens)


def prefix_rows(units, prefix_tokens):
    size = short_tokens(prefix_tokens)

    def values(scenario, key):
        return [run_value(unit, prefix_tokens, scenario, key) for unit in units]

    return [
        Row(f"Cold TTFT {size} (s)", values("cold", "ttft_seconds"), LOWER_IS_BETTER, 2),
        Row(f"Warm TTFT {size} (s)", values("warm", "ttft_seconds"), LOWER_IS_BETTER, 2),
        Row(f"Cold prefill {size} (t/s)", values("cold", "prefill_tokens_per_second"), HIGHER_IS_BETTER, 0),
        Row(f"Warm decode {size} (t/s)", values("warm", "decode_tokens_per_second"), HIGHER_IS_BETTER, 1),
    ]


def measurement_rows(units, plan):
    rows = []
    for prefix_tokens in table_prefix_sizes(units, plan):
        rows.extend(prefix_rows(units, prefix_tokens))
    rows.append(Row("Peak memory used (GB)", [unit.peak_memory_gb for unit in units], LOWER_IS_BETTER, 1))
    return rows


def weights_gb(unit):
    return None if unit.weights_bytes is None else unit.weights_bytes / BYTES_PER_GB


def best_value(row):
    present = [value for value in row.values if value is not None]
    if row.better is None or len(set(present)) < 2:
        return None
    return min(present) if row.better == LOWER_IS_BETTER else max(present)


def number_cell(value, digits, best):
    if value is None:
        return f"<td>{NO_VALUE}</td>"
    css = ' class="best"' if best is not None and value == best else ""
    return f"<td{css}>{value:.{digits}f}</td>"


def render_row(row):
    best = best_value(row)
    cells = "".join(number_cell(value, row.digits, best) for value in row.values)
    return f"<tr><td>{html.escape(row.label)}</td>{cells}</tr>"


def cell(css, text):
    css_attribute = f' class="{css}"' if css else ""
    return f"<td{css_attribute}>{html.escape(text)}</td>"


def labelled_row(label, cells):
    return f"<tr><td>{html.escape(label)}</td>{''.join(cells)}</tr>"


def expected_measurements(plan):
    return 2 * len(plan.prefix_tokens) if plan and plan.prefix_tokens else None


def stop_reason(unit):
    return unit.reason or unit.error or "see the log below"


def status_cell(unit, plan):
    if unit.status == RUNNING:
        expected = expected_measurements(plan)
        progress = f"{len(unit.runs)} of {expected}" if expected else str(len(unit.runs))
        return cell("running", f"running, {progress} measurements")
    if unit.status in STOPPED_STATUSES:
        return cell(FAIL, f"{unit.status}: {stop_reason(unit)}")
    if unit.status == CACHED:
        return cell("done", f"cached: {unit.reason}" if unit.reason else "cached")
    if unit.status == DONE:
        return cell("done", "done")
    return cell("waiting", unit.status)


def gate_cell(unit):
    if unit.gate is None:
        return cell("", NO_VALUE)
    if unit.gate.get("status") == GATE_PASSED:
        return cell(PASS, f"passed in {unit.gate.get('seconds', 0):.0f} s")
    return cell(FAIL, f"failed: {unit.gate.get('reason') or 'no reason given'}")


def tool_text(unit):
    return f"{unit.tool_calls['parsed']}/{unit.tool_calls['trials']}" if unit.tool_calls else NO_VALUE


def replay_hit(unit):
    if unit.replay is None or unit.replay.get("error"):
        return None
    return unit.replay.get("verbatim")


def replay_text(unit):
    if unit.replay is None:
        return NO_VALUE
    if unit.replay.get("error"):
        return "failed"
    if unit.replay.get("verbatim") is None:
        return NO_VALUE
    return f"{unit.replay['verbatim']:.1f} ({unit.replay['requests']} requests)"


def thinking_leaked(unit):
    flags = [run["thinking_leak"] for run in unit.runs if "thinking_leak" in run]
    return any(flags) if flags else None


def leak_cell(unit):
    leaked = thinking_leaked(unit)
    if leaked is None:
        return cell("", NO_VALUE)
    return cell(FAIL, "yes") if leaked else cell("", "no")


def conditions_text(unit):
    if not unit.conditions:
        return NO_VALUE
    parts = [unit.conditions.get("power") or "power unknown"]
    if unit.conditions.get("low_power_mode"):
        parts.append("Low Power Mode")
    memory = unit.conditions.get("memory_before_gb")
    if memory is not None:
        parts.append(f"{memory} GB in use")
    return ", ".join(parts)


def unfair_conditions(unit):
    power = unit.conditions.get("power")
    return bool(unit.conditions) and (power != AC_POWER or unit.conditions.get("low_power_mode"))


def deciding_prefix(baseline, candidate):
    shared = set(prefix_sizes([baseline])) & set(prefix_sizes([candidate]))
    return max(shared) if shared else None


def ratio_text(ours, theirs):
    return f"×{ours / theirs:.2f}" if ours and theirs else "unknown"


def speed_failure(baseline, candidate, prefix_tokens):
    size = short_tokens(prefix_tokens)
    base_ttft = run_value(baseline, prefix_tokens, "warm", "ttft_seconds")
    ours_ttft = run_value(candidate, prefix_tokens, "warm", "ttft_seconds")
    if None in (base_ttft, ours_ttft):
        return f"no warm TTFT at {size}"
    if ours_ttft <= base_ttft * (1 - WARM_TTFT_CUT):
        return None
    base_decode = run_value(baseline, prefix_tokens, "warm", "decode_tokens_per_second")
    ours_decode = run_value(candidate, prefix_tokens, "warm", "decode_tokens_per_second")
    if base_decode and ours_decode and ours_ttft <= base_ttft and ours_decode >= base_decode * (1 + DECODE_GAIN):
        return None
    saved = (1 - ours_ttft / base_ttft) * 100
    return (
        f"warm TTFT {size} only {saved:.0f}% lower (needs {WARM_TTFT_CUT:.0%}) and decode "
        f"{ratio_text(ours_decode, base_decode)} (needs ×{1 + DECODE_GAIN:.2f} with TTFT no worse)"
    )


def tool_failure(candidate):
    calls = candidate.tool_calls
    if not calls or calls["trials"] == 0 or calls["parsed"] < calls["trials"]:
        return f"tool calls {tool_text(candidate)}"
    return None


def replay_failure(baseline, candidate):
    base, ours = replay_hit(baseline), replay_hit(candidate)
    if base is None or ours is None or ours >= base - REPLAY_POINTS_FLOOR:
        return None
    return f"replay cache hit {ours:.1f}% vs {base:.1f}% (at most {REPLAY_POINTS_FLOOR:.0f} points lower)"


def leak_failure(candidate):
    return "thinking leak" if thinking_leaked(candidate) else None


def mtp_inactive(unit):
    return unit.mtp is not None and unit.mtp.get("active") is False


def mtp_failure(candidate):
    return "MTP not active" if mtp_inactive(candidate) else None


def candidate_failures(baseline, candidate):
    prefix_tokens = deciding_prefix(baseline, candidate)
    speed = "no shared prefix size with Ollama" if prefix_tokens is None else speed_failure(baseline, candidate, prefix_tokens)
    checks = (
        speed,
        tool_failure(candidate),
        replay_failure(baseline, candidate),
        leak_failure(candidate),
        mtp_failure(candidate),
    )
    return [failure for failure in checks if failure]


def smaller_weights(baseline, candidate):
    if baseline.weights_bytes is None or candidate.weights_bytes is None:
        return False
    return candidate.weights_bytes < baseline.weights_bytes * WEIGHTS_FLOOR


def is_judged(unit):
    return unit.status in JUDGED_STATUSES


def baseline_of(units):
    return next((unit for unit in units if unit.server == BASELINE and is_judged(unit)), None)


def verdict(units, unit):
    if unit.server == BASELINE:
        return "baseline", "baseline"
    if unit.status in STOPPED_STATUSES:
        return FAIL, f"FAIL: {unit.status}"
    if not is_judged(unit):
        return "waiting", NO_VALUE
    baseline = baseline_of(units)
    if baseline is None:
        return "baseline", "no Ollama baseline"
    if smaller_weights(baseline, unit):
        return "waiting", "no verdict: smaller weights"
    failures = candidate_failures(baseline, unit)
    if failures:
        return FAIL, "FAIL: " + "; ".join(failures)
    return PASS, "PASS"


def verdict_cell(units, unit):
    return cell(*verdict(units, unit))


def screened_verdicts(tables, server):
    outcomes = [verdict(table.units, unit)[0] for table in tables for unit in table.units if unit.server == server]
    return [outcome == PASS for outcome in outcomes if outcome in (PASS, FAIL)]


def all_units(tables):
    return [unit for table in tables for unit in table.units]


def challengers(tables):
    return ordered_unique(unit.server for unit in all_units(tables) if unit.server != BASELINE)


def screened_finalists(tables):
    finalists = []
    for server in challengers(tables):
        verdicts = screened_verdicts(tables, server)
        if verdicts and all(verdicts):
            finalists.append(server)
    return finalists


def mtp_word(unit):
    if unit.mtp is None:
        return NO_VALUE
    return MTP_ACTIVE_WORDS.get(unit.mtp.get("active"), "unverified")


def mtp_text(unit):
    word = mtp_word(unit)
    detail = unit.mtp.get("detail") if unit.mtp else None
    return f"{word} ({detail})" if detail else word


def mtp_off_partner(server, servers):
    if server.endswith(MTP_SUFFIX):
        return server.removesuffix(MTP_SUFFIX)
    if server + NO_MTP_SUFFIX in servers:
        return server + NO_MTP_SUFFIX
    return None


def judged_unit(units, server):
    return next((unit for unit in units if unit.server == server and is_judged(unit)), None)


def decode_ratio(unit, units):
    partner = mtp_off_partner(unit.server, [other.server for other in units])
    base = judged_unit(units, partner) if partner else None
    if base is None or not is_judged(unit):
        return NO_VALUE
    prefix_tokens = deciding_prefix(base, unit)
    if prefix_tokens is None:
        return NO_VALUE
    ours = run_value(unit, prefix_tokens, "warm", "decode_tokens_per_second")
    theirs = run_value(base, prefix_tokens, "warm", "decode_tokens_per_second")
    if not ours or not theirs:
        return NO_VALUE
    return f"×{ours / theirs:.2f}"


def table_title(table):
    return f"{table.model} · {table.stage}"


def mtp_summary_lines(tables):
    lines = []
    for table in tables:
        ratios = [(unit.server, decode_ratio(unit, table.units)) for unit in table.units]
        parts = [f"{server} {ratio}" for server, ratio in ratios if ratio != NO_VALUE]
        if parts:
            lines.append(f"MTP decode: {table_title(table)}: {', '.join(parts)}")
    return lines


def is_running(plan):
    return plan is not None and not plan.finished


def finals_result(cells, name):
    result = cells.get(name) or {}
    return {
        "green": result.get("green", 0),
        "runs": result.get("runs", 0),
        "median_seconds": result.get("median_seconds"),
        "timeouts": result.get("timeouts", 0),
    }


def beats_baseline(result, base, most_green):
    if result["green"] < most_green or result["median_seconds"] is None:
        return False
    if result["timeouts"] > base["timeouts"]:
        return False
    if base["median_seconds"] is None:
        return True
    return result["median_seconds"] <= base["median_seconds"] * (1 - FINALS_SECONDS_CUT)


def model_winner(cells, baseline_name):
    if baseline_name not in cells:
        return None
    results = {name: finals_result(cells, name) for name in cells}
    most_green = max(result["green"] for result in results.values())
    base = results[baseline_name]
    winners = [
        name for name, result in results.items() if name != baseline_name and beats_baseline(result, base, most_green)
    ]
    return min(winners, key=lambda name: results[name]["median_seconds"]) if winners else None


def finals_baseline(finals):
    return finals.get("baseline") or BASELINE


def finals_winners(finals):
    baseline_name = finals_baseline(finals)
    return {model: model_winner(cells, baseline_name) for model, cells in finals["models"].items()}


def models_run_by(finals, name):
    return [model for model, cells in finals["models"].items() if name in cells]


def finals_challengers(finals):
    names = ordered_unique(name for cells in finals["models"].values() for name in cells)
    return [name for name in names if name != finals_baseline(finals)]


def full_winner(finals, winners):
    for name in finals_challengers(finals):
        models = models_run_by(finals, name)
        if models and all(winners[model] == name for model in models):
            return name
    return None


def finals_headline(finals):
    winners = finals_winners(finals)
    switch_all = full_winner(finals, winners)
    if switch_all:
        return f"Switch to {switch_all}"
    if not any(winners.values()):
        return "Stay on Ollama"
    parts = [f"switch {model} to {name}" if name else f"stay on Ollama for {model}" for model, name in winners.items()]
    text = "; ".join(parts)
    return text[0].upper() + text[1:]


def has_baseline(tables):
    return any(baseline_of(table.units) for table in tables)


def progress_headline(tables):
    units = all_units(tables)
    finished = sum(unit.status in FINISHED_STATUSES for unit in units)
    return f"Running: {finished} of {len(units)} runs done"


def headline(tables, plan, finals):
    if is_running(plan):
        return progress_headline(tables)
    if finals:
        return finals_headline(finals)
    if not has_baseline(tables):
        return "No Ollama baseline: see the errors below"
    finalists = screened_finalists(tables)
    if finalists:
        return f"Finalists: {', '.join(finalists)}; the finals decide"
    return "Stay on Ollama"


def failure_details(units):
    blocks = []
    for unit in units:
        if unit.status in LOGGED_STATUSES:
            summary = html.escape(f"{unit.server} on {unit.model} {unit.status}: {stop_reason(unit)}")
            blocks.append(f"<details open><summary>{summary}</summary><pre>{html.escape(unit.log_tail)}</pre></details>")
    return "".join(blocks)


def family_header(units):
    families = [server_family(unit.server) for unit in units]
    spans = "".join(
        f'<th colspan="{families.count(family)}">{html.escape(family)}</th>' for family in ordered_unique(families)
    )
    return f"<tr><th></th>{spans}</tr>"


def server_header(units):
    names = "".join(f"<th>{html.escape(unit.server)}</th>" for unit in units)
    return f"<tr><th>Metric</th>{names}</tr>"


def describing_rows(units, plan):
    return [
        labelled_row("Status", [status_cell(unit, plan) for unit in units]),
        labelled_row("Gate", [gate_cell(unit) for unit in units]),
        labelled_row("Version", [cell("", unit.version or NO_VALUE) for unit in units]),
        labelled_row("Weights", [cell("", unit.weights or NO_VALUE) for unit in units]),
        render_row(Row("Weights size (GB)", [weights_gb(unit) for unit in units], None, 1)),
        labelled_row("MTP active", [cell("", mtp_text(unit)) for unit in units]),
    ]


def judging_rows(units):
    return [
        labelled_row("Decode vs MTP off", [cell("", decode_ratio(unit, units)) for unit in units]),
        labelled_row("Tool calls parsed", [cell("", tool_text(unit)) for unit in units]),
        labelled_row("Thinking leak", [leak_cell(unit) for unit in units]),
        labelled_row("Replay cache hit %", [cell("", replay_text(unit)) for unit in units]),
        labelled_row("Conditions", [cell("", conditions_text(unit)) for unit in units]),
        labelled_row("Verdict", [verdict_cell(units, unit) for unit in units]),
    ]


def render_table(table, plan):
    units = table.units
    body = describing_rows(units, plan)
    body.extend(render_row(row) for row in measurement_rows(units, plan))
    body.extend(judging_rows(units))
    repo = html.escape(" · ".join(ordered_unique(unit.repo for unit in units if unit.repo)))
    rows = "\n".join(body)
    return (
        f'<h2>{html.escape(table_title(table))}</h2><p class="muted">{repo}</p>'
        f'<div class="scroll"><table><thead>{family_header(units)}{server_header(units)}</thead>'
        f"<tbody>\n{rows}\n</tbody></table></div>{failure_details(units)}"
    )


def finals_outcome(name, baseline_name, winner):
    if name == baseline_name:
        return cell("baseline", "baseline")
    return cell(PASS, "winner") if name == winner else cell("", NO_VALUE)


def finals_row(model, name, result, outcome):
    median = NO_VALUE if result["median_seconds"] is None else f"{result['median_seconds']:.0f}"
    cells = [
        cell("", name),
        cell("", f"{result['green']}/{result['runs']}"),
        cell("", median),
        cell("", str(result["timeouts"])),
        outcome,
    ]
    return labelled_row(model, cells)


def render_finals(finals):
    if not finals:
        return ""
    baseline_name = finals_baseline(finals)
    winners = finals_winners(finals)
    rows = [
        finals_row(model, name, finals_result(cells, name), finals_outcome(name, baseline_name, winners[model]))
        for model, cells in finals["models"].items()
        for name in cells
    ]
    header = "<tr><th>Model</th><th>Cell</th><th>Green</th><th>Median s to green</th><th>Timeouts</th><th>Result</th></tr>"
    body = "\n".join(rows)
    return f'<h2>Finals</h2><div class="scroll"><table><thead>{header}</thead><tbody>\n{body}\n</tbody></table></div>'


def warning(tables):
    if any(unfair_conditions(unit) for unit in all_units(tables)):
        return (
            '<p class="warning">Some runs were on battery or in Low Power Mode. Their numbers are not '
            "comparable with runs on AC power; rerun them plugged in.</p>"
        )
    return ""


def mtp_summary(tables):
    return "".join(f'<p class="muted">{html.escape(line)}</p>' for line in mtp_summary_lines(tables))


def refresh_tag(plan):
    return f'<meta http-equiv="refresh" content="{REFRESH_SECONDS}">' if is_running(plan) else ""


def explanation(plan):
    rule = (
        f"Every cell is judged against Ollama on the same model and stage. A cell goes to the finals when "
        f"every tool call parses, its replay cache hit rate is at most {REPLAY_POINTS_FLOOR:.0f} points below "
        f"Ollama's, its warm TTFT at the largest prefix is at least {WARM_TTFT_CUT:.0%} lower (or its warm "
        f"decode at least {DECODE_GAIN:.0%} higher with warm TTFT no worse), no reply leaks thinking and MTP "
        f"is not reported inactive. A cell whose weights are under {WEIGHTS_FLOOR:.0%} of Ollama's gets no "
        "verdict. In the finals a cell wins a model with the most green task runs, a median time to green "
        f"at least {FINALS_SECONDS_CUT:.0%} below Ollama's and no timeouts Ollama lacks. Every server gets "
        "the same prompts, Qwen's instruct sampling (temperature 0.7, top_p 0.8, top_k 20) and the same "
        "token limits. Decode vs MTP off compares an MTP cell with its MTP-off pair. Highlighted cells are "
        "the best value in their row."
    )
    live = f" This page reloads every {REFRESH_SECONDS} s while the bench runs." if is_running(plan) else ""
    return f'<p class="muted">{html.escape(rule + live)}</p>'


def render_page(tables, plan, finals):
    sections = "\n".join(render_table(table, plan) for table in tables)
    return (
        '<!doctype html><html lang="en"><head><meta charset="utf-8">'
        '<meta name="viewport" content="width=device-width, initial-scale=1">'
        f"{refresh_tag(plan)}<title>Backend bench-off</title><style>{STYLE}</style></head><body>"
        f'<h1>Backend bench-off</h1><p class="headline">{html.escape(headline(tables, plan, finals))}</p>'
        f"{mtp_summary(tables)}{warning(tables)}{explanation(plan)}{render_finals(finals)}{sections}</body></html>\n"
    )


def load_results(results_dir):
    plan = load_plan(results_dir)
    units = load_units(results_dir)
    if not units and plan is None:
        raise ReportError(f"no results in {results_dir}")
    return build_tables(plan, units), plan


def write_atomically(path, text):
    partial = path.with_name(path.name + ".partial")
    partial.write_text(text, encoding="utf-8")
    partial.replace(path)


def main(argv):
    arguments = parse_args(argv)
    output = arguments.output or arguments.results_dir / REPORT_NAME
    try:
        tables, plan = load_results(arguments.results_dir)
    except (ReportError, OSError, ValueError, KeyError) as error:
        print(f"backend-bench-report: {error}", file=sys.stderr)
        return 1
    finals = load_finals(arguments.results_dir)
    if arguments.headline_only:
        print(headline(tables, plan, finals))
        return 0
    write_atomically(output, render_page(tables, plan, finals))
    print(output)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
