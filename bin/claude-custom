#!/usr/bin/env bash
set -u

repo_dir="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
status=0
wired=""

report_unmanaged() {
  echo "skip: $1 exists and is not managed by claude-custom" >&2
  status=1
}

resolved_target() {
  readlink -f "$1" 2>/dev/null || printf '%s' "$1"
}

temp_beside() {
  local target
  target="$(resolved_target "$1")"
  mktemp "$(dirname "$target")/.claude-custom.XXXXXX" 2>/dev/null || {
    echo "skip: cannot write next to $target" >&2
    return 1
  }
}

commit_temp() {
  local tmp="$1" file="$2"
  if mv -f "$tmp" "$(resolved_target "$file")"; then
    return 0
  fi
  rm -f "$tmp"
  echo "skip: could not update $file" >&2
  status=1
  return 1
}

login_shell_name() {
  local shell_path="${SHELL:-}"
  printf '%s' "${shell_path##*/}"
}

rc_block() {
  cat <<EOF
# >>> claude-custom >>>
case ":\$PATH:" in *":\$HOME/.local/bin:"*) ;; *) PATH="\$HOME/.local/bin:\$PATH"; export PATH ;; esac
CLAUDE_CUSTOM_HOME='$repo_dir'
[ -r "\$CLAUDE_CUSTOM_HOME/personal/claude.sh" ] && . "\$CLAUDE_CUSTOM_HOME/personal/claude.sh"
# <<< claude-custom <<<
EOF
}

fish_config_dir() {
  printf '%s' "${XDG_CONFIG_HOME:-$HOME/.config}/fish"
}

fish_dropin_path() {
  printf '%s/conf.d/claude-custom.fish' "$(fish_config_dir)"
}

fish_dropin_body() {
  cat <<EOF
fish_add_path -g \$HOME/.local/bin
set -g CLAUDE_CUSTOM_HOME '$repo_dir'
test -r \$CLAUDE_CUSTOM_HOME/personal/claude.fish; and source \$CLAUDE_CUSTOM_HOME/personal/claude.fish
EOF
}

claude_md_path() {
  printf '%s/CLAUDE.md' "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
}

imported_files='shared/preferences/PREFERENCES.md'
retired_imports='personal/CLAUDE.tokens.md'

import_line() {
  printf '@%s/%s' "$repo_dir" "$1"
}

tilde_import_line() {
  case "$repo_dir" in
    "$HOME"/*) printf '@~%s/%s' "${repo_dir#"$HOME"}" "$1" ;;
    *) import_line "$1" ;;
  esac
}

has_import_line() {
  [ -f "$1" ] && { grep -qxF "$(import_line "$2")" "$1" || grep -qxF "$(tilde_import_line "$2")" "$1"; }
}

has_unmatched_marker() {
  [ -f "$1" ] || return 1
  local starts ends
  starts="$(grep -c '^# >>> claude-custom >>>$' "$1")"
  ends="$(grep -c '^# <<< claude-custom <<<$' "$1")"
  [ "$starts" != "$ends" ]
}

has_block() {
  grep -q '^# >>> claude-custom >>>$' "$1"
}

strip_block() {
  [ -f "$1" ] || return 0
  awk '/^# >>> claude-custom >>>$/{skip=1} !skip{print} /^# <<< claude-custom <<<$/{skip=0}' "$1"
}

install_sh_block() {
  local file="$1" tmp
  if has_unmatched_marker "$file"; then
    echo "skip: unmatched claude-custom marker in $file" >&2
    status=1
    return 1
  fi
  mkdir -p "$(dirname "$file")"
  tmp="$(temp_beside "$file")" || { status=1; return 1; }
  strip_block "$file" > "$tmp" || { rm -f "$tmp"; return 1; }
  if [ -s "$tmp" ] && [ -n "$(tail -c 1 "$tmp")" ]; then
    printf '\n' >> "$tmp"
  fi
  rc_block >> "$tmp"
  commit_temp "$tmp" "$file"
}

remove_sh_block() {
  local file="$1" tmp
  [ -f "$file" ] || return 0
  if has_unmatched_marker "$file"; then
    echo "skip: unmatched claude-custom marker in $file" >&2
    status=1
    return 0
  fi
  has_block "$file" || return 0
  tmp="$(temp_beside "$file")" || { status=1; return 1; }
  strip_block "$file" > "$tmp" || { rm -f "$tmp"; return 1; }
  commit_temp "$tmp" "$file"
}

wire_zsh() {
  local file="${ZDOTDIR:-$HOME}/.zshrc"
  if [ -e "$file" ] || [ "$(login_shell_name)" = zsh ]; then
    if install_sh_block "$file"; then
      wired="$wired zsh"
    fi
  fi
}

wire_bash() {
  local file
  for file in "$HOME/.bashrc" "$HOME/.bash_profile"; do
    if [ -e "$file" ] && install_sh_block "$file"; then
      wired="$wired bash"
    fi
  done
  if [ "$(login_shell_name)" = bash ] && [ ! -e "$HOME/.bashrc" ] && [ ! -e "$HOME/.bash_profile" ]; then
    if install_sh_block "$HOME/.bashrc"; then
      wired="$wired bash"
    fi
  fi
}

wire_ksh() {
  local file="$HOME/.kshrc"
  if [ -e "$file" ] || [ "$(login_shell_name)" = ksh ]; then
    if install_sh_block "$file"; then
      wired="$wired ksh"
    fi
  fi
}

wire_fish() {
  local dropin
  dropin="$(fish_dropin_path)"
  if [ -d "$(fish_config_dir)" ] || [ "$(login_shell_name)" = fish ]; then
    mkdir -p "$(dirname "$dropin")"
    fish_dropin_body > "$dropin"
    wired="$wired fish"
  fi
}

wire_shells() {
  wired=""
  wire_zsh
  wire_bash
  wire_ksh
  wire_fish
}

print_activation() {
  case " $wired " in *" zsh "*) echo "zsh:  run 'exec zsh' or open a new terminal" ;; esac
  case " $wired " in *" bash "*) echo "bash: run 'exec bash' or open a new terminal" ;; esac
  case " $wired " in *" ksh "*) echo "ksh:  run 'exec ksh' or open a new terminal" ;; esac
  case " $wired " in *" fish "*) echo "fish: run 'source $(fish_dropin_path)' or open a new terminal" ;; esac
  case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) printf '%s/.local/bin was not on PATH; the shells above add it on next start\n' '~' ;;
  esac
}

place_link() {
  local target="$1" link="$2" current
  mkdir -p "$(dirname "$link")"
  if [ -L "$link" ]; then
    current="$(readlink "$link")"
    if [ "$current" = "$target" ]; then
      return 0
    fi
    case "$current" in
      "$repo_dir"/*) rm "$link" ;;
      *) report_unmanaged "$link"; return 0 ;;
    esac
  elif [ -e "$link" ]; then
    report_unmanaged "$link"
    return 0
  fi
  ln -s "$target" "$link"
}

remove_link() {
  local target="$1" link="$2"
  if [ -L "$link" ] && [ "$(readlink "$link")" = "$target" ]; then
    rm "$link"
  fi
}

place_links() {
  place_link "$repo_dir/bin/claude-ollama" "$HOME/.local/bin/claude-ollama"
  place_link "$repo_dir/bin/claude-custom" "$HOME/.local/bin/claude-custom"
  place_link "$repo_dir/bin/claude-tools" "$HOME/.local/bin/claude-tools"
  place_link "$repo_dir/bin/ollama-agent" "$HOME/.local/bin/ollama-agent"
  place_link "$repo_dir/shared/agents/pr-review.md" "$HOME/.claude/agents/pr-review.md"
  place_link "$repo_dir/shared/skills/handoff" "$HOME/.claude/skills/handoff"
  place_link "$repo_dir/shared/skills/find-docs" "$HOME/.claude/skills/find-docs"
  place_link "$repo_dir/shared/skills/pr-draft" "$HOME/.claude/skills/pr-draft"
  place_link "$repo_dir/shared/skills/pr-review-draft" "$HOME/.claude/skills/pr-review-draft"
}

remove_stale_hook_links() {
  local link
  for link in "$HOME"/.claude/hooks/*; do
    [ -L "$link" ] || continue
    case "$(readlink "$link")" in
      "$repo_dir"/shared/hooks/*) rm "$link" ;;
    esac
  done
}

add_import_line() {
  local file
  file="$(claude_md_path)"
  if has_import_line "$file" "$1"; then
    return 0
  fi
  mkdir -p "$(dirname "$file")"
  if [ -s "$file" ] && [ -n "$(tail -c 1 "$file")" ]; then
    printf '\n' >> "$file"
  fi
  printf '%s\n' "$(import_line "$1")" >> "$file"
}

remove_import_line() {
  local file tmp
  file="$(claude_md_path)"
  has_import_line "$file" "$1" || return 0
  tmp="$(temp_beside "$file")" || { status=1; return 1; }
  awk -v absolute="$(import_line "$1")" -v tilde="$(tilde_import_line "$1")" '$0 != absolute && $0 != tilde' "$file" > "$tmp" \
    || { rm -f "$tmp"; return 1; }
  commit_temp "$tmp" "$file"
}

add_import_lines() {
  local imported
  for imported in $imported_files; do
    add_import_line "$imported"
  done
}

remove_import_lines() {
  local imported
  for imported in $imported_files; do
    remove_import_line "$imported"
  done
}

remove_retired_imports() {
  local retired
  for retired in $retired_imports; do
    remove_import_line "$retired"
  done
}

retire_plan_001_fish_link() {
  remove_link "$repo_dir/personal/claude.fish" "$(fish_config_dir)/functions/claude.fish"
}

check_ollama_profiles() {
  command -v jq >/dev/null 2>&1 || { echo "skip: jq not installed; the generated profile check did not run" >&2; return 0; }
  "$repo_dir/bin/ollama-profiles" --check || { echo "fail: ollama profiles are stale; run bin/ollama-profiles" >&2; status=1; }
}

refresh_ollama_models() {
  command -v ollama >/dev/null 2>&1 || return 0
  local modelfile size base name verb='pull'
  for modelfile in "$repo_dir"/ollama/Modelfile.*; do
    [ -f "$modelfile" ] || continue
    size="${modelfile##*/Modelfile.}"
    base="$(sed -n 's/^FROM //p' "$modelfile")"
    if [[ "$base" == ./weights/* ]]; then
      echo "skip: $base is a pinned GGUF; claude-ollama $size downloads and imports it on first launch" >&2
      continue
    fi
    name="$(jq -r .model "$repo_dir/ollama/settings.$size.json")"
    if [ -z "$name" ] || [ "$name" = null ]; then
      echo "fail: no model name in ollama/settings.$size.json" >&2
      status=1
      continue
    fi
    if ! ollama show "$base" >/dev/null 2>&1; then
      echo "skip: ollama base model $base not available; run 'ollama $verb $base' (and make sure 'ollama serve' is running), then re-run claude-custom install" >&2
      continue
    fi
    if ! ollama create "$name" -f "$modelfile"; then
      echo "fail: ollama create $name" >&2
      status=1
    fi
  done
}

guard_repo_path() {
  case "$repo_dir" in
    *"'"*) echo "claude-custom path must not contain a single quote" >&2; exit 2 ;;
  esac
}

build_go_apps() {
  command -v go >/dev/null 2>&1 || { echo "skip: go not installed; TUIs build on first launch" >&2; return 0; }
  (cd "$repo_dir/go" && go build -o cmd/model-picker/model-picker ./cmd/model-picker) || { echo "fail: build model-picker" >&2; status=1; }
  (cd "$repo_dir/go" && go build -o cmd/claude-tools/claude-tools ./cmd/claude-tools) || { echo "fail: build claude-tools" >&2; status=1; }
  (cd "$repo_dir/go" && go build -o cmd/ollama-agent/ollama-agent ./cmd/ollama-agent) || { echo "fail: build ollama-agent" >&2; status=1; }
}

remove_session_packages() {
  rm -rf "$HOME/.local/share/claude-custom/sandbox-runtime" "$HOME/.local/share/claude-custom/shortcut-cli"
}

running_ollama_env() {
  local pid
  pid="$(pgrep -x ollama | head -n 1)" || true
  [ -n "$pid" ] || return 1
  if [ -r "/proc/$pid/environ" ]; then
    tr '\0' '\n' < "/proc/$pid/environ"
  else
    ps -Eo command -p "$pid" | tr ' ' '\n'
  fi
}

server_env_is_current() {
  local wanted
  while IFS= read -r wanted; do
    [ -n "$wanted" ] || continue
    printf '%s\n' "$1" | grep -qxF "$wanted" || return 1
  done < "$repo_dir/ollama/server.env"
}

restart_stale_ollama_server() {
  [ "$(uname)" = Darwin ] || return 0
  local running
  running="$(running_ollama_env)" || return 0
  server_env_is_current "$running" && return 0
  echo "install: the Ollama server lacks ollama/server.env values; restarting it" >&2
  "${CLAUDE_OLLAMA_AGENT:-$repo_dir/bin/ollama-agent}" -apply >&2 || echo "skip: could not restart Ollama; run: claude-custom agent -apply" >&2
}

sync_fingerprint="$repo_dir/bin/sync-fingerprint"
sync_sections="commit dirty claude_version models server_env hooks sandbox"
sync_beacon_file="${XDG_CONFIG_HOME:-$HOME/.config}/claude-custom/beacon.json"

launch_beacon_file() {
  echo "${CLAUDE_CONSOLE_STATE_DIR:-$HOME/.local/share/claude-custom/console}/beacon/$(hostname -s).json"
}

write_launch_beacon() {
  [ "${CLAUDE_OLLAMA_BEACON:-}" = 0 ] && return 0
  command -v jq >/dev/null 2>&1 || return 0
  "$sync_fingerprint" --out "$(launch_beacon_file)" || echo "skip: launch beacon not written" >&2
}

install_all() {
  guard_repo_path
  place_links
  remove_stale_hook_links
  add_import_lines
  remove_retired_imports
  retire_plan_001_fish_link
  wire_shells
  check_ollama_profiles
  refresh_ollama_models
  build_go_apps
  install_ctx7_cli
  restart_stale_ollama_server
  remove_session_packages
  write_launch_beacon
  print_activation
}

sync_check_usage() {
  echo "usage: claude-custom sync-check [--write] [--against FILE]" >&2
  exit 2
}

section_value() {
  jq -cS ".$2" "$1"
}

summary_label() {
  sed -n "s/^$2: //p" <<< "$1"
}

model_diff_lines() {
  jq -r --slurpfile beacon "$2" '
    def shown: if . == null then "none" else "\(.name) \(.digest)" end;
    .models as $local | $beacon[0].models as $theirs
    | (($local + $theirs) | keys[]) as $size
    | select($local[$size] != $theirs[$size])
    | "  \($size): local \($local[$size] | shown) vs beacon \($theirs[$size] | shown)"' "$1"
}

hook_diff_lines() {
  jq -r --slurpfile beacon "$2" '
    def shown: if . == null then "none" else .[:12] end;
    .hooks as $local | $beacon[0].hooks as $theirs
    | (($local + $theirs) | keys[]) as $hook
    | select($local[$hook] != $theirs[$hook])
    | "  \($hook): local \($local[$hook] | shown) vs beacon \($theirs[$hook] | shown)"' "$1"
}

write_sync_beacon() {
  (umask 077 && mkdir -p "$(dirname "$sync_beacon_file")" && cp "$1" "$sync_beacon_file" && chmod 600 "$sync_beacon_file") || exit 1
  echo "beacon written: $sync_beacon_file"
}

report_sync_diff() {
  local local_file="$1" beacon="$2" local_summary beacon_summary host age section differs=0
  local_summary="$("$sync_fingerprint" --summary "$local_file")"
  beacon_summary="$("$sync_fingerprint" --summary "$beacon")"
  host="$(jq -r '.host // "unknown host"' "$beacon")"
  age="$("$sync_fingerprint" --age "$beacon")"
  for section in $sync_sections; do
    [ "$(section_value "$local_file" "$section")" != "$(section_value "$beacon" "$section")" ] || continue
    differs=1
    echo "$section: local $(summary_label "$local_summary" "$section") vs beacon $(summary_label "$beacon_summary" "$section") ($host, $age)"
    case "$section" in
      models) model_diff_lines "$local_file" "$beacon" ;;
      hooks) hook_diff_lines "$local_file" "$beacon" ;;
    esac
  done
  [ "$differs" -eq 1 ] || echo "beacon matches ($host, $age)"
  return "$differs"
}

sync_check() {
  local write="" against="" local_file
  while [ $# -gt 0 ]; do
    case "$1" in
      --write) write=1 ;;
      --against) [ -n "${2:-}" ] || sync_check_usage; against="$2"; shift ;;
      *) sync_check_usage ;;
    esac
    shift
  done
  command -v jq >/dev/null 2>&1 || { echo "claude-custom sync-check: jq is required (brew install jq)" >&2; exit 1; }
  local_file="$(umask 077 && mktemp "${TMPDIR:-/tmp}/claude-custom-sync.XXXXXX")" || exit 1
  trap 'rm -f "$local_file"' EXIT
  "$sync_fingerprint" > "$local_file" || exit 1
  "$sync_fingerprint" --summary "$local_file"
  if [ -n "$write" ]; then
    write_sync_beacon "$local_file"
    exit 0
  fi
  against="${against:-$sync_beacon_file}"
  if [ ! -f "$against" ]; then
    echo "no beacon at $against (run claude-custom sync-check --write on the other machine and copy its beacon.json here, or pass --against FILE)" >&2
    exit 2
  fi
  report_sync_diff "$local_file" "$against"
  exit "$?"
}

uninstall_all() {
  guard_repo_path
  remove_sh_block "${ZDOTDIR:-$HOME}/.zshrc"
  remove_sh_block "$HOME/.bashrc"
  remove_sh_block "$HOME/.bash_profile"
  remove_sh_block "$HOME/.kshrc"
  rm -f "$(fish_dropin_path)"
  remove_link "$repo_dir/bin/claude-ollama" "$HOME/.local/bin/claude-ollama"
  remove_link "$repo_dir/bin/claude-custom" "$HOME/.local/bin/claude-custom"
  remove_link "$repo_dir/bin/claude-tools" "$HOME/.local/bin/claude-tools"
  remove_link "$repo_dir/bin/ollama-agent" "$HOME/.local/bin/ollama-agent"
  remove_link "$repo_dir/shared/agents/pr-review.md" "$HOME/.claude/agents/pr-review.md"
  remove_link "$repo_dir/shared/skills/handoff" "$HOME/.claude/skills/handoff"
  remove_link "$repo_dir/shared/skills/find-docs" "$HOME/.claude/skills/find-docs"
  remove_link "$repo_dir/shared/skills/pr-draft" "$HOME/.claude/skills/pr-draft"
  remove_link "$repo_dir/shared/skills/pr-review-draft" "$HOME/.claude/skills/pr-review-draft"
  remove_stale_hook_links
  remove_import_lines
  remove_retired_imports
  rm -rf "$ctx7_home"
  echo "open a new terminal; current shells keep the claude function until they exit"
}

ctx7_version="0.8.2"
ctx7_home="$HOME/.cache/claude-custom/ctx7"
ctx7_package_dir="$repo_dir/shared/ctx7"

installed_ctx7_version() {
  sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$ctx7_home/node_modules/ctx7/package.json" 2>/dev/null | head -n 1
}

ctx7_cli_is_current() {
  [ -x "$ctx7_home/node_modules/.bin/ctx7" ] &&
    [ "$(installed_ctx7_version)" = "$ctx7_version" ] &&
    cmp -s "$ctx7_package_dir/package-lock.json" "$ctx7_home/package-lock.json"
}

make_private_ctx7_home() {
  mkdir -p "$ctx7_home" || return 1
  chmod 700 "$HOME/.cache/claude-custom" "$ctx7_home"
}

install_ctx7_cli() {
  ctx7_cli_is_current && return 0
  command -v npm >/dev/null 2>&1 || { echo "skip: npm not installed; claude-custom ctx7 needs it: run claude-custom install after installing Node" >&2; return 0; }
  make_private_ctx7_home || { echo "fail: cannot create $ctx7_home" >&2; status=1; return 0; }
  rm -rf "$ctx7_home/node_modules"
  cp "$ctx7_package_dir/package.json" "$ctx7_package_dir/package-lock.json" "$ctx7_home/" || { echo "fail: cannot copy the ctx7 lockfile" >&2; status=1; return 0; }
  if (cd "$ctx7_home" && npm ci --ignore-scripts --no-audit --no-fund --loglevel=error >&2); then
    echo "installed the Context7 CLI ctx7@$ctx7_version into $ctx7_home" >&2
  else
    echo "fail: npm ci for ctx7@$ctx7_version in $ctx7_home; /find-docs will not work until it succeeds" >&2
    status=1
  fi
}

ctx7_home_writable() {
  mkdir -p "$1/npm-cache" 2>/dev/null && : > "$1/npm-cache/.writable" 2>/dev/null
}

redact_secrets() {
  sed -E \
    -e 's#(://)[^/@[:space:]]*@#\1#g' \
    -e 's#_authToken=[^[:space:]]+#_authToken=<redacted>#g' \
    -e 's#Bearer [^[:space:]]+#Bearer <redacted>#g' \
    -e 's#sk-[A-Za-z0-9_-]{8,}#<redacted>#g' \
    -e 's#ghp_[A-Za-z0-9]{8,}#<redacted>#g' \
    -e 's#(^|[^A-Za-z0-9+=_-])[A-Za-z0-9+=_-]{40,}#\1<redacted>#g'
}

ctx7_registry() {
  (cd "$1" && npm config get registry 2>/dev/null | redact_secrets) || echo "an unknown registry"
}

explain_ctx7_failure() {
  local prefix="$1" status="$2"
  echo "claude-custom ctx7: npm could not fetch ctx7@$ctx7_version from $(ctx7_registry "$prefix") (exit $status)" >&2
  echo "claude-custom ctx7: npm reads ~/.npmrc here, never a project .npmrc; put the registry's auth token line in ~/.npmrc" >&2
}

run_pinned_ctx7() {
  local prefix="$1" output errors status
  shift
  output="$(mktemp "${TMPDIR:-/tmp}/claude-custom-ctx7-out.XXXXXX")" || return 1
  errors="$(mktemp "${TMPDIR:-/tmp}/claude-custom-ctx7-err.XXXXXX")" || { rm -f "$output"; return 1; }
  (cd "$prefix" && npx --yes --prefix="$prefix" "$@") > "$output" 2> "$errors"
  status=$?
  head -n 80 "$output"
  redact_secrets < "$errors" >&2
  rm -f "$output" "$errors"
  [ "$status" -eq 0 ] || explain_ctx7_failure "$prefix" "$status"
  return "$status"
}

run_ctx7_from_scratch() {
  local scratch status
  scratch="$(mktemp -d "${TMPDIR:-/tmp}/claude-custom-ctx7.XXXXXX")" || exit 1
  run_pinned_ctx7 "$scratch" "ctx7@$ctx7_version" "$@"
  status=$?
  rm -rf "$scratch"
  return "$status"
}

check_ctx7_lookup() {
  case "${1:-}" in
    library|docs) ;;
    *) echo "usage: claude-custom ctx7 library NAME QUERY | claude-custom ctx7 docs ID QUERY [--language L]" >&2; exit 2 ;;
  esac
}

run_ctx7() {
  local home
  check_ctx7_lookup "$@"
  home="$HOME/.cache/claude-custom/ctx7"
  if ctx7_home_writable "$home"; then
    run_pinned_ctx7 "$home" --cache="$home/npm-cache" "ctx7@$ctx7_version" "$@"
    return
  fi
  run_ctx7_from_scratch "$@"
}

update_repo() {
  if ! git -C "$repo_dir" pull --ff-only; then
    echo "update: git pull failed; fix the repo state, then run: $repo_dir/bin/claude-custom install" >&2
    exit 1
  fi
  exec "$repo_dir/bin/claude-custom" finish-update
}

main() {
  case "${1:-install}" in
    install) install_all ;;
    update) update_repo ;;
    finish-update) install_all ;;
    uninstall) uninstall_all ;;
    ollama) shift; exec "$repo_dir/bin/claude-ollama" "$@" ;;
    qwen) shift; exec "$repo_dir/bin/claude-ollama" qwen "$@" ;;
    tools) shift; exec "$repo_dir/bin/claude-tools" "$@" ;;
    agent) shift; exec "$repo_dir/bin/ollama-agent" "$@" ;;
    ctx7) shift; run_ctx7 "$@"; status=$? ;;
    sync-check) shift; sync_check "$@" ;;
    *) echo "usage: claude-custom [install|update|uninstall|ollama|qwen|tools|agent|ctx7|sync-check]" >&2; exit 2 ;;
  esac
  exit "$status"
}

main "$@"
