#!/usr/bin/env bash
set -u

repo_dir="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
status=0
wired=""

report_unmanaged() {
  echo "skip: $1 exists and is not managed by claude-custom" >&2
  status=1
}

resolved_target() {
  readlink -f "$1" 2>/dev/null || printf '%s' "$1"
}

temp_beside() {
  local target
  target="$(resolved_target "$1")"
  mktemp "$(dirname "$target")/.claude-custom.XXXXXX" 2>/dev/null || {
    echo "skip: cannot write next to $target" >&2
    return 1
  }
}

commit_temp() {
  local tmp="$1" file="$2"
  if mv -f "$tmp" "$(resolved_target "$file")"; then
    return 0
  fi
  rm -f "$tmp"
  echo "skip: could not update $file" >&2
  status=1
  return 1
}

login_shell_name() {
  local shell_path="${SHELL:-}"
  printf '%s' "${shell_path##*/}"
}

rc_block() {
  cat <<EOF
# >>> claude-custom >>>
case ":\$PATH:" in *":\$HOME/.local/bin:"*) ;; *) PATH="\$HOME/.local/bin:\$PATH"; export PATH ;; esac
CLAUDE_CUSTOM_HOME='$repo_dir'
[ -r "\$CLAUDE_CUSTOM_HOME/personal/claude.sh" ] && . "\$CLAUDE_CUSTOM_HOME/personal/claude.sh"
# <<< claude-custom <<<
EOF
}

fish_config_dir() {
  printf '%s' "${XDG_CONFIG_HOME:-$HOME/.config}/fish"
}

fish_dropin_path() {
  printf '%s/conf.d/claude-custom.fish' "$(fish_config_dir)"
}

fish_dropin_body() {
  cat <<EOF
fish_add_path -g \$HOME/.local/bin
set -g CLAUDE_CUSTOM_HOME '$repo_dir'
test -r \$CLAUDE_CUSTOM_HOME/personal/claude.fish; and source \$CLAUDE_CUSTOM_HOME/personal/claude.fish
EOF
}

claude_md_path() {
  printf '%s/CLAUDE.md' "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
}

imported_files='shared/preferences/PREFERENCES.md'
retired_imports='personal/CLAUDE.tokens.md'

import_line() {
  printf '@%s/%s' "$repo_dir" "$1"
}

tilde_import_line() {
  case "$repo_dir" in
    "$HOME"/*) printf '@~%s/%s' "${repo_dir#"$HOME"}" "$1" ;;
    *) import_line "$1" ;;
  esac
}

has_import_line() {
  [ -f "$1" ] && { grep -qxF "$(import_line "$2")" "$1" || grep -qxF "$(tilde_import_line "$2")" "$1"; }
}

has_unmatched_marker() {
  [ -f "$1" ] || return 1
  local starts ends
  starts="$(grep -c '^# >>> claude-custom >>>$' "$1")"
  ends="$(grep -c '^# <<< claude-custom <<<$' "$1")"
  [ "$starts" != "$ends" ]
}

has_block() {
  grep -q '^# >>> claude-custom >>>$' "$1"
}

strip_block() {
  [ -f "$1" ] || return 0
  awk '/^# >>> claude-custom >>>$/{skip=1} !skip{print} /^# <<< claude-custom <<<$/{skip=0}' "$1"
}

install_sh_block() {
  local file="$1" tmp
  if has_unmatched_marker "$file"; then
    echo "skip: unmatched claude-custom marker in $file" >&2
    status=1
    return 1
  fi
  mkdir -p "$(dirname "$file")"
  tmp="$(temp_beside "$file")" || { status=1; return 1; }
  strip_block "$file" > "$tmp" || { rm -f "$tmp"; return 1; }
  if [ -s "$tmp" ] && [ -n "$(tail -c 1 "$tmp")" ]; then
    printf '\n' >> "$tmp"
  fi
  rc_block >> "$tmp"
  commit_temp "$tmp" "$file"
}

remove_sh_block() {
  local file="$1" tmp
  [ -f "$file" ] || return 0
  if has_unmatched_marker "$file"; then
    echo "skip: unmatched claude-custom marker in $file" >&2
    status=1
    return 0
  fi
  has_block "$file" || return 0
  tmp="$(temp_beside "$file")" || { status=1; return 1; }
  strip_block "$file" > "$tmp" || { rm -f "$tmp"; return 1; }
  commit_temp "$tmp" "$file"
}

wire_zsh() {
  local file="${ZDOTDIR:-$HOME}/.zshrc"
  if [ -e "$file" ] || [ "$(login_shell_name)" = zsh ]; then
    if install_sh_block "$file"; then
      wired="$wired zsh"
    fi
  fi
}

wire_bash() {
  local file
  for file in "$HOME/.bashrc" "$HOME/.bash_profile"; do
    if [ -e "$file" ] && install_sh_block "$file"; then
      wired="$wired bash"
    fi
  done
  if [ "$(login_shell_name)" = bash ] && [ ! -e "$HOME/.bashrc" ] && [ ! -e "$HOME/.bash_profile" ]; then
    if install_sh_block "$HOME/.bashrc"; then
      wired="$wired bash"
    fi
  fi
}

wire_ksh() {
  local file="$HOME/.kshrc"
  if [ -e "$file" ] || [ "$(login_shell_name)" = ksh ]; then
    if install_sh_block "$file"; then
      wired="$wired ksh"
    fi
  fi
}

wire_fish() {
  local dropin
  dropin="$(fish_dropin_path)"
  if [ -d "$(fish_config_dir)" ] || [ "$(login_shell_name)" = fish ]; then
    mkdir -p "$(dirname "$dropin")"
    fish_dropin_body > "$dropin"
    wired="$wired fish"
  fi
}

wire_shells() {
  wired=""
  wire_zsh
  wire_bash
  wire_ksh
  wire_fish
}

print_activation() {
  case " $wired " in *" zsh "*) echo "zsh:  run 'exec zsh' or open a new terminal" ;; esac
  case " $wired " in *" bash "*) echo "bash: run 'exec bash' or open a new terminal" ;; esac
  case " $wired " in *" ksh "*) echo "ksh:  run 'exec ksh' or open a new terminal" ;; esac
  case " $wired " in *" fish "*) echo "fish: run 'source $(fish_dropin_path)' or open a new terminal" ;; esac
  case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) printf '%s/.local/bin was not on PATH; the shells above add it on next start\n' '~' ;;
  esac
}

place_link() {
  local target="$1" link="$2" current
  mkdir -p "$(dirname "$link")"
  if [ -L "$link" ]; then
    current="$(readlink "$link")"
    if [ "$current" = "$target" ]; then
      return 0
    fi
    case "$current" in
      "$repo_dir"/*) rm "$link" ;;
      *) report_unmanaged "$link"; return 0 ;;
    esac
  elif [ -e "$link" ]; then
    report_unmanaged "$link"
    return 0
  fi
  ln -s "$target" "$link"
}

remove_link() {
  local target="$1" link="$2"
  if [ -L "$link" ] && [ "$(readlink "$link")" = "$target" ]; then
    rm "$link"
  fi
}

place_links() {
  place_link "$repo_dir/bin/claude-ollama" "$HOME/.local/bin/claude-ollama"
  place_link "$repo_dir/bin/claude-custom" "$HOME/.local/bin/claude-custom"
  place_link "$repo_dir/bin/claude-tools" "$HOME/.local/bin/claude-tools"
  place_link "$repo_dir/bin/ollama-agent" "$HOME/.local/bin/ollama-agent"
  place_link "$repo_dir/shared/agents/pr-review.md" "$HOME/.claude/agents/pr-review.md"
}

remove_stale_hook_links() {
  local link
  for link in "$HOME"/.claude/hooks/*; do
    [ -L "$link" ] || continue
    case "$(readlink "$link")" in
      "$repo_dir"/shared/hooks/*) rm "$link" ;;
    esac
  done
}

add_import_line() {
  local file
  file="$(claude_md_path)"
  if has_import_line "$file" "$1"; then
    return 0
  fi
  mkdir -p "$(dirname "$file")"
  if [ -s "$file" ] && [ -n "$(tail -c 1 "$file")" ]; then
    printf '\n' >> "$file"
  fi
  printf '%s\n' "$(import_line "$1")" >> "$file"
}

remove_import_line() {
  local file tmp
  file="$(claude_md_path)"
  has_import_line "$file" "$1" || return 0
  tmp="$(temp_beside "$file")" || { status=1; return 1; }
  awk -v absolute="$(import_line "$1")" -v tilde="$(tilde_import_line "$1")" '$0 != absolute && $0 != tilde' "$file" > "$tmp" \
    || { rm -f "$tmp"; return 1; }
  commit_temp "$tmp" "$file"
}

add_import_lines() {
  local imported
  for imported in $imported_files; do
    add_import_line "$imported"
  done
}

remove_import_lines() {
  local imported
  for imported in $imported_files; do
    remove_import_line "$imported"
  done
}

remove_retired_imports() {
  local retired
  for retired in $retired_imports; do
    remove_import_line "$retired"
  done
}

retire_plan_001_fish_link() {
  remove_link "$repo_dir/personal/claude.fish" "$(fish_config_dir)/functions/claude.fish"
}

check_ollama_profiles() {
  command -v npx >/dev/null 2>&1 || { echo "skip: npx not installed; the generated profile check did not run" >&2; return 0; }
  "$repo_dir/bin/ollama-profiles" --check || { echo "fail: ollama profiles are stale; run bin/ollama-profiles" >&2; status=1; }
}

refresh_ollama_models() {
  command -v ollama >/dev/null 2>&1 || return 0
  local modelfile size base name verb='pull'
  for modelfile in "$repo_dir"/ollama/Modelfile.*; do
    [ -f "$modelfile" ] || continue
    size="${modelfile##*/Modelfile.}"
    base="$(sed -n 's/^FROM //p' "$modelfile")"
    name="$(jq -r .model "$repo_dir/ollama/settings.$size.json")"
    if [ -z "$name" ] || [ "$name" = null ]; then
      echo "fail: no model name in ollama/settings.$size.json" >&2
      status=1
      continue
    fi
    if ! ollama show "$base" >/dev/null 2>&1; then
      echo "skip: ollama base model $base not available; run 'ollama $verb $base' (and make sure 'ollama serve' is running), then re-run claude-custom install" >&2
      continue
    fi
    if ! ollama create "$name" -f "$modelfile"; then
      echo "fail: ollama create $name" >&2
      status=1
    fi
  done
}

guard_repo_path() {
  case "$repo_dir" in
    *"'"*) echo "claude-custom path must not contain a single quote" >&2; exit 2 ;;
  esac
}

build_go_apps() {
  command -v go >/dev/null 2>&1 || { echo "skip: go not installed; TUIs build on first launch" >&2; return 0; }
  (cd "$repo_dir/go" && go build -o cmd/model-picker/model-picker ./cmd/model-picker) || { echo "fail: build model-picker" >&2; status=1; }
  (cd "$repo_dir/go" && go build -o cmd/claude-tools/claude-tools ./cmd/claude-tools) || { echo "fail: build claude-tools" >&2; status=1; }
  (cd "$repo_dir/go" && go build -o cmd/ollama-agent/ollama-agent ./cmd/ollama-agent) || { echo "fail: build ollama-agent" >&2; status=1; }
}

install_all() {
  guard_repo_path
  place_links
  remove_stale_hook_links
  add_import_lines
  remove_retired_imports
  retire_plan_001_fish_link
  wire_shells
  check_ollama_profiles
  refresh_ollama_models
  build_go_apps
  print_activation
}

uninstall_all() {
  guard_repo_path
  remove_sh_block "${ZDOTDIR:-$HOME}/.zshrc"
  remove_sh_block "$HOME/.bashrc"
  remove_sh_block "$HOME/.bash_profile"
  remove_sh_block "$HOME/.kshrc"
  rm -f "$(fish_dropin_path)"
  remove_link "$repo_dir/bin/claude-ollama" "$HOME/.local/bin/claude-ollama"
  remove_link "$repo_dir/bin/claude-custom" "$HOME/.local/bin/claude-custom"
  remove_link "$repo_dir/bin/claude-tools" "$HOME/.local/bin/claude-tools"
  remove_link "$repo_dir/bin/ollama-agent" "$HOME/.local/bin/ollama-agent"
  remove_link "$repo_dir/shared/agents/pr-review.md" "$HOME/.claude/agents/pr-review.md"
  remove_stale_hook_links
  remove_import_lines
  remove_retired_imports
  echo "open a new terminal; current shells keep the claude function until they exit"
}

update_repo() {
  if ! git -C "$repo_dir" pull --ff-only; then
    echo "update: git pull failed; fix the repo state, then run: $repo_dir/bin/claude-custom install" >&2
    exit 1
  fi
  exec "$repo_dir/bin/claude-custom" install
}

main() {
  case "${1:-install}" in
    install) install_all ;;
    update) update_repo ;;
    uninstall) uninstall_all ;;
    ollama) shift; exec "$repo_dir/bin/claude-ollama" "$@" ;;
    tools) shift; exec "$repo_dir/bin/claude-tools" "$@" ;;
    agent) shift; exec "$repo_dir/bin/ollama-agent" "$@" ;;
    *) echo "usage: claude-custom [install|update|uninstall|ollama|tools|agent]" >&2; exit 2 ;;
  esac
  exit "$status"
}

main "$@"
