#!/usr/bin/env python3
import json
import os
import statistics
import sys
from collections import Counter, defaultdict
from datetime import datetime

TOP_CALLS = 5
LINT_MIN_DENIALS = 30
LINT_TRIPS_PER_100 = 20


def log_path_from(arguments, environment):
    if arguments:
        return arguments[0]
    return environment.get("CLAUDE_TOOL_TELEMETRY")


def read_records(path):
    records = []
    with open(path, encoding="utf-8") as log:
        for line in log:
            try:
                record = json.loads(line)
            except json.JSONDecodeError:
                continue
            if isinstance(record, dict):
                records.append(record)
    return records


def tool_row(tool, calls):
    sizes = [call["bytes"] for call in calls]
    over_limit = sum(1 for call in calls if call["over_trim_limit"])
    return (tool, len(calls), sum(sizes), statistics.median(sizes), max(sizes), over_limit)


def tool_rows(calls):
    by_tool = defaultdict(list)
    for call in calls:
        by_tool[call["tool"]].append(call)
    rows = [tool_row(tool, group) for tool, group in by_tool.items()]
    return sorted(rows, key=lambda row: row[2], reverse=True)


def format_time(timestamp):
    return datetime.fromtimestamp(timestamp).strftime("%Y-%m-%d %H:%M:%S")


def print_tool_table(calls):
    print(f"{'tool':<12}{'calls':>7}{'total':>12}{'median':>10}{'max':>10}{'over_limit':>12}")
    for tool, count, total, median, largest, over_limit in tool_rows(calls):
        print(f"{tool:<12}{count:>7}{total:>12}{median:>10.0f}{largest:>10}{over_limit:>12}")


def print_largest_calls(calls):
    print()
    print("largest calls")
    largest_first = sorted(calls, key=lambda call: call["bytes"], reverse=True)
    for call in largest_first[:TOP_CALLS]:
        print(f"{call['bytes']:>10}  {call['tool']:<12} {call['session']}  {format_time(call['time'])}")


def denial_rows(denials):
    by_hook = defaultdict(list)
    for denial in denials:
        by_hook[denial.get("hook", "unknown")].append(denial)
    rows = [(hook, len(group), group[-1].get("reason", "")) for hook, group in by_hook.items()]
    return sorted(rows, key=lambda row: row[1], reverse=True)


def print_denials(denials):
    print()
    if not denials:
        print("denials: none")
        return
    print("denials")
    for hook, count, reason in denial_rows(denials):
        print(f"{hook:<20}{count:>7}  {reason}")


def trip_rows(trips):
    by_hook = defaultdict(int)
    for trip in trips:
        by_hook[trip.get("hook", "unknown")] += 1
    return sorted(by_hook.items(), key=lambda row: row[1], reverse=True)


def print_friction(frictions):
    print()
    if not frictions:
        print("friction: none")
        return
    print("friction")
    cache_hits = [line for line in frictions if "saved_bytes" in line]
    trips = [line for line in frictions if "saved_bytes" not in line]
    for hook, count in trip_rows(trips):
        print(f"{hook:<20}{count:>7} trip{'' if count == 1 else 's'}")
    print(f"cache hits: {len(cache_hits)}, bytes saved: {sum(hit['saved_bytes'] for hit in cache_hits)}")


def guard_rows(denials, trips):
    denials_by_hook = defaultdict(list)
    for denial in denials:
        denials_by_hook[denial.get("hook", "unknown")].append(denial)
    trips_by_hook = dict(trip_rows(trips))
    hooks = sorted(set(denials_by_hook) | set(trips_by_hook), key=lambda hook: -len(denials_by_hook[hook]))
    return [(hook, denials_by_hook[hook], trips_by_hook.get(hook, 0)) for hook in hooks]


def trips_per_100(denial_count, trip_count):
    return round(100 * trip_count / denial_count) if denial_count else None


def most_common_reason(hook_denials):
    return Counter(denial.get("reason", "") for denial in hook_denials).most_common(1)[0][0]


def lint_lines(rows):
    lines = []
    for hook, hook_denials, trip_count in rows:
        rate = trips_per_100(len(hook_denials), trip_count)
        if len(hook_denials) >= LINT_MIN_DENIALS and rate > LINT_TRIPS_PER_100:
            lines.append(f"lint: {hook}: message unclear or rule too strict: {most_common_reason(hook_denials)}")
    return lines or ["lint: none flagged"]


def print_guards(denials, trips):
    print()
    rows = guard_rows(denials, trips)
    if not rows:
        print("guards: none")
        return
    print("guards")
    print(f"{'hook':<20}{'denials':>8}{'trips':>7}{'per100':>8}")
    for hook, hook_denials, trip_count in rows:
        rate = trips_per_100(len(hook_denials), trip_count)
        print(f"{hook:<20}{len(hook_denials):>8}{trip_count:>7}{'-' if rate is None else rate:>8}")
    print("\n".join(lint_lines(rows)))


def test_run_seconds(test_events):
    return [event["seconds"] for event in test_events if isinstance(event.get("seconds"), (int, float))]


def print_tests(test_events):
    print()
    if not test_events:
        print("tests: none")
        return
    results = Counter(event.get("result") for event in test_events)
    seconds = test_run_seconds(test_events)
    median = f"{statistics.median(seconds):.1f}s" if seconds else "-"
    print(
        f"tests: {len(test_events)} calls, {results['pass']} pass, {results['fail']} fail, "
        f"{results['timeout']} timeout, median {median}"
    )


def main():
    path = log_path_from(sys.argv[1:], os.environ)
    if not path:
        sys.exit("usage: tool-telemetry-report LOG (or set CLAUDE_TOOL_TELEMETRY)")
    if os.path.islink(path):
        sys.exit(f"telemetry log {path} is a symlink")
    if not os.path.isfile(path):
        sys.exit(f"no telemetry log at {path}")
    records = read_records(path)
    calls = [record for record in records if record.get("kind", "call") == "call"]
    denials = [record for record in records if record.get("kind") == "deny"]
    print_tool_table(calls)
    print_largest_calls(calls)
    print_denials(denials)
    frictions = [record for record in records if record.get("kind") == "friction"]
    print_friction(frictions)
    print_guards(denials, [line for line in frictions if "saved_bytes" not in line])
    print_tests([record for record in records if record.get("kind") == "test-after-edit"])


main()
