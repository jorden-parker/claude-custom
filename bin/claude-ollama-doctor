#!/bin/bash
set -euo pipefail

repo_dir="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
. "$repo_dir/bin/lib/size-profile.sh"
. "$repo_dir/bin/lib/ollama-server.sh"
. "$repo_dir/bin/lib/doctor-checks.sh"
. "$repo_dir/bin/lib/memory-fit.sh"
. "$repo_dir/bin/lib/nvm-node.sh"
. "$repo_dir/bin/lib/session-logs.sh"
. "$repo_dir/bin/lib/cmux-terminal.sh"
managed_settings="${CLAUDE_OLLAMA_MANAGED_SETTINGS:-/Library/Application Support/ClaudeCode/managed-settings.json}"

check_node() {
  use_nvm_node 2>/dev/null
  if [ -n "$node_choice" ]; then
    report ok "node $node_choice"
  elif command -v node >/dev/null; then
    report ok "node $(command -v node) (no nvm)"
  else
    report warn "node: none on PATH"
  fi
}

hook_names() {
  jq -r '.hooks[]?[]?.hooks[]?.command' "$profile_dir/settings.$size.json" |
    sed -n 's#.*/shared/hooks/##p' | sort -u
}

check_hooks_present() {
  local hook status=0
  while IFS= read -r hook; do
    if [ -x "$repo_dir/shared/hooks/$hook" ]; then
      report ok "hook $hook present"
    else
      report fail "hook $hook missing or not executable in shared/hooks"
      status=1
    fi
  done < <(hook_names)
  return "$status"
}

check_model_allowed() {
  if ! [ -r "$managed_settings" ] || ! jq -e 'has("availableModels")' "$managed_settings" >/dev/null 2>&1; then
    report ok "no managed availableModels restricts $model"
  elif jq -e --arg model "$model" '.availableModels | index($model) != null' "$managed_settings" >/dev/null; then
    report ok "managed availableModels allows $model"
  else
    report warn "managed availableModels lacks $model (ask your admin to add it; Claude Code substitutes a [1m] variant)"
  fi
}

check_fetch_domains() {
  local domains
  domains="$(fetch_domains | paste -sd' ' -)"
  if [ -n "$domains" ]; then
    report ok "web fetch on for: $domains"
  else
    report ok "web fetch off (no domains in $fetch_domains_file)"
  fi
}

check_beacon() {
  local beacon commit head
  beacon="$(launch_beacon_file)"
  if [ ! -f "$beacon" ]; then
    report warn "beacon: none yet (written at the next launch)"
    return 0
  fi
  commit="$(jq -r '.commit // "none"' "$beacon")"
  head="$(git -C "$repo_dir" rev-parse HEAD 2>/dev/null || echo none)"
  if [ "$commit" = "$head" ]; then
    report ok "beacon: $("$repo_dir/bin/sync-fingerprint" --age "$beacon") ago, commit matches"
  else
    report warn "beacon: stale, commit ${commit:0:7} vs HEAD ${head:0:7}: run claude-custom update"
  fi
}

check_browser() {
  if [ "${CLAUDE_OLLAMA_CMUX:-}" = 0 ]; then
    report ok "browser tools off (CLAUDE_OLLAMA_CMUX=0)"
  elif in_cmux_terminal; then
    report ok "browser tools on (cmux terminal; the dev MCP server runs cmux browser repl)"
  else
    report warn "browser tools off: not a cmux terminal (CMUX_SOCKET_PATH unset or cmux missing); page_check will say so"
  fi
}

matched_rule_count() {
  awk 'NF == 2 && $2 > 0 { matched++ } END { print matched + 0 }'
}

check_classifier() {
  local log hits
  if ! log="$(server_log_path)"; then
    report ok "incident classifier not checked (no server log)"
    return 0
  fi
  if hits="$("$(incident_watcher)" --check-rules --log "$log" --model "$model" 2>/dev/null)"; then
    report ok "incident classifier matches the server log (rules: $(printf '%s\n' "$hits" | matched_rule_count))"
  else
    report fail "incident classifier is blind to the server log format (update ollama/incidents/watcher.py rules)"
  fi
}

check_tool_budget() {
  local suggest
  if ! suggest="$(run_tool_budget 2>/dev/null | sed -n 's/^suggest: //p')" || [ -z "$suggest" ]; then
    report warn "tool budget: not checked (bin/tool-budget failed)"
    return 0
  fi
  if [ "$suggest" = "nothing to drop" ]; then
    report ok "tool budget: nothing to drop"
    return 0
  fi
  report warn "tool budget: ${suggest/drop: /drop }: claude-ollama tool-budget"
}

check_guards() {
  local log lint
  log="$(telemetry_log_path)"
  if [ -z "$log" ] || [ ! -f "$log" ]; then
    report ok "guards: not checked (no telemetry log)"
    return 0
  fi
  if ! lint="$("$repo_dir/bin/tool-telemetry-report" "$log" 2>/dev/null | sed -n 's/^lint: //p')" || [ -z "$lint" ]; then
    report warn "guards: not checked (tool-telemetry-report failed on $log)"
    return 0
  fi
  if [ "$lint" = "none flagged" ]; then
    report ok "guards: none flagged"
    return 0
  fi
  while IFS= read -r line; do
    report warn "guards: $line"
  done <<< "$lint"
}

check_rule_cards() {
  local lister="$repo_dir/shared/hooks/rule-cards.py" problems count
  count="$("$lister" --list 2>/dev/null | grep -c . || true)"
  problems="$("$lister" --list 2>&1 >/dev/null | sed 's/^rule-cards: //' | paste -sd ';' - | sed 's/;/; /g' || true)"
  if [ -z "$problems" ]; then
    report ok "rule cards: $count"
  else
    report warn "rule cards: $count ok, $problems"
  fi
}

fit_report() {
  local embedding="" fit_result
  fit_on || return 0
  ! embedding_model_fits || embedding="$embedding_model"
  if ! fit_result="$(run_fit "$(modelfile_num_ctx)" "$embedding" 2>&1)"; then
    report warn "memory fit: $fit_result"
    return 0
  fi
  read_fit "$fit_result"
  if fit_fits "$fit_result"; then
    report ok "memory fit: $(fit_summary)"
  else
    report warn "memory fit: $(fit_summary) ($(fit_shortfall) short)"
  fi
}

report_lease() {
  local state holder_name holder_pid holder_model
  read -r state holder_name _ holder_pid _ holder_model _ <<< "$1"
  case "$state" in
    live) report ok "lease held by $holder_name (pid $holder_pid, model $holder_model)" ;;
    stale) report warn "stale lease $holder_name (pid $holder_pid) removed" ;;
  esac
}

check_leases() {
  local line count=0
  lease_on || return 0
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    count=$((count + 1))
    report_lease "$line"
  done < <("$lease_bin" holders 2>/dev/null)
  [ "$count" -gt 0 ] || report ok "no lease holders"
}

doctor() {
  local status=0
  use_throwaway_settings
  compose_launch_settings
  report ok "jq on PATH"
  check_node
  check_leases
  fit_report
  check_model_present model "$model" "run claude-ollama $size to pull and create it" || status=1
  check_model_present "embedding model" "$embedding_model" "pick 'Set up embedding model' in claude-ollama" || status=1
  check_digests || status=1
  check_context_sizes || status=1
  check_hooks_present || status=1
  check_reachable || status=1
  check_server_env || status=1
  check_classifier || status=1
  check_guards
  check_tool_budget
  check_rule_cards
  check_beacon
  check_fetch_domains
  report ok "profile $profile_file: $(profile_summary)"
  check_gh_login
  check_browser
  check_model_allowed
  exit "$status"
}

require_jq
require_size "${1:-}" claude-ollama-doctor
use_size "$1"
model="$(size_model)"
load_profile
doctor
