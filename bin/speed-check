#!/usr/bin/env python3
import json
import os
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path

REPO_DIR = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_DIR / "shared"))

import model_server

SIZES = ("27b", "35b")
THINK_SUFFIX = "@think"
SPEED_STAGE_COUNT = 5
THINKING_STAGE_COUNT = 3
NAMED_THINKING_STAGE_COUNT = 2
THINKING_ONLY_FLAG = "--thinking-only"
MODEL_FLAG = "--model"
MIN_FREE_KB = 45 * 1024 * 1024
THINKING_PREFIX_TOKENS = "2000"
THINKING_TOOL_TRIALS = 3
SPEED_TOOL_TRIALS = 5
VERDICT_PREFIX_TOKENS = 60000
RERUN = "run claude-ollama speed-check again"


class StageFailure(Exception):
    pass


@dataclass
class SizeVerdict:
    size: str
    warm: dict
    failed_conditions: list

    def line(self):
        if self.failed_conditions:
            return f"{self.size}: needs a look ({', '.join(self.failed_conditions)})"
        return (f"{self.size}: ok (warm 60k: ttft {self.warm['ttft_seconds']:.1f}s, "
                f"decode {self.warm['decode_tokens_per_second']:.1f} tok/s)")


def tool_path(variable, default_name):
    return os.environ.get(variable) or str(REPO_DIR / "bin" / default_name)


def sizes_config():
    return json.loads((REPO_DIR / "ollama" / "sizes.json").read_text())


def model_name(size):
    return sizes_config()[size]["model"]


def weights_dir():
    return Path(os.environ.get("CLAUDE_OLLAMA_WEIGHTS_DIR") or Path.home() / ".claude-ollama" / "weights")


def weights_present(size):
    return (weights_dir() / sizes_config()[size]["gguf"]["file"]).is_file()


def command_output(command):
    return subprocess.run(command, check=False, capture_output=True, text=True)


def announce(number, total, title):
    print(f"[{number}/{total}] {title}", flush=True)


def require(condition, fix):
    if not condition:
        raise StageFailure(fix)


def on_ac_power():
    return "AC Power" in command_output(["pmset", "-g", "batt"]).stdout


def low_power_mode_on():
    for line in command_output(["pmset", "-g"]).stdout.splitlines():
        words = line.split()
        if len(words) == 2 and words[0] == "lowpowermode":
            return words[1] == "1"
    return False


def other_session_running():
    return command_output(["pgrep", "-f", r"ollama/settings\."]).returncode == 0


def free_disk_kb():
    lines = command_output(["df", "-k", str(weights_dir().parent)]).stdout.splitlines()
    return int(lines[-1].split()[3])


def require_server():
    require(model_server.up(), f"llama-server is not answering at {model_server.server_url()}: start it, then {RERUN}")


def preflight():
    require(on_ac_power(), f"plug in the charger, then {RERUN}")
    require(not low_power_mode_on(), f"turn off Low Power Mode in System Settings > Battery, then {RERUN}")
    require(not other_session_running(), f"quit the other claude-ollama session, then {RERUN}")
    require_server()
    missing = [size for size in SIZES if not weights_present(size)]
    if missing:
        require(free_disk_kb() >= MIN_FREE_KB, f"free up disk space (45 GB needed to download {', '.join(missing)}), then {RERUN}")


def prepare_models(sizes):
    for size in sizes:
        result = subprocess.run([tool_path("SPEED_CHECK_LAUNCHER", "claude-ollama"), "prepare", size], check=False)
        require(result.returncode == 0, f"claude-ollama prepare {size} failed: fix the error above, then {RERUN}")


def run_bench(model, thinking, tool_trials, *extra):
    command = [tool_path("SPEED_CHECK_BENCH", "messages-bench"), "--model", model, "--thinking", thinking,
               "--tool-trials", str(tool_trials), *extra, "--json", "--base-url", model_server.server_url()]
    result = subprocess.run(command, check=False, stdout=subprocess.PIPE, text=True)
    require(result.returncode == 0, f"messages-bench on {model} failed: fix the error above, then {RERUN}")
    return json.loads(result.stdout)


def thinking_chars(report):
    return sum(run.get("thinking_chars", 0) for run in report["runs"])


def all_tool_calls_parsed(report):
    calls = report["tool_calls"]
    return calls["parsed"] == calls["trials"]


def flag_value(argv, flag):
    if flag not in argv:
        return None
    position = argv.index(flag) + 1
    return argv[position] if position < len(argv) else None


def thinking_targets(argv):
    if MODEL_FLAG not in argv:
        return {size: (f"{model_name(size)}{THINK_SUFFIX}", model_name(size)) for size in SIZES}
    named = flag_value(argv, MODEL_FLAG)
    require(named is not None, "give --model a preset id")
    return {named: (None, named)}


def thinking_bench(model):
    return run_bench(model, "claude-code", THINKING_TOOL_TRIALS, "--prefix-tokens", THINKING_PREFIX_TOKENS)


def check_thinking(targets):
    results = {}
    for label, (think_model, plain_model) in targets.items():
        think_chars = thinking_chars(thinking_bench(think_model)) if think_model else None
        plain = thinking_bench(plain_model)
        results[label] = {
            "think_thinking_chars": think_chars,
            "plain_thinking_chars": thinking_chars(plain),
            "plain_tool_calls": plain["tool_calls"],
            "passed": (think_chars is None or think_chars > 0) and thinking_chars(plain) == 0 and all_tool_calls_parsed(plain),
        }
    return results


def bench_sizes():
    return {size: run_bench(model_name(size), "disabled", SPEED_TOOL_TRIALS) for size in SIZES}


def probe_caches():
    reports = {}
    for size in SIZES:
        model = model_name(size)
        result = subprocess.run([tool_path("SPEED_CHECK_PROBE", "ollama-cache-probe"), model, "--json"],
                                check=False, stdout=subprocess.PIPE, text=True)
        require(result.returncode == 0, f"ollama-cache-probe {model} failed: fix the error above, then {RERUN}")
        reports[size] = json.loads(result.stdout)
    return reports


def warm_run(report):
    for run in report["runs"]:
        if run["prefix_tokens"] == VERDICT_PREFIX_TOKENS and run["scenario"] == "warm":
            return run
    raise StageFailure(f"messages-bench gave no warm run at {VERDICT_PREFIX_TOKENS} tokens; tell Claude")


def size_verdict(size, benches, probes):
    failed = []
    if not all_tool_calls_parsed(benches[size]):
        failed.append("tool calls missed")
    if not probes[size].get("cache_reused"):
        failed.append("prompt cache not reused")
    return SizeVerdict(size, warm_run(benches[size]), failed)


def thinking_passed(thinking):
    return all(result["passed"] for result in thinking.values())


def think_count(chars):
    return "-" if chars is None else str(chars)


def thinking_line(thinking):
    status = "PASS" if thinking_passed(thinking) else "FAIL"
    counts = ", ".join(
        f"{label} think {think_count(result['think_thinking_chars'])} -> {result['plain_thinking_chars']}"
        for label, result in thinking.items()
    )
    return f"Thinking check: {status} ({counts})"


def next_line(thinking, verdicts):
    if not thinking_passed(thinking):
        return "Next: paste the block below into Claude; thinking is still wrong."
    if any(verdict.failed_conditions for verdict in verdicts):
        return "Next: paste the block below into Claude; a size needs a look."
    return "Next: nothing to change; paste the block below into Claude to record the numbers."


def save_report(report):
    folder = Path.home() / "bench-results"
    folder.mkdir(parents=True, exist_ok=True)
    path = folder / f"speed-check-{time.strftime('%Y%m%d-%H%M')}.json"
    path.write_text(json.dumps(report, indent=2) + "\n")
    return path


def print_verdict(lines, next_action, report_path):
    print()
    print("\n".join(lines))
    print(next_action)
    print()
    print("Paste this block into Claude:")
    print("```")
    print("speed-check results")
    print("\n".join(lines))
    print(f"full report: {report_path}")
    print("```")


def run_thinking_only(argv):
    targets = thinking_targets(argv)
    named = MODEL_FLAG in argv
    total = NAMED_THINKING_STAGE_COUNT if named else THINKING_STAGE_COUNT
    announce(1, total, "Preflight: llama-server")
    require_server()
    if not named:
        announce(2, total, "Prepare models: download the sizes")
        prepare_models(SIZES)
    announce(total, total, "Thinking check: @think thinks, the plain preset does not")
    thinking = check_thinking(targets)
    print()
    print(thinking_line(thinking))
    return 0 if thinking_passed(thinking) else 1


def run_speed_check():
    announce(1, SPEED_STAGE_COUNT, "Preflight: power, other sessions, llama-server, disk")
    preflight()
    announce(2, SPEED_STAGE_COUNT, "Prepare models: download every size")
    prepare_models(SIZES)
    announce(3, SPEED_STAGE_COUNT, "Thinking check: @think thinks, the plain preset does not")
    thinking = check_thinking(thinking_targets([]))
    announce(4, SPEED_STAGE_COUNT, "Speed bench: each size on llama-server")
    benches = bench_sizes()
    announce(5, SPEED_STAGE_COUNT, "Cache probe")
    probes = probe_caches()
    verdicts = [size_verdict(size, benches, probes) for size in SIZES]
    lines = [thinking_line(thinking), *(verdict.line() for verdict in verdicts)]
    next_action = next_line(thinking, verdicts)
    report_path = save_report({"verdict": lines, "next": next_action, "thinking": thinking,
                               "benches": benches, "probes": probes})
    print_verdict(lines, next_action, report_path)
    return 0


def main(argv):
    try:
        return run_thinking_only(argv) if THINKING_ONLY_FLAG in argv else run_speed_check()
    except StageFailure as failure:
        print(f"speed-check stopped: {failure}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
