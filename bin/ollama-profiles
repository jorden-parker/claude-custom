#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
data_dir="${CLAUDE_CUSTOM_REPO:-$repo_dir}"
profile_dir="${OLLAMA_PROFILE_DIR:-$data_dir/ollama}"
shared_dir="$data_dir/shared/settings"
personal_dir="$data_dir/personal"
sizes_file="$profile_dir/sizes.json"
settings_template="$profile_dir/profile-template.json"
modelfile_template="$profile_dir/profile-template.Modelfile"
extra_hooks_file="$profile_dir/hooks.extra.json"
headroom_file="$profile_dir/headroom.json"
personal_template="$personal_dir/settings.tokens.template.json"
personal_settings="$personal_dir/settings.tokens.json"
env_catalogue="$data_dir/shared/profile-env.json"
console_env_catalogue="$data_dir/web/console/src/lib/profile-env.generated.json"
env_docs="$data_dir/docs/ollama.md"
env_table_start="<!-- profile-env:start -->"
env_table_end="<!-- profile-env:end -->"
incident_causes="$data_dir/ollama/incidents/causes.json"
console_causes="$data_dir/web/console/src/lib/incident-causes.generated.json"
console_causes_name="${console_causes##*/}"
server_ini="$profile_dir/server.ini"
embedding_file="$profile_dir/embedding.json"
preset_keys_file="$profile_dir/preset-keys.json"
models_ini="$profile_dir/models.ini"
ladder_dir="$data_dir/ollama/incidents"
profile_overlay="$data_dir/shared/profile-overlay"
weights_placeholder="@WEIGHTS@"

sizes() {
  jq -r 'keys[]' "$sizes_file"
}

field() {
  jq -r --arg size "$1" --arg name "$2" '.[$size][$name]' "$sizes_file"
}

is_listed() {
  jq -e --arg size "$1" 'has($size)' "$sizes_file" >/dev/null
}

size_of_settings() {
  local name="${1##*/settings.}"
  echo "${name%.json}"
}

format_json_files() {
  local prettier="$repo_dir/node_modules/.bin/prettier"
  [ -x "$prettier" ] || { echo "ollama-profiles: run pnpm install first (prettier formats the rendered JSON)" >&2; return 1; }
  "$prettier" --config "$repo_dir/.prettierrc" --parser json --log-level warn --write "$@"
}

splice_fragments() {
  jq --argjson extra "$1" --slurpfile shared "$shared_dir/hooks.json" --slurpfile readDeny "$shared_dir/read-deny.json" '
    (if .hooks == "{{HOOKS}}" then .hooks = (reduce ($extra | keys_unsorted[]) as $event ($shared[0]; .[$event] = ((.[$event] // []) + $extra[$event]))) else . end)
    | .permissions.deny |= map(if . == "{{READ_DENY}}" then $readDeny[0][] else . end)
  '
}

headroom() {
  jq -r --arg name "$1" '.[$name]' "$headroom_file"
}

output_tokens() {
  jq -r --arg size "$1" --slurpfile headroom "$headroom_file" '.[$size].output_tokens // $headroom[0].output_tokens' "$sizes_file"
}

context_tokens() {
  local context
  context="$(field "$1" context)"
  if [ "$context" -le "$(output_tokens "$1")" ]; then
    echo "ollama-profiles: size $1 has context $context, which leaves no room after its output_tokens" >&2
    return 1
  fi
  echo "$context"
}

render_settings() {
  local context_tokens
  context_tokens="$(context_tokens "$1")" || return 1
  jq --arg model "$(field "$1" model)" --arg context_tokens "$context_tokens" --arg output_tokens "$(output_tokens "$1")" \
    'walk(if type == "string" then gsub("\\{\\{MODEL\\}\\}"; $model) | gsub("\\{\\{CONTEXT_TOKENS\\}\\}"; $context_tokens) | gsub("\\{\\{OUTPUT_TOKENS\\}\\}"; $output_tokens) else . end)' \
    "$settings_template" | splice_fragments "$(cat "$extra_hooks_file")"
}

render_personal() {
  splice_fragments '{}' < "$personal_template"
}

gguf_file() {
  jq -er --arg size "$1" '.[$size].gguf.file // empty' "$sizes_file" ||
    { echo "ollama-profiles: size $1 has no gguf file in sizes.json" >&2; return 1; }
}

render_parameters() {
  jq -r --arg size "$1" '.[$size].parameters // {} | to_entries | sort_by(.key)[] | "PARAMETER \(.key) \(.value)"' "$sizes_file"
}

render_modelfile() {
  local file
  file="$(gguf_file "$1")" || return 1
  sed -e "s|{{BASE}}|./weights/$file|" -e "s|{{CONTEXT}}|$(field "$1" context)|" -e "s|{{OUTPUT_TOKENS}}|$(output_tokens "$1")|" "$modelfile_template"
  render_parameters "$1"
}

lower_context() {
  python3 -I -c 'import sys; sys.path.insert(0, sys.argv[1]); from ladder import lower_context; print(lower_context(int(sys.argv[2]), sys.argv[3]))' \
    "$ladder_dir" "$1" "$sizes_file"
}

preset_lines() {
  jq -r --arg size "$1" --argjson context "$2" --arg reasoning "$3" --argjson output "$(output_tokens "$1")" \
    --arg weights "$weights_placeholder" --slurpfile keys "$preset_keys_file" '
    .[$size] as $spec
    | "model = \($weights)/\($spec.gguf.file)",
      "ctx-size = \($context)",
      "n-predict = \($output)",
      (($spec.parameters // {}) | to_entries
        | map({key: ($keys[0][.key] // error("ollama-profiles: size \($size) has parameter \(.key), which has no preset key in preset-keys.json")), value})
        | sort_by(.key)[] | "\(.key) = \(.value)"),
      "reasoning = \($reasoning)"' "$sizes_file"
}

render_preset() {
  printf '[%s]\n' "$1"
  shift
  preset_lines "$@" || return 1
  echo
}

render_size_presets() {
  local model context lower
  gguf_file "$1" >/dev/null || return 1
  model="$(field "$1" model)"
  context="$(field "$1" context)"
  lower="$(lower_context "$context")" || return 1
  render_preset "$model" "$1" "$context" off || return 1
  render_preset "$model@think" "$1" "$context" on || return 1
  render_preset "$model@$lower" "$1" "$lower" off
}

render_embedding_preset() {
  jq -r --arg weights "$weights_placeholder" '
    "[\(.model | gsub(":"; "-"))]",
    "alias = \(.model)",
    "model = \($weights)/\(.gguf.file)",
    "ctx-size = \(.context)",
    "embeddings = true",
    "pooling = last"' "$embedding_file"
}

render_models_ini() {
  local size
  cat "$server_ini"
  echo
  for size in $(sizes); do
    render_size_presets "$size" || return 1
  done
  render_embedding_preset
}

env_table() {
  jq -r '
    def meaning:
      if .kind == "integer" then "\(.label), \(.min) to \(.max)"
      elif .kind == "choice" then "\(.label) (\(.choices | map("`\(.value)`") | join(", ")))"
      else .label end;
    def padded($width): if $width > length then . + (" " * ($width - length)) else . end;
    def dashes($width): reduce range($width) as $dash (""; . + "-");
    (map(["`\(.key)`", .default, meaning])) as $rows
    | (["Key", "Default", "Meaning"]) as $header
    | ([range(3) as $column | ([$header[$column]] + ($rows | map(.[$column])) | map(length) | max)]) as $widths
    | def row: [range(3) as $column | .[$column] | padded($widths[$column])] | "| \(join(" | ")) |";
      ($header | row),
      ([range(3) as $column | dashes($widths[$column])] | "| \(join(" | ")) |"),
      ($rows[] | row)
  ' "$env_catalogue"
}

render_env_docs() {
  if ! grep -qxF "$env_table_start" "$env_docs" || ! grep -qxF "$env_table_end" "$env_docs"; then
    echo "ollama-profiles: $env_docs lacks the $env_table_start and $env_table_end lines" >&2
    return 1
  fi
  env_table="$(env_table)" awk -v start="$env_table_start" -v end="$env_table_end" '
    $0 == start { print; print ""; print ENVIRON["env_table"]; print ""; skipping = 1; next }
    $0 == end { skipping = 0 }
    !skipping { print }
  ' "$env_docs"
}

render_all() {
  local size
  for size in $(sizes); do
    render_settings "$size" > "$1/settings.$size.json" || return 1
    render_modelfile "$size" > "$1/Modelfile.$size" || return 1
  done
  render_models_ini > "$1/models.ini" || return 1
  render_personal > "$1/settings.tokens.json"
  cp "$env_catalogue" "$1/profile-env.generated.json"
  render_env_docs > "$1/ollama.md"
  jq . "$incident_causes" > "$1/$console_causes_name"
}

same_content() {
  case "$1" in
    *"$console_causes_name") cmp -s <(jq -c . "$1") <(jq -c . "$2") ;;
    *.json) cmp -s <(jq -S . "$1") <(jq -S . "$2") ;;
    *) cmp -s "$1" "$2" ;;
  esac
}

rendered_matches() {
  if [ ! -f "$2" ]; then
    echo "stale: $2" >&2
    return 1
  fi
  same_content "$1" "$2" || { echo "stale: $2" >&2; return 1; }
}

check_size() {
  local size="$2" status=0
  rendered_matches "$1/settings.$size.json" "$profile_dir/settings.$size.json" || status=1
  rendered_matches "$1/Modelfile.$size" "$profile_dir/Modelfile.$size" || status=1
  return "$status"
}

check_unlisted() {
  local file status=0
  for file in "$profile_dir"/settings.*.json; do
    is_listed "$(size_of_settings "$file")" || { echo "stale: $file is not in sizes.json" >&2; status=1; }
  done
  return "$status"
}

check_profiles() {
  local size status=0
  for size in $(sizes); do
    check_size "$1" "$size" || status=1
  done
  check_unlisted || status=1
  rendered_matches "$1/models.ini" "$models_ini" || status=1
  rendered_matches "$1/settings.tokens.json" "$personal_settings" || status=1
  rendered_matches "$1/profile-env.generated.json" "$console_env_catalogue" || status=1
  rendered_matches "$1/ollama.md" "$env_docs" || status=1
  rendered_matches "$1/$console_causes_name" "$console_causes" || status=1
  return "$status"
}

write_size() {
  cp "$1/settings.$2.json" "$profile_dir/settings.$2.json"
  cp "$1/Modelfile.$2" "$profile_dir/Modelfile.$2"
}

remove_unlisted() {
  local file size
  for file in "$profile_dir"/settings.*.json; do
    size="$(size_of_settings "$file")"
    is_listed "$size" || rm -f "$file" "$profile_dir/Modelfile.$size"
  done
}

write_profiles() {
  local size
  format_json_files "$1"/*.json || return 1
  for size in $(sizes); do
    write_size "$1" "$size"
  done
  remove_unlisted
  cp "$1/models.ini" "$models_ini"
  cp "$1/settings.tokens.json" "$personal_settings"
  cp "$1/profile-env.generated.json" "$console_env_catalogue"
  cp "$1/ollama.md" "$env_docs"
  mkdir -p "${console_causes%/*}"
  cp "$1/$console_causes_name" "$console_causes"
}

with_rendered() {
  local rendered status=0
  rendered="$(mktemp -d)"
  render_all "$rendered" && "$1" "$rendered" || status=$?
  rm -rf "$rendered"
  return "$status"
}

usage() {
  echo "usage: ollama-profiles [--check | --user-presets [--out FILE] [--profiles-dir DIR]]" >&2
  exit 2
}

section_lines() {
  awk -v id="[$2]" '$0 == id { on = 1; next } /^\[/ { on = 0 } on && NF' "$1"
}

has_section() {
  grep -qxF "[$2]" "$1"
}

add_context_preset() {
  local presets="$1" model="$2" context="$3" lines
  has_section "$presets" "$model@$context" && return 0
  lines="$(section_lines "$presets" "$model" | sed "s/^ctx-size = .*/ctx-size = $context/")"
  printf '[%s]\n%s\n\n' "$model@$context" "$lines" >> "$presets"
}

changes_sampling() {
  jq -e 'has("output_tokens") or ((.parameters // {}) | length > 0)' "$1" >/dev/null
}

add_profile_presets() {
  local presets="$1" size="$2" profile="$3" model context lower lines
  [ -e "$profile" ] || [ -L "$profile" ] || return 0
  "$profile_overlay" check "$profile" || return 1
  model="$(field "$size" model)"
  context="$(jq -r '.context // empty' "$profile")"
  if [ -n "$context" ]; then
    lower="$(lower_context "$context")" || return 1
    add_context_preset "$presets" "$model" "$context"
    add_context_preset "$presets" "$model" "$lower"
  fi
  changes_sampling "$profile" || return 0
  lines="$(section_lines "$presets" "$model" | "$profile_overlay" preset-parameters "$profile")" || return 1
  printf '[%s]\n%s\n\n' "$model@profile" "$lines" >> "$presets"
}

render_user_presets() {
  local presets="$1" profiles="$2" weights="$3" content size
  content="$(cat "$models_ini")" || return 1
  printf '%s\n' "${content//$weights_placeholder/$weights}" > "$presets"
  for size in $(sizes); do
    add_profile_presets "$presets" "$size" "$profiles/ollama-$size.json" || return 1
  done
}

write_user_presets() {
  local out="$HOME/.claude-ollama/presets/models.ini" profiles="${XDG_CONFIG_HOME:-$HOME/.config}/claude-custom/profiles" rendered status=0
  while [ $# -gt 0 ]; do
    [ $# -ge 2 ] || usage
    case "$1" in
      --out) out="$2" ;;
      --profiles-dir) profiles="$2" ;;
      *) usage ;;
    esac
    shift 2
  done
  rendered="$(mktemp)"
  if render_user_presets "$rendered" "$profiles" "${CLAUDE_OLLAMA_WEIGHTS_DIR:-$HOME/.claude-ollama/weights}"; then
    install_user_presets "$rendered" "$out" || status=1
  else
    status=1
  fi
  rm -f "$rendered"
  return "$status"
}

install_user_presets() {
  mkdir -p "${2%/*}" && chmod 700 "${2%/*}" || return 1
  if [ -f "$2" ] && cmp -s "$1" "$2"; then
    echo unchanged
    return 0
  fi
  (umask 077 && cp "$1" "$2.$$.tmp") && chmod 600 "$2.$$.tmp" && mv -f "$2.$$.tmp" "$2" || return 1
  echo changed
}

main() {
  case "${1:-}" in
    "") with_rendered write_profiles ;;
    --check) with_rendered check_profiles ;;
    --user-presets) shift; write_user_presets "$@" ;;
    *) usage ;;
  esac
}

main "$@"
