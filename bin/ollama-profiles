#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
data_dir="${CLAUDE_CUSTOM_REPO:-$repo_dir}"
profile_dir="${OLLAMA_PROFILE_DIR:-$data_dir/ollama}"
shared_dir="$data_dir/shared/settings"
personal_dir="$data_dir/personal"
sizes_file="$profile_dir/sizes.json"
settings_template="$profile_dir/profile-template.json"
modelfile_template="$profile_dir/profile-template.Modelfile"
extra_hooks_file="$profile_dir/hooks.extra.json"
headroom_file="$profile_dir/headroom.json"
personal_template="$personal_dir/settings.tokens.template.json"
personal_settings="$personal_dir/settings.tokens.json"
env_catalogue="$data_dir/shared/profile-env.json"
console_env_catalogue="$data_dir/web/console/src/lib/profile-env.generated.json"
env_docs="$data_dir/docs/ollama.md"
env_table_start="<!-- profile-env:start -->"
env_table_end="<!-- profile-env:end -->"
incident_causes="$data_dir/ollama/incidents/causes.json"
console_causes="$data_dir/web/console/src/lib/incident-causes.generated.json"
console_causes_name="${console_causes##*/}"

sizes() {
  jq -r 'keys[]' "$sizes_file"
}

field() {
  jq -r --arg size "$1" --arg name "$2" '.[$size][$name]' "$sizes_file"
}

is_listed() {
  jq -e --arg size "$1" 'has($size)' "$sizes_file" >/dev/null
}

size_of_settings() {
  local name="${1##*/settings.}"
  echo "${name%.json}"
}

format_json_files() {
  local prettier="$repo_dir/node_modules/.bin/prettier"
  [ -x "$prettier" ] || { echo "ollama-profiles: run pnpm install first (prettier formats the rendered JSON)" >&2; return 1; }
  "$prettier" --config "$repo_dir/.prettierrc" --parser json --log-level warn --write "$@"
}

splice_fragments() {
  jq --argjson extra "$1" --slurpfile shared "$shared_dir/hooks.json" --slurpfile readDeny "$shared_dir/read-deny.json" '
    (if .hooks == "{{HOOKS}}" then .hooks = (reduce ($extra | keys_unsorted[]) as $event ($shared[0]; .[$event] = ((.[$event] // []) + $extra[$event]))) else . end)
    | .permissions.deny |= map(if . == "{{READ_DENY}}" then $readDeny[0][] else . end)
  '
}

headroom() {
  jq -r --arg name "$1" '.[$name]' "$headroom_file"
}

output_tokens() {
  jq -r --arg size "$1" --slurpfile headroom "$headroom_file" '.[$size].output_tokens // $headroom[0].output_tokens' "$sizes_file"
}

context_tokens() {
  local context
  context="$(field "$1" context)"
  if [ "$context" -le "$(output_tokens "$1")" ]; then
    echo "ollama-profiles: size $1 has context $context, which leaves no room after its output_tokens" >&2
    return 1
  fi
  echo "$context"
}

render_settings() {
  local context_tokens
  context_tokens="$(context_tokens "$1")" || return 1
  jq --arg model "$(field "$1" model)" --arg context_tokens "$context_tokens" --arg output_tokens "$(output_tokens "$1")" \
    'walk(if type == "string" then gsub("\\{\\{MODEL\\}\\}"; $model) | gsub("\\{\\{CONTEXT_TOKENS\\}\\}"; $context_tokens) | gsub("\\{\\{OUTPUT_TOKENS\\}\\}"; $output_tokens) else . end)' \
    "$settings_template" | splice_fragments "$(cat "$extra_hooks_file")"
}

render_personal() {
  splice_fragments '{}' < "$personal_template"
}

render_renderer() {
  jq -r --arg size "$1" '.[$size] | select(.renderer) | "RENDERER \(.renderer)\nPARSER \(.parser // .renderer)"' "$sizes_file"
}

render_parameters() {
  jq -r --arg size "$1" '.[$size].parameters // {} | to_entries | sort_by(.key)[] | "PARAMETER \(.key) \(.value)"' "$sizes_file"
}

render_modelfile() {
  sed -e "s|{{BASE}}|$(field "$1" base)|" -e "s|{{CONTEXT}}|$(field "$1" context)|" -e "s|{{OUTPUT_TOKENS}}|$(output_tokens "$1")|" "$modelfile_template"
  render_renderer "$1"
  render_parameters "$1"
}

env_table() {
  jq -r '
    def meaning:
      if .kind == "integer" then "\(.label), \(.min) to \(.max)"
      elif .kind == "choice" then "\(.label) (\(.choices | map("`\(.value)`") | join(", ")))"
      else .label end;
    def padded($width): if $width > length then . + (" " * ($width - length)) else . end;
    def dashes($width): reduce range($width) as $dash (""; . + "-");
    (map(["`\(.key)`", .default, meaning])) as $rows
    | (["Key", "Default", "Meaning"]) as $header
    | ([range(3) as $column | ([$header[$column]] + ($rows | map(.[$column])) | map(length) | max)]) as $widths
    | def row: [range(3) as $column | .[$column] | padded($widths[$column])] | "| \(join(" | ")) |";
      ($header | row),
      ([range(3) as $column | dashes($widths[$column])] | "| \(join(" | ")) |"),
      ($rows[] | row)
  ' "$env_catalogue"
}

render_env_docs() {
  if ! grep -qxF "$env_table_start" "$env_docs" || ! grep -qxF "$env_table_end" "$env_docs"; then
    echo "ollama-profiles: $env_docs lacks the $env_table_start and $env_table_end lines" >&2
    return 1
  fi
  env_table="$(env_table)" awk -v start="$env_table_start" -v end="$env_table_end" '
    $0 == start { print; print ""; print ENVIRON["env_table"]; print ""; skipping = 1; next }
    $0 == end { skipping = 0 }
    !skipping { print }
  ' "$env_docs"
}

render_all() {
  local size
  for size in $(sizes); do
    render_settings "$size" > "$1/settings.$size.json" || return 1
    render_modelfile "$size" > "$1/Modelfile.$size"
  done
  render_personal > "$1/settings.tokens.json"
  cp "$env_catalogue" "$1/profile-env.generated.json"
  render_env_docs > "$1/ollama.md"
  jq . "$incident_causes" > "$1/$console_causes_name"
}

same_content() {
  case "$1" in
    *"$console_causes_name") cmp -s <(jq -c . "$1") <(jq -c . "$2") ;;
    *.json) cmp -s <(jq -S . "$1") <(jq -S . "$2") ;;
    *) cmp -s "$1" "$2" ;;
  esac
}

rendered_matches() {
  if [ ! -f "$2" ]; then
    echo "stale: $2" >&2
    return 1
  fi
  same_content "$1" "$2" || { echo "stale: $2" >&2; return 1; }
}

check_size() {
  local size="$2" status=0
  rendered_matches "$1/settings.$size.json" "$profile_dir/settings.$size.json" || status=1
  rendered_matches "$1/Modelfile.$size" "$profile_dir/Modelfile.$size" || status=1
  return "$status"
}

check_unlisted() {
  local file status=0
  for file in "$profile_dir"/settings.*.json; do
    is_listed "$(size_of_settings "$file")" || { echo "stale: $file is not in sizes.json" >&2; status=1; }
  done
  return "$status"
}

check_profiles() {
  local size status=0
  for size in $(sizes); do
    check_size "$1" "$size" || status=1
  done
  check_unlisted || status=1
  rendered_matches "$1/settings.tokens.json" "$personal_settings" || status=1
  rendered_matches "$1/profile-env.generated.json" "$console_env_catalogue" || status=1
  rendered_matches "$1/ollama.md" "$env_docs" || status=1
  rendered_matches "$1/$console_causes_name" "$console_causes" || status=1
  return "$status"
}

write_size() {
  cp "$1/settings.$2.json" "$profile_dir/settings.$2.json"
  cp "$1/Modelfile.$2" "$profile_dir/Modelfile.$2"
}

remove_unlisted() {
  local file size
  for file in "$profile_dir"/settings.*.json; do
    size="$(size_of_settings "$file")"
    is_listed "$size" || rm -f "$file" "$profile_dir/Modelfile.$size"
  done
}

write_profiles() {
  local size
  format_json_files "$1"/*.json || return 1
  for size in $(sizes); do
    write_size "$1" "$size"
  done
  remove_unlisted
  cp "$1/settings.tokens.json" "$personal_settings"
  cp "$1/profile-env.generated.json" "$console_env_catalogue"
  cp "$1/ollama.md" "$env_docs"
  mkdir -p "${console_causes%/*}"
  cp "$1/$console_causes_name" "$console_causes"
}

with_rendered() {
  local rendered status=0
  rendered="$(mktemp -d)"
  render_all "$rendered" && "$1" "$rendered" || status=$?
  rm -rf "$rendered"
  return "$status"
}

main() {
  case "${1:-}" in
    "") with_rendered write_profiles ;;
    --check) with_rendered check_profiles ;;
    *) echo "usage: ollama-profiles [--check]" >&2; exit 2 ;;
  esac
}

main "$@"
