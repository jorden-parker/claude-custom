#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
data_dir="${CLAUDE_CUSTOM_REPO:-$repo_dir}"
profile_dir="${OLLAMA_PROFILE_DIR:-$data_dir/ollama}"
shared_dir="$data_dir/shared/settings"
personal_dir="$data_dir/personal"
sizes_file="$profile_dir/sizes.json"
settings_template="$profile_dir/profile-template.json"
modelfile_template="$profile_dir/profile-template.Modelfile"
extra_hooks_file="$profile_dir/hooks.extra.json"
personal_template="$personal_dir/settings.tokens.template.json"
personal_settings="$personal_dir/settings.tokens.json"

sizes() {
  jq -r 'keys[]' "$sizes_file"
}

field() {
  jq -r --arg size "$1" --arg name "$2" '.[$size][$name]' "$sizes_file"
}

is_listed() {
  jq -e --arg size "$1" 'has($size)' "$sizes_file" >/dev/null
}

size_of_settings() {
  local name="${1##*/settings.}"
  echo "${name%.json}"
}

format_json() {
  (cd "$repo_dir" && npx --no prettier -- --parser json)
}

splice_fragments() {
  jq --argjson extra "$1" --slurpfile shared "$shared_dir/hooks.json" --slurpfile readDeny "$shared_dir/read-deny.json" '
    (if .hooks == "{{HOOKS}}" then .hooks = (reduce ($extra | keys_unsorted[]) as $event ($shared[0]; .[$event] = ((.[$event] // []) + $extra[$event]))) else . end)
    | .permissions.deny |= map(if . == "{{READ_DENY}}" then $readDeny[0][] else . end)
  '
}

render_settings() {
  jq --arg model "$(field "$1" model)" --arg context "$(field "$1" context)" \
    'walk(if type == "string" then gsub("\\{\\{MODEL\\}\\}"; $model) | gsub("\\{\\{CONTEXT\\}\\}"; $context) else . end)' \
    "$settings_template" | splice_fragments "$(cat "$extra_hooks_file")" | format_json
}

render_personal() {
  splice_fragments '{}' < "$personal_template" | format_json
}

render_renderer() {
  jq -r --arg size "$1" '.[$size].renderer // empty | "RENDERER \(.)\nPARSER \(.)"' "$sizes_file"
}

render_modelfile() {
  sed -e "s|{{BASE}}|$(field "$1" base)|" -e "s|{{CONTEXT}}|$(field "$1" context)|" "$modelfile_template"
  render_renderer "$1"
}

rendered_matches() {
  [ -f "$2" ] && [ "$(cat "$2")" = "$1" ]
}

check_size() {
  local size="$1" status=0
  rendered_matches "$(render_settings "$size")" "$profile_dir/settings.$size.json" || { echo "stale: $profile_dir/settings.$size.json" >&2; status=1; }
  rendered_matches "$(render_modelfile "$size")" "$profile_dir/Modelfile.$size" || { echo "stale: $profile_dir/Modelfile.$size" >&2; status=1; }
  return "$status"
}

check_unlisted() {
  local file status=0
  for file in "$profile_dir"/settings.*.json; do
    is_listed "$(size_of_settings "$file")" || { echo "stale: $file is not in sizes.json" >&2; status=1; }
  done
  return "$status"
}

check_personal() {
  rendered_matches "$(render_personal)" "$personal_settings" || { echo "stale: $personal_settings" >&2; return 1; }
}

check_profiles() {
  local size status=0
  for size in $(sizes); do
    check_size "$size" || status=1
  done
  check_unlisted || status=1
  check_personal || status=1
  return "$status"
}

write_size() {
  render_settings "$1" > "$profile_dir/settings.$1.json"
  render_modelfile "$1" > "$profile_dir/Modelfile.$1"
}

remove_unlisted() {
  local file size
  for file in "$profile_dir"/settings.*.json; do
    size="$(size_of_settings "$file")"
    is_listed "$size" || rm -f "$file" "$profile_dir/Modelfile.$size"
  done
}

write_profiles() {
  local size
  for size in $(sizes); do
    write_size "$size"
  done
  remove_unlisted
  render_personal > "$personal_settings"
}

main() {
  case "${1:-}" in
    "") write_profiles ;;
    --check) check_profiles ;;
    *) echo "usage: ollama-profiles [--check]" >&2; exit 2 ;;
  esac
}

main "$@"
