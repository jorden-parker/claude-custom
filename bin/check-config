#!/usr/bin/env bash
set -u
repo="$(cd "$(dirname "$0")/.." && pwd -P)"
failures=0
fail() {
  echo "FAIL: $1"
  failures=$((failures + 1))
}

check_eq() {
  if [ "$2" != "$3" ]; then
    fail "$1: expected [$2] got [$3]"
  fi
}

check_that() {
  local name="$1"
  shift
  "$@" || fail "$name"
}

check_not() {
  local name="$1"
  shift
  if "$@"; then
    fail "$name"
  fi
}

for settings in "$repo"/ollama/settings.*.json; do
  check_eq "hooks in ${settings##*/} include every personal overlay hook" "[]" \
    "$(jq -c -n --slurpfile personal "$repo/personal/settings.tokens.json" --slurpfile profile "$settings" \
      '[$personal[0].hooks | to_entries[] | .key as $event | .value[] | {event: $event, matcher: (.matcher // ""), command: .hooks[].command}]
       - [$profile[0].hooks | to_entries[] | .key as $event | .value[] | {event: $event, matcher: (.matcher // ""), command: .hooks[].command}]')"
done

for settings in "$repo"/ollama/settings.*.json; do
  check_that "${settings##*/} denies Workflow" \
    test "$(jq -r '.permissions.deny | index("Workflow") != null' "$settings")" = true
  check_that "${settings##*/} denies Agent, since a subagent would run on the main model" \
    test "$(jq -r '.permissions.deny | index("Agent") != null' "$settings")" = true
  check_eq "${settings##*/} lets the model use your skills but not the bundled ones" "true true" \
    "$(jq -r '[(.permissions.deny | index("Skill") == null), .disableBundledSkills] | map(tostring) | join(" ")' "$settings")"
  check_eq "${settings##*/} sends the Haiku slot to the main model" \
    "$(jq -r .model "$settings")" "$(jq -r .env.ANTHROPIC_DEFAULT_HAIKU_MODEL "$settings")"
  check_eq "${settings##*/} sets no subagent model" "null null" \
    "$(jq -r '[.env.CLAUDE_CODE_SUBAGENT_MODEL, .env.CLAUDE_CODE_SUBAGENT_MODEL_FORCE] | map(tostring) | join(" ")' "$settings")"
  check_eq "${settings##*/} maps no Claude ID to a local model, so the banner names the main model" null \
    "$(jq -c .modelOverrides "$settings")"
  check_eq "${settings##*/} lists only its main model in availableModels" \
    "$(jq -c '[.model]' "$settings")" "$(jq -c '.availableModels' "$settings")"
  check_eq "${settings##*/} waits the full 30 minutes for a silent Ollama stream" "1800000 1800000" \
    "$(jq -r '[.env.CLAUDE_STREAM_IDLE_TIMEOUT_MS, .env.API_TIMEOUT_MS] | join(" ")' "$settings")"
  check_eq "${settings##*/} keeps the prompt prefix stable so Ollama reuses its cache" "0 off" \
    "$(jq -r '[.env.CLAUDE_CODE_ATTRIBUTION_HEADER, .env.CLAUDE_CODE_TOTAL_TOKENS_REMINDER] | join(" ")' "$settings")"
  check_eq "${settings##*/} leaves Bash to the session sandbox, which a second sandbox cannot nest in" false \
    "$(jq -r .sandbox.enabled "$settings")"
  check_eq "${settings##*/} starts in default mode with auto mode off, since its classifier would call Ollama for a Claude model" "default disable" \
    "$(jq -r '[.permissions.defaultMode, .permissions.disableAutoMode] | join(" ")' "$settings")"
  check_eq "${settings##*/} asks before every Bash command, commit and push" '["Bash","Bash(git commit *)","Bash(git push *)"]' \
    "$(jq -c .permissions.ask "$settings")"
done

sandbox_policy="$repo/ollama/sandbox.json"
check_eq "the session sandbox reaches only GitHub and the npm registry" '["github.com","api.github.com","registry.npmjs.org"]' \
  "$(jq -c .network.allowedDomains "$sandbox_policy")"
check_eq "the session sandbox reaches the clipboard, so copied images paste" '["com.apple.pasteboard.1"]' \
  "$(jq -c .network.allowMachLookup "$sandbox_policy")"
check_eq "the session sandbox sends the push token only to github.com and the read-only token only to the GitHub API, both masked" '[{"name":"GH_BASIC","mode":"mask","injectHosts":["github.com"]},{"name":"GH_TOKEN","mode":"mask","injectHosts":["api.github.com"]}]' \
  "$(jq -c .credentials.envVars "$sandbox_policy")"
check_eq "the session sandbox hides credentials and the normal Claude config" true \
  "$(jq '.filesystem.denyRead | (["~/.ssh", "~/.aws", "~/.config/gh", "~/.npmrc", "~/Library/Keychains", "~/.claude"] - .) == []' "$sandbox_policy")"
check_eq "the session sandbox writes only the project, so no folder an unsandboxed program runs from" '["."]' \
  "$(jq -c .filesystem.allowWrite "$sandbox_policy")"

digests="$repo/ollama/model-digests.json"
pulled_models() {
  sed -n 's/^FROM //p' "$repo"/ollama/Modelfile.*
  sed -n 's/^embedding_model=.*CODE_SEARCH_MODEL:-\([^}]*\)}.*/\1/p' "$repo/bin/claude-ollama"
}
is_sha256() {
  [[ "$1" =~ ^[0-9a-f]{64}$ ]]
}
for name in $(pulled_models); do
  check_that "$name is an Ollama library model" test "${name#*/}" = "$name"
  check_that "$name has a sha256 pin in model-digests.json" \
    is_sha256 "$(jq -r ".[\"$name\"] // empty" "$digests")"
done

check_eq "rendered profiles are current" 0 "$("$repo/bin/ollama-profiles" --check >/dev/null 2>&1; echo $?)"

check_not "the side model is gone" test -e "$repo/ollama/side.Modelfile"

check_eq "settings.tokens.json sets subagents to Haiku" haiku \
  "$(jq -r .env.CLAUDE_CODE_SUBAGENT_MODEL "$repo/personal/settings.tokens.json")"
check_eq "settings.tokens.json forces the subagent model" 1 \
  "$(jq -r .env.CLAUDE_CODE_SUBAGENT_MODEL_FORCE "$repo/personal/settings.tokens.json")"

denies_tool() {
  jq -e --arg tool "$2" '.permissions.deny | index($tool) != null' "$1" >/dev/null
}

for settings in "$repo"/ollama/settings.*.json; do
  for tool in Grep Glob; do
    check_that "${settings##*/} denies $tool" denies_tool "$settings" "$tool"
  done
done

for tool in Artifact ScheduleWakeup SendFeedback Workflow; do
  check_that "settings.tokens.json denies $tool" denies_tool "$repo/personal/settings.tokens.json" "$tool"
done

for settings in "$repo"/ollama/settings.*.json; do
  check_eq "${settings##*/} denies every bare tool the personal overlay denies" "[]" \
    "$(jq -c -n --slurpfile personal "$repo/personal/settings.tokens.json" --slurpfile profile "$settings" \
      '[$personal[0].permissions.deny[] | select(contains("(") | not)] - $profile[0].permissions.deny')"
done

default_embedding() {
  grep -c 'qwen3-embedding:0.6b' "$1"
}

for source in bin/claude-ollama shared/mcp/code-search.py go/internal/picker/profiles/embedding.go; do
  check_eq "$source names the default embedding model once" 1 "$(default_embedding "$repo/$source")"
done

check_that "CLAUDE.local.md tells the model to use semantic_search" grep -qF 'semantic_search' "$repo/ollama/CLAUDE.local.md"
check_that "CLAUDE.local.md names the embedding setup row" grep -qF 'Set up embedding model' "$repo/ollama/CLAUDE.local.md"

allows_semantic_search() {
  jq -e '.permissions.allow | index("mcp__code-search__semantic_search") != null' "$1" >/dev/null
}

for settings in "$repo"/ollama/settings.*.json; do
  check_that "${settings##*/} allows semantic_search" allows_semantic_search "$settings"
done

gates_text_search() {
  jq -e '[.hooks.PreToolUse[] | select(.matcher | test("Bash") and test("semantic_search")) | .hooks[].command] | any(test("tool-nudge"))' "$1" >/dev/null
}

for settings in "$repo"/ollama/settings.*.json; do
  check_that "${settings##*/} runs tool-nudge.py before Bash and semantic_search" gates_text_search "$settings"
done

check_eq "tool-telemetry counts the same line limit that bash-output-trim applies" \
  "$(sed -n 's/^MAX_LINES = //p' "$repo/shared/hooks/bash-output-trim.py")" \
  "$(sed -n 's/^TRIM_LINE_LIMIT = //p' "$repo/shared/hooks/tool-telemetry.py")"

agent="$repo/shared/agents/pr-review.md"
agent_frontmatter() {
  sed -n '2,/^---$/p' "$agent" | sed '$d'
}
check_eq "pr-review agent name matches its file name" pr-review "$(agent_frontmatter | sed -n 's/^name: *//p')"
check_that "pr-review agent has a description" test -n "$(agent_frontmatter | sed -n '/^description:/,/^[a-z]*:/p' | sed '$d' | sed 's/^description://' | tr -d ' \n')"
check_eq "pr-review agent lists the review tools" "Bash, Read, Grep, Glob" "$(agent_frontmatter | sed -n 's/^tools: *//p')"
check_not "pr-review agent pins no model, so --agent keeps the session model" grep -q '^model:' <<<"$(agent_frontmatter)"
check_that "pr-review agent runs fallow audit with --format json" grep -qF 'audit --base MERGE_BASE --format json' "$agent"
check_not "pr-review agent never runs npx, which can resolve PR-owned code" grep -qF 'npx' "$agent"
check_that "pr-review agent runs fallow from the work dir against the PR head" grep -qF "cd \"\$work\" && \"\$fallow_bin\" --root \"\$work/head/\$pkg\" audit" "$agent"
check_not "pr-review agent never splices a PR path into a command" grep -qF '/PKG' "$agent"
check_that "pr-review agent refuses a package path outside the allowlist" grep -qF "grep -qE '^[A-Za-z0-9._/-]+\$'" "$agent"
check_that "pr-review agent names the 250-line Read window" grep -q '250' "$agent"
check_that "pr-review agent posts only a comment review" grep -qF -- '--comment --body-file' "$agent"
check_that "pr-review agent removes its worktree" grep -qF 'worktree remove --force' "$agent"

if [ "$failures" -eq 0 ]; then
  echo "all passed"
else
  echo "$failures failed"
  exit 1
fi
