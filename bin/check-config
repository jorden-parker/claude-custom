overlay_env_keys() {
  sed -n 's/^env_allowlist="\(.*\)"$/\1/p' "$repo/shared/profile-overlay" | tr ' ' '\n' | sort
}
console_env_keys() {
  sed -n '/^export const PROFILE_ENV_KEYS = \[$/,/^\] as const;$/p' "$repo/web/console/src/lib/profile-rules.ts" | sed -n 's/^ *"\([A-Z_]*\)",$/\1/p' | sort
}
check_that "the console lists at least one profile env key" test -n "$(console_env_keys)"
check_eq "the profile overlay's env allowlist and the console's PROFILE_ENV_KEYS name the same variables" "$(console_env_keys)" "$(overlay_env_keys)"
for env_key in $(console_env_keys); do
  check_that "docs/ollama.md names the profile env key $env_key" grep -qF "\`$env_key\`" "$repo/docs/ollama.md"
  check_that "CLAUDE.md names the profile env key $env_key" grep -qF "\`$env_key\`" "$repo/CLAUDE.md"
done
check_that "the launcher and the console agree on the drafts folder" grep -qF '.claude-ollama/drafts' "$repo/web/console/src/lib/drafts.ts"
check_that "the launcher keeps drafts in the session config" grep -qF "drafts_dir=\"\$session_config_dir/drafts\"" "$repo/bin/claude-ollama"
