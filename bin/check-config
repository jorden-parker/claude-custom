#!/usr/bin/env bash
set -u
repo="$(cd "$(dirname "$0")/.." && pwd -P)"
failures=0
fail() {
  echo "FAIL: $1"
  failures=$((failures + 1))
}

check_eq() {
  if [ "$2" != "$3" ]; then
    fail "$1: expected [$2] got [$3]"
  fi
}

check_that() {
  local name="$1"
  shift
  "$@" || fail "$name"
}

check_not() {
  local name="$1"
  shift
  if "$@"; then
    fail "$name"
  fi
}

for settings in "$repo"/ollama/settings.*.json; do
  check_eq "hooks in ${settings##*/} include every personal overlay hook" "[]" \
    "$(jq -c -n --slurpfile personal "$repo/personal/settings.tokens.json" --slurpfile profile "$settings" \
      '[$personal[0].hooks | to_entries[] | .key as $event | .value[] | {event: $event, matcher: (.matcher // ""), command: .hooks[].command}]
       - [$profile[0].hooks | to_entries[] | .key as $event | .value[] | {event: $event, matcher: (.matcher // ""), command: .hooks[].command}]')"
done

for settings in "$repo"/ollama/settings.*.json; do
  check_that "${settings##*/} denies Workflow" \
    test "$(jq -r '.permissions.deny | index("Workflow") != null' "$settings")" = true
  check_that "${settings##*/} denies Agent, since a subagent would run on the main model" \
    test "$(jq -r '.permissions.deny | index("Agent") != null' "$settings")" = true
  check_eq "${settings##*/} lets the model use your skills but not the bundled ones" "true true" \
    "$(jq -r '[(.permissions.deny | index("Skill") == null), .disableBundledSkills] | map(tostring) | join(" ")' "$settings")"
  check_eq "${settings##*/} sends the Haiku slot to the main model" \
    "$(jq -r .model "$settings")" "$(jq -r .env.ANTHROPIC_DEFAULT_HAIKU_MODEL "$settings")"
  check_eq "${settings##*/} sets no subagent model" "null null" \
    "$(jq -r '[.env.CLAUDE_CODE_SUBAGENT_MODEL, .env.CLAUDE_CODE_SUBAGENT_MODEL_FORCE] | map(tostring) | join(" ")' "$settings")"
  check_eq "${settings##*/} maps no Claude ID to a local model, so the banner names the main model" null \
    "$(jq -c .modelOverrides "$settings")"
  check_eq "${settings##*/} lists only its main model in availableModels" \
    "$(jq -c '[.model]' "$settings")" "$(jq -c '.availableModels' "$settings")"
  check_eq "${settings##*/} waits the full 30 minutes for a silent Ollama stream" "1800000 1800000" \
    "$(jq -r '[.env.CLAUDE_STREAM_IDLE_TIMEOUT_MS, .env.API_TIMEOUT_MS] | join(" ")' "$settings")"
  check_eq "${settings##*/} keeps the prompt prefix stable so Ollama reuses its cache" "0 off" \
    "$(jq -r '[.env.CLAUDE_CODE_ATTRIBUTION_HEADER, .env.CLAUDE_CODE_TOTAL_TOKENS_REMINDER] | join(" ")' "$settings")"
  check_eq "${settings##*/} asks Ollama for no thinking, since Claude Code's adaptive thinking reaches Ollama as effort high (a profile's thinking:true drops it)" \
    '{"thinking":{"type":"disabled"}}' \
    "$(jq -r .env.CLAUDE_CODE_EXTRA_BODY "$settings" | jq -c .)"
  check_eq "${settings##*/} sends no telemetry, error reports, surveys, feedback drafts, update checks or marketplace installs home" "1 1 1 1 1 1 0 1 off 0" \
    "$(jq -r '[.env.DISABLE_TELEMETRY, .env.DO_NOT_TRACK, .env.DISABLE_ERROR_REPORTING, .env.DISABLE_AUTOUPDATER, .env.DISABLE_BUG_COMMAND, .env.CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY, .env.CLAUDE_CODE_SEND_FEEDBACK, .env.CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL, .feedbackDrafts, .feedbackSurveyRate] | map(tostring) | join(" ")' "$settings")"
  check_eq "${settings##*/} runs Bash in Claude Code's own sandbox and lets sandboxed commands run without a prompt" "true true" \
    "$(jq -r '[.sandbox.enabled, .sandbox.autoAllowBashIfSandboxed] | map(tostring) | join(" ")' "$settings")"
  check_eq "${settings##*/} runs only cmux, gh, short, git push, claude-custom ctx7 and pnpm outside the sandbox" '["cmux *","gh *","short *","git push *","claude-custom ctx7 *","pnpm *"]' \
    "$(jq -c .sandbox.excludedCommands "$settings")"
  check_eq "${settings##*/} reaches github.com, the loopback addresses, and the npm, Go, PyPI and GitHub download hosts" \
    '["127.0.0.1","[::1]","github.com","*.github.com","*.githubusercontent.com","registry.npmjs.org","proxy.golang.org","sum.golang.org","pypi.org","files.pythonhosted.org","context7.com"] true' \
    "$(jq -r '[(.network.allowedDomains | tojson), (.network.allowLocalBinding | tostring)] | join(" ")' <<<"$(jq .sandbox "$settings")")"
  check_eq "${settings##*/} lets sandboxed commands write only the sandbox cache folder beyond the project and the temp dir" '["~/.cache/claude-sandbox"]' \
    "$(jq -c '.sandbox.filesystem.allowWrite' "$settings")"
  check_eq "${settings##*/} needs no denyWrite, since nothing a hook or launcher runs lives under a writable path" null \
    "$(jq -c '.sandbox.filesystem.denyWrite' "$settings")"
  check_eq "${settings##*/} hides credentials, the normal Claude config and the console state from sandboxed commands" true \
    "$(jq '.sandbox.filesystem.denyRead | (["~/.ssh", "~/.aws", "~/.config/gh", "~/.npmrc", "~/Library/Keychains", "~/.claude", "~/.qwen", "~/.local/share/claude-custom", "~/.config/context7"] - .) == []' "$settings")"
  check_eq "${settings##*/} unsets the GitHub and Shortcut tokens for sandboxed commands" '["GH_TOKEN","GITHUB_TOKEN","SHORTCUT_API_TOKEN"]' \
    "$(jq -c '[.sandbox.credentials.envVars[] | select(.mode == "deny") | .name]' "$settings")"
  check_eq "${settings##*/} starts in default mode with auto mode off, since its classifier would call Ollama for a Claude model" "default disable" \
    "$(jq -r '[.permissions.defaultMode, .permissions.disableAutoMode] | join(" ")' "$settings")"
  check_eq "${settings##*/} asks before a commit, a push and a command that leaves the sandbox, and before nothing else" '["Bash(git commit *)","Bash(git push *)","Bash(dangerouslyDisableSandbox:true)"]' \
    "$(jq -c .permissions.ask "$settings")"
done

qwen_template="$repo/ollama/qwen-settings.template.json"
check_eq "the Qwen Code profile talks to Ollama as an OpenAI endpoint with a placeholder key" "openai OLLAMA_API_KEY ollama" \
  "$(jq -r '[.security.auth.selectedType, .modelProviders.openai[0].envKey, .env.OLLAMA_API_KEY] | join(" ")' "$qwen_template")"
check_eq "the Qwen Code profile asks Ollama for no thinking, which /v1/chat/completions reads as reasoning_effort" none \
  "$(jq -r '.modelProviders.openai[0].generationConfig.extra_body.reasoning_effort' "$qwen_template")"
check_eq "the Qwen Code profile waits the full 30 minutes for a silent Ollama stream" "1800000 1800000" \
  "$(jq -r '.modelProviders.openai[0].generationConfig | [.timeout, .streamIdleTimeoutMs] | join(" ")' "$qwen_template")"
check_eq "the Qwen Code profile sends nothing home and never self-updates" "false false false" \
  "$(jq -r '[.privacy.usageStatisticsEnabled, .telemetry.enabled, .general.enableAutoUpdate] | map(tostring) | join(" ")' "$qwen_template")"
check_eq "the Qwen Code profile has no subagent, web or notebook tools and runs the whole CLI under macOS Seatbelt" "true sandbox-exec" \
  "$(jq -r '[((["agent", "web_fetch", "web_search", "notebook_edit"] - .tools.disabled) == []), .tools.sandbox] | map(tostring) | join(" ")' "$qwen_template")"
qwen_profile="$repo/ollama/qwen-sandbox.sb"
deny_read_paths_missing_from() {
  jq -r '.sandbox.filesystem.denyRead[]' "$repo/ollama/settings.27b.json" | sed 's|^~||' |
    while IFS= read -r path; do grep -qF "\"$path\"" "$1" || echo "$path"; done
}
check_eq "the Qwen Seatbelt profile denies every path the Claude profiles deny reading" "" \
  "$(deny_read_paths_missing_from "$qwen_profile")"
closes_outbound_tcp_except_loopback_and_web() {
  grep -qF '(deny network-outbound (remote tcp "*:*"))' "$1" &&
    grep -qF '(remote tcp "localhost:*")' "$1" &&
    grep -qF '(remote tcp "*:443")' "$1" &&
    grep -qF '(remote tcp "*:80")' "$1" &&
    ! grep -qF "/.gitconfig" "$1"
}
check_that "the Qwen Seatbelt profile closes outbound TCP except loopback, 443 and 80" \
  closes_outbound_tcp_except_loopback_and_web "$qwen_profile"
check_eq "the Qwen Seatbelt profile writes under the home folder only in the sandbox cache, like the Claude profiles" '"/.cache/claude-sandbox"' \
  "$(sed -n '/^(allow file-write\*/,/^)/p' "$qwen_profile" | sed -n 's/.*(param "HOME_DIR") \("[^"]*"\).*/\1/p' | sort -u | tr '\n' ' ' | sed 's/ $//')"
check_eq "the Qwen Code profile allows semantic_search and the repo tools without a prompt, like the Claude profiles" true \
  "$(jq '(.permissions.allow | index("mcp__code-search__semantic_search") != null) and (.permissions.allow | index("mcp__repo") != null)' "$qwen_template")"
check_eq "the Qwen Code profile keeps a project .env, which the session can write, from choosing the next session's system prompt, model, key or Seatbelt profile, or claiming a sandbox" true \
  "$(jq '(["QWEN_SYSTEM_MD", "SEATBELT_PROFILE", "OPENAI_API_KEY", "OPENAI_BASE_URL", "OPENAI_MODEL", "QWEN_MODEL", "SANDBOX"] - .advanced.excludedEnvVars) == []' "$qwen_template")"
check_eq "the Qwen Code profile turns cross-session messaging off, since no second session should drive this one" false \
  "$(jq -r '.agents.crossSessionMessaging' "$qwen_template")"

digests="$repo/ollama/model-digests.json"
pulled_models() {
  sed -n 's/^FROM //p' "$repo"/ollama/Modelfile.*
  sed -n 's/^embedding_model=.*CODE_SEARCH_MODEL:-\([^}]*\)}.*/\1/p' "$repo/bin/claude-ollama"
}
is_sha256() {
  [[ "$1" =~ ^[0-9a-f]{64}$ ]]
}
is_library_name() {
  [[ "$1" != */* ]]
}
is_pinned_gguf() {
  local file="${1#./weights/}"
  [[ "$1" == ./weights/* && "$file" != */* && "$file" == *.gguf ]] || return 1
  jq -e --arg base "$1" '
    [.[] | select(.base == $base) | .gguf // empty
      | select((.repo | test("^unsloth/[A-Za-z0-9._-]+-GGUF$")) and (.revision | test("^[0-9a-f]{40}$")))
    ] | length > 0' "$repo/ollama/sizes.json" >/dev/null
}
is_allowed_base() {
  is_library_name "$1" || is_pinned_gguf "$1"
}
for name in $(pulled_models); do
  check_that "$name is an Ollama library model or a pinned Unsloth GGUF" is_allowed_base "$name"
  check_that "$name has a sha256 pin in model-digests.json" \
    is_sha256 "$(jq -r ".[\"$name\"] // empty" "$digests")"
done
check_that ".gitignore keeps downloaded GGUF weights out of git" grep -qx 'ollama/weights/' "$repo/.gitignore"

check_eq "rendered profiles are current" 0 "$("$repo/bin/ollama-profiles" --check >/dev/null 2>&1; echo $?)"

check_not "the side model is gone" test -e "$repo/ollama/side.Modelfile"

check_eq "settings.tokens.json sets subagents to Haiku" haiku \
  "$(jq -r .env.CLAUDE_CODE_SUBAGENT_MODEL "$repo/personal/settings.tokens.json")"
check_eq "settings.tokens.json forces the subagent model" 1 \
  "$(jq -r .env.CLAUDE_CODE_SUBAGENT_MODEL_FORCE "$repo/personal/settings.tokens.json")"
check_eq "settings.tokens.json turns Claude Code's own sandbox on for every personal session" true \
  "$(jq -r .sandbox.enabled "$repo/personal/settings.tokens.json")"
check_eq "settings.tokens.json asks before a command leaves that sandbox, whatever the permission mode" '["Bash(dangerouslyDisableSandbox:true)","Bash(gh *)","Bash(git push *)"]' \
  "$(jq -c '.permissions.ask' "$repo/personal/settings.tokens.json")"
check_eq "settings.tokens.json reaches the same hosts and writes the same cache folder as the Ollama profiles, hides every credential and the console state, and unsets the same tokens" true \
  "$(jq --slurpfile ollama "$repo/ollama/settings.27b.json" '
    .sandbox.network == $ollama[0].sandbox.network
    and .sandbox.filesystem.allowWrite == $ollama[0].sandbox.filesystem.allowWrite
    and .sandbox.filesystem.denyRead == ["~/.ssh", "~/.aws", "~/.config/gh", "~/.config/context7", "~/.npmrc", "~/Library/Keychains", "~/.local/share/claude-custom"]
    and .sandbox.credentials == $ollama[0].sandbox.credentials
    and .sandbox.excludedCommands == ["gh *", "git push *", "claude-custom ctx7 *"]
  ' "$repo/personal/settings.tokens.json")"
check_eq "shared/sandbox-env keeps every package cache under the folder both sandboxes may write" \
  "$(jq -r '.sandbox.filesystem.allowWrite[0]' "$repo/ollama/settings.27b.json")" \
  "$(grep -o 'HOME/[^}]*' "$repo/shared/sandbox-env" | sed 's|^HOME|~|' | sort -u)"
check_eq "claude-ollama runs claude and qwen through shared/sandbox-env" 2 \
  "$(grep -cF "exec \"\$repo_dir/shared/sandbox-env\" " "$repo/bin/claude-ollama")"
check_eq "personal/launch runs claude through shared/sandbox-env" 1 \
  "$(grep -cF "exec \"\$repo_dir/shared/sandbox-env\" claude " "$repo/personal/launch")"
check_eq "shared/host-env unsets every cache variable shared/sandbox-env sets, so hooks and MCP servers use your own caches" \
  "$(sed -n 's/^export \([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p' "$repo/shared/sandbox-env" | grep -v '^CLAUDE_SANDBOX_CACHE_DIR$' | sort | tr '\n' ' ')" \
  "$(sed -n 's/^ *unset //p' "$repo/shared/host-env" | tr ' ' '\n' | sort | tr '\n' ' ')"
check_eq "every hook command runs through shared/host-env" 0 \
  "$(jq -r '.[][].hooks[].command' "$repo/shared/settings/hooks.json" "$repo/ollama/hooks.extra.json" | grep -vcF "/shared/host-env \"\$CLAUDE_CUSTOM_HOME\"/shared/hooks/")"
check_eq "claude-ollama starts its three MCP servers through shared/host-env" 3 \
  "$(grep -oF "\"\$repo_dir/shared/host-env\" " "$repo/bin/claude-ollama" | wc -l | tr -d ' ')"
check_that "claude-ollama starts the incident watcher tied to its own pid" \
  grep -qF -- '--model "$model" --out "$incidents_file" --watch-pid "$$"' "$repo/bin/claude-ollama"
check_that "claude-ollama starts the degrade ladder beside the watcher, tied to its own pid" \
  grep -qF -- '--watch-pid "$$" --context "$(modelfile_num_ctx)"' "$repo/bin/claude-ollama"
check_that "claude-ollama lets CLAUDE_OLLAMA_LADDER=0 turn the ladder off" grep -qF '"${CLAUDE_OLLAMA_LADDER:-}" = 0' "$repo/bin/claude-ollama"
check_that "claude-ollama holds a session lease before it starts the indexer" \
  test "$(grep -n '^claim_session$' "$repo/bin/claude-ollama" | cut -d: -f1)" -lt "$(grep -n '^warm_search_index$' "$repo/bin/claude-ollama" | cut -d: -f1)"

denies_tool() {
  jq -e --arg tool "$2" '.permissions.deny | index($tool) != null' "$1" >/dev/null
}

for settings in "$repo"/ollama/settings.*.json; do
  for tool in Grep Glob; do
    check_that "${settings##*/} denies $tool" denies_tool "$settings" "$tool"
  done
done

for tool in Artifact ScheduleWakeup SendFeedback Workflow; do
  check_that "settings.tokens.json denies $tool" denies_tool "$repo/personal/settings.tokens.json" "$tool"
done

for settings in "$repo"/ollama/settings.*.json; do
  check_eq "${settings##*/} denies every bare tool the personal overlay denies" "[]" \
    "$(jq -c -n --slurpfile personal "$repo/personal/settings.tokens.json" --slurpfile profile "$settings" \
      '[$personal[0].permissions.deny[] | select(contains("(") | not)] - $profile[0].permissions.deny')"
done

default_embedding() {
  grep -c 'qwen3-embedding:0.6b' "$1"
}

for source in bin/claude-ollama shared/mcp/code-search.py go/internal/picker/profiles/embedding.go; do
  check_eq "$source names the default embedding model once" 1 "$(default_embedding "$repo/$source")"
done

check_that "CLAUDE.local.md tells the model to use semantic_search" grep -qF 'semantic_search' "$repo/ollama/CLAUDE.local.md"
check_that "CLAUDE.local.md names the embedding setup row" grep -qF 'Set up embedding model' "$repo/ollama/CLAUDE.local.md"

allows_semantic_search() {
  jq -e '.permissions.allow | index("mcp__code-search__semantic_search") != null' "$1" >/dev/null
}

allows_repo_tools() {
  jq -e '.permissions.allow | index("mcp__repo") != null' "$1" >/dev/null
}

allows_read_only_dev_tools() {
  jq -e '.permissions.allow as $allowed | all(["mcp__dev__dev_status", "mcp__dev__dev_logs", "mcp__dev__dev_errors", "mcp__dev__dev_deps", "mcp__dev__page_check", "mcp__dev__page_snapshot", "mcp__dev__page_act"][]; . as $tool | any($allowed[]; . == $tool))' "$1" >/dev/null
}

asks_before_dev_start() {
  jq -e '.permissions.allow | all(. != "mcp__dev" and . != "mcp__dev__dev_start" and . != "mcp__dev__dev_stop" and . != "mcp__dev__dev_install")' "$1" >/dev/null
}

check_that "CLAUDE.local.md tells the model to use the repo tools" grep -qF 'mcp__repo__' "$repo/ollama/CLAUDE.local.md"
check_that "CLAUDE.local.md tells the model to use the dev tools" grep -qF 'mcp__dev__dev_status' "$repo/ollama/CLAUDE.local.md"

session_tool_names() {
  python3 - "$repo" <<'PYTHON'
import re
import sys
from pathlib import Path

repo = Path(sys.argv[1])
names = set(re.findall(r'tools="([A-Za-z,]+)"', (repo / "bin" / "claude-ollama").read_text())[0].split(","))
for server in ("dev-server.py", "repo-tools.py"):
    names.update(re.findall(r'\btool\(\s*"([a-z_]+)"', (repo / "shared" / "mcp" / server).read_text()))
for server in ("github_tools.py", "draft_store.py", "code-search.py"):
    names.update(re.findall(r'"name": "([a-z_]+)"', (repo / "shared" / "mcp" / server).read_text()))
print("\n".join(sorted(names)))
PYTHON
}

prompt_names_every_tool() {
  local missing
  missing="$(session_tool_names | grep -vxF -f <(sed 's/__/ /g' "$repo/ollama/CLAUDE.local.md" | grep -oE '[A-Za-z_]+' | sort -u))"
  [ -z "$missing" ] || { echo "CLAUDE.local.md never names: $(echo "$missing" | tr '\n' ' ')" >&2; return 1; }
}

check_that "CLAUDE.local.md names every tool the session can call" prompt_names_every_tool
check_that "CLAUDE.local.md maps commands to the tools that replace them" grep -qF 'Tool instead of command' "$repo/ollama/CLAUDE.local.md"
check_that "system-prompt.md points the model at that map" grep -qF 'tool instead of command' "$repo/ollama/system-prompt.md"

allows_find_docs_skill() {
  jq -e '.permissions.allow | index("Skill(find-docs)") != null' "$1" >/dev/null
}

for settings in "$repo"/ollama/settings.*.json; do
  check_that "${settings##*/} allows semantic_search" allows_semantic_search "$settings"
  check_that "${settings##*/} allows the find-docs skill without a prompt" allows_find_docs_skill "$settings"
  check_that "${settings##*/} allows the read-only repo tools without a prompt" allows_repo_tools "$settings"
  check_that "${settings##*/} allows the read-only dev tools without a prompt" allows_read_only_dev_tools "$settings"
  check_that "${settings##*/} asks before dev_start and dev_stop" asks_before_dev_start "$settings"
done

modelfile_num_ctx_for() {
  sed -n 's/^PARAMETER num_ctx //p' "$repo/ollama/Modelfile.$1"
}

leaves_headroom() {
  local size="${1##*/settings.}" tokens output reserve
  size="${size%.json}"
  tokens="$(jq -r .env.CLAUDE_CODE_MAX_CONTEXT_TOKENS "$1")"
  output="$(jq -r .env.CLAUDE_CODE_MAX_OUTPUT_TOKENS "$1")"
  reserve="$(jq -r .summary_reserve "$repo/ollama/headroom.json")"
  [ $((tokens + output + reserve)) -le "$(modelfile_num_ctx_for "$size")" ]
}

check_eq "headroom.json keeps the output tokens every Ollama profile sends" "$(jq -r .output_tokens "$repo/ollama/headroom.json")" \
  "$(jq -r .env.CLAUDE_CODE_MAX_OUTPUT_TOKENS "$repo"/ollama/settings.*.json | sort -u)"
check_that "headroom.json reserves at least 2048 tokens for the compaction summary" \
  test "$(jq -r .summary_reserve "$repo/ollama/headroom.json")" -ge 2048
for settings in "$repo"/ollama/settings.*.json; do
  check_that "${settings##*/} leaves room under num_ctx for the output and the compaction summary" leaves_headroom "$settings"
done

gates_text_search() {
  jq -e '[.hooks.PreToolUse[] | select(.matcher | test("Bash") and test("semantic_search")) | .hooks[].command] | any(test("tool-nudge"))' "$1" >/dev/null
}

gates_node_modules_reads() {
  jq -e '[.hooks.PreToolUse[] | select(.matcher | test("Read") and test("Skill")) | .hooks[].command] | any(test("tool-nudge"))' "$1" >/dev/null
}

watches_context_budget() {
  jq -e '[.hooks.PostToolUse[] | select(has("matcher") | not) | .hooks[].command] | any(test("context-budget"))' "$1" >/dev/null
}

relaunches_on_handoff() {
  jq -e '[.hooks.Stop[] | .hooks[].command] | any(test("handoff-relaunch"))' "$1" >/dev/null
}

notes_incidents() {
  jq -e '[.hooks.UserPromptSubmit[].hooks[].command] | any(test("incident-note"))' "$1" >/dev/null
}

resets_friction_budget() {
  jq -e '[.hooks.UserPromptSubmit[].hooks[].command] | any(test("friction_budget"))' "$1" >/dev/null
}

caches_repeat_calls() {
  jq -e --arg event "$2" '[.hooks[$event][] | select((.matcher // "") | test("Read") and test("mcp__repo__git_status") and test("mcp__code-search__semantic_search")) | .hooks[].command] | any(test("repeat-call-cache"))' "$1" >/dev/null
}

suggests_tests_after_edits() {
  jq -e '[.hooks.PostToolUse[] | select((.matcher // "") | test("Edit") and test("Write") and test("MultiEdit")) | .hooks[].command] | any(test("test-after-edit"))' "$1" >/dev/null
}

delivers_rule_cards() {
  jq -e '[.hooks.PreToolUse[] | select((.matcher // "") | test("Edit") and test("Write") and test("MultiEdit") and test("Read") and test("Bash")) | .hooks[].command] | any(test("rule-cards"))' "$1" >/dev/null
}

rule_card_lister="$repo/shared/hooks/rule-cards.py"
rule_card_ids() {
  "$rule_card_lister" --list 2>/dev/null | sed 's/:.*//'
}

trimmed_lines() {
  sed 's/^[[:space:]-]*//; s/[[:space:]]*$//' "$@" | grep .
}

card_body() {
  sed '1,/^---$/d' "$1"
}

card_body_lines() {
  card_body "$1" | trimmed_lines
}

rule_cards_well_formed() {
  "$rule_card_lister" --list >/dev/null
}

always_on_prompt_repeats_a_card() {
  local card repeated
  for card in "$repo"/ollama/rule-cards/*.md; do
    repeated="$(card_body_lines "$card" | grep -xF -f <(trimmed_lines "$repo/ollama/CLAUDE.local.md" "$repo/ollama/system-prompt.md" "$repo/shared/preferences/PREFERENCES.md") || true)"
    [ -z "$repeated" ] || { echo "${card##*/} repeats the always-on prompt: $repeated" >&2; return 0; }
  done
  return 1
}

card_bodies_fit_the_cap() {
  local cap card length
  cap="$(sed -n 's/^CONTEXT_CAP = //p' "$rule_card_lister")"
  for card in "$repo"/ollama/rule-cards/*.md; do
    length="$(card_body "$card" | wc -c | tr -d ' ')"
    [ "$length" -le "$cap" ] || { echo "${card##*/} body is $length characters, over the $cap cap" >&2; return 1; }
  done
}

check_that "every rule card has a trigger and a body" rule_cards_well_formed
check_that "rule cards exist" test -n "$(rule_card_ids)"
check_eq "no two rule cards share an id" "" "$(rule_card_ids | sort | uniq -d)"
check_that "every rule card body fits the hook's byte cap" card_bodies_fit_the_cap
check_not "the always-on prompt no longer holds a line a rule card carries" always_on_prompt_repeats_a_card
for settings in "$repo"/ollama/settings.*.json; do
  check_that "${settings##*/} runs rule-cards.py before Edit, Write, MultiEdit, Read and Bash" delivers_rule_cards "$settings"
done

for settings in "$repo"/ollama/settings.*.json; do
  check_that "${settings##*/} runs friction_budget.py on each prompt" resets_friction_budget "$settings"
  check_that "${settings##*/} runs repeat-call-cache.py before Read, git_status and semantic_search" caches_repeat_calls "$settings" PreToolUse
  check_that "${settings##*/} runs repeat-call-cache.py after Read, git_status and semantic_search" caches_repeat_calls "$settings" PostToolUse
  check_that "${settings##*/} runs tool-nudge.py before Bash and semantic_search" gates_text_search "$settings"
  check_that "${settings##*/} runs tool-nudge.py before Read and Skill" gates_node_modules_reads "$settings"
  check_that "${settings##*/} runs context-budget.py after every tool" watches_context_budget "$settings"
  check_that "${settings##*/} runs handoff-relaunch.py on Stop" relaunches_on_handoff "$settings"
  check_that "${settings##*/} runs incident-note.py on each prompt" notes_incidents "$settings"
  check_that "${settings##*/} runs test-after-edit.py after Edit, Write and MultiEdit" suggests_tests_after_edits "$settings"
done

recipe_problems() {
  python3 - "$repo" <<'PYTHON'
import json
import re
import sys
from pathlib import Path

repo = Path(sys.argv[1])
for recipe_file in sorted((repo / "ollama" / "recipes").glob("*.json")):
    hook = recipe_file.stem
    if not (repo / "shared" / "hooks" / f"{hook}.py").is_file():
        print(f"{recipe_file.name}: no hook shared/hooks/{hook}.py")
    recipes = json.loads(recipe_file.read_text())
    if not isinstance(recipes, list) or not recipes:
        print(f"{recipe_file.name}: must be a non-empty list")
        continue
    for index, recipe in enumerate(recipes):
        try:
            re.compile(recipe["match"])
        except (KeyError, TypeError, re.error) as error:
            print(f"{recipe_file.name}[{index}]: match does not compile ({error})")
        steps = recipe.get("steps")
        if not isinstance(steps, list) or not steps or len(steps) > 3 or any(not isinstance(step, str) or not step.strip() for step in steps):
            print(f"{recipe_file.name}[{index}]: steps must be one to three non-empty strings")
PYTHON
}

check_eq "every recovery recipe names a hook, compiles its match and lists one to three steps" "" "$(recipe_problems)"
for hook in bash-output-guard read-range-guard tool-nudge tdd-guard; do
  check_that "ollama/recipes/$hook.json exists for the guard that uses it" test -f "$repo/ollama/recipes/$hook.json"
done

check_eq "test-after-edit supplies every Seatbelt parameter the qwen sandbox profile reads, and no other" \
  "$(grep -o '(param "[A-Z_]*")' "$repo/ollama/qwen-sandbox.sb" | sed 's/(param "\(.*\)")/\1/' | sort -u)" \
  "$(sed -n 's/^SEATBELT_PARAMS = (\(.*\))$/\1/p' "$repo/shared/hooks/test-after-edit.py" | tr -d '" ' | tr ',' '\n' | grep . | sort -u)"
check_that "test-after-edit renders the same Seatbelt profile claude-ollama qwen stages" grep -qF 'qwen-sandbox.sb' "$repo/shared/hooks/test-after-edit.py"
check_eq "tool-telemetry counts the same line limit that bash-output-trim applies" \
  "$(sed -n 's/^MAX_LINES = //p' "$repo/shared/hooks/bash-output-trim.py")" \
  "$(sed -n 's/^TRIM_LINE_LIMIT = //p' "$repo/shared/hooks/tool-telemetry.py")"

check_eq "the console's fetch-domain pattern equals the launcher's" \
  "$(sed -n "s/^fetch_domain_pattern='\(.*\)'\$/\1/p" "$repo/bin/claude-ollama")" \
  "$(sed -n 's|^export const FETCH_DOMAIN_PATTERN = /\(.*\)/;$|\1|p' "$repo/web/console/src/lib/fetch-domain-rules.ts")"

agent="$repo/shared/agents/pr-review.md"
agent_frontmatter() {
  sed -n '2,/^---$/p' "$agent" | sed '$d'
}
check_eq "pr-review agent name matches its file name" pr-review "$(agent_frontmatter | sed -n 's/^name: *//p')"
