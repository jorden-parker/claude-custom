check_eq "pr-review agent lists the review tools" "Bash, Read, Grep, Glob" "$(agent_frontmatter | sed -n 's/^tools: *//p')"
check_not "pr-review agent pins no model, so --agent keeps the session model" grep -q '^model:' <<<"$(agent_frontmatter)"
check_that "pr-review agent runs fallow audit with --format json" grep -qF 'audit --base MERGE_BASE --format json' "$agent"
check_not "pr-review agent never runs npx, which can resolve PR-owned code" grep -qF 'npx' "$agent"
check_that "pr-review agent runs fallow from the work dir against the PR head" grep -qF "cd \"\$work\" && \"\$fallow_bin\" --root \"\$work/head/\$pkg\" audit" "$agent"
check_not "pr-review agent never splices a PR path into a command" grep -qF '/PKG' "$agent"
check_that "pr-review agent refuses a package path outside the allowlist" grep -qF "grep -qE '^[A-Za-z0-9._/-]+\$'" "$agent"
check_that "pr-review agent names the 250-line Read window" grep -q '250' "$agent"
check_that "pr-review agent posts only a comment review" grep -qF -- '--comment --body-file' "$agent"
check_that "pr-review agent removes its worktree" grep -qF 'worktree remove --force' "$agent"

for draft_skill in pr-draft pr-review-draft; do
  check_that "the $draft_skill skill saves through its MCP tool" grep -qF "mcp__repo__draft_" "$repo/shared/skills/$draft_skill/SKILL.md"
  check_that "claude-custom install links the $draft_skill skill" grep -qF "shared/skills/$draft_skill" "$repo/bin/claude-custom"
done
check_that "claude-custom install links the find-docs skill" grep -qF "shared/skills/find-docs" "$repo/bin/claude-custom"
check_that "claude-custom ctx7 pins one Context7 CLI version" grep -qE '^ctx7_version="[0-9]+\.[0-9]+\.[0-9]+"$' "$repo/bin/claude-custom"
check_that "claude-custom ctx7 runs only the library and docs lookups" grep -qF 'library|docs) ;;' "$repo/bin/claude-custom"
check_that "claude-custom ctx7 resolves the CLI from ~/.cache/claude-custom, which no sandbox can write, never from the project" \
  grep -qF -- "run_pinned_ctx7 \"\$home\" --cache=\"\$home/npm-cache\" \"ctx7@\$ctx7_version\"" "$repo/bin/claude-custom"
check_that "claude-custom ctx7 pins that folder under the real home, not an environment variable" grep -qF "home=\"\$HOME/.cache/claude-custom/ctx7\"" "$repo/bin/claude-custom"
check_that "claude-custom ctx7 never resolves the CLI from the working folder: without its cache folder it runs from a fresh temp folder" \
  grep -qF "scratch=\"\$(mktemp -d \"\${TMPDIR:-/tmp}/claude-custom-ctx7.XXXXXX\")\"" "$repo/bin/claude-custom"
for prompt_file in shared/skills/find-docs/SKILL.md ollama/CLAUDE.local.md ollama/QWEN.local.md; do
  check_that "$prompt_file runs the Context7 CLI through claude-custom ctx7" grep -qF 'claude-custom ctx7 library' "$repo/$prompt_file"
  check_not "$prompt_file never runs npx ctx7, which would resolve a package the session wrote" grep -qF 'npx ctx7' "$repo/$prompt_file"
done
for settings in "$repo"/personal/settings.tokens.json "$repo"/ollama/settings.*.json; do
