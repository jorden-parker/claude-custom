#!/usr/bin/env bash
set -u
repo="$(cd "$(dirname "$0")/.." && pwd -P)"
failures=0
fail() {
  echo "FAIL: $1"
  failures=$((failures + 1))
}

check_eq() {
  if [ "$2" != "$3" ]; then
    fail "$1: expected [$2] got [$3]"
  fi
}

check_that() {
  local name="$1"
  shift
  "$@" || fail "$name"
}

check_not() {
  local name="$1"
  shift
  if "$@"; then
    fail "$name"
  fi
}

for settings in "$repo"/ollama/settings.*.json; do
  check_eq "hooks in ${settings##*/} include every personal overlay hook" "[]" \
    "$(jq -c -n --slurpfile personal "$repo/personal/settings.tokens.json" --slurpfile profile "$settings" \
      '[$personal[0].hooks | to_entries[] | .key as $event | .value[] | {event: $event, matcher: (.matcher // ""), command: .hooks[].command}]
       - [$profile[0].hooks | to_entries[] | .key as $event | .value[] | {event: $event, matcher: (.matcher // ""), command: .hooks[].command}]')"
done

for settings in "$repo"/ollama/settings.*.json; do
  check_that "${settings##*/} denies Workflow" \
    test "$(jq -r '.permissions.deny | index("Workflow") != null' "$settings")" = true
  check_that "${settings##*/} denies Agent, since a subagent would run on the main model" \
    test "$(jq -r '.permissions.deny | index("Agent") != null' "$settings")" = true
  check_eq "${settings##*/} lets the model use your skills but not the bundled ones" "true true" \
    "$(jq -r '[(.permissions.deny | index("Skill") == null), .disableBundledSkills] | map(tostring) | join(" ")' "$settings")"
  check_eq "${settings##*/} sends the Haiku slot to the main model" \
    "$(jq -r .model "$settings")" "$(jq -r .env.ANTHROPIC_DEFAULT_HAIKU_MODEL "$settings")"
  check_eq "${settings##*/} sets no subagent model" "null null" \
    "$(jq -r '[.env.CLAUDE_CODE_SUBAGENT_MODEL, .env.CLAUDE_CODE_SUBAGENT_MODEL_FORCE] | map(tostring) | join(" ")' "$settings")"
  check_eq "${settings##*/} maps no Claude ID to a local model, so the banner names the main model" null \
    "$(jq -c .modelOverrides "$settings")"
  check_eq "${settings##*/} lists only its main model in availableModels" \
    "$(jq -c '[.model]' "$settings")" "$(jq -c '.availableModels' "$settings")"
  check_eq "${settings##*/} waits the full 30 minutes for a silent Ollama stream" "1800000 1800000" \
    "$(jq -r '[.env.CLAUDE_STREAM_IDLE_TIMEOUT_MS, .env.API_TIMEOUT_MS] | join(" ")' "$settings")"
  check_eq "${settings##*/} keeps the prompt prefix stable so Ollama reuses its cache" "0 off" \
    "$(jq -r '[.env.CLAUDE_CODE_ATTRIBUTION_HEADER, .env.CLAUDE_CODE_TOTAL_TOKENS_REMINDER] | join(" ")' "$settings")"
  check_eq "${settings##*/} asks Ollama for no thinking, since Claude Code's adaptive thinking reaches Ollama as effort high" \
    '{"thinking":{"type":"disabled"}}' \
    "$(jq -r .env.CLAUDE_CODE_EXTRA_BODY "$settings" | jq -c .)"
  check_eq "${settings##*/} runs Bash in Claude Code's own sandbox and still asks before each sandboxed command" "true false" \
    "$(jq -r '[.sandbox.enabled, .sandbox.autoAllowBashIfSandboxed] | map(tostring) | join(" ")' "$settings")"
  check_eq "${settings##*/} runs only cmux, gh, short and git push outside the sandbox" '["cmux *","gh *","short *","git push *"]' \
    "$(jq -c .sandbox.excludedCommands "$settings")"
  check_eq "${settings##*/} reaches only github.com, the npm registry and local ports" '["github.com","registry.npmjs.org"] true' \
    "$(jq -r '[(.network.allowedDomains | tojson), (.network.allowLocalBinding | tostring)] | join(" ")' <<<"$(jq .sandbox "$settings")")"
  check_eq "${settings##*/} hides credentials, the normal Claude config and the console state from sandboxed commands" true \
    "$(jq '.sandbox.filesystem.denyRead | (["~/.ssh", "~/.aws", "~/.config/gh", "~/.npmrc", "~/Library/Keychains", "~/.claude", "~/.qwen", "~/.local/share/claude-custom"] - .) == []' "$settings")"
  check_eq "${settings##*/} unsets the GitHub and Shortcut tokens for sandboxed commands" '["GH_TOKEN","GITHUB_TOKEN","SHORTCUT_API_TOKEN"]' \
    "$(jq -c '[.sandbox.credentials.envVars[] | select(.mode == "deny") | .name]' "$settings")"
  check_eq "${settings##*/} starts in default mode with auto mode off, since its classifier would call Ollama for a Claude model" "default disable" \
    "$(jq -r '[.permissions.defaultMode, .permissions.disableAutoMode] | join(" ")' "$settings")"
  check_eq "${settings##*/} asks before every Bash command, commit and push, and before a command leaves the sandbox" '["Bash","Bash(git commit *)","Bash(git push *)","Bash(dangerouslyDisableSandbox:true)"]' \
    "$(jq -c .permissions.ask "$settings")"
done

qwen_template="$repo/ollama/qwen-settings.template.json"
check_eq "the Qwen Code profile talks to Ollama as an OpenAI endpoint with a placeholder key" "openai OLLAMA_API_KEY ollama" \
  "$(jq -r '[.security.auth.selectedType, .modelProviders.openai[0].envKey, .env.OLLAMA_API_KEY] | join(" ")' "$qwen_template")"
check_eq "the Qwen Code profile asks Ollama for no thinking, which /v1/chat/completions reads as reasoning_effort" none \
  "$(jq -r '.modelProviders.openai[0].generationConfig.extra_body.reasoning_effort' "$qwen_template")"
check_eq "the Qwen Code profile waits the full 30 minutes for a silent Ollama stream" "1800000 1800000" \
  "$(jq -r '.modelProviders.openai[0].generationConfig | [.timeout, .streamIdleTimeoutMs] | join(" ")' "$qwen_template")"
check_eq "the Qwen Code profile sends nothing home and never self-updates" "false false false" \
  "$(jq -r '[.privacy.usageStatisticsEnabled, .telemetry.enabled, .general.enableAutoUpdate] | map(tostring) | join(" ")' "$qwen_template")"
check_eq "the Qwen Code profile has no subagent, web or notebook tools and no sandbox of its own (Qwen Code runs as you)" "true false" \
  "$(jq -r '[((["agent", "web_fetch", "web_search", "notebook_edit"] - .tools.disabled) == []), .tools.sandbox] | map(tostring) | join(" ")' "$qwen_template")"
check_eq "the Qwen Code profile allows semantic_search and the repo tools without a prompt, like the Claude profiles" true \
  "$(jq '(.permissions.allow | index("mcp__code-search__semantic_search") != null) and (.permissions.allow | index("mcp__repo") != null)' "$qwen_template")"
check_eq "the Qwen Code profile keeps a project .env, which the session can write, from choosing the next session's system prompt, model, key or Seatbelt profile, or claiming a sandbox" true \
  "$(jq '(["QWEN_SYSTEM_MD", "SEATBELT_PROFILE", "OPENAI_API_KEY", "OPENAI_BASE_URL", "OPENAI_MODEL", "QWEN_MODEL", "SANDBOX"] - .advanced.excludedEnvVars) == []' "$qwen_template")"
check_eq "the Qwen Code profile turns cross-session messaging off, since no second session should drive this one" false \
  "$(jq -r '.agents.crossSessionMessaging' "$qwen_template")"

digests="$repo/ollama/model-digests.json"
pulled_models() {
  sed -n 's/^FROM //p' "$repo"/ollama/Modelfile.*
  sed -n 's/^embedding_model=.*CODE_SEARCH_MODEL:-\([^}]*\)}.*/\1/p' "$repo/bin/claude-ollama"
}
is_sha256() {
  [[ "$1" =~ ^[0-9a-f]{64}$ ]]
}
is_library_name() {
  [[ "$1" != */* ]]
}
is_pinned_gguf() {
  local file="${1#./weights/}"
  [[ "$1" == ./weights/* && "$file" != */* && "$file" == *.gguf ]] || return 1
  jq -e --arg base "$1" '
    [.[] | select(.base == $base) | .gguf // empty
      | select((.repo | test("^unsloth/[A-Za-z0-9._-]+-GGUF$")) and (.revision | test("^[0-9a-f]{40}$")))
    ] | length > 0' "$repo/ollama/sizes.json" >/dev/null
}
is_allowed_base() {
  is_library_name "$1" || is_pinned_gguf "$1"
}
for name in $(pulled_models); do
  check_that "$name is an Ollama library model or a pinned Unsloth GGUF" is_allowed_base "$name"
  check_that "$name has a sha256 pin in model-digests.json" \
    is_sha256 "$(jq -r ".[\"$name\"] // empty" "$digests")"
done
check_that ".gitignore keeps downloaded GGUF weights out of git" grep -qx 'ollama/weights/' "$repo/.gitignore"

check_eq "rendered profiles are current" 0 "$("$repo/bin/ollama-profiles" --check >/dev/null 2>&1; echo $?)"

check_not "the side model is gone" test -e "$repo/ollama/side.Modelfile"

check_eq "settings.tokens.json sets subagents to Haiku" haiku \
  "$(jq -r .env.CLAUDE_CODE_SUBAGENT_MODEL "$repo/personal/settings.tokens.json")"
check_eq "settings.tokens.json forces the subagent model" 1 \
  "$(jq -r .env.CLAUDE_CODE_SUBAGENT_MODEL_FORCE "$repo/personal/settings.tokens.json")"
check_eq "settings.tokens.json turns Claude Code's own sandbox on for every personal session" true \
  "$(jq -r .sandbox.enabled "$repo/personal/settings.tokens.json")"
check_eq "settings.tokens.json asks before a command leaves that sandbox, whatever the permission mode" true \
  "$(jq '.permissions.ask | index("Bash(dangerouslyDisableSandbox:true)") != null' "$repo/personal/settings.tokens.json")"

denies_tool() {
  jq -e --arg tool "$2" '.permissions.deny | index($tool) != null' "$1" >/dev/null
}

for settings in "$repo"/ollama/settings.*.json; do
  for tool in Grep Glob; do
    check_that "${settings##*/} denies $tool" denies_tool "$settings" "$tool"
  done
done

for tool in Artifact ScheduleWakeup SendFeedback Workflow; do
  check_that "settings.tokens.json denies $tool" denies_tool "$repo/personal/settings.tokens.json" "$tool"
done

for settings in "$repo"/ollama/settings.*.json; do
  check_eq "${settings##*/} denies every bare tool the personal overlay denies" "[]" \
    "$(jq -c -n --slurpfile personal "$repo/personal/settings.tokens.json" --slurpfile profile "$settings" \
      '[$personal[0].permissions.deny[] | select(contains("(") | not)] - $profile[0].permissions.deny')"
done

default_embedding() {
  grep -c 'qwen3-embedding:0.6b' "$1"
}

for source in bin/claude-ollama shared/mcp/code-search.py go/internal/picker/profiles/embedding.go; do
  check_eq "$source names the default embedding model once" 1 "$(default_embedding "$repo/$source")"
done

check_that "CLAUDE.local.md tells the model to use semantic_search" grep -qF 'semantic_search' "$repo/ollama/CLAUDE.local.md"
check_that "CLAUDE.local.md names the embedding setup row" grep -qF 'Set up embedding model' "$repo/ollama/CLAUDE.local.md"

allows_semantic_search() {
  jq -e '.permissions.allow | index("mcp__code-search__semantic_search") != null' "$1" >/dev/null
}

allows_repo_tools() {
  jq -e '.permissions.allow | index("mcp__repo") != null' "$1" >/dev/null
}

allows_read_only_dev_tools() {
  jq -e '.permissions.allow as $allowed | all(["mcp__dev__dev_status", "mcp__dev__dev_logs", "mcp__dev__dev_errors", "mcp__dev__page_check", "mcp__dev__page_snapshot", "mcp__dev__page_act"][]; . as $tool | any($allowed[]; . == $tool))' "$1" >/dev/null
}

asks_before_dev_start() {
  jq -e '.permissions.allow | all(. != "mcp__dev" and . != "mcp__dev__dev_start" and . != "mcp__dev__dev_stop")' "$1" >/dev/null
}

check_that "CLAUDE.local.md tells the model to use the repo tools" grep -qF 'mcp__repo__' "$repo/ollama/CLAUDE.local.md"
check_that "CLAUDE.local.md tells the model to use the dev tools" grep -qF 'mcp__dev__dev_status' "$repo/ollama/CLAUDE.local.md"

for settings in "$repo"/ollama/settings.*.json; do
  check_that "${settings##*/} allows semantic_search" allows_semantic_search "$settings"
  check_that "${settings##*/} allows the read-only repo tools without a prompt" allows_repo_tools "$settings"
  check_that "${settings##*/} allows the read-only dev tools without a prompt" allows_read_only_dev_tools "$settings"
  check_that "${settings##*/} asks before dev_start and dev_stop" asks_before_dev_start "$settings"
done

gates_text_search() {
  jq -e '[.hooks.PreToolUse[] | select(.matcher | test("Bash") and test("semantic_search")) | .hooks[].command] | any(test("tool-nudge"))' "$1" >/dev/null
}

for settings in "$repo"/ollama/settings.*.json; do
  check_that "${settings##*/} runs tool-nudge.py before Bash and semantic_search" gates_text_search "$settings"
done

check_eq "tool-telemetry counts the same line limit that bash-output-trim applies" \
  "$(sed -n 's/^MAX_LINES = //p' "$repo/shared/hooks/bash-output-trim.py")" \
  "$(sed -n 's/^TRIM_LINE_LIMIT = //p' "$repo/shared/hooks/tool-telemetry.py")"

check_eq "the console's fetch-domain pattern equals the launcher's" \
  "$(sed -n "s/^fetch_domain_pattern='\(.*\)'\$/\1/p" "$repo/bin/claude-ollama")" \
  "$(sed -n 's|^export const FETCH_DOMAIN_PATTERN = /\(.*\)/;$|\1|p' "$repo/web/console/src/lib/fetch-domain-rules.ts")"

agent="$repo/shared/agents/pr-review.md"
agent_frontmatter() {
  sed -n '2,/^---$/p' "$agent" | sed '$d'
}
check_eq "pr-review agent name matches its file name" pr-review "$(agent_frontmatter | sed -n 's/^name: *//p')"
check_that "pr-review agent has a description" test -n "$(agent_frontmatter | sed -n '/^description:/,/^[a-z]*:/p' | sed '$d' | sed 's/^description://' | tr -d ' \n')"
check_eq "pr-review agent lists the review tools" "Bash, Read, Grep, Glob" "$(agent_frontmatter | sed -n 's/^tools: *//p')"
check_not "pr-review agent pins no model, so --agent keeps the session model" grep -q '^model:' <<<"$(agent_frontmatter)"
check_that "pr-review agent runs fallow audit with --format json" grep -qF 'audit --base MERGE_BASE --format json' "$agent"
check_not "pr-review agent never runs npx, which can resolve PR-owned code" grep -qF 'npx' "$agent"
check_that "pr-review agent runs fallow from the work dir against the PR head" grep -qF "cd \"\$work\" && \"\$fallow_bin\" --root \"\$work/head/\$pkg\" audit" "$agent"
check_not "pr-review agent never splices a PR path into a command" grep -qF '/PKG' "$agent"
check_that "pr-review agent refuses a package path outside the allowlist" grep -qF "grep -qE '^[A-Za-z0-9._/-]+\$'" "$agent"
check_that "pr-review agent names the 250-line Read window" grep -q '250' "$agent"
check_that "pr-review agent posts only a comment review" grep -qF -- '--comment --body-file' "$agent"
check_that "pr-review agent removes its worktree" grep -qF 'worktree remove --force' "$agent"

for draft_skill in pr-draft pr-review-draft; do
  check_that "the $draft_skill skill saves through its MCP tool" grep -qF "mcp__repo__draft_" "$repo/shared/skills/$draft_skill/SKILL.md"
  check_that "claude-custom install links the $draft_skill skill" grep -qF "shared/skills/$draft_skill" "$repo/bin/claude-custom"
done
check_that "the pr-review-draft skill finds the PR from the current branch" grep -qF 'head:BRANCH' "$repo/shared/skills/pr-review-draft/SKILL.md"
check_that "CLAUDE.local.md points the model at the draft skills" grep -qF "/pr-draft" "$repo/ollama/CLAUDE.local.md"
check_that "the launcher and the console agree on the drafts folder" grep -qF '.claude-ollama/drafts' "$repo/web/console/src/lib/drafts.ts"
check_that "the launcher keeps drafts in the session config" grep -qF "drafts_dir=\"\$session_config_dir/drafts\"" "$repo/bin/claude-ollama"
draft_id_pattern="$(sed -n 's/^DRAFT_ID = re.compile(r"\(.*\)")$/\1/p' "$repo/ollama/drafts/opener.py")"
check_that "the opener and the console agree on draft ids" grep -rqF -- "${draft_id_pattern#^}" "$repo/web/console/src/lib"
for skill_dir in "$repo"/shared/skills/*/; do
  skill_name="$(basename "$skill_dir")"
  skill_frontmatter="$(sed -n '2,/^---$/p' "$skill_dir/SKILL.md" | sed '$d')"
  check_eq "$skill_name skill name matches its folder" "$skill_name" "$(sed -n 's/^name: *//p' <<<"$skill_frontmatter")"
  check_that "$skill_name skill has a description" test -n "$(sed -n '/^description:/,/^[a-z]*:/p' <<<"$skill_frontmatter" | sed 's/^description://' | tr -d ' \n')"
done

if [ "$failures" -eq 0 ]; then
  echo "all passed"
else
  echo "$failures failed"
  exit 1
fi
