#!/usr/bin/env bash
set -u
repo="$(cd "$(dirname "$0")/.." && pwd -P)"
# shellcheck source=../shared/testing/stub-llama-lib.sh
. "$repo/shared/testing/stub-llama-lib.sh"
launcher="${CONSOLE_SMOKE_LAUNCHER:-$repo/bin/claude-ollama}"
app_dir="$repo/web/console/src/app"
port=8790
keep=""
failures=0
server_pid=""
scratch=""
token=""
curl_config=""
keeping=""
smoke_model=""

parse_args() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --port)
        port="${2:-}"
        shift 2 || shift
        ;;
      --keep)
        keep=1
        shift
        ;;
      *)
        echo "console-smoke: unknown argument: $1" >&2
        exit 2
        ;;
    esac
  done
  case "$port" in
    ''|*[!0-9]*)
      echo "console-smoke: --port needs a number" >&2
      exit 2
      ;;
  esac
}

refuse_busy_port() {
  if nc -z 127.0.0.1 "$port" 2>/dev/null; then
    echo "console-smoke: port $port is already in use; pick another with --port N" >&2
    exit 2
  fi
}

prepare_scratch() {
  scratch="$(mktemp -d)" || exit 1
  export CLAUDE_CONSOLE_STATE_DIR="$scratch/console-state"
  export PR_REVIEW_LOG_DIR="$scratch/reviews"
  export XDG_CONFIG_HOME="$scratch/xdg-config"
  export CONSOLE_TOOLS_SETTINGS="$scratch/tools-settings.json"
  mkdir -p "$XDG_CONFIG_HOME"
  printf '{}\n' > "$CONSOLE_TOOLS_SETTINGS"
}

server_alive() {
  local state
  state="$(ps -o stat= -p "$server_pid" 2>/dev/null)"
  case "$state" in
    ''|Z*) return 1 ;;
  esac
  return 0
}

start_model_server() {
  smoke_model="$(jq -r '.model // empty' "$repo/ollama/settings.27b.json")"
  if [ -z "$smoke_model" ]; then
    echo "console-smoke: ollama/settings.27b.json names no model" >&2
    exit 1
  fi
  jq -n --arg id "$smoke_model" '{models: {($id): {size: 1000000, n_ctx: 65536}}}' > "$scratch/model-server.json"
  start_stub_llama "$scratch/model-server.json" || exit 1
}

start_console() {
  set -m
  "$launcher" ui --port "$port" < /dev/null > "$scratch/launcher.log" 2>&1 &
  server_pid=$!
  set +m
}

wait_for_console() {
  local token_file="$CLAUDE_CONSOLE_STATE_DIR/tokens/$port" waited=0
  while [ "$waited" -lt 180 ]; do
    if ! server_alive; then
      echo "FAIL: console exited before it answered"
      return 1
    fi
    if [ -s "$token_file" ]; then
      token="$(cat "$token_file")"
      if nc -z 127.0.0.1 "$port" 2>/dev/null; then
        return 0
      fi
    fi
    sleep 1
    waited=$((waited + 1))
  done
  echo "FAIL: console did not answer within 180 s"
  return 1
}

show_log_tail() {
  if [ -n "$token" ]; then
    tail -n 30 "$scratch/launcher.log" | sed "s|$token|<token>|g"
  else
    tail -n 30 "$scratch/launcher.log"
  fi
}

write_curl_config() {
  curl_config="$scratch/curl.conf"
  (umask 077; printf 'header = "Cookie: console_token=%s"\n' "$token" > "$curl_config")
}

fetch_status() {
  curl -s -K "$curl_config" -o "$scratch/body" -w '%{http_code}' --max-time 120 "http://127.0.0.1:$port$1" 2>/dev/null
}

post_status() {
  curl -s -K "$curl_config" -o "$scratch/body" -w '%{http_code}' --max-time 120 -X POST \
    -H "Origin: http://127.0.0.1:$port" -H 'Content-Type: application/json' --data "$2" \
    "http://127.0.0.1:$port$1" 2>/dev/null
}

report_ok() {
  echo "ok $1"
}

report_fail() {
  echo "FAIL: $1"
  failures=$((failures + 1))
}

check_token_gate() {
  local status
  status="$(curl -s -o /dev/null -w '%{http_code}' --max-time 60 "http://127.0.0.1:$port/" 2>/dev/null)"
  if [ "$status" = 401 ]; then
    report_ok "token gate"
  else
    report_fail "token gate (status $status, want 401)"
  fi
}

check_origin_guard() {
  local status
  status="$(curl -s -o /dev/null -w '%{http_code}' --max-time 60 -X POST \
    -H 'Origin: http://evil.example' -H 'Content-Type: application/json' --data '{}' \
    "http://127.0.0.1:$port/api/runs" 2>/dev/null)"
  if [ "$status" = 403 ]; then
    report_ok "origin guard"
  else
    report_fail "origin guard (status $status, want 403)"
  fi
}

check_page() {
  local route="$1" status
  status="$(fetch_status "$route")"
  if [ "$status" = 200 ]; then
    report_ok "page $route"
  else
    report_fail "page $route (status $status)"
  fi
}

check_pages() {
  local file route
  while IFS= read -r file; do
    route="${file#"$app_dir"}"
    route="${route%/page.tsx}"
    [ -n "$route" ] || route=/
    case "$route" in
      *\[*) echo "skip $route (needs a real id)" ;;
      *) check_page "$route" ;;
    esac
  done < <(find "$app_dir" -name page.tsx | sort)
  check_page /profiles/claude-code
}

check_api() {
  local api_path="$1" status
  status="$(fetch_status "$api_path")"
  if [ "$status" = 200 ] && jq -e . "$scratch/body" >/dev/null 2>&1; then
    report_ok "api $api_path"
  else
    report_fail "api $api_path (status $status)"
  fi
}

check_apis() {
  local api_path
  while IFS= read -r api_path; do
    check_api "$api_path"
  done <<'APIS'
/api/project
/api/sizes
/api/config?size=27b
/api/models
/api/history
/api/runs
/api/reviews
/api/drafts
/api/tools
/api/profiles
/api/telemetry
/api/tool-budget
/api/speed-reports
/api/server
/api/logs/path
/api/machine
/api/workspaces
APIS
}

check_ping() {
  local status state
  status="$(fetch_status /api/server/ping)"
  state="$(jq -r '.state // empty' "$scratch/body" 2>/dev/null)"
  if [ "$status" = 200 ] && [ "$state" = up ]; then
    report_ok "api /api/server/ping"
  else
    report_fail "api /api/server/ping (status $status, state ${state:-none}, want up)"
  fi
}

stub_model_status() {
  curl -s --max-time 10 "$LLAMA_SERVER_URL/models" |
    jq -r --arg id "$smoke_model" '.data[] | select(.id == $id) | .status.value' 2>/dev/null
}

check_model_route() {
  local action="$1" want="$2" status got
  status="$(post_status "/api/models/$action" "$(jq -cn --arg id "$smoke_model" '{model: $id}')")"
  if [ "$status" != 200 ]; then
    report_fail "api /api/models/$action (status $status)"
    return
  fi
  got="$(stub_model_status)"
  if [ "$got" = "$want" ]; then
    report_ok "api /api/models/$action"
  else
    report_fail "api /api/models/$action ($smoke_model is ${got:-missing}, want $want)"
  fi
}

check_model_routes() {
  check_model_route load loaded
  check_model_route unload unloaded
}

keep_console() {
  keeping=1
  echo "console kept running: http://127.0.0.1:$port/?token=$token"
  echo "model server stub: $LLAMA_SERVER_URL (pid $stub_llama_pid)"
  echo "stop it with: kill -TERM -- -$server_pid; kill $stub_llama_pid (scratch dir: $scratch)"
}

finish() {
  if [ "$failures" -ne 0 ]; then
    echo "$failures failed"
    return 1
  fi
  echo "all passed"
  if [ -n "$keep" ]; then
    keep_console
  fi
}

stop_console() {
  if [ -n "$server_pid" ]; then
    kill -TERM -- "-$server_pid" 2>/dev/null
    wait "$server_pid" 2>/dev/null
  fi
}

cleanup() {
  if [ -z "$keeping" ]; then
    stop_console
    stop_stub_llama
    [ -z "$scratch" ] || rm -rf "$scratch"
  fi
}

main() {
  parse_args "$@"
  refuse_busy_port
  prepare_scratch
  start_model_server
  start_console
  if ! wait_for_console; then
    show_log_tail
    exit 1
  fi
  write_curl_config
  check_token_gate
  check_origin_guard
  check_pages
  check_apis
  check_ping
  check_model_routes
  finish
}

trap cleanup EXIT
main "$@"
