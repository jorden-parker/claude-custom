class ReviewError(Exception):
    pass


@dataclasses.dataclass
class ReviewConfig:
    target: str | None
    commit_range: str | None
    model: str
    base_url: str
    auth_token: str
    full_file_lines: int
    prompt_chars: int
    max_tokens: int
    heartbeat_seconds: float
    post: bool
    as_json: bool
    color: str
    log_dir: str | None
    no_log: bool


@dataclasses.dataclass
class Finding:
    label: str
    blocking: bool
    path: str
    line: int | None
    summary: str
    why: str
    confidence: str


@dataclasses.dataclass
class Note:
    path: str
    note: str


@dataclasses.dataclass
class Source:
    path: str
    diff: str
    line_count: int
    text: str | None
    languages: tuple


@dataclasses.dataclass
class FallowResult:
    status: str
    lines: list

    @property
    def failed(self):
        return self.status == "fail"


@dataclasses.dataclass
class Review:
    meta: dict
    verdict: str
    summary: str
    findings: list
    checks: str
    fallow: FallowResult
    notes: list


def positive_int(text):
    value = int(text)
    if value < 1:
        raise argparse.ArgumentTypeError("must be at least 1")
    return value


def positive_float(text):
    value = float(text)
    if value <= 0:
        raise argparse.ArgumentTypeError("must be above 0")
    return value


def parse_args(argv):
    parser = argparse.ArgumentParser(
        description="Review a GitHub pull request, or local commits with --range BASE..HEAD, with a local /v1/messages model, one file per request."
    )
    parser.add_argument(
        "target",
        nargs="?",
        default=None,
        help="pull request number, URL or branch, as gh accepts it",
    )
    parser.add_argument("--range", dest="commit_range", help="review local commits BASE..HEAD instead")
    parser.add_argument("--model", required=True)
    parser.add_argument("--base-url", default=DEFAULT_BASE_URL)
    parser.add_argument("--auth-token", default=DEFAULT_AUTH_TOKEN)
    parser.add_argument("--full-file-lines", type=positive_int, default=DEFAULT_FULL_FILE_LINES)
    parser.add_argument("--prompt-chars", type=positive_int, default=DEFAULT_PROMPT_CHARS)
    parser.add_argument("--max-tokens", type=positive_int, default=DEFAULT_MAX_TOKENS)
    parser.add_argument("--heartbeat-seconds", type=positive_float, default=DEFAULT_HEARTBEAT_SECONDS)
    parser.add_argument("--post", action="store_true")
    parser.add_argument("--json", dest="as_json", action="store_true")
    parser.add_argument("--color", choices=("auto", "always", "never"), default="auto")
    parser.add_argument("--log-dir", default=None, help="directory for the event log (one JSON line per event)")
    parser.add_argument("--no-log", action="store_true", help="do not write the event log")
    options = parser.parse_args(argv)
    if (options.target is None) == (options.commit_range is None):
        parser.error("give a pull request or --range BASE..HEAD")
    if options.commit_range is not None and options.post:
        parser.error("--post needs a pull request")
    return ReviewConfig(**vars(options))


def capture(args, cwd=None, stdin=None):
    try:
        return subprocess.run(
            args, cwd=cwd, input=stdin, capture_output=True, text=True, check=False
        )
    except OSError as error:
        return subprocess.CompletedProcess(args, 127, "", str(error))


def run(args, cwd=None, stdin=None):
    completed = capture(args, cwd, stdin)
    if completed.returncode != 0:
        raise ReviewError(f"{args[0]} failed: {completed.stderr.strip()}")
    return completed.stdout


def load_json(text, source):
    try:
        return json.loads(text)
    except ValueError as error:
        raise ReviewError(f"{source} returned no JSON") from error


def live_page_link(log_path):
    try:
        base = (log_path.parent / WEB_URL_FILE).read_text(encoding="utf-8").strip()
    except (OSError, ValueError):
        return None
    if not base:
        return None
    return f"{base.rstrip('/')}/reviews/{log_path.stem}"


class JsonlLog:
    def __init__(self, path, handle):
        self.path = path
        self.handle = handle

    @classmethod
    def create(cls, directory, slug):
        directory.mkdir(parents=True, exist_ok=True)
        directory.chmod(PRIVATE_DIRECTORY_MODE)
        stamp = datetime.datetime.now(datetime.UTC).strftime("%Y%m%d-%H%M%S")
        for number in itertools.count(1):
            suffix = "" if number == 1 else f"-{number}"
            path = directory / f"{stamp}-{slug}{suffix}.jsonl"
            try:
                descriptor = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, PRIVATE_FILE_MODE)
            except FileExistsError:
                continue
            return cls(path, os.fdopen(descriptor, "w", encoding="utf-8"))

    def write(self, event):
        self.handle.write(json.dumps(event) + "\n")
        self.handle.flush()


class Reporter:
    def __init__(self, terminal, log_directory):
        self.terminal = terminal
        self.log_directory = log_directory
        self.log = None
        self.lock = threading.Lock()
        self.started_at = time.perf_counter()

    def emit(self, kind, **fields):
        event = {"t": round(time.perf_counter() - self.started_at, 2), "kind": kind, **fields}
        with self.lock:
            self.terminal.handle(event)
            self.write_log(event)

    def write_log(self, event):
        if self.log is None:
            return
        try:
            self.log.write(event)
        except OSError as error:
            self.log = None
            self.terminal.handle({"kind": "stage", "message": f"event log disabled: {error}"})

    def stage(self, message):
        self.emit("stage", message=message)

    def announce(self, message):
        with self.lock:
            self.terminal.handle({"kind": "stage", "message": message})

    def begin(self, slug, name, title, model, base_url):
        if self.log_directory is not None:
            self.open_log(slug)
        self.emit("start", name=name, title=title, model=model, base_url=base_url)
        if self.log is not None:
            self.announce(f"log {self.log.path}")
            live_link = live_page_link(self.log.path)
            if live_link is not None:
                self.announce(f"live at {live_link}")

    def open_log(self, slug):
        try:
            self.log = JsonlLog.create(self.log_directory, slug)
        except OSError as error:
            self.stage(f"event log disabled: {error}")


class TerminalRenderer:
    def __init__(self, stream, color):
        self.stream = stream
        self.color = color
        self.tag = None
        self.findings = 0
        self.spinner = 0
        self.status_shown = False
        self.handlers = {
            "stage": self.show_stage,
            "waiting": self.show_waiting,
            "writing": self.show_writing,
            "file_start": self.show_file_start,
            "finding": self.show_finding,
            "retry": self.show_retry,
            "file_done": self.show_file_done,
            "summary": self.show_summary,
            "verdict": self.show_verdict,
            "error": self.show_error,
        }

    def handle(self, event):
        handler = self.handlers.get(event["kind"])
        if handler is not None:
            handler(event)

    def paint(self, text, code):
        return ansi(text, code) if self.color else text

    def prefix(self):
        return self.paint("pr-review-local:", DIM)

    def shown_tag(self):
        return self.paint(self.tag, BOLD)

    def with_tag(self, text):
        return f"{self.shown_tag()}: {text}" if self.tag else text

    def line(self, text):
        if self.status_shown:
            self.stream.write(CLEAR_STATUS)
            self.status_shown = False
        print(text, file=self.stream, flush=True)

    def status(self, text):
        self.spinner = (self.spinner + 1) % len(SPINNER_FRAMES)
        columns = shutil.get_terminal_size(fallback=(80, 24)).columns
        frame = fit_to_columns(f"  {SPINNER_FRAMES[self.spinner]} {text}", columns)
        self.stream.write(f"{CLEAR_STATUS}{frame}")
        self.stream.flush()
        self.status_shown = True

    def show_stage(self, event):
        self.line(f"{self.prefix()} {self.paint(event['message'], BOLD)}")

    def show_waiting(self, event):
        text = f"waiting for the first token, {event['seconds']:.1f}s"
        if self.color:
            self.status(self.with_tag(text))
        else:
            self.line(f"{self.prefix()} {text}")

    def show_writing(self, event):
        if self.color:
            found = f"{self.findings} {'finding' if self.findings == 1 else 'findings'}"
            self.status(f"{self.shown_tag()}: writing, {event['chars']} chars, {found} so far")

    def show_file_start(self, event):
        self.tag = f"[{event['index']}/{event['total']}] {event['path']}"
        self.findings = 0
        self.line(f"{self.shown_tag()}: reviewing, {event['chars']} chars")

    def show_finding(self, event):
        finding = Finding(**event["finding"])
        self.findings += 1
        where = f"{finding.path}:{finding.line}" if finding.line is not None else finding.path
        text = label_text(finding)
        label = self.paint(text, LABEL_COLORS.get(text, BOLD))
        self.line(f"{self.shown_tag()}:   {label}  {where}  {finding.summary}")

    def show_retry(self, event):
        self.line(f"{self.shown_tag()}: retrying, the answer was not a JSON array")
        reply = event["reply"].replace("\n", " ")
        self.line(f"{self.shown_tag()}:   reply was: {reply}")

    def show_file_done(self, event):
        self.line(f"{self.shown_tag()}: {event['outcome']} in {event['seconds']:.1f}s")
        self.tag = None

    def show_summary(self, event):
        self.line(event["text"])

    def show_verdict(self, event):
        verdict = self.paint(event["verdict"], VERDICT_COLORS.get(event["verdict"], BOLD))
        self.line(f"{self.prefix()} {verdict} after {event['seconds']:.1f}s")

    def show_error(self, event):
        self.line(f"{self.prefix()} {event['message']}")


def ansi(text, code):
    return f"\033[{code}m{text}\033[0m"


def fit_to_columns(text, columns):
    limit = columns - 1
    if len(ANSI_SEQUENCE.sub("", text)) <= limit:
        return text
    budget = max(limit - 1, 0)
    pieces = []
    for index, part in enumerate(ANSI_SEQUENCE.split(text)):
        if index % 2:
            pieces.append(part)
        else:
            kept = part[:budget]
            pieces.append(kept)
            budget -= len(kept)
    return "".join(pieces) + "\033[0m…"


def styled_report_line(line):
    heading = HEADING_LINE.match(line)
    if heading:
        return ansi(heading.group(1), BOLD)
    line = VERDICT_WORD.sub(lambda match: match.group(1) + ansi(match.group(2), VERDICT_COLORS[match.group(2)]), line)
    return LABEL_PREFIX.sub(lambda match: ansi(match.group(1) + ":", LABEL_COLORS.get(match.group(1), BOLD)), line)


def styled_report(report):
    return "\n".join(styled_report_line(line) for line in report.splitlines())


def wants_color(mode, stream):
    if mode == "always":
        return True
    if mode == "never":
        return False
    return stream.isatty() and "NO_COLOR" not in os.environ and os.environ.get("TERM") != "dumb"


class ArrayObjectScanner:
    def __init__(self):
        self.depth = 0
        self.in_string = False
        self.escaped = False
        self.object_chars = None

    def feed(self, text):
        completed = [self.consume(character) for character in text]
        return [object_text for object_text in completed if object_text is not None]

    def consume(self, character):
        if self.depth == 0:
            self.depth = 1 if character == "[" else 0
            return None
        if self.in_string:
            self.update_string(character)
        elif character == '"':
            self.in_string = True
        elif character in "[{":
            self.depth += 1
            if character == "{" and self.depth == 2:
                self.object_chars = []
        elif character in "]}":
            self.depth -= 1
            if character == "}" and self.depth == 1:
                self.record(character)
                return self.take_object()
        self.record(character)
        return None

    def update_string(self, character):
        if self.escaped:
            self.escaped = False
        elif character == "\\":
            self.escaped = True
        elif character == '"':
            self.in_string = False

    def record(self, character):
        if self.object_chars is not None:
            self.object_chars.append(character)

    def take_object(self):
        object_text = "".join(self.object_chars)
        self.object_chars = None
        return object_text


class AnswerStream:
    def __init__(self, reporter, index, path):
        self.reporter = reporter
        self.index = index
        self.path = path
        self.scanner = ArrayObjectScanner()
        self.chars = 0
        self.last_writing_at = None

    def __call__(self, text):
        self.chars += len(text)
        for object_text in self.scanner.feed(text):
            self.report_finding(object_text)
        self.report_writing()

    def report_finding(self, object_text):
        try:
            item = json.loads(object_text)
        except ValueError:
            return
        if not isinstance(item, dict):
            return
        finding = finding_from(item, self.path)
        self.reporter.emit("finding", index=self.index, path=self.path, finding=dataclasses.asdict(finding))

    def report_writing(self):
        now = time.perf_counter()
        if self.last_writing_at is not None and now - self.last_writing_at < WRITING_INTERVAL_SECONDS:
            return
        self.last_writing_at = now
        self.reporter.emit("writing", index=self.index, path=self.path, chars=self.chars)


def ignore_text(text):
    return None


def repo_root():
    completed = capture(["git", "rev-parse", "--show-toplevel"])
    if completed.returncode != 0:
        raise ReviewError("not inside a git repository")
    return Path(completed.stdout.strip())


def pr_metadata(root, target):
    return load_json(run(["gh", "pr", "view", target, "--json", PR_FIELDS], root), "gh pr view")


def fetch_head(root, meta, ref):
    number, base = meta["number"], meta["baseRefName"]
    run(["git", "fetch", "-q", "origin", f"refs/pull/{number}/head:{ref}", base], root)
    return run(["git", "merge-base", ref, f"origin/{base}"], root).strip()


def changed_paths(root, merge_base, ref):
    return run(["git", "diff", "--name-only", merge_base, ref], root).splitlines()


def git_blob(root, ref, path):
    completed = subprocess.run(
        ["git", "show", f"{ref}:{path}"], cwd=root, capture_output=True, check=False
    )
    return completed.stdout if completed.returncode == 0 else None


def skip_reason(path, blob):
    if blob is None:
        return "deleted"
    if b"\0" in blob:
        return "binary"
    if any(part in path for part in SKIPPED_PATH_PARTS) or path.endswith(SKIPPED_SUFFIXES):
        return "generated or vendored path"
    return None


def numbered_line(number, text):
    return f"{number:>{NUMBER_WIDTH}} | {text}"


def blank_numbered_line(text):
    return f"{'':>{NUMBER_WIDTH}} | {text}"


def numbered_file(text):
    return "\n".join(
        numbered_line(number, line) for number, line in enumerate(text.splitlines(), start=1)
    )


def numbered_diff(diff):
    numbered, next_number = [], None
    for line in diff.split("\n"):
        hunk = HUNK_HEADER.match(line)
        if hunk:
            next_number = int(hunk.group(1))
            numbered.append(line)
        elif next_number is None or line.startswith("\\"):
            numbered.append(line)
        elif line.startswith("-"):
            numbered.append(blank_numbered_line(line))
        elif line.startswith((" ", "+")):
            numbered.append(numbered_line(next_number, line))
            next_number += 1
        else:
            numbered.append(line)
    return "\n".join(numbered)


def is_doc(path):
    return path.endswith(DOC_SUFFIXES)


def is_test_path(path):
    name = Path(path).name
    directories = Path(path).parts[:-1]
    return (
        name.startswith("test_")
        or any(mark in name for mark in TEST_NAME_MARKS)
        or any(part in TEST_DIR_PARTS for part in directories)
    )


def language_by_shebang(first_line):
    if not first_line.startswith("#!"):
        return None
    for marker, language in SHEBANG_LANGUAGES:
        if marker in first_line:
            return language
    return None


def language_of(path, first_line):
    return SUFFIX_LANGUAGES.get(Path(path).suffix) or language_by_shebang(first_line)


def languages_for(path, first_line):
    languages = ["test"] if is_test_path(path) else []
    language = language_of(path, first_line)
    if language is not None:
        languages.append(language)
    return tuple(languages)


def whole_text_for(path, text, line_count, limit):
    if is_doc(path) or line_count > limit:
        return None
    return numbered_file(text)


def source_for(root, merge_base, ref, path, blob, limit):
    text = blob.decode("utf-8", errors="replace")
    line_count = len(text.splitlines())
    diff = run(["git", "diff", f"-U{DIFF_CONTEXT_LINES}", merge_base, ref, "--", path], root)
    languages = languages_for(path, text.partition("\n")[0])
    return Source(path, numbered_diff(diff), line_count, whole_text_for(path, text, line_count, limit), languages)


def gather_sources(root, merge_base, ref, paths, limit):
    sources, notes = [], []
    for path in paths:
        blob = git_blob(root, ref, path)
        reason = skip_reason(path, blob)
        if reason:
            notes.append(Note(path, f"skipped ({reason})"))
        else:
            sources.append(source_for(root, merge_base, ref, path, blob, limit))
    return sources, notes


def existing_comments(root, number):
    completed = capture(
        [
            "gh",
            "api",
            f"repos/{{owner}}/{{repo}}/pulls/{number}/comments",
            "--paginate",
            "--jq",
            COMMENTS_JQ,
        ],
        root,
    )
    if completed.returncode != 0:
        return ""
    return completed.stdout.strip()


def check_buckets(text):
    try:
        return [check["bucket"] for check in json.loads(text)]
    except (ValueError, KeyError, TypeError):
        return None


def check_summary(root, target):
    completed = capture(["gh", "pr", "checks", target, "--json", "name,bucket"], root)
    buckets = check_buckets(completed.stdout)
    if buckets is None:
        return "CI unavailable"
    counts = {name: buckets.count(name) for name in ("pass", "fail", "pending")}
    return f"CI {counts['pass']} pass, {counts['fail']} fail, {counts['pending']} pending"


def nearest_package_dir(root, path):
    directory = (root / path).parent
    while not (directory / "package.json").is_file():
        if directory == root or directory.parent == directory:
            return None
        directory = directory.parent
    return directory


def fallow_runner(package_dir):
    found = shutil.which("fallow")
    if found:
        return [found]
    local = package_dir / "node_modules" / ".bin" / "fallow"
    if os.access(local, os.X_OK):
        return [str(local)]
    return ["npx", "-y", "fallow"]


def parse_json_object(text):
    try:
        value = json.loads(text)
    except ValueError:
        return None
    return value if isinstance(value, dict) else None


def fallow_error(completed, report):
    if report is not None and "error" in report:
        return str(report["error"])
    tail = completed.stderr.strip().splitlines()
    return tail[-1] if tail else f"exit status {completed.returncode}"


def fallow_lines(report_text):
    library = Path(__file__).resolve().parent.parent / FALLOW_LIB
    program = run(["bash", "-c", 'source "$1" && fallow_report_filter', "_", str(library)])
    return run(["jq", "-r", program], stdin=report_text).splitlines()


def audit_in_package(package_dir, merge_base):
    args = [*fallow_runner(package_dir), "audit", "--base", merge_base, "--format", "json", "--quiet"]
    completed = capture(args, package_dir)
    report = parse_json_object(completed.stdout)
    if completed.returncode == FALLOW_USAGE_EXIT_CODE or report is None or "error" in report:
        return FallowResult(f"did not run: {fallow_error(completed, report)}", [])
    return FallowResult(str(report.get("verdict", "unknown")), fallow_lines(completed.stdout))


def link_node_modules(package_dir, head_package_dir):
    user_modules = package_dir / "node_modules"
    if user_modules.exists():
        (head_package_dir / "node_modules").symlink_to(user_modules)


def audit_at_head(root, package_dir, merge_base, ref):
    temp_dir = Path(tempfile.mkdtemp(prefix="pr-review-fallow-"))
    worktree = temp_dir / "head"
    try:
        run(["git", "worktree", "add", "-q", "--detach", str(worktree), ref], root)
        head_package_dir = worktree / package_dir.relative_to(root)
        link_node_modules(package_dir, head_package_dir)
        return audit_in_package(head_package_dir, merge_base)
    finally:
        capture(["git", "worktree", "remove", "--force", str(worktree)], root)
        shutil.rmtree(temp_dir, ignore_errors=True)


def fallow_result(root, merge_base, ref, paths, reporter):
    typescript = [path for path in paths if path.endswith(TYPESCRIPT_SUFFIXES)]
    if not typescript:
        return FallowResult(NOT_RUN_NO_TYPESCRIPT, [])
    package_dir = nearest_package_dir(root, typescript[0])
    if package_dir is None:
        return FallowResult("did not run: no package.json above the changed TypeScript", [])
    reporter.stage(f"running Fallow in {package_dir.relative_to(root)} at the PR head")
    return audit_at_head(root, package_dir, merge_base, ref)


def review_name(meta):
    if meta["number"] is not None:
        return f"PR #{meta['number']}"
    return meta["name"]


def review_slug(meta):
    if meta["number"] is not None:
        return f"pr-{meta['number']}"
    return re.sub(r"[^A-Za-z0-9._-]", "-", meta["name"])


def prompt_head(meta, path, comments):
    return (
        f"{review_name(meta)}: {meta['title']}\n\n"
        f"Description:\n{meta.get('body') or '(none)'}\n\n"
        f"Already raised by reviewers:\n{comments or '(none)'}\n\n"
        f"File: {path}\n\n"
        f"Diff against {meta['baseRefName']}:\n"
    )


def omitted_section(source, limit):
    if is_doc(source.path):
        return DOC_OMITTED_NOTE
    return f"Whole file omitted: {source.line_count} lines, over the {limit}-line limit."


def whole_file_section(source, limit):
    if source.text is None:
        return omitted_section(source, limit)
    return f"Whole file at the PR head ({source.line_count} lines):\n{source.text}"


def compose_prompt(head, diff, tail):
    return f"{head}{diff}\n{tail}"


def fit_prompt(head, diff, tail, omitted, limit):
    prompt = compose_prompt(head, diff, tail)
    if len(prompt) <= limit:
        return prompt, False
    prompt = compose_prompt(head, diff, omitted)
    if len(prompt) <= limit:
        return prompt, False
    room = limit - len(compose_prompt(head, "", omitted)) - len(TRUNCATED_MARK)
    return compose_prompt(head, diff[: max(room, 0)] + TRUNCATED_MARK, omitted), True


def build_prompt(config, meta, comments, source):
    return fit_prompt(
        prompt_head(meta, source.path, comments),
        source.diff,
        whole_file_section(source, config.full_file_lines),
        omitted_section(source, config.full_file_lines),
        config.prompt_chars,
    )


def request_headers(auth_token):
    return {
        "content-type": "application/json",
        "anthropic-version": ANTHROPIC_VERSION,
        "x-api-key": auth_token,
        "authorization": f"Bearer {auth_token}",
    }


def parse_event(payload):
    try:
        return json.loads(payload)
    except json.JSONDecodeError as error:
        raise ReviewError(f"malformed SSE data: {payload[:80]}") from error


def iter_events(lines):
    data_lines = []
    for raw_line in lines:
        line = raw_line.decode("utf-8").rstrip("\r\n")
        if line.startswith("data:"):
            data_lines.append(line[len("data:"):].lstrip())
        elif line == "" and data_lines:
            yield parse_event("\n".join(data_lines))
            data_lines = []
    if data_lines:
        yield parse_event("\n".join(data_lines))


def is_text_delta(event):
    return event.get("type") == "content_block_delta" and event.get("delta", {}).get("type") == "text_delta"


def collect_text(events, on_text):
    pieces = []
    for event in events:
        if event.get("type") == "error":
            raise ReviewError(f"server sent an error event: {event.get('error')}")
        if is_text_delta(event):
            text = event["delta"].get("text", "")
            on_text(text)
            pieces.append(text)
    return "".join(pieces)


class Heartbeat:
    def __init__(self, interval, reporter):
        self.interval = interval
        self.reporter = reporter
        self.started_at = time.perf_counter()
        self.stopped = threading.Event()
        self.thread = threading.Thread(target=self.beat, daemon=True)

    def beat(self):
        while not self.stopped.wait(self.interval):
            self.reporter.emit("waiting", seconds=round(time.perf_counter() - self.started_at, 1))

    def stop(self):
        self.stopped.set()
        if self.thread.is_alive():
            self.thread.join()

    def __enter__(self):
        self.thread.start()
        return self

    def __exit__(self, *exc_info):
        self.stop()


def http_error_detail(error):
    try:
        body = error.read().decode("utf-8", errors="replace")
    except OSError:
        return ""
    try:
        parsed = json.loads(body)
    except ValueError:
        return body.strip()[:300]
    if isinstance(parsed, dict) and isinstance(parsed.get("error"), dict):
        message = parsed["error"].get("message")
        if isinstance(message, str):
            return message
    return body.strip()[:300]


def stop_waiting_on_first(heartbeat, on_text):
    def on_delta(text):
        heartbeat.stop()
        on_text(text)

    return on_delta


def request_text(config, reporter, system, user, max_tokens, on_text):
    url = config.base_url.rstrip("/") + "/v1/messages"
    body = {
        "model": config.model,
        "max_tokens": max_tokens,
        "temperature": TEMPERATURE,
        "stream": True,
        "system": system,
        "thinking": {"type": "disabled"},
        "messages": [{"role": "user", "content": user}],
    }
    request = urllib.request.Request(
        url,
        data=json.dumps(body).encode("utf-8"),
        headers=request_headers(config.auth_token),
        method="POST",
    )
    with Heartbeat(config.heartbeat_seconds, reporter) as heartbeat:
        try:
            with urllib.request.urlopen(request, timeout=REQUEST_TIMEOUT_SECONDS) as response:
                return collect_text(iter_events(response), stop_waiting_on_first(heartbeat, on_text))
        except urllib.error.HTTPError as error:
            detail = http_error_detail(error)
            suffix = f": {detail}" if detail else ""
            raise ReviewError(f"{url} answered HTTP {error.code}{suffix}") from error
        except (OSError, http.client.HTTPException) as error:
            raise ReviewError(f"request to {url} failed: {error}") from error


def finding_from(item, path):
    confidence = item.get("confidence")
    if confidence not in CONFIDENCE_ORDER:
        confidence = UNSTATED_CONFIDENCE
    label = item.get("label")
    if label not in LABELS:
        label = "question"
    finding_path = item.get("path", path)
    blocking = label == "issue" and item.get("blocking") is True and not is_doc(str(finding_path))
    if confidence == "low" and label != "praise":
        label, blocking = "question", False
    line = item.get("line")
    return Finding(
        label=label,
        blocking=blocking,
        path=finding_path,
        line=line if isinstance(line, int) else None,
        summary=str(item.get("summary", "")),
        why=str(item.get("why", "")),
        confidence=confidence,
    )


def is_list_of_objects(value):
    return isinstance(value, list) and all(isinstance(item, dict) for item in value)


def find_findings_array(reply):
    decoder = json.JSONDecoder()
    first_empty = None
    for index, character in enumerate(reply):
        if character != "[":
            continue
        try:
            value, _ = decoder.raw_decode(reply, index)
        except ValueError:
            continue
        if not is_list_of_objects(value):
            continue
        if value:
            return value
        if first_empty is None:
            first_empty = value
    if first_empty is not None:
        return first_empty
    raise ValueError("no JSON array of objects in the reply")


def parse_findings(reply, path):
    items = find_findings_array(reply)
    return [finding_from(item, path) for item in items[:MAX_FINDINGS_PER_FILE]]


def system_prompt_for(source):
    if is_doc(source.path):
        return f"{FILE_SYSTEM_PROMPT}\n\n{DOC_SYSTEM_NOTE}"
    notes = [LANGUAGE_NOTES[name] for name in source.languages if name in LANGUAGE_NOTES]
    if not notes:
        return FILE_SYSTEM_PROMPT
    return f"{FILE_SYSTEM_PROMPT}\n\n" + "\n".join(notes)


def ask_model(config, reporter, system, prompt, index, path):
    stream = AnswerStream(reporter, index, path)
    return request_text(config, reporter, system, prompt, config.max_tokens, stream)


def review_prompt_answer(config, reporter, system, prompt, path, index):
    reply = ask_model(config, reporter, system, prompt, index, path)
    try:
        return parse_findings(reply, path)
    except ValueError:
        reporter.emit("retry", index=index, path=path, reply=reply[:RETRY_REPLY_CHARS])
    reply = ask_model(config, reporter, system, prompt + RETRY_NOTE, index, path)
    return parse_findings(reply, path)


def review_source(config, reporter, meta, comments, source, index, total):
    started_at = time.perf_counter()
    prompt, truncated = build_prompt(config, meta, comments, source)
    reporter.emit("file_start", index=index, total=total, path=source.path, chars=len(prompt))
    try:
        found = review_prompt_answer(config, reporter, system_prompt_for(source), prompt, source.path, index)
    except ValueError:
        found = None
    seconds = time.perf_counter() - started_at
    outcome = f"{len(found)} findings" if found is not None else "unparsable answer"
    reporter.emit("file_done", index=index, total=total, path=source.path, outcome=outcome, seconds=round(seconds, 1))
    return found, truncated


def review_sources(config, reporter, meta, comments, sources):
    findings, notes = [], []
    for index, source in enumerate(sources, start=1):
        found, truncated = review_source(config, reporter, meta, comments, source, index, len(sources))
        if truncated:
            notes.append(Note(source.path, TRUNCATED_NOTE))
        if found is None:
            notes.append(Note(source.path, "skipped (unparsable answer)"))
        else:
            findings.extend(found)
    return findings, notes


def verdict_for(findings):
    if any(finding.blocking for finding in findings):
        return "REQUEST CHANGES"
    if any(finding.label in ("issue", "suggestion", "question") for finding in findings):
        return "APPROVE WITH COMMENTS"
    return "APPROVE"


def location(finding):
    if not finding.path:
        return ""
    if finding.line is None:
        return f"`{finding.path}`"
    return f"`{finding.path}:{finding.line}`"


def finding_brief(finding):
    where = location(finding).strip("`") or "no location"
    return f"{finding.label}, {where}: {finding.summary}"


def summary_sentence(config, reporter, meta, verdict, findings):
    brief = "\n".join(finding_brief(finding) for finding in findings) or "(none)"
    prompt = (
        f"{review_name(meta)}: {meta['title']}\n\n"
        f"Description:\n{meta.get('body') or '(none)'}\n\n"
        f"Verdict: {verdict}\n\nFindings:\n{brief}"
    )
    try:
        reply = request_text(config, reporter, SUMMARY_SYSTEM_PROMPT, prompt, SUMMARY_MAX_TOKENS, ignore_text)
    except ReviewError as error:
        reporter.stage(f"summary failed: {error}")
        return f"Summary unavailable: {error}."
    lines = reply.strip().splitlines()
    summary = lines[0] if lines else "Summary unavailable: the reply was empty."
    reporter.emit("summary", text=summary)
    return summary


def fallow_failure_finding():
    return Finding("issue", True, "fallow", None, "Fallow audit failed", "see the Fallow section", "high")


def review_comments(root, meta, reporter):
    if meta["number"] is None:
        return ""
    reporter.stage("reading review comments already on the PR")
    return existing_comments(root, meta["number"])


def ci_checks(root, config, meta, reporter):
    if meta["number"] is None:
        return NOT_CHECKED_LOCAL_RANGE
    reporter.stage("reading CI checks")
    return check_summary(root, config.target)


def build_review(config, reporter, root, meta, ref, merge_base):
    paths = changed_paths(root, merge_base, ref)
    sources, notes = gather_sources(root, merge_base, ref, paths, config.full_file_lines)
    reporter.stage(f"{len(sources)} files to review, {len(notes)} skipped")
    comments = review_comments(root, meta, reporter)
    findings, review_notes = review_sources(config, reporter, meta, comments, sources)
    fallow = fallow_result(root, merge_base, ref, paths, reporter)
    reporter.stage(f"Fallow {fallow.status}")
    if fallow.failed:
        findings.append(fallow_failure_finding())
    verdict = verdict_for(findings)
    reporter.stage("writing the summary")
    summary = summary_sentence(config, reporter, meta, verdict, findings)
    checks = ci_checks(root, config, meta, reporter)
    return Review(
        meta=meta,
        verdict=verdict,
        summary=summary,
        findings=findings,
        checks=checks,
        fallow=fallow,
        notes=notes + review_notes,
    )


def review_pull_request(config, reporter):
    root = repo_root()
    reporter.stage(f"looking up PR {config.target}")
    meta = pr_metadata(root, config.target)
    reporter.begin(review_slug(meta), review_name(meta), meta["title"], config.model, config.base_url)
    ref = REVIEW_REF.format(number=meta["number"])
    try:
        reporter.stage(f"fetching PR #{meta['number']} and {meta['baseRefName']}")
        merge_base = fetch_head(root, meta, ref)
        return build_review(config, reporter, root, meta, ref, merge_base)
    finally:
        capture(["git", "update-ref", "-d", ref], root)


def split_range(commit_range):
    parts = commit_range.split("..")
    if len(parts) != 2 or not all(parts):
        raise ReviewError("--range must be BASE..HEAD")
    return parts


def review_range(config, reporter):
    root = repo_root()
    base, head = split_range(config.commit_range)
    reporter.stage(f"reviewing {base}..{head}")
    base_rev = run(["git", "rev-parse", "--verify", f"{base}^{{commit}}"], root).strip()
    head_rev = run(["git", "rev-parse", "--verify", f"{head}^{{commit}}"], root).strip()
    merge_base = run(["git", "merge-base", base_rev, head_rev], root).strip()
    meta = {
        "number": None,
        "name": f"{base}..{head}",
        "title": run(["git", "log", "-1", "--format=%s", head_rev], root).strip(),
        "body": run(["git", "log", "-1", "--format=%b", head_rev], root).strip(),
        "baseRefName": base,
    }
    reporter.begin(review_slug(meta), review_name(meta), meta["title"], config.model, config.base_url)
    reporter.stage("local range: no review comments or CI to read")
    return build_review(config, reporter, root, meta, head_rev, merge_base)


def label_text(finding):
    if finding.label == "issue":
        return "issue (blocking)" if finding.blocking else "issue (non-blocking)"
    if finding.label == "suggestion":
        return "suggestion (non-blocking)"
    if finding.label == "nitpick":
        return "nitpick (if-minor)"
    return finding.label


def finding_lines(finding):
    head = f"- **{label_text(finding)}:** {finding.summary}"
    where = location(finding)
    if where:
        head += f" — {where}"
    lines = [head]
    if finding.why:
        lines.append(f"  {finding.why}")
    return lines


def ranked(findings):
    return sorted(findings, key=lambda finding: CONFIDENCE_ORDER.index(finding.confidence))


def section(title, findings):
    if not findings:
        return []
    lines = [f"### {title}", ""]
    for finding in ranked(findings):
        lines.extend(finding_lines(finding))
    return lines + [""]


def fallow_section(fallow):
    if not fallow.lines:
        return []
    return ["### Fallow", "", *fallow.lines, ""]


def not_checked_section(notes):
    lines = [
        "### Not checked",
        "",
        "- Cross-file effects: each file was reviewed on its own; callers in other files were not read.",
    ]
    lines.extend(f"- {note.path}: {note.note}" for note in notes)
    lines.append("- Findings with low confidence are listed as questions.")
    return lines


def render_report(config, review):
    meta = review.meta
    findings = review.findings
    lines = [
        f"## {review_name(meta)}: {meta['title']}",
        "",
        f"**Verdict:** {review.verdict}. {review.summary}",
        f"**Checks:** {review.checks}; Fallow {review.fallow.status}.",
        "**Spec:** reviewed against the PR description; no linked issue was read.",
        f"**Reviewer:** {config.model} at {config.base_url}, one request per file.",
        "",
    ]
    lines += section("Blocking", [finding for finding in findings if finding.blocking])
    lines += section(
        "Non-blocking",
        [f for f in findings if not f.blocking and f.label not in ("nitpick", "praise")],
    )
    lines += section("Nits", [finding for finding in findings if finding.label == "nitpick"])
    lines += section("Praise", [finding for finding in findings if finding.label == "praise"])
    lines += fallow_section(review.fallow)
    lines += not_checked_section(review.notes)
    return "\n".join(lines)


def review_as_dict(review):
    return {
        "number": review.meta["number"],
        "verdict": review.verdict,
        "summary": review.summary,
        "findings": [dataclasses.asdict(finding) for finding in review.findings],
        "fallow": {"status": review.fallow.status, "lines": review.fallow.lines},
        "skipped": [dataclasses.asdict(note) for note in review.notes],
    }


def post_review(target, report):
    with tempfile.TemporaryDirectory() as directory:
        body_path = Path(directory) / "review.md"
        body_path.write_text(report + "\n", encoding="utf-8")
        run(["gh", "pr", "review", target, "--comment", "--body-file", str(body_path)])


def log_directory_for(config):
    chosen = config.log_dir or os.environ.get("PR_REVIEW_LOG_DIR") or DEFAULT_LOG_DIR
    return Path(chosen).expanduser().absolute()


def build_reporter(config):
    terminal = TerminalRenderer(sys.stderr, wants_color(config.color, sys.stderr))
    log_directory = None if config.no_log else log_directory_for(config)
    return Reporter(terminal, log_directory)


def main(argv):
    config = parse_args(argv)
    reporter = build_reporter(config)
    status = 1
    try:
        status = run_review(config, reporter)
    finally:
        reporter.emit("end", status="ok" if status == 0 else "error")
    return status


def run_review(config, reporter):
    started_at = time.perf_counter()
    try:
        review = review_range(config, reporter) if config.commit_range is not None else review_pull_request(config, reporter)
        report = render_report(config, review)
        if config.post:
            reporter.stage(f"posting the review to {config.target}")
            post_review(config.target, report)
    except ReviewError as error:
        reporter.emit("error", message=str(error))
        return 1
    reporter.emit("verdict", verdict=review.verdict, seconds=round(time.perf_counter() - started_at, 1))
    reporter.emit("report", markdown=report)
    if config.as_json:
        print(json.dumps(review_as_dict(review), indent=2))
    elif sys.stdout.isatty() and wants_color(config.color, sys.stdout):
        print(styled_report(report))
    else:
        print(report)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
