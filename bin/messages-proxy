#!/usr/bin/env python3
import argparse
import hashlib
import http.client
import json
import os
import re
import sys
import threading
import time
import uuid
from datetime import datetime, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlsplit

MESSAGES_PATH = "/v1/messages"
REQUEST_ID_HEADER = "X-Claude-Ollama-Request"
DIFF_CHARS = 200
WATCH_INTERVAL_SECONDS = 1.0
STREAM_CHUNK_BYTES = 4096
IMAGE_NOTE = "[image omitted: this model cannot see images; ask the user to describe it]"
UPSTREAM_TIMEOUT_SECONDS = 1800
HOP_BY_HOP_HEADERS = {"connection", "keep-alive", "proxy-connection", "transfer-encoding", "upgrade", "host", "content-length"}
LOOPBACK_HOSTS = {"127.0.0.1", "localhost", "[::1]"}
FORWARDED_ROUTES = {
    ("POST", MESSAGES_PATH),
    ("POST", "/v1/messages/count_tokens"),
    ("GET", "/v1/models"),
    ("GET", "/health"),
    ("GET", "/models"),
}
DEFAULT_UPSTREAM = "http://127.0.0.1:11435"
VOLATILE_SPAN_BYTES = 400
DIGIT = re.compile(r"\d")
WEEKDAY = re.compile(r"\b(?:mon|tues|wednes|thurs|fri|satur|sun)day\b", re.IGNORECASE)
MONTH = re.compile(
    r"\b(?:jan(?:uary)?|feb(?:ruary)?|mar(?:ch)?|apr(?:il)?|may|june?|july?|aug(?:ust)?|sep(?:t(?:ember)?)?|oct(?:ober)?|nov(?:ember)?|dec(?:ember)?)\b",
    re.IGNORECASE,
)
VOLATILE_LINE_STARTS = ("today's date", "current date", "the current time")
HARD_RULE_MAX_CHARS = 200
WEEKDAY_TOKEN = "<weekday>"
MONTH_TOKEN = "<month>"
ISO_DATE_TOKEN = "####-##-##"
AM_PM_TOKENS = {"am", "pm", "a.m", "p.m"}
DAY_SUFFIXES = ("st", "nd", "rd", "th")
TOKEN_EDGE_PUNCTUATION = "()[].!-"


def parse_args(argv):
    parser = argparse.ArgumentParser(description="Observe /v1/messages traffic between Claude Code and llama-server without changing it.")
    parser.add_argument("--upstream", default=os.environ.get("LLAMA_SERVER_URL", DEFAULT_UPSTREAM))
    parser.add_argument("--port", type=int, required=True)
    parser.add_argument("--port-file")
    parser.add_argument("--log", required=True)
    parser.add_argument("--record", help="folder that gets each /v1/messages body as <request_id>.json")
    parser.add_argument("--stabilize", action="store_true", help="move learned volatile system lines after the stable prefix")
    parser.add_argument("--images-as-note", action="store_true", help="replace image blocks with a text note, for a model without a vision projector")
    parser.add_argument("--watch-pid", type=int)
    return parser.parse_args(argv)


def canonical(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":"))


def volatile_key(line):
    return DIGIT.sub("#", MONTH.sub("<month>", WEEKDAY.sub("<weekday>", line)))


def hash_run(text, shortest, longest):
    return shortest <= len(text) <= longest and set(text) == {"#"}


def is_full_date(token):
    if token == ISO_DATE_TOKEN:
        return True
    parts = token.split("/")
    return len(parts) == 3 and hash_run(parts[0], 1, 2) and hash_run(parts[1], 1, 2) and hash_run(parts[2], 2, 4)


def is_time(token):
    parts = token.split(":")
    return 2 <= len(parts) <= 3 and hash_run(parts[0], 1, 2) and all(hash_run(part, 2, 2) for part in parts[1:])


def is_day_or_year(token):
    for suffix in DAY_SUFFIXES:
        if token.endswith(suffix):
            token = token[: -len(suffix)]
            break
    return hash_run(token, 1, 2) or hash_run(token, 4, 4)


def is_date_word(token):
    return token in (WEEKDAY_TOKEN, MONTH_TOKEN) or token in AM_PM_TOKENS


def date_tokens(masked_line):
    tokens = (token.strip(TOKEN_EDGE_PUNCTUATION) for token in masked_line.replace(",", " ").lower().split())
    return [token for token in tokens if token]


def date_or_time_only(masked_line):
    tokens = date_tokens(masked_line)
    if not tokens:
        return False
    if not all(is_date_word(token) or is_full_date(token) or is_time(token) or is_day_or_year(token) for token in tokens):
        return False
    if any(is_full_date(token) or is_time(token) for token in tokens):
        return True
    return MONTH_TOKEN in tokens and any(is_day_or_year(token) for token in tokens)


def hard_volatile(line):
    if len(line) > HARD_RULE_MAX_CHARS:
        return False
    if line.strip().lower().startswith(VOLATILE_LINE_STARTS):
        return True
    return DIGIT.search(line) is not None and date_or_time_only(volatile_key(line))


def common_prefix_length(old, new):
    index = 0
    limit = min(len(old), len(new))
    while index < limit and old[index] == new[index]:
        index += 1
    return index


def common_suffix_length(old, new, prefix):
    index = 0
    limit = min(len(old), len(new)) - prefix
    while index < limit and old[-1 - index] == new[-1 - index]:
        index += 1
    return index


def line_end(text, index):
    found = text.find("\n", index)
    return len(text) if found < 0 else found


def changed_lines(old_text, new_text):
    prefix = common_prefix_length(old_text, new_text)
    suffix = common_suffix_length(old_text, new_text, prefix)
    start = old_text.rfind("\n", 0, prefix) + 1
    old_lines = old_text[start : line_end(old_text, len(old_text) - suffix)].split("\n")
    new_lines = new_text[start : line_end(new_text, len(new_text) - suffix)].split("\n")
    while old_lines and new_lines and old_lines[0] == new_lines[0]:
        old_lines.pop(0)
        new_lines.pop(0)
    while old_lines and new_lines and old_lines[-1] == new_lines[-1]:
        old_lines.pop()
        new_lines.pop()
    return old_lines, new_lines


def span_bytes(lines):
    return len("\n".join(lines).encode("utf-8"))


def learned_volatile_keys(old_text, new_text):
    if old_text == new_text:
        return []
    old_lines, new_lines = changed_lines(old_text, new_text)
    if max(span_bytes(old_lines), span_bytes(new_lines)) > VOLATILE_SPAN_BYTES:
        return []
    return [volatile_key(line) for line in old_lines + new_lines if line.strip()]


def is_text_block(block):
    return isinstance(block, dict) and isinstance(block.get("text"), str)


def system_text(system):
    if isinstance(system, str):
        return system
    if isinstance(system, list):
        return "\n".join(block["text"] for block in system if is_text_block(block))
    return ""


def split_volatile_lines(text, is_volatile):
    kept, moved = [], []
    for line in text.split("\n"):
        (moved if is_volatile(line) else kept).append(line)
    return "\n".join(kept), moved


def stabilized_blocks(system, is_volatile):
    blocks, moved = [], []
    for block in system:
        if not is_text_block(block):
            blocks.append(block)
            continue
        kept, block_moved = split_volatile_lines(block["text"], is_volatile)
        moved.extend(block_moved)
        if block_moved and not kept.strip():
            continue
        blocks.append({**block, "text": kept} if block_moved else block)
    if not moved:
        return system, []
    tail = "\n".join(moved)
    text_indexes = [index for index, block in enumerate(blocks) if is_text_block(block)]
    if text_indexes:
        last = blocks[text_indexes[-1]]
        blocks[text_indexes[-1]] = {**last, "text": last["text"] + "\n" + tail}
    else:
        blocks.append({"type": "text", "text": tail})
    return blocks, moved


def stabilized_system(system, is_volatile):
    if isinstance(system, str):
        kept, moved = split_volatile_lines(system, is_volatile)
        return ("\n".join([kept] + moved), moved) if moved else (system, [])
    if isinstance(system, list):
        return stabilized_blocks(system, is_volatile)
    return system, []


class PrefixStabilizer:
    def __init__(self):
        self.lock = threading.Lock()
        self.volatile_keys = set()
        self.previous_system_text = None

    def learn(self, text):
        with self.lock:
            if self.previous_system_text is not None:
                self.volatile_keys.update(learned_volatile_keys(self.previous_system_text, text))
            self.previous_system_text = text
            return frozenset(self.volatile_keys)

    def stabilize(self, body):
        known_keys = self.learn(system_text(body.get("system")))
        system, moved = stabilized_system(body.get("system"), lambda line: hard_volatile(line) or volatile_key(line) in known_keys)
        if not moved:
            return body, []
        return {**body, "system": system}, moved


def stabilize_bodies(bodies):
    stabilizer = PrefixStabilizer()
    return [stabilizer.stabilize(body)[0] for body in bodies]


def stabilized_keys(moved):
    return list(dict.fromkeys(volatile_key(line) for line in moved))


def prompt_sections(body):
    sections = []
    if "system" in body:
        sections.append(("system", canonical(body["system"])))
    if "tools" in body:
        sections.append(("tools", canonical(body["tools"])))
    for index, message in enumerate(body.get("messages") or []):
        sections.append((f"message:{index}", canonical(message)))
    return sections


def canonical_bytes(value):
    return len(canonical(value).encode("utf-8"))


def tool_name(tool, index):
    name = tool.get("name") if isinstance(tool, dict) else None
    return name if isinstance(name, str) and name else f"tool:{index}"


def prompt_ledger(body):
    tools = body.get("tools") if isinstance(body.get("tools"), list) else []
    messages = body.get("messages") if isinstance(body.get("messages"), list) else []
    return {
        "system": canonical_bytes(body["system"]) if "system" in body else 0,
        "tools": {tool_name(tool, index): canonical_bytes(tool) for index, tool in enumerate(tools)},
        "messages": sum(canonical_bytes(message) for message in messages),
    }


def prefix_hashes(sections):
    running = hashlib.sha256()
    hashes = []
    for _, text in sections:
        running.update(text.encode("utf-8"))
        hashes.append(running.hexdigest())
    return hashes


def first_difference(old, new):
    for index, (old_char, new_char) in enumerate(zip(old, new)):
        if old_char != new_char:
            return index
    return min(len(old), len(new))


def byte_offset(text, char_index):
    return len(text[:char_index].encode("utf-8"))


class SectionTracker:
    def __init__(self):
        self.lock = threading.Lock()
        self.previous_sections = None
        self.previous_hashes = None

    def compare(self, sections):
        hashes = prefix_hashes(sections)
        with self.lock:
            report = self.divergence(sections, hashes)
            self.previous_sections = sections
            self.previous_hashes = hashes
        return report

    def divergence(self, sections, hashes):
        report = {"sections": len(sections), "stable_sections": 0, "diverged_at": None, "offset": None, "diff": None}
        if self.previous_hashes is None:
            return report
        stable = 0
        for old_hash, new_hash in zip(self.previous_hashes, hashes):
            if old_hash != new_hash:
                break
            stable += 1
        report["stable_sections"] = stable
        if stable < len(sections):
            name, text = sections[stable]
            old_text = self.previous_sections[stable][1] if stable < len(self.previous_sections) else ""
            char_index = first_difference(old_text, text)
            report["diverged_at"] = name
            report["offset"] = byte_offset(text, char_index)
            report["diff"] = text[char_index : char_index + DIFF_CHARS]
        return report


class RequestLog:
    def __init__(self, path):
        self.path = path
        self.lock = threading.Lock()
        folder = os.path.dirname(path) or "."
        os.makedirs(folder, mode=0o700, exist_ok=True)
        os.chmod(folder, 0o700)

    def append(self, row):
        line = json.dumps(row, separators=(",", ":")) + "\n"
        with self.lock:
            descriptor = os.open(self.path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
            with os.fdopen(descriptor, "a") as handle:
                handle.write(line)
            os.chmod(self.path, 0o600)


class BodyRecorder:
    def __init__(self, folder):
        self.folder = folder
        os.makedirs(folder, mode=0o700, exist_ok=True)
        os.chmod(folder, 0o700)

    def save(self, request_id, body):
        path = os.path.join(self.folder, f"{request_id}.json")
        descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(body)
        os.chmod(path, 0o600)


def now_iso():
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


def process_alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def host_part(host):
    if host.startswith("["):
        return host.split("]", 1)[0] + "]"
    return host.split(":", 1)[0]


def loopback_host(host):
    return host_part(host.strip().lower()) in LOOPBACK_HOSTS


def loopback_origin(origin):
    parsed = urlsplit(origin.strip())
    return parsed.scheme in ("http", "https") and loopback_host(parsed.netloc)


def refusal(headers):
    host = headers.get("Host")
    if host is None or not loopback_host(host):
        return "Host must be a loopback address"
    origin = headers.get("Origin")
    if origin is not None and not loopback_origin(origin):
        return "Origin must be a loopback origin"
    return None


def forwarded_headers(headers, request_id):
    kept = [(name, value) for name, value in headers.items() if name.lower() not in HOP_BY_HOP_HEADERS]
    if request_id:
        kept.append((REQUEST_ID_HEADER, request_id))
    return kept


def returned_headers(headers):
    return [(name, value) for name, value in headers.items() if name.lower() not in HOP_BY_HOP_HEADERS]


def parse_body(body):
    try:
        parsed = json.loads(body)
    except ValueError:
        return None
    return parsed if isinstance(parsed, dict) else None


def blocks_with_notes(blocks):
    replaced = 0
    kept = []
    for block in blocks:
        if isinstance(block, dict) and block.get("type") == "image":
            kept.append({"type": "text", "text": IMAGE_NOTE})
            replaced += 1
            continue
        if isinstance(block, dict) and isinstance(block.get("content"), list):
            inner, inner_replaced = blocks_with_notes(block["content"])
            if inner_replaced:
                block = dict(block, content=inner)
                replaced += inner_replaced
        kept.append(block)
    return kept, replaced


def images_as_notes(parsed):
    messages = parsed.get("messages")
    if not isinstance(messages, list):
        return parsed, 0
    replaced = 0
    noted = []
    for message in messages:
        if isinstance(message, dict) and isinstance(message.get("content"), list):
            content, count = blocks_with_notes(message["content"])
            if count:
                message = dict(message, content=content)
                replaced += count
        noted.append(message)
    return (dict(parsed, messages=noted), replaced) if replaced else (parsed, 0)


def forwarded_body(parsed, body, stabilizer, images_as_note=False):
    noted = 0
    if images_as_note:
        parsed, noted = images_as_notes(parsed)
    moved = []
    if stabilizer is not None:
        stabilized, moved = stabilizer.stabilize(parsed)
        if moved:
            parsed = stabilized
    if not moved and not noted:
        return parsed, body, [], 0
    return parsed, json.dumps(parsed, ensure_ascii=False).encode("utf-8"), moved, noted


def observe_request(body, tracker, log, recorder, stabilizer=None, images_as_note=False):
    parsed = parse_body(body)
    if parsed is None:
        return None, body
    request_id = str(uuid.uuid4())
    forwarded, forwarded_bytes, moved, noted = forwarded_body(parsed, body, stabilizer, images_as_note)
    row = {"ts": now_iso(), "request_id": request_id}
    row.update(tracker.compare(prompt_sections(forwarded)))
    row["prompt_bytes"] = len(forwarded_bytes)
    row["ledger"] = prompt_ledger(forwarded)
    if stabilizer is not None:
        row["stabilized"] = stabilized_keys(moved)
        row["moved_bytes"] = span_bytes(moved)
    if images_as_note:
        row["images_as_note"] = noted
    log.append(row)
    if recorder is not None:
        recorder.save(request_id, body)
    return request_id, forwarded_bytes


class ProxyHandler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    upstream = None
    tracker = None
    log = None
    recorder = None
    stabilizer = None
    images_as_note = False
    response_started = False

    def log_message(self, format, *args):
        return

    def route_path(self):
        return self.path.split("?", 1)[0]

    def do_GET(self):
        self.handle_request()

    def do_POST(self):
        self.handle_request()

    def do_PUT(self):
        self.handle_request()

    def do_DELETE(self):
        self.handle_request()

    def read_body(self):
        length = int(self.headers.get("Content-Length") or 0)
        return self.rfile.read(length) if length else b""

    def refuse(self, status, reason):
        body = (reason + "\n").encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "text/plain")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def handle_request(self):
        body = self.read_body()
        reason = refusal(self.headers)
        if reason:
            self.refuse(403, reason)
        elif (self.command, self.route_path()) not in FORWARDED_ROUTES:
            self.refuse(404, "messages-proxy forwards only /v1/messages, /v1/messages/count_tokens, /v1/models, /health and /models")
        else:
            self.forward(body)

    def fail_upstream(self, error):
        if self.response_started:
            self.close_connection = True
            return
        try:
            self.send_error(502, f"upstream failed: {error}")
        except OSError:
            self.close_connection = True

    def forward(self, body):
        self.response_started = False
        request_id = None
        if self.command == "POST" and self.route_path() == MESSAGES_PATH:
            request_id, body = observe_request(body, self.tracker, self.log, self.recorder, self.stabilizer, self.images_as_note)
        connection = http.client.HTTPConnection(self.upstream.hostname, self.upstream.port, timeout=UPSTREAM_TIMEOUT_SECONDS)
        try:
            connection.putrequest(self.command, self.path, skip_host=True, skip_accept_encoding=True)
            for name, value in forwarded_headers(self.headers, request_id):
                connection.putheader(name, value)
            connection.putheader("Host", self.upstream.netloc)
            connection.putheader("Content-Length", str(len(body)))
            connection.endheaders(body)
            reply = connection.getresponse()
            self.relay(reply)
        except (OSError, http.client.HTTPException) as error:
            self.fail_upstream(error)
        finally:
            connection.close()

    def relay(self, reply):
        self.response_started = True
        self.send_response_only(reply.status, reply.reason)
        for name, value in returned_headers(reply.headers):
            self.send_header(name, value)
        chunked = reply.headers.get("Transfer-Encoding", "").lower() == "chunked"
        if chunked:
            self.send_header("Transfer-Encoding", "chunked")
        elif reply.headers.get("Content-Length") is not None:
            self.send_header("Content-Length", reply.headers["Content-Length"])
        else:
            self.send_header("Connection", "close")
            self.close_connection = True
        self.end_headers()
        while True:
            chunk = reply.read1(STREAM_CHUNK_BYTES) if hasattr(reply, "read1") else reply.read(STREAM_CHUNK_BYTES)
            if not chunk:
                break
            if chunked:
                self.wfile.write(b"%x\r\n%s\r\n" % (len(chunk), chunk))
            else:
                self.wfile.write(chunk)
            self.wfile.flush()
        if chunked:
            self.wfile.write(b"0\r\n\r\n")
            self.wfile.flush()


def publish_port(path, port):
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(descriptor, "w") as handle:
        handle.write(f"{port}\n")


def watch_pid(pid, server):
    while process_alive(pid):
        time.sleep(WATCH_INTERVAL_SECONDS)
    server.shutdown()


def serve(options):
    upstream = urlsplit(options.upstream)
    if upstream.scheme != "http" or not upstream.hostname:
        raise SystemExit(f"messages-proxy: --upstream must be an http:// URL, got {options.upstream}")
    handler = type("BoundProxyHandler", (ProxyHandler,), {
        "upstream": upstream,
        "tracker": SectionTracker(),
        "log": RequestLog(options.log),
        "recorder": BodyRecorder(options.record) if options.record else None,
        "stabilizer": PrefixStabilizer() if options.stabilize else None,
        "images_as_note": options.images_as_note,
    })
    server = ThreadingHTTPServer(("127.0.0.1", options.port), handler)
    server.daemon_threads = True
    if options.port_file:
        publish_port(options.port_file, server.server_port)
    if options.watch_pid is not None:
        threading.Thread(target=watch_pid, args=(options.watch_pid, server), daemon=True).start()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()


if __name__ == "__main__":
    serve(parse_args(sys.argv[1:]))
