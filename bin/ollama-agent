#!/usr/bin/env bash
set -euo pipefail

go_dir="$(cd "$(dirname "$(readlink -f "$0")")/../go" && pwd)"
tool_binary="$go_dir/cmd/ollama-agent/ollama-agent"
server_env="$go_dir/../ollama/server.env"

binary_is_current() {
  local dir="$1" binary="$2"
  [ -x "$binary" ] || return 1
  [ -z "$(find "$dir" \( -name '*.go' -o -name 'go.mod' -o -name 'go.sum' \) -newer "$binary" -print -quit)" ]
}

ensure_built() {
  local module_dir="$1" binary="$2" package="$3" label="$4" hint="${5:-}"
  binary_is_current "$module_dir" "$binary" && return 0
  if ! command -v go >/dev/null 2>&1; then
    echo "$label: needs Go 1.26+ (https://go.dev/dl) to build $binary$hint" >&2
    return 1
  fi
  (cd "$module_dir" && go build -o "$binary" "$package") >&2
}

ensure_built "$go_dir" "$tool_binary" ./cmd/ollama-agent ollama-agent || exit 1
exec "$tool_binary" -server-env "$server_env" "$@"
