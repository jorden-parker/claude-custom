#!/usr/bin/env python3
import argparse
import dataclasses
import json
import shutil
import stat
import subprocess
import sys
import tempfile
import time
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
REPO_ROOT = SCRIPT_DIR.parent
DEFAULT_REVIEWER = SCRIPT_DIR / "pr-review-local"
DEFAULT_SCENARIOS = REPO_ROOT / "eval" / "pr-review" / "scenarios"
DEFAULT_BASE_URL = "http://localhost:11434"
TEMP_PREFIX = "pr-review-eval-"
LINE_WINDOW = 3
PRAISE = "praise"
SHEBANG = b"#!"
EXEC_BITS = stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH
GIT_IDENTITY = ("-c", "user.name=pr-review-eval", "-c", "user.email=pr-review-eval@example.invalid")
CAUGHT_BLOCKING = "caught blocking"
CAUGHT = "caught"
MISSED = "missed"


@dataclasses.dataclass
class Scorecard:
    name: str
    outcomes: list
    false_blockers: list
    clean_findings: list
    unparsable: int
    seconds: float
    verdict: str
    expected_verdicts: list

    @property
    def bug_count(self):
        return len(self.outcomes)

    @property
    def caught(self):
        return sum(1 for _, outcome in self.outcomes if outcome != MISSED)

    @property
    def caught_blocking(self):
        return sum(1 for _, outcome in self.outcomes if outcome == CAUGHT_BLOCKING)

    @property
    def missed(self):
        return [bug_id for bug_id, outcome in self.outcomes if outcome == MISSED]

    @property
    def verdict_ok(self):
        return not self.expected_verdicts or self.verdict in self.expected_verdicts


@dataclasses.dataclass
class Totals:
    caught: int
    caught_blocking: int
    bugs: int
    false_blockers: int
    clean_findings: int
    verdicts_ok: int
    scenarios: int
    unparsable: int
    seconds: float


class ReviewerFailed(Exception):
    def __init__(self, code):
        super().__init__(code)
        self.code = code


def split_reviewer_args(argv):
    if "--" not in argv:
        return argv, []
    index = argv.index("--")
    return argv[:index], argv[index + 1 :]


def parse_args(argv):
    parser = argparse.ArgumentParser(
        description="Run pr-review-local on each eval scenario and print a scorecard. Arguments after -- go to the reviewer."
    )
    parser.add_argument("--model", required=True)
    parser.add_argument("--base-url", default=DEFAULT_BASE_URL)
    parser.add_argument("--reviewer", type=Path, default=DEFAULT_REVIEWER)
    parser.add_argument("--scenarios", type=Path, default=DEFAULT_SCENARIOS)
    parser.add_argument("--scenario", action="append")
    parser.add_argument("--keep", action="store_true")
    parser.add_argument("--json", dest="as_json", action="store_true")
    return parser.parse_args(argv)


def git(repo, *args):
    subprocess.run(["git", *args], cwd=repo, check=True, capture_output=True, text=True)


def git_commit(repo, *message_args):
    git(repo, *GIT_IDENTITY, "commit", "-q", *message_args)


def copy_side(side_root, repo):
    for source in sorted(path for path in side_root.rglob("*") if path.is_file()):
        content = source.read_bytes()
        target = repo / source.relative_to(side_root).with_suffix("")
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(content)
        if content.startswith(SHEBANG):
            target.chmod(target.stat().st_mode | EXEC_BITS)


def load_expected(scenario_dir):
    return json.loads((scenario_dir / "expected.json").read_text(encoding="utf-8"))


def build_repo(scenario_dir, repo, expected):
    git(repo, "init", "-q", "-b", "main")
    copy_side(scenario_dir / "base", repo)
    git(repo, "add", "-A")
    git_commit(repo, "-m", "base")
    git(repo, "checkout", "-q", "-b", "change")
    copy_side(scenario_dir / "head", repo)
    git(repo, "add", "-A")
    git_commit(repo, "-m", expected["title"], "-m", expected["body"])


def reviewer_command(args, reviewer_args):
    return [
        str(args.reviewer),
        "--model",
        args.model,
        "--base-url",
        args.base_url,
        "--range",
        "main..change",
        "--json",
        *reviewer_args,
    ]


def run_reviewer(args, repo, reviewer_args):
    return subprocess.run(
        reviewer_command(args, reviewer_args),
        cwd=repo,
        stdout=subprocess.PIPE,
        text=True,
        check=False,
    )


def parse_review(text):
    try:
        return json.loads(text)
    except json.JSONDecodeError:
        raise SystemExit("pr-review-eval: reviewer did not print JSON")


def anchor_lines(repo, bug):
    lines = (repo / bug["path"]).read_text(encoding="utf-8").splitlines()
    return [
        number
        for number, text in enumerate(lines, start=1)
        if any(anchor in text for anchor in bug["anchors"])
    ]


def hits(finding, bug, lines):
    if finding.get("label") == PRAISE or finding.get("path") != bug["path"]:
        return False
    line = finding.get("line")
    if not isinstance(line, int) or isinstance(line, bool):
        return False
    return any(abs(line - bug_line) <= LINE_WINDOW for bug_line in lines)


def outcome_for(findings, bug, lines):
    matches = [finding for finding in findings if hits(finding, bug, lines)]
    if any(finding.get("blocking") is True for finding in matches):
        return CAUGHT_BLOCKING
    if matches:
        return CAUGHT
    return MISSED


def score(name, expected, review, repo, seconds):
    findings = review.get("findings", [])
    scoped_bugs = [(bug, anchor_lines(repo, bug)) for bug in expected["bugs"]]
    outcomes = [(bug["id"], outcome_for(findings, bug, lines)) for bug, lines in scoped_bugs]
    false_blockers = [
        finding
        for finding in findings
        if finding.get("blocking") is True
        and not any(hits(finding, bug, lines) for bug, lines in scoped_bugs)
    ]
    clean_findings = [
        finding
        for finding in findings
        if finding.get("label") != PRAISE and finding.get("path") in expected["clean"]
    ]
    unparsable = sum(
        1 for note in review.get("skipped", []) if "unparsable" in note.get("note", "")
    )
    return Scorecard(
        name,
        outcomes,
        false_blockers,
        clean_findings,
        unparsable,
        seconds,
        review.get("verdict", ""),
        expected.get("verdicts", []),
    )


def totals_of(cards):
    return Totals(
        caught=sum(card.caught for card in cards),
        caught_blocking=sum(card.caught_blocking for card in cards),
        bugs=sum(card.bug_count for card in cards),
        false_blockers=sum(len(card.false_blockers) for card in cards),
        clean_findings=sum(len(card.clean_findings) for card in cards),
        verdicts_ok=sum(1 for card in cards if card.verdict_ok),
        scenarios=len(cards),
        unparsable=sum(card.unparsable for card in cards),
        seconds=sum(card.seconds for card in cards),
    )


def finding_line(kind, finding):
    return f"{kind:<15} {finding.get('path')}:{finding.get('line')}  {finding.get('summary')}"


def counts_text(totals):
    return (
        f"caught {totals.caught}/{totals.bugs} (blocking {totals.caught_blocking}/{totals.bugs}), "
        f"false blockers {totals.false_blockers}, clean-file findings {totals.clean_findings}"
    )


def verdict_line(card):
    expected = " or ".join(card.expected_verdicts) or "any"
    result = "right" if card.verdict_ok else "wrong"
    return f"verdict {card.verdict} (expected {expected}): {result}"


def score_line(card):
    totals = totals_of([card])
    return f"score: {counts_text(totals)}, unparsable {totals.unparsable}, {totals.seconds:.1f}s"


def total_line(cards):
    totals = totals_of(cards)
    return (
        f"total: {counts_text(totals)}, verdicts {totals.verdicts_ok}/{totals.scenarios}, "
        f"unparsable {totals.unparsable}, {totals.seconds:.1f}s"
    )


def text_report(card):
    lines = [f"{outcome:<15} {bug_id}" for bug_id, outcome in card.outcomes]
    lines += [finding_line("false blocker", finding) for finding in card.false_blockers]
    lines += [finding_line("clean file", finding) for finding in card.clean_findings]
    lines.append(verdict_line(card))
    lines.append(score_line(card))
    return "\n".join(lines)


def scenario_json(card):
    return {
        "caught": card.caught,
        "caught_blocking": card.caught_blocking,
        "bugs": card.bug_count,
        "false_blockers": len(card.false_blockers),
        "clean_findings": len(card.clean_findings),
        "unparsable": card.unparsable,
        "seconds": round(card.seconds, 1),
        "missed": card.missed,
        "verdict": card.verdict,
        "verdict_ok": card.verdict_ok,
    }


def total_json(totals):
    return {
        "caught": totals.caught,
        "caught_blocking": totals.caught_blocking,
        "bugs": totals.bugs,
        "false_blockers": totals.false_blockers,
        "clean_findings": totals.clean_findings,
        "verdicts_ok": totals.verdicts_ok,
        "scenarios": totals.scenarios,
        "unparsable": totals.unparsable,
        "seconds": round(totals.seconds, 1),
    }


def json_report(cards):
    return json.dumps(
        {
            "scenarios": {card.name: scenario_json(card) for card in cards},
            "total": total_json(totals_of(cards)),
        },
        indent=2,
    )


def finish_repo(repo, keep):
    if keep:
        print(f"pr-review-eval: kept {repo}", file=sys.stderr)
    else:
        shutil.rmtree(repo, ignore_errors=True)


def evaluate_scenario(args, reviewer_args, name, scenario_dir):
    expected = load_expected(scenario_dir)
    repo = Path(tempfile.mkdtemp(prefix=TEMP_PREFIX))
    try:
        build_repo(scenario_dir, repo, expected)
        started = time.perf_counter()
        completed = run_reviewer(args, repo, reviewer_args)
        seconds = time.perf_counter() - started
        if completed.returncode != 0:
            print(f"pr-review-eval: reviewer exited {completed.returncode}", file=sys.stderr)
            raise ReviewerFailed(completed.returncode)
        return score(name, expected, parse_review(completed.stdout), repo, seconds)
    finally:
        finish_repo(repo, args.keep)


def run_eval(args, reviewer_args, scenarios):
    cards = []
    for name, scenario_dir in scenarios:
        if not args.as_json:
            print(f"== {name} ==", flush=True)
        print(f"pr-review-eval: scenario {name}", file=sys.stderr, flush=True)
        card = evaluate_scenario(args, reviewer_args, name, scenario_dir)
        cards.append(card)
        if not args.as_json:
            print(text_report(card), flush=True)
    if args.as_json:
        print(json_report(cards))
    else:
        print(total_line(cards))
    return 0


def scenario_dirs(root):
    return sorted(path for path in root.iterdir() if (path / "expected.json").is_file())


def main(argv):
    own_argv, reviewer_args = split_reviewer_args(argv)
    args = parse_args(own_argv)
    available = {path.name: path for path in scenario_dirs(args.scenarios)}
    selected = args.scenario or sorted(available)
    for name in selected:
        if name not in available:
            print(f"pr-review-eval: no scenario {name}", file=sys.stderr)
            return 2
    try:
        return run_eval(args, reviewer_args, [(name, available[name]) for name in selected])
    except ReviewerFailed as failure:
        return failure.code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
