#!/usr/bin/env python3
import hashlib
import json
import os
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path

REPO_DIR = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO_DIR / "shared"))

import model_server

USAGE = "usage: bin/model-upgrade SIZE [--eval] [--keep] [--force]"
OPTION_FLAGS = {"--eval", "--keep", "--force"}
THINKING_TITLE = "Thinking check"
TASK_MEDIAN_RISE_LIMIT = 1.25
CANDIDATE_SUFFIX = "@next"
HASH_CHUNK_BYTES = 1 << 20


class Refusal(Exception):
    pass


class StageFailure(Exception):
    pass


@dataclass
class Upgrade:
    size: str
    model: str
    repo: str
    file: str
    pinned_revision: str
    keep: bool
    run_eval: bool
    force: bool

    @property
    def candidate(self):
        return f"{self.model}{CANDIDATE_SUFFIX}"

    @property
    def weights(self):
        return weights_dir() / self.file

    @property
    def candidate_weights(self):
        return weights_dir() / f"{self.file}.next"


@dataclass
class Revision:
    sha: str
    lfs_sha256: str

    @property
    def short(self):
        return self.sha[:12]


def tool_path(variable, default_name):
    return os.environ.get(variable) or str(REPO_DIR / "bin" / default_name)


def hf_endpoint():
    return os.environ.get("HF_ENDPOINT") or "https://huggingface.co"


def weights_dir():
    return Path(os.environ.get("CLAUDE_OLLAMA_WEIGHTS_DIR") or Path.home() / ".claude-ollama" / "weights")


def user_presets_file():
    return Path.home() / ".claude-ollama" / "presets" / "models.ini"


def read_json(relative_path):
    return json.loads((REPO_DIR / relative_path).read_text())


def announce(title):
    print(f"[{title}]", flush=True)


def refuse(condition, fix):
    if not condition:
        raise Refusal(fix)


def require(condition, fix):
    if not condition:
        raise StageFailure(fix)


def command_output(command):
    return subprocess.run(command, check=False, capture_output=True, text=True)


def run_captured(command):
    print("+ " + " ".join(command), flush=True)
    return subprocess.run(command, check=False, stdout=subprocess.PIPE, text=True)


def run_step(command):
    print("+ " + " ".join(command), flush=True)
    result = subprocess.run(command, check=False, stdout=sys.stderr)
    require(result.returncode == 0, f"{' '.join(command)} failed; see the error above")


def hf_json(path):
    result = command_output(["curl", "-sf", "-m", "30", f"{hf_endpoint()}/api/models/{path}"])
    if result.returncode != 0:
        return None
    try:
        return json.loads(result.stdout)
    except ValueError:
        return None


def main_revision(repo):
    reply = hf_json(f"{repo}/revision/main")
    return reply.get("sha") if isinstance(reply, dict) else None


def lfs_sha256(repo, revision, file):
    tree = hf_json(f"{repo}/tree/{revision}")
    entries = tree if isinstance(tree, list) else []
    return next((entry.get("lfs", {}).get("oid") for entry in entries if entry.get("path") == file), None)


def upgrade_from_argv(argv):
    positional = [arg for arg in argv if not arg.startswith("--")]
    flags = [arg for arg in argv if arg.startswith("--")]
    refuse(len(positional) == 1 and set(flags) <= OPTION_FLAGS, USAGE)
    size = positional[0]
    sizes = read_json("ollama/sizes.json")
    refuse(size in sizes, f"unknown size {size}; sizes are {', '.join(sizes)}")
    gguf = sizes[size].get("gguf")
    refuse(gguf is not None, f"size {size} has no gguf in ollama/sizes.json")
    return Upgrade(
        size=size,
        model=sizes[size]["model"],
        repo=gguf["repo"],
        file=gguf["file"],
        pinned_revision=gguf["revision"],
        keep="--keep" in flags,
        run_eval="--eval" in flags,
        force="--force" in flags,
    )


def preflight(upgrade):
    refuse(model_server.up(), f"llama-server is not answering at {model_server.server_url()}: start it, then rerun")
    latest = main_revision(upgrade.repo)
    refuse(latest, f"{upgrade.repo} has no main revision at {hf_endpoint()}: check the network, then rerun")
    return latest


def candidate_revision(upgrade, latest):
    sha256 = lfs_sha256(upgrade.repo, latest, upgrade.file)
    refuse(sha256, f"{upgrade.repo} at {latest} lists no LFS sha256 for {upgrade.file}")
    return Revision(sha=latest, lfs_sha256=sha256)


def file_sha256(path):
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(HASH_CHUNK_BYTES), b""):
            digest.update(chunk)
    return digest.hexdigest()


def download_candidate(upgrade, revision):
    announce(f"Download {upgrade.file} at {revision.short} beside the current file")
    part = upgrade.candidate_weights.with_name(upgrade.candidate_weights.name + ".part")
    part.parent.mkdir(parents=True, exist_ok=True)
    url = f"{hf_endpoint()}/{upgrade.repo}/resolve/{revision.sha}/{upgrade.file}"
    result = subprocess.run(["curl", "-fL", "--retry", "3", "-C", "-", "-o", str(part), url], check=False)
    require(result.returncode == 0, f"the download of {upgrade.file} stopped; rerun to resume it")
    actual = file_sha256(part)
    if actual != revision.lfs_sha256:
        part.unlink()
        raise StageFailure(f"{upgrade.file} at {revision.short} has sha256 {actual}, but Hugging Face lists {revision.lfs_sha256}")
    part.replace(upgrade.candidate_weights)


def section_lines(text, section):
    lines = []
    inside = False
    for line in text.splitlines():
        if line.startswith("["):
            inside = line == f"[{section}]"
            continue
        if inside and line.strip():
            lines.append(line)
    return lines


def candidate_section(upgrade, presets):
    lines = section_lines(presets, upgrade.model)
    require(lines, f"the user presets have no [{upgrade.model}] section")
    body = [f"model = {upgrade.candidate_weights}" if line.split("=")[0].strip() == "model" else line for line in lines]
    return "\n".join([f"[{upgrade.candidate}]", *body]) + "\n"


def write_private(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.parent.chmod(0o700)
    staged = path.with_name(f".{path.name}.{os.getpid()}")
    staged.write_text(text)
    staged.chmod(0o600)
    staged.replace(path)


def stage_candidate_preset(upgrade):
    announce(f"Stage the [{upgrade.candidate}] preset and restart the server")
    staging = user_presets_file().with_name(f".models.next.{os.getpid()}.ini")
    staging.parent.mkdir(parents=True, exist_ok=True)
    try:
        run_step([tool_path("MODEL_UPGRADE_PROFILES", "ollama-profiles"), "--user-presets", "--out", str(staging)])
        presets = staging.read_text()
    finally:
        staging.unlink(missing_ok=True)
    write_private(user_presets_file(), presets.rstrip("\n") + "\n\n" + candidate_section(upgrade, presets))
    run_step([tool_path("MODEL_UPGRADE_AGENT", "ollama-agent"), "-apply"])


def restore_presets():
    announce("Restore the user presets and restart the server")
    run_step([tool_path("MODEL_UPGRADE_PROFILES", "ollama-profiles"), "--user-presets"])
    run_step([tool_path("MODEL_UPGRADE_AGENT", "ollama-agent"), "-apply"])


def run_thinking(upgrade):
    result = run_captured([
        tool_path("MODEL_UPGRADE_SPEED_CHECK", "speed-check"), "--thinking-only", "--model", upgrade.candidate,
    ])
    print(result.stdout, end="")
    return {"exit_code": result.returncode, "output": result.stdout}


def run_json(command, label):
    result = run_captured(command)
    require(result.returncode == 0, f"{label} failed; see the error above")
    try:
        return json.loads(result.stdout)
    except ValueError:
        raise StageFailure(f"{label} printed no JSON")


def run_cache_probe(upgrade):
    return run_json([tool_path("MODEL_UPGRADE_PROBE", "ollama-cache-probe"), upgrade.candidate, "--json"],
                    "ollama-cache-probe")


def run_review_eval(upgrade):
    return run_json([tool_path("MODEL_UPGRADE_EVAL", "pr-review-eval"), "--model", upgrade.candidate, "--json"],
                    "pr-review-eval")


def run_task_eval(upgrade):
    return run_json([tool_path("MODEL_UPGRADE_TASK_EVAL", "task-eval"), "--model", upgrade.candidate, "--json"],
                    "task-eval")


def task_report_model(path):
    try:
        return json.loads(path.read_text()).get("model")
    except (OSError, ValueError):
        return None


def task_baseline(upgrade):
    reports = sorted((Path.home() / "bench-results").glob("task-eval-*.json"), reverse=True)
    for path in reports:
        if task_report_model(path) == upgrade.model:
            return json.loads(path.read_text())["total"]
    return None


def gather_evidence(upgrade):
    announce(THINKING_TITLE)
    evidence = {"thinking": run_thinking(upgrade)}
    announce("Cache probe")
    evidence["cache_probe"] = run_cache_probe(upgrade)
    evidence["review_eval"] = None
    evidence["task_eval"] = None
    evidence["task_baseline"] = None
    if upgrade.run_eval:
        announce("Review eval (pr-review-eval)")
        evidence["review_eval"] = run_review_eval(upgrade)
        evidence["task_baseline"] = task_baseline(upgrade)
        announce("Task eval (task-eval)")
        evidence["task_eval"] = run_task_eval(upgrade)
    return evidence


def eval_summary(review):
    if review is None:
        return "skipped"
    total = review["total"]
    return (f"{total['caught']} of {total['bugs']} bugs caught, "
            f"{total['false_blockers']} false blockers, {total['unparsable']} unparsable")


def median_text(total):
    median = total["median_seconds"]
    return "no green run" if median is None else f"{median:.1f}s"


def task_totals_text(total):
    return f"{total['green']}/{total['runs']} green, median {median_text(total)}"


def task_baseline_text(baseline):
    return f"baseline {baseline['green']}/{baseline['runs']}, {median_text(baseline)}"


def tasks_within_baseline(total, baseline):
    if total["green"] < baseline["green"]:
        return False
    if total["median_seconds"] is None or baseline["median_seconds"] is None:
        return True
    return total["median_seconds"] <= baseline["median_seconds"] * TASK_MEDIAN_RISE_LIMIT


def judge_tasks(tasks, baseline):
    if tasks is None:
        return "skipped", True
    total = tasks["total"]
    if baseline is None:
        return f"{task_totals_text(total)} (no baseline)", True
    passed = tasks_within_baseline(total, baseline)
    verdict = "PASS" if passed else "FAIL"
    return f"{task_totals_text(total)} ({task_baseline_text(baseline)}): {verdict}", passed


def judge(evidence):
    thinking_ok = evidence["thinking"]["exit_code"] == 0
    cache_ok = bool(evidence["cache_probe"].get("cache_reused"))
    review = evidence["review_eval"]
    review_ok = review is None or review["total"]["unparsable"] == 0
    tasks_text, tasks_ok = judge_tasks(evidence["task_eval"], evidence["task_baseline"])
    return {
        "thinking": "PASS" if thinking_ok else "FAIL",
        "cache": "reused" if cache_ok else "not reused",
        "eval": eval_summary(review),
        "tasks": tasks_text,
        "passed": thinking_ok and cache_ok and review_ok and tasks_ok,
    }


def save_report(upgrade, revision, evidence, verdict):
    folder = Path.home() / "bench-results"
    folder.mkdir(parents=True, exist_ok=True)
    path = folder / f"upgrade-{upgrade.size}-{time.strftime('%Y%m%d-%H%M')}.json"
    report = {
        "size": upgrade.size,
        "repo": upgrade.repo,
        "file": upgrade.file,
        "candidate": upgrade.candidate,
        "pinned_revision": upgrade.pinned_revision,
        "revision": revision.sha,
        "sha256": revision.lfs_sha256,
        **evidence,
        "verdict": verdict,
    }
    path.write_text(json.dumps(report, indent=2) + "\n")
    return path


def print_verdict(upgrade, revision, verdict, report_path):
    print()
    print(f"thinking: {verdict['thinking']}")
    print(f"cache: {verdict['cache']}")
    print(f"eval: {verdict['eval']}")
    print(f"tasks: {verdict['tasks']}")
    if verdict["passed"]:
        print(f"Next: git add ollama/sizes.json ollama/model-digests.json && "
              f"git commit -m 'chore: pin {upgrade.size} at {revision.short}'")
    else:
        print(f"Not pinning; {upgrade.size} stays at {upgrade.pinned_revision[:12]}.")
    print(f"report: {report_path}")


def promote(upgrade, revision):
    announce(f"Promote {upgrade.file} at {revision.short}")
    upgrade.candidate_weights.replace(upgrade.weights)
    pin = [tool_path("MODEL_UPGRADE_MODELS", "ollama-models"), "pin", upgrade.size, "--revision", revision.sha]
    run_step(pin)


def discard_candidate(upgrade):
    if not upgrade.keep:
        upgrade.candidate_weights.unlink(missing_ok=True)


def checked_candidate(upgrade, revision):
    stage_candidate_preset(upgrade)
    try:
        evidence = gather_evidence(upgrade)
        verdict = judge(evidence)
        announce("Report")
        report_path = save_report(upgrade, revision, evidence, verdict)
        print_verdict(upgrade, revision, verdict, report_path)
        if verdict["passed"]:
            promote(upgrade, revision)
        else:
            discard_candidate(upgrade)
        return verdict["passed"]
    except StageFailure:
        discard_candidate(upgrade)
        raise
    finally:
        restore_presets()


def run_upgrade(argv):
    upgrade = upgrade_from_argv(argv)
    announce("Preflight: llama-server, size and Hugging Face")
    latest = preflight(upgrade)
    if latest == upgrade.pinned_revision and not upgrade.force:
        print(f"{upgrade.size} is current at {latest[:12]}; nothing to upgrade")
        return 0
    revision = candidate_revision(upgrade, latest)
    download_candidate(upgrade, revision)
    return 0 if checked_candidate(upgrade, revision) else 1


def main(argv):
    try:
        return run_upgrade(argv)
    except Refusal as refusal:
        print(f"model-upgrade: {refusal}", file=sys.stderr)
        return 2
    except StageFailure as failure:
        print(f"model-upgrade stopped: {failure}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
