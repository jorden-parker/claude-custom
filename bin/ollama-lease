#!/bin/bash
set -euo pipefail
. "$(dirname "$(readlink -f "$0")")/lib/model-server.sh"

lease_dir="${CLAUDE_OLLAMA_LEASE_DIR:-$HOME/.claude-ollama/lease}"
lock_dir="$lease_dir/lease.lock"
poll_seconds="${CLAUDE_OLLAMA_LEASE_POLL:-1}"
refused_status=3
lock_tries=200
name=""
model=""
holder_pid="$PPID"
num_ctx=""
rung=""
exclusive=""
wait_seconds=""
embedding_model=""
meminfo="${CLAUDE_OLLAMA_MEMINFO:-/proc/meminfo}"
rough_kv_share=0.25
rough_kv_context=65536
gguf_inspect="${CLAUDE_OLLAMA_GGUF_INSPECT:-$repo_dir/bin/gguf-inspect}"

usage() {
  cat >&2 <<'EOF'
usage: ollama-lease acquire NAME [--model M] [--pid N] [--num-ctx N] [--rung R] [--exclusive] [--wait SECONDS]
       ollama-lease release NAME [--pid N]
       ollama-lease holders
       ollama-lease fit --model ID --num-ctx N [--embedding ID]
EOF
  exit 2
}

option_value() {
  [ $# -ge 2 ] || usage
  printf '%s' "$2"
}

parse_options() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --model) model="$(option_value "$@")"; shift 2 ;;
      --pid) holder_pid="$(option_value "$@")"; shift 2 ;;
      --num-ctx) num_ctx="$(option_value "$@")"; shift 2 ;;
      --rung) rung="$(option_value "$@")"; shift 2 ;;
      --wait) wait_seconds="$(option_value "$@")"; shift 2 ;;
      --embedding) embedding_model="$(option_value "$@")"; shift 2 ;;
      --exclusive) exclusive=1; shift ;;
      *) usage ;;
    esac
  done
}

prepare_dir() {
  (umask 077; mkdir -p "$lease_dir")
  chmod 700 "$lease_dir"
}

drop_lock() {
  rmdir "$lock_dir" 2>/dev/null || true
}

remove_stale_lock() {
  [ -n "$(find "$lock_dir" -maxdepth 0 -mmin +1 2>/dev/null)" ] && rmdir "$lock_dir" 2>/dev/null || true
}

take_lock() {
  local tries=0
  until mkdir "$lock_dir" 2>/dev/null; do
    remove_stale_lock
    tries=$((tries + 1))
    [ "$tries" -lt "$lock_tries" ] || { echo "ollama lease: $lock_dir is held" >&2; exit 1; }
    sleep 0.05
  done
  trap drop_lock EXIT
}

pid_of() {
  local file="${1##*/}"
  file="${file%.json}"
  case "$file" in ''|*[!0-9]*) return 1 ;; esac
  printf '%s' "$file"
}

pid_alive() {
  kill -0 "$1" 2>/dev/null
}

holder_line() {
  jq -r '[.name, .model // "", .rung // ""] | @tsv' "$1" 2>/dev/null
}

lease_files() {
  local file
  for file in "$lease_dir"/*.json; do
    [ -f "$file" ] || continue
    pid_of "$file" >/dev/null || continue
    printf '%s\n' "$file"
  done
}

prune_dead() {
  local file pid
  while IFS= read -r file; do
    pid="$(pid_of "$file")"
    pid_alive "$pid" || rm -f "$file"
  done < <(lease_files)
}

other_holders() {
  local file pid holder_name holder_model holder_rung
  while IFS= read -r file; do
    pid="$(pid_of "$file")"
    [ "$pid" != "$holder_pid" ] || continue
    IFS=$'\t' read -r holder_name holder_model holder_rung < <(holder_line "$file") || continue
    printf '%s\t%s\t%s\t%s\n' "$holder_name" "$pid" "$holder_model" "$holder_rung"
  done < <(lease_files)
}

blocking_holder() {
  if [ -n "$exclusive" ]; then
    other_holders | head -n 1
  else
    other_holders | awk -F '\t' '$1 == "session" { print; exit }'
  fi
}

distinct_model_count() {
  { other_holders | cut -f 3; printf '%s\n' "$model"; } | grep -v '^$' | sort -u | wc -l | tr -d ' '
}

models_fit() {
  local cap
  cap="$(models_max)"
  [ -n "$cap" ] && [ "$cap" -ge "$(distinct_model_count)" ] 2>/dev/null
}

write_lease() {
  local target="$lease_dir/$holder_pid.json"
  (umask 077; jq -cn --arg name "$name" --arg model "$model" --arg num_ctx "$num_ctx" --arg rung "$rung" \
    --arg started "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{name: $name, model: (if $model == "" then null else $model end),
      num_ctx: (if $num_ctx == "" then null else ($num_ctx | tonumber) end),
      rung: (if $rung == "" then null else $rung end), started: $started}' > "$target.tmp")
  mv -f "$target.tmp" "$target"
}

refusal() {
  local holder_name holder_pid_ holder_model
  IFS=$'\t' read -r holder_name holder_pid_ holder_model _ <<< "$1"
  echo "ollama lease: held by $holder_name (pid $holder_pid_, model $holder_model); run after that session ends or run claude-custom agent -set models-max=2" >&2
}

try_acquire() {
  take_lock
  prune_dead
  blocker="$(blocking_holder)"
  if [ -z "$blocker" ] || { [ -z "$exclusive" ] && models_fit; }; then
    write_lease
    drop_lock
    return 0
  fi
  drop_lock
  return "$refused_status"
}

deadline_passed() {
  awk -v start="$1" -v now="$(date +%s)" -v limit="$wait_seconds" 'BEGIN { exit !(now - start >= limit) }'
}

acquire() {
  local started blocker=""
  started="$(date +%s)"
  while :; do
    try_acquire && return 0
    if [ -z "$wait_seconds" ] || deadline_passed "$started"; then break; fi
    sleep "$poll_seconds"
  done
  refusal "$blocker"
  exit "$refused_status"
}

release() {
  local file="$lease_dir/$holder_pid.json"
  take_lock
  prune_dead
  [ "$(holder_line "$file" | cut -f 1)" = "$name" ] && rm -f "$file"
  drop_lock
  return 0
}

holders() {
  local file pid holder_name holder_model holder_rung
  take_lock
  while IFS= read -r file; do
    pid="$(pid_of "$file")"
    IFS=$'\t' read -r holder_name holder_model holder_rung < <(holder_line "$file") || continue
    if pid_alive "$pid"; then
      echo "live $holder_name pid $pid model ${holder_model:--} rung ${holder_rung:--}"
    else
      echo "stale $holder_name pid $pid model ${holder_model:--}"
      rm -f "$file"
    fi
  done < <(lease_files)
  drop_lock
}

presets_source() {
  if [ -r "$user_presets_file" ]; then printf '%s' "$user_presets_file"; else printf '%s' "$profile_dir/models.ini"; fi
}

presets_text() {
  if [ -r "$user_presets_file" ]; then
    cat "$user_presets_file"
  else
    sed "s|@WEIGHTS@|$(weights_dir)|g" "$profile_dir/models.ini"
  fi
}

preset_weights() {
  presets_text | awk -v id="$1" '
    function finish() { if (matched && weights != "") { print weights; found = 1; exit } }
    /^\[/ { finish(); section = substr($0, 2, length($0) - 2); matched = (section == id); weights = ""; next }
    {
      split($0, parts, "="); key = parts[1]; gsub(/[ \t]/, "", key)
      value = substr($0, index($0, "=") + 1); gsub(/^[ \t]+|[ \t]+$/, "", value)
      if (key == "alias" && value == id) matched = 1
      if (key == "model") weights = value
    }
    END { if (!found) finish(); exit found ? 0 : 1 }'
}

weights_of() {
  local weights
  weights="$(preset_weights "$1")" || { echo "ollama lease: no preset $1 in $(presets_source)" >&2; return 1; }
  [ -f "$weights" ] || { echo "ollama lease: $weights is missing (run claude-ollama prepare)" >&2; return 1; }
  printf '%s' "$weights"
}

file_bytes() {
  stat -f %z "$1" 2>/dev/null || stat -c %s "$1"
}

kv_bytes_per_element() {
  case "$(server_setting cache-type-k 2>/dev/null)" in
    q8_0) echo 1 ;;
    q4_0) echo 0.5 ;;
    *) echo 2 ;;
  esac
}

kv_head_widths() {
  { "$gguf_inspect" "$1" --json 2>/dev/null || true; } | jq -er '
    .architecture as $arch | .metadata as $meta
    | def field($name): $meta[$arch + "." + $name];
    field("attention.key_length") as $key
    | (field("attention.value_length") // $key) as $value
    | field("attention.head_count_kv") as $heads
    | field("block_count") as $blocks
    | (field("full_attention_interval") // 1) as $interval
    | if ($key | type) != "number" then empty
      elif ($heads | type) == "array" then ($heads | add) * ($key + $value)
      elif ($heads | type) == "number" and ($blocks | type) == "number"
        then (($blocks / $interval) | floor) * $heads * ($key + $value)
      else empty end' 2>/dev/null
}

exact_kv_bytes() {
  local widths
  widths="$(kv_head_widths "$1")" || return 1
  awk -v ctx="$num_ctx" -v widths="$widths" -v per="$(kv_bytes_per_element)" 'BEGIN { printf "%.0f", ctx * widths * per }'
}

rough_kv_bytes() {
  awk -v bytes="$1" -v share="$rough_kv_share" -v ctx="$num_ctx" -v reference="$rough_kv_context" \
    'BEGIN { printf "%.0f", bytes * share * ctx / reference }'
}

resident_bytes() {
  local id total=0 weights
  for id in "$@"; do
    model_loaded "$id" || continue
    weights="$(weights_of "$id" 2>/dev/null)" || continue
    total=$((total + $(file_bytes "$weights")))
  done
  printf '%s' "$total"
}

free_bytes_linux() {
  awk '$1 == "MemAvailable:" { printf "%.0f", $2 * 1024; exit }' "$meminfo"
}

free_bytes_macos() {
  local memsize
  memsize="$(sysctl -n hw.memsize 2>/dev/null)" || return 1
  vm_stat | awk -v memsize="$memsize" '
    /page size of/ { page = $8 }
    /^Pages active:/ { active = $3 }
    /^Pages wired down:/ { wired = $4 }
    END { printf "%.0f", memsize - (active + wired) * page }'
}

free_bytes() {
  local bytes
  if [ -r "$meminfo" ]; then bytes="$(free_bytes_linux)"; else bytes="$(free_bytes_macos)"; fi
  case "$bytes" in ''|*[!0-9]*) echo "ollama lease: cannot read the free memory" >&2; return 1 ;; esac
  printf '%s' "$bytes"
}

fit() {
  local weights model_bytes kv_bytes embedding_bytes=0 estimate=exact free
  [ -n "$model" ] && [ -n "$num_ctx" ] || usage
  weights="$(weights_of "$model")" || exit 1
  model_bytes="$(file_bytes "$weights")"
  kv_bytes="$(exact_kv_bytes "$weights")" || { kv_bytes="$(rough_kv_bytes "$model_bytes")"; estimate=rough; }
  if [ -n "$embedding_model" ]; then
    weights="$(weights_of "$embedding_model")" || exit 1
    embedding_bytes="$(file_bytes "$weights")"
  fi
  free="$(free_bytes)" || exit 1
  free=$(( free + $(resident_bytes "$model" ${embedding_model:+"$embedding_model"}) ))
  jq -cn --argjson model "$model_bytes" --argjson kv "$kv_bytes" --argjson embedding "$embedding_bytes" \
    --argjson free "$free" --arg estimate "$estimate" \
    '{model_bytes: $model, kv_bytes: $kv, embedding_bytes: $embedding, total_bytes: ($model + $kv + $embedding),
      free_bytes: $free, fits: ($model + $kv + $embedding <= $free), margin_bytes: ($free - $model - $kv - $embedding),
      estimate: $estimate}'
}

[ $# -ge 1 ] || usage
command_name="$1"
shift
case "$command_name" in
  acquire|release)
    [ $# -ge 1 ] || usage
    name="$1"
    shift
    ;;
esac
parse_options "$@"
prepare_dir
case "$command_name" in
  acquire) acquire ;;
  release) release ;;
  holders) holders ;;
  fit) fit ;;
  *) usage ;;
esac
