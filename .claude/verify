#!/bin/sh
cd "$(dirname "$0")/.." || exit 1

[ "$#" -eq 0 ] && exec make test

sibling_test() {
  name="${1##*/}"
  printf '%s\n' "${1%"$name"}${name%.*}.test.sh"
}

tests_for() {
  case "$1" in
    *.test.sh) printf '%s\n' "$1" ;;
    bin/claude-custom) printf '%s\n' personal/install.test.sh bin/claude-ollama.test.sh ;;
    ollama/drafts/*) printf '%s\n' ollama/drafts/opener.test.sh bin/claude-ollama.test.sh ;;
    shared/hooks/recovery_recipes.py | ollama/recipes/*) printf '%s\n' shared/hooks/friction_budget.test.sh shared/hooks/tdd-guard.test.sh ;;
    ollama/incidents/*) printf '%s\n' ollama/incidents/incident_log.test.sh ollama/incidents/watcher.test.sh ollama/incidents/ladder.test.sh ollama/incidents/why.test.sh bin/claude-ollama.test.sh ;;
    shared/relaunch_dir.py) printf '%s\n' shared/relaunch_dir.test.sh shared/hooks/handoff-relaunch.test.sh ollama/incidents/ladder.test.sh shared/mcp/code-search.test.sh bin/claude-ollama.test.sh ;;
    eval/tasks/*) printf '%s\n' bin/task-eval.test.sh ;;
    shared/mcp/draft_store.py) printf '%s\n' shared/mcp/repo-tools.test.sh ;;
    shared/mcp/github_tools.py) printf '%s\n' shared/mcp/repo-tools.test.sh ;;
    shared/mcp/mcp_stdio.py) printf '%s\n' shared/mcp/code-search.test.sh shared/mcp/repo-tools.test.sh shared/mcp/dev-server.test.sh ;;
    bin/lib/*) printf '%s\n' bin/claude-ollama.test.sh bin/claude-ollama-doctor.test.sh bin/claude-ollama-qwen.test.sh ;;
    bin/claude-tools | bin/ollama-agent) printf '%s\n' bin/claude-ollama.test.sh ;;
    ollama/*) printf '%s\n' bin/claude-ollama.test.sh bin/claude-ollama-doctor.test.sh bin/claude-ollama-qwen.test.sh ;;
    personal/settings-path | personal/launch) printf '%s\n' personal/settings-path.test.sh personal/install.test.sh ;;
    personal/* | shared/settings/* | shared/agents/*) printf '%s\n' personal/install.test.sh ;;
    shared/hooks/fallow-lib.sh | shared/hooks/fallow-test-lib.sh) printf '%s\n' shared/hooks/fallow-*.test.sh ;;
    shared/hooks/test_scope.py) printf '%s\n' shared/hooks/test_scope.test.sh shared/hooks/tdd-guard.test.sh shared/hooks/test-after-edit.test.sh ;;
    shared/hooks/hook_telemetry.py) printf '%s\n' shared/hooks/test-after-edit.test.sh shared/hooks/bash-output-guard.test.sh shared/hooks/read-range-guard.test.sh shared/hooks/git-push-guard.test.sh shared/hooks/dev-server-guard.test.sh shared/hooks/context-budget.test.sh shared/hooks/friction_budget.test.sh shared/hooks/repeat-call-cache.test.sh ;;
    shared/hooks/profile_env.py) printf '%s\n' shared/hooks/profile_env.test.sh shared/hooks/context-budget.test.sh shared/hooks/test-after-edit.test.sh ;;
    shared/profile-env.json) printf '%s\n' shared/profile-overlay.test.sh shared/hooks/profile_env.test.sh shared/hooks/context-budget.test.sh shared/hooks/test-after-edit.test.sh bin/ollama-profiles.test.sh ;;
    shared/hooks/friction_budget.py) printf '%s\n' shared/hooks/friction_budget.test.sh shared/hooks/repeat-call-cache.test.sh shared/hooks/bash-output-guard.test.sh shared/hooks/read-range-guard.test.sh ;;
    *) sibling_test "$1" ;;
  esac
}

go_changed=""
web_changed=""
tests=""
for file in "$@"; do
  case "$file" in
    Makefile) exec make test ;;
    go/*) go_changed=1 ;;
    web/console/*) web_changed=1 ;;
  esac
  tests="$tests
$(tests_for "$file")"
done

set -- check-json check-config check-profiles
[ -n "$go_changed" ] && set -- "$@" test-go
[ -n "$web_changed" ] && set -- "$@" test-web

status=0
make --no-print-directory "$@" || status=1
for test in $(printf '%s\n' "$tests" | sort -u); do
  [ -x "$test" ] || continue
  "./$test" || status=1
done
exit "$status"
