{
  "bashOutputMaxChars": 15000,
  "promptSuggestionEnabled": false,
  "skillListingMaxDescChars": 300,
  "sandbox": {
    "enabled": true,
    "excludedCommands": ["gh *", "git push *"],
    "network": {
      "allowedDomains": [
        "127.0.0.1",
        "[::1]",
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "proxy.golang.org",
        "sum.golang.org",
        "pypi.org",
        "files.pythonhosted.org",
        "context7.com"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "~/.cache",
        "~/Library/Caches",
        "~/.npm",
        "~/go/pkg/mod",
        "~/Library/pnpm/store",
        "~/.local/share/pnpm/store",
        "~/.local/state/pnpm",
        "~/.bun/install/cache"
      ],
      "denyWrite": ["~/.cache/claude-custom"],
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.config/gh",
        "~/.config/context7",
        "~/.npmrc",
        "~/Library/Keychains",
        "~/.local/share/claude-custom"
      ]
    },
    "credentials": {
      "envVars": [
        { "name": "GH_TOKEN", "mode": "deny" },
        { "name": "GITHUB_TOKEN", "mode": "deny" },
        { "name": "SHORTCUT_API_TOKEN", "mode": "deny" }
      ]
    }
  },
  "env": {
    "MAX_MCP_OUTPUT_TOKENS": "10000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku",
    "CLAUDE_CODE_SUBAGENT_MODEL_FORCE": "1",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "70",
    "npm_config_fund": "false",
    "npm_config_update_notifier": "false",
    "npm_config_progress": "false",
    "PIP_DISABLE_PIP_VERSION_CHECK": "1",
    "NODE_USE_ENV_PROXY": "1"
  },
  "permissions": {
    "deny": [
      "{{READ_DENY}}",
      "Artifact",
      "CronCreate",
      "CronDelete",
      "CronList",
      "NotebookEdit",
      "PushNotification",
      "RemoteTrigger",
      "ScheduleWakeup",
      "SendFeedback",
      "SendUserFile",
      "ShareOnboardingGuide",
      "Workflow"
    ],
    "ask": [
      "Bash(dangerouslyDisableSandbox:true)",
      "Bash(gh *)",
      "Bash(git push *)"
    ]
  },
  "hooks": "{{HOOKS}}"
}
