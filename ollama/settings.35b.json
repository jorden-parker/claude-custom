{
  "model": "qwen3.6-35b-cc",
  "apiKeyHelper": "",
  "disableClaudeAiConnectors": true,
  "disableBundledSkills": true,
  "autoMemoryEnabled": false,
  "includeGitInstructions": false,
  "promptSuggestionEnabled": false,
  "bashOutputMaxChars": 12000,
  "env": {
    "ANTHROPIC_BASE_URL": "http://localhost:11434",
    "ANTHROPIC_AUTH_TOKEN": "ollama",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "qwen3.6-35b-cc",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "qwen3.6-35b-cc",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "qwen3.6-35b-cc",
    "CLAUDE_CODE_SUBAGENT_MODEL": "qwen3.6-35b-cc",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "65536",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "75",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "8192",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "8000",
    "MAX_MCP_OUTPUT_TOKENS": "4000",
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "permissions": {
    "deny": [
      "Read(**/node_modules/**)",
      "Read(**/dist/**)",
      "Read(**/.next/**)",
      "Read(**/coverage/**)",
      "Read(**/*.min.js)",
      "Read(**/*.map)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/bash-output-guard.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/edit-check.py",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/bash-output-trim.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/stop-verify.py",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
