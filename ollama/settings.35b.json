{
  "model": "qwen3.6-35b-cc",
  "availableModels": ["qwen3.6-35b-cc"],
  "apiKeyHelper": "",
  "disableClaudeAiConnectors": true,
  "disableBundledSkills": true,
  "skillListingBudgetFraction": 0.06,
  "precomputeCompactionEnabled": false,
  "autoMemoryEnabled": false,
  "includeGitInstructions": false,
  "promptSuggestionEnabled": false,
  "feedbackDrafts": "off",
  "feedbackSurveyRate": 0,
  "bashOutputMaxChars": 12000,
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:11434",
    "ANTHROPIC_AUTH_TOKEN": "ollama",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "qwen3.6-35b-cc",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "qwen3.6-35b-cc",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "qwen3.6-35b-cc",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "qwen3.6-35b-cc",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "98304",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "88",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "8192",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "4000",
    "MAX_MCP_OUTPUT_TOKENS": "2000",
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CUSTOM_HOOK_SANDBOX": "1",
    "DISABLE_TELEMETRY": "1",
    "DO_NOT_TRACK": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_BUG_COMMAND": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_SEND_FEEDBACK": "0",
    "CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
    "CLAUDE_CODE_TOTAL_TOKENS_REMINDER": "off",
    "CLAUDE_CODE_EXTRA_BODY": "{\"thinking\":{\"type\":\"disabled\"}}",
    "CLAUDE_STREAM_IDLE_TIMEOUT_MS": "1800000",
    "API_TIMEOUT_MS": "1800000"
  },
  "permissions": {
    "deny": [
      "Read(**/dist/**)",
      "Read(**/.next/**)",
      "Read(**/coverage/**)",
      "Read(**/*.min.js)",
      "Read(**/*.map)",
      "Agent",
      "Artifact",
      "CronCreate",
      "CronDelete",
      "CronList",
      "EnterWorktree",
      "ExitWorktree",
      "ListAgents",
      "NotebookEdit",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "SendFeedback",
      "SendMessage",
      "SendUserFile",
      "ShareOnboardingGuide",
      "WebFetch",
      "WebSearch",
      "Workflow",
      "Glob",
      "Grep"
    ],
    "defaultMode": "default",
    "disableAutoMode": "disable",
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(dangerouslyDisableSandbox:true)"
    ],
    "allow": ["Skill(find-docs)", "Bash(claude-custom ctx7 *)"]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "cmux *",
      "gh *",
      "short *",
      "git push *",
      "git commit *",
      "claude-custom ctx7 *",
      "pnpm *"
    ],
    "network": {
      "allowedDomains": [
        "127.0.0.1",
        "[::1]",
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "proxy.golang.org",
        "sum.golang.org",
        "pypi.org",
        "files.pythonhosted.org",
        "context7.com"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": ["~/.cache/claude-sandbox"],
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.config/gh",
        "~/.npmrc",
        "~/Library/Keychains",
        "~/.claude",
        "~/.qwen",
        "~/.local/share/claude-custom",
        "~/.config/context7"
      ]
    },
    "credentials": {
      "envVars": [
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "SHORTCUT_API_TOKEN",
          "mode": "deny"
        }
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_CUSTOM_HOME\"/shared/host-env \"$CLAUDE_CUSTOM_HOME\"/shared/hooks/bash-output-guard.py"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_CUSTOM_HOME\"/shared/host-env \"$CLAUDE_CUSTOM_HOME\"/shared/hooks/fallow-command-guard.sh",
            "timeout": 180
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_CUSTOM_HOME\"/shared/host-env \"$CLAUDE_CUSTOM_HOME\"/shared/hooks/read-range-guard.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_CUSTOM_HOME\"/shared/host-env \"$CLAUDE_CUSTOM_HOME\"/shared/hooks/tdd-guard.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_CUSTOM_HOME\"/shared/host-env \"$CLAUDE_CUSTOM_HOME\"/shared/hooks/git-push-guard.py"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_CUSTOM_HOME\"/shared/host-env \"$CLAUDE_CUSTOM_HOME\"/shared/hooks/dev-server-guard.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_CUSTOM_HOME\"/shared/host-env \"$CLAUDE_CUSTOM_HOME\"/shared/hooks/name-nudge.py"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_CUSTOM_HOME\"/shared/host-env \"$CLAUDE_CUSTOM_HOME\"/shared/hooks/edit-nudge.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_CUSTOM_HOME\"/shared/host-env \"$CLAUDE_CUSTOM_HOME\"/shared/hooks/rule-cards.py"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_CUSTOM_HOME\"/shared/host-env \"$CLAUDE_CUSTOM_HOME\"/shared/hooks/repeat-call-cache.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_CUSTOM_HOME\"/shared/host-env \"$CLAUDE_CUSTOM_HOME\"/shared/hooks/edit-check.py",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_CUSTOM_HOME\"/shared/host-env \"$CLAUDE_CUSTOM_HOME\"/shared/hooks/stop-verify.py"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_CUSTOM_HOME\"/shared/host-env \"$CLAUDE_CUSTOM_HOME\"/shared/hooks/fallow-after-edit.sh",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_CUSTOM_HOME\"/shared/host-env \"$CLAUDE_CUSTOM_HOME\"/shared/hooks/tdd-guard.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_CUSTOM_HOME\"/shared/host-env \"$CLAUDE_CUSTOM_HOME\"/shared/hooks/bash-output-trim.py"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_CUSTOM_HOME\"/shared/host-env \"$CLAUDE_CUSTOM_HOME\"/shared/hooks/fallow-mark-preview.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_CUSTOM_HOME\"/shared/host-env \"$CLAUDE_CUSTOM_HOME\"/shared/hooks/tdd-guard.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$CLAUDE_TOOL_TELEMETRY\" ] || \"$CLAUDE_CUSTOM_HOME\"/shared/host-env \"$CLAUDE_CUSTOM_HOME\"/shared/hooks/tool-telemetry.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_CUSTOM_HOME\"/shared/host-env \"$CLAUDE_CUSTOM_HOME\"/shared/hooks/context-budget.py"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_CUSTOM_HOME\"/shared/host-env \"$CLAUDE_CUSTOM_HOME\"/shared/hooks/repeat-call-cache.py"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_CUSTOM_HOME\"/shared/host-env \"$CLAUDE_CUSTOM_HOME\"/shared/hooks/test-after-edit.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_CUSTOM_HOME\"/shared/host-env \"$CLAUDE_CUSTOM_HOME\"/shared/hooks/stop-verify.py",
            "timeout": 600
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_CUSTOM_HOME\"/shared/host-env \"$CLAUDE_CUSTOM_HOME\"/shared/hooks/handoff-relaunch.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_CUSTOM_HOME\"/shared/host-env \"$CLAUDE_CUSTOM_HOME\"/shared/hooks/friction_budget.py"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_CUSTOM_HOME\"/shared/host-env \"$CLAUDE_CUSTOM_HOME\"/shared/hooks/incident-note.py"
          }
        ]
      }
    ]
  }
}
