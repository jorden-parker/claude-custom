(version 1)
(allow default)
(deny file-read*
    (subpath (string-append (param "HOME_DIR") "/.ssh"))
    (subpath (string-append (param "HOME_DIR") "/.aws"))
    (subpath (string-append (param "HOME_DIR") "/.config/gh"))
    (literal (string-append (param "HOME_DIR") "/.npmrc"))
    (subpath (string-append (param "HOME_DIR") "/Library/Keychains"))
    (subpath (string-append (param "HOME_DIR") "/.claude"))
    (subpath (string-append (param "HOME_DIR") "/.qwen"))
    (subpath (string-append (param "HOME_DIR") "/.local/share/claude-custom"))
    (subpath (string-append (param "HOME_DIR") "/.config/context7"))
)
(deny file-write*)
(deny file-write* (subpath (string-append (param "HOME_DIR") "/.cache/claude-custom")))
(allow file-write*
    (subpath (param "TARGET_DIR"))
    (subpath (param "TMP_DIR"))
    (subpath (param "CACHE_DIR"))
    (subpath (param "QWEN_DIR"))
    (subpath (param "RUNTIME_DIR"))
    (subpath (string-append (param "HOME_DIR") "/.cache"))
    (subpath (string-append (param "HOME_DIR") "/Library/Caches"))
    (subpath (string-append (param "HOME_DIR") "/.npm"))
    (subpath (string-append (param "HOME_DIR") "/go/pkg/mod"))
    (subpath (string-append (param "HOME_DIR") "/Library/pnpm/store"))
    (subpath (string-append (param "HOME_DIR") "/.local/share/pnpm/store"))
    (subpath (string-append (param "HOME_DIR") "/.local/state/pnpm"))
    (subpath (string-append (param "HOME_DIR") "/.bun/install/cache"))
    (literal "/dev/stdout")
    (literal "/dev/stderr")
    (literal "/dev/null")
    (literal "/dev/ptmx")
    (regex #"^/dev/ttys[0-9]*$")
)
