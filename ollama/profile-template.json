{
  "model": "{{MODEL}}",
  "availableModels": ["{{MODEL}}"],
  "apiKeyHelper": "",
  "disableClaudeAiConnectors": true,
  "disableBundledSkills": true,
  "autoMemoryEnabled": false,
  "includeGitInstructions": false,
  "promptSuggestionEnabled": false,
  "bashOutputMaxChars": 12000,
  "env": {
    "ANTHROPIC_BASE_URL": "http://localhost:11434",
    "ANTHROPIC_AUTH_TOKEN": "ollama",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "{{MODEL}}",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "{{MODEL}}",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "{{MODEL}}",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "{{MODEL}}",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "{{CONTEXT}}",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "88",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "8192",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "4000",
    "MAX_MCP_OUTPUT_TOKENS": "2000",
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
    "CLAUDE_CODE_TOTAL_TOKENS_REMINDER": "off",
    "CLAUDE_STREAM_IDLE_TIMEOUT_MS": "1800000",
    "API_TIMEOUT_MS": "1800000"
  },
  "permissions": {
    "deny": [
      "{{READ_DENY}}",
      "Agent",
      "Artifact",
      "CronCreate",
      "CronDelete",
      "CronList",
      "EnterWorktree",
      "ExitWorktree",
      "ListAgents",
      "NotebookEdit",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "SendFeedback",
      "SendMessage",
      "SendUserFile",
      "ShareOnboardingGuide",
      "Skill",
      "TaskStop",
      "WebFetch",
      "WebSearch",
      "Workflow",
      "Glob",
      "Grep"
    ],
    "defaultMode": "default",
    "disableAutoMode": "disable",
    "ask": ["Bash", "Bash(git commit *)", "Bash(git push *)"],
    "allow": ["mcp__code-search__semantic_search"]
  },
  "sandbox": {
    "enabled": false
  },
  "hooks": "{{HOOKS}}"
}
