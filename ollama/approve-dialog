#!/bin/sh
limit=4000
if ! command -v osascript >/dev/null 2>&1; then
  echo deny
  exit 0
fi
text="$(cat)"
total="$(printf '%s' "$text" | wc -c | tr -d ' ')"
if [ "$total" -gt "$limit" ]; then
  shown="$(printf '%s' "$text" | head -c "$limit")"
  text="$shown
[... $((total - limit)) more bytes]"
fi
escaped="$(printf '%s' "$text" | sed 's/\\/\\\\/g; s/"/\\"/g')"
answer="$(osascript -e "display dialog \"$escaped\" with title \"claude-ollama wants to run a write\" buttons {\"Deny\", \"Allow once\", \"Always allow\"} default button \"Deny\" cancel button \"Deny\" giving up after 60" 2>/dev/null)"
case "$answer" in
  *"gave up:true"*) echo deny ;;
  *"Allow once"*) echo allow ;;
  *"Always allow"*) echo allow-always ;;
  *) echo deny ;;
esac
