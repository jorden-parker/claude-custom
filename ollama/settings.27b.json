{
  "model": "qwen3.8-27b-cc",
  "apiKeyHelper": "",
  "disableClaudeAiConnectors": true,
  "disableBundledSkills": true,
  "autoMemoryEnabled": false,
  "includeGitInstructions": false,
  "promptSuggestionEnabled": false,
  "bashOutputMaxChars": 12000,
  "env": {
    "ANTHROPIC_BASE_URL": "http://localhost:11434",
    "ANTHROPIC_AUTH_TOKEN": "ollama",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "qwen3.8-27b-cc",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "qwen3.8-27b-cc",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "qwen3.8-27b-cc",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "qwen3-4b-cc",
    "CLAUDE_CODE_SUBAGENT_MODEL": "qwen3-4b-cc",
    "CLAUDE_CODE_SUBAGENT_MODEL_FORCE": "1",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "65536",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "75",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "8192",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "8000",
    "MAX_MCP_OUTPUT_TOKENS": "4000",
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "permissions": {
    "deny": [
      "Read(**/node_modules/**)",
      "Read(**/dist/**)",
      "Read(**/.next/**)",
      "Read(**/coverage/**)",
      "Read(**/*.min.js)",
      "Read(**/*.map)",
      "Artifact",
      "CronCreate",
      "CronDelete",
      "CronList",
      "EnterWorktree",
      "ExitWorktree",
      "ListAgents",
      "NotebookEdit",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "SendFeedback",
      "SendMessage",
      "SendUserFile",
      "ShareOnboardingGuide",
      "Skill",
      "TaskStop",
      "WebFetch",
      "WebSearch",
      "Workflow",
      "Glob",
      "Grep"
    ],
    "allow": ["mcp__code-search__semantic_search"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_CUSTOM_HOME\"/shared/hooks/bash-output-guard.py"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_CUSTOM_HOME\"/shared/hooks/fallow-command-guard.sh",
            "timeout": 180
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_CUSTOM_HOME\"/shared/hooks/read-range-guard.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_CUSTOM_HOME\"/shared/hooks/edit-check.py",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_CUSTOM_HOME\"/shared/hooks/fallow-after-edit.sh",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_CUSTOM_HOME\"/shared/hooks/bash-output-trim.py"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_CUSTOM_HOME\"/shared/hooks/fallow-mark-preview.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Read|Agent|mcp__code-search__semantic_search",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_CUSTOM_HOME\"/shared/hooks/tool-nudge.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_CUSTOM_HOME\"/shared/hooks/stop-verify.py",
            "timeout": 600
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_CUSTOM_HOME\"/shared/hooks/tool-nudge.py"
          }
        ]
      }
    ]
  },
  "modelOverrides": {
    "claude-haiku-5-5": "qwen3-4b-cc",
    "claude-haiku-4-5": "qwen3-4b-cc"
  }
}
