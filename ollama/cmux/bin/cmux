#!/usr/bin/env python3
import base64
import json
import os
import socket
import sys
from pathlib import Path


def split_out_path(args):
    if "--out" not in args:
        return args, None
    at = args.index("--out")
    if at + 1 >= len(args):
        sys.exit("cmux broker: --out needs a path")
    return args[:at] + args[at + 2 :], Path(os.getcwd(), args[at + 1])


def ask_broker(socket_path, request):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        try:
            connection.connect(socket_path)
        except OSError:
            sys.exit("cmux broker: not running; launch claude-ollama from a cmux terminal (CLAUDE_OLLAMA_CMUX=0 turns it off)")
        connection.sendall(json.dumps(request).encode() + b"\n")
        with connection.makefile("rb") as replies:
            return json.loads(replies.readline())


def write_file(path, encoded):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(base64.b64decode(encoded))


def main():
    args, out_path = split_out_path(sys.argv[1:])
    reply = ask_broker(
        os.environ.get("CLAUDE_OLLAMA_CMUX_BROKER", ""), {"args": args, "out": out_path is not None}
    )
    if out_path and reply.get("file"):
        write_file(out_path, reply["file"])
    sys.stdout.write(reply.get("stdout", ""))
    sys.stderr.write(reply.get("stderr", ""))
    sys.exit(reply.get("exit", 1))


if __name__ == "__main__":
    main()
