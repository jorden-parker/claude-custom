#!/bin/sh
session_dir="$CLAUDE_CONFIG_DIR"
export TMPDIR="$session_dir/tmp"
export XDG_CACHE_HOME="$session_dir/cache"
export XDG_STATE_HOME="$session_dir/state"
export XDG_DATA_HOME="$session_dir/data"
export npm_config_cache="$session_dir/npm"
export GOCACHE="$session_dir/go-build"
export GOMODCACHE="$session_dir/go-mod"
export EDIT_CHECK_CACHE_DIR="$session_dir/cache/claude-custom/edit-check"
export STOP_VERIFY_STATE_DIR="$session_dir/cache/claude-custom/edited-files"
export DISABLE_AUTOUPDATER=1
if [ -n "${GH_BASIC:-}" ]; then
  export GIT_CONFIG_COUNT=1
  export GIT_CONFIG_KEY_0=http.https://github.com/.extraHeader
  export GIT_CONFIG_VALUE_0="Authorization: Basic $GH_BASIC"
fi
exec "$@"
