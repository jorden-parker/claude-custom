#!/bin/sh
set -u

env_catalogue="$(dirname "$0")/profile-env.json"
preset_keys="$(dirname "$0")/../ollama/preset-keys.json"

fail() {
  echo "profile-overlay: $1" >&2
  exit 1
}

usage() {
  echo "usage: profile-overlay settings BASE PROFILE OUT | compose BASE OUT [--fetch-domain HOST]... [--profile FILE] [--context N] [--proxy-url URL] | tools BASE_LIST PROFILE | env PROFILE | mcp PROFILE NAME | parameters PROFILE < LINES | preset-parameters PROFILE < LINES | sandbox-off | summary PROFILE | check PROFILE" >&2
  exit 2
}

read_profile() {
  if [ -L "$1" ]; then
    fail "$1 is a symlink; edit the file it points to instead"
  fi
  if [ ! -e "$1" ]; then
    echo '{}'
    return 0
  fi
  jq -ce 'if type == "object" then . else error("not an object") end' "$1" 2>/dev/null ||
    fail "$1 is not a JSON object"
}

profile_id() {
  profile_name="${1##*/}"
  echo "${profile_name%.json}"
}

is_set() {
  eval "[ \"\${$1+set}\" = set ]"
}

headroom_value() {
  jq -r --arg name "$1" '.[$name]' "$(dirname "$0")/../ollama/headroom.json"
}

refuse_thinking_with_context() {
  if [ "$(printf '%s\n' "$2" | jq -r '.thinking == true and has("context")')" = true ]; then
    fail "$1 sets thinking and a context; no preset has both, so drop one"
  fi
}

profile_layer() {
  layer_profile="$1"
  claude="$2"
  ladder_context="${3:-null}"
  default_output_tokens=0
  if [ "$claude" = false ]; then
    default_output_tokens="$(headroom_value output_tokens)"
  fi
  jq --argjson profile "$layer_profile" --argjson claude "$claude" --argjson defaultOutputTokens "$default_output_tokens" --argjson ladderContext "$ladder_context" '
    def retarget($from; $to):
      .model = $to
      | .availableModels = ((.availableModels // []) | map(if . == $from then $to else . end))
      | .env = ((.env // {}) | with_entries(if (.key | test("^ANTHROPIC_DEFAULT_[A-Z]+_MODEL$")) and .value == $from then .value = $to else . end));
    def preset_suffix:
      if $profile.thinking == true then "@think"
      elif $ladderContext != null then "@\($ladderContext)"
      elif ($profile | has("output_tokens")) or (($profile.parameters // {}) | length > 0) then "@profile"
      elif ($profile | has("context")) then "@\($profile.context)"
      else "" end;
    def clear_rule($name):
      .permissions.allow = ((.permissions.allow // []) - [$name])
      | .permissions.ask = ((.permissions.ask // []) - [$name])
      | .permissions.deny = ((.permissions.deny // []) - [$name]);
    def add_rule($name; $state):
      if $state == "allow" then .permissions.allow += [$name]
      elif $state == "ask" then .permissions.ask += [$name]
      elif $state == "deny" or $state == "off" then .permissions.deny += [$name]
      else . end;
    ($profile.tools // {} | to_entries
      | map(select(.value != "default" and (.key != "Agent" or $claude)))) as $tools
    | reduce $tools[] as $tool (.; clear_rule($tool.key) | add_rule($tool.key; $tool.value))
    | if ($claude and ($profile.sandbox == false)) then .sandbox.enabled = false else . end
    | (.env.CLAUDE_CODE_MAX_OUTPUT_TOKENS // $defaultOutputTokens | tonumber) as $baseOutputTokens
    | (if ($claude | not) and ($profile | has("output_tokens")) then $profile.output_tokens else $baseOutputTokens end) as $outputTokens
    | if ($claude | not) and ($profile | has("output_tokens")) then .env.CLAUDE_CODE_MAX_OUTPUT_TOKENS = ($outputTokens | tostring) else . end
    | if ($profile | has("context")) then .env.CLAUDE_CODE_MAX_CONTEXT_TOKENS = (if $profile.context > $outputTokens then $profile.context | tostring else error("context must exceed the output tokens") end)
      else . end
    | if (($claude | not) and $profile.thinking == true) then del(.env.CLAUDE_CODE_EXTRA_BODY) else . end
    | if ($claude | not) and (.model | type) == "string" and preset_suffix != "" then retarget(.model; .model + preset_suffix) else . end
  '
}

fetch_domains_layer() {
  jq --argjson domains "$1" '
    .permissions.deny = ((.permissions.deny - ["WebFetch"])
      + ["WebFetch(domain:localhost)", "WebFetch(domain:127.0.0.1)", "WebFetch(domain:0.0.0.0)", "WebFetch(domain:[::1])"])
    | .permissions.allow += [$domains[] | "WebFetch(domain:\(.))"]
    | .skipWebFetchPreflight = true
  '
}

proxy_url_layer() {
  jq --arg url "$1" '.env.ANTHROPIC_BASE_URL = $url'
}

save_settings() {
  settings_tmp="$2.$$.tmp"
  if (umask 077 && printf '%s\n' "$1" > "$settings_tmp"); then
    mv -f "$settings_tmp" "$2"
  else
    rm -f "$settings_tmp"
    fail "could not write $2"
  fi
}

is_claude_code_profile() {
  if [ "$(profile_id "$1")" = claude-code ]; then echo true; else echo false; fi
}

write_settings() {
  profile="$(read_profile "$2")" || exit 1
  [ "$(is_claude_code_profile "$2")" = true ] || refuse_thinking_with_context "$2" "$profile"
  settings="$(profile_layer "$profile" "$(is_claude_code_profile "$2")" < "$1")" || fail "could not write $3"
  save_settings "$settings" "$3"
}

compose_profile_layer() {
  profile='{}'
  claude=false
  ladder_context=null
  if [ -n "$compose_profile" ]; then
    profile="$(read_profile "$compose_profile")" || exit 1
    claude="$(is_claude_code_profile "$compose_profile")"
    [ "$claude" = true ] || refuse_thinking_with_context "$compose_profile" "$profile"
  fi
  if [ -n "$compose_context" ]; then
    profile="$(printf '%s\n' "$profile" | jq -c --argjson context "$compose_context" '.context = $context' 2>/dev/null)" ||
      fail "--context needs a whole number, got $compose_context"
    ladder_context="$compose_context"
  fi
  printf '%s\n' "$1" | profile_layer "$profile" "$claude" "$ladder_context"
}

compose_settings() {
  [ $# -ge 2 ] || usage
  compose_base="$1"
  compose_out="$2"
  shift 2
  compose_domains=""
  compose_profile=""
  compose_context=""
  compose_proxy_url=""
  while [ $# -gt 0 ]; do
    [ $# -ge 2 ] || usage
    case "$1" in
      --fetch-domain) compose_domains="$compose_domains$2
" ;;
      --profile) compose_profile="$2" ;;
      --context) compose_context="$2" ;;
      --proxy-url) compose_proxy_url="$2" ;;
      *) usage ;;
    esac
    shift 2
  done
  settings="$(jq . "$compose_base")" || fail "could not read $compose_base"
  if [ -n "$compose_domains" ]; then
    domains="$(printf '%s' "$compose_domains" | jq -R . | jq -sc .)"
    settings="$(printf '%s\n' "$settings" | fetch_domains_layer "$domains")" || fail "could not write $compose_out"
  fi
  if [ -n "$compose_profile" ] || [ -n "$compose_context" ]; then
    settings="$(compose_profile_layer "$settings")" || fail "could not write $compose_out"
  fi
  if [ -n "$compose_proxy_url" ]; then
    settings="$(printf '%s\n' "$settings" | proxy_url_layer "$compose_proxy_url")" || fail "could not write $compose_out"
  fi
  save_settings "$settings" "$compose_out"
}

tools_list() {
  profile="$(read_profile "$2")" || exit 1
  jq -rn --arg base "$1" --argjson profile "$profile" '
    ($base | split(",") | map(select(. != ""))) as $list
    | reduce ($profile.tools // {} | to_entries[]) as $tool ($list;
        if $tool.key == "Agent" then .
        elif $tool.value == "allow" or $tool.value == "ask" then
          (if index($tool.key) == null then . + [$tool.key] else . end)
        elif $tool.value == "off" or $tool.value == "deny" then map(select(. != $tool.key))
        else . end)
    | join(",")
  '
}

print_env() {
  profile="$(read_profile "$1")" || exit 1
  printf '%s\n' "$profile" | jq -r --slurpfile catalogue "$env_catalogue" '
    ($catalogue[0] | map(.key)) as $allowed
    | (.env // {}) | to_entries | sort_by(.key)[]
    | select(.key as $key | $allowed | index($key) != null)
    | "\(.key)=\(.value | tostring | @sh)"
  ' | while IFS= read -r assignment; do
    if ! is_set "${assignment%%=*}"; then
      echo "export $assignment"
    fi
  done
}

mcp_enabled() {
  profile="$(read_profile "$1")" || exit 1
  printf '%s\n' "$profile" | jq -r --arg name "$2" 'if .mcp[$name] == false then "false" else "true" end'
}

merge_parameters() {
  profile="$(read_profile "$1")" || exit 1
  jq -Rrn --argjson profile "$profile" '
    ([inputs | select(length > 0) | capture("^(?<key>[^ ]+) (?<value>.+)$")]) as $base
    | (($profile.parameters // {}) | with_entries(.value |= tostring)) as $parameters
    | (if ($profile | has("context")) then {num_ctx: ($profile.context | tostring)} else {} end) as $context
    | (if ($profile | has("output_tokens")) then {num_predict: ($profile.output_tokens | tostring)} else {} end) as $output
    | ($parameters + $context + $output) as $overrides
    | ($base | map(.key)) as $keys
    | ($base | map({key, value: ($overrides[.key] // .value)}))
      + ($overrides | to_entries | map(select(.key as $key | ($keys | index($key)) == null)))
    | .[] | "\(.key) \(.value)"
  '
}

merge_preset_parameters() {
  profile="$(read_profile "$1")" || exit 1
  jq -Rrn --argjson profile "$profile" --slurpfile keys "$preset_keys" '
    ([inputs | select(length > 0) | capture("^(?<key>[^ =]+) = (?<value>.*)$")]) as $base
    | (($profile.parameters // {}) | to_entries | map({key: ($keys[0][.key] // .key), value: (.value | tostring)}) | from_entries) as $parameters
    | (if ($profile | has("context")) then {"ctx-size": ($profile.context | tostring)} else {} end) as $context
    | (if ($profile | has("output_tokens")) then {"n-predict": ($profile.output_tokens | tostring)} else {} end) as $output
    | ($parameters + $context + $output) as $overrides
    | ($base | map(.key)) as $names
    | ($base | map({key, value: ($overrides[.key] // .value)}))
      + ($overrides | to_entries | map(select(.key as $key | ($names | index($key)) == null)))
    | .[] | "\(.key) = \(.value)"
  '
}

sandbox_off_requested() {
  machine_config="${XDG_CONFIG_HOME:-$HOME/.config}/claude-custom"
  if [ -e "$machine_config/sandbox-off" ]; then
    echo true
    return 0
  fi
  profile="$(read_profile "$machine_config/profiles/claude-code.json")" || exit 1
  printf '%s\n' "$profile" | jq -r 'if .sandbox == false then "true" else "false" end'
}

summary() {
  profile="$(read_profile "$1")" || exit 1
  printf '%s\n' "$profile" | jq -r '
    [
      (.tools // {} | to_entries[] | "tools.\(.key)=\(.value)"),
      (if has("sandbox") then "sandbox=\(.sandbox)" else empty end),
      (if has("context") then "context=\(.context)" else empty end),
      (if has("thinking") then "thinking=\(.thinking)" else empty end),
      (if has("output_tokens") then "output_tokens=\(.output_tokens)" else empty end),
      (.parameters // {} | to_entries[] | "parameters.\(.key)=\(.value)"),
      (.mcp // {} | to_entries[] | "mcp.\(.key)=\(.value)"),
      (.env // {} | to_entries[] | "env.\(.key)=\(.value)")
    ]
    | if length == 0 then "none" else join(", ") end
  '
}

[ $# -gt 0 ] || usage

case "$1" in
  settings)
    [ $# -eq 4 ] || usage
    write_settings "$2" "$3" "$4"
    ;;
  compose)
    shift
    compose_settings "$@"
    ;;
  tools)
    [ $# -eq 3 ] || usage
    tools_list "$2" "$3"
    ;;
  env)
    [ $# -eq 2 ] || usage
    print_env "$2"
    ;;
  mcp)
    [ $# -eq 3 ] || usage
    mcp_enabled "$2" "$3"
    ;;
  parameters)
    [ $# -eq 2 ] || usage
    merge_parameters "$2"
    ;;
  preset-parameters)
    [ $# -eq 2 ] || usage
    merge_preset_parameters "$2"
    ;;
  sandbox-off)
    [ $# -eq 1 ] || usage
    sandbox_off_requested
    ;;
  summary)
    [ $# -eq 2 ] || usage
    summary "$2"
    ;;
  check)
    [ $# -eq 2 ] || usage
    read_profile "$2" >/dev/null
    ;;
  *)
    usage
    ;;
esac
