(version 1)
(allow default)
(deny file-read*
    (subpath (string-append (param "HOME_DIR") "/.ssh"))
    (subpath (string-append (param "HOME_DIR") "/.aws"))
    (subpath (string-append (param "HOME_DIR") "/.config/gh"))
    (literal (string-append (param "HOME_DIR") "/.npmrc"))
    (subpath (string-append (param "HOME_DIR") "/Library/Keychains"))
    (subpath (string-append (param "HOME_DIR") "/.claude"))
    (subpath (string-append (param "HOME_DIR") "/.local/share/claude-custom"))
    (subpath (string-append (param "HOME_DIR") "/.config/context7"))
)
(deny file-write*)
(allow file-write*
    (subpath (param "TARGET_DIR"))
    (subpath (param "TMP_DIR"))
    (subpath (param "CACHE_DIR"))
    (subpath (string-append (param "HOME_DIR") "/.cache/claude-sandbox"))
    (literal "/dev/stdout")
    (literal "/dev/stderr")
    (literal "/dev/null")
    (literal "/dev/ptmx")
    (regex #"^/dev/ttys[0-9]*$")
)
(deny file-write*
    (literal (string-append (param "TARGET_DIR") "/.git"))
    (subpath (string-append (param "TARGET_DIR") "/.git"))
    (subpath (param "GIT_DIR_REAL"))
    (literal (string-append (param "TARGET_DIR") "/.envrc"))
    (subpath (string-append (param "TARGET_DIR") "/.vscode"))
    (subpath (string-append (param "TARGET_DIR") "/.idea"))
    (subpath (string-append (param "TARGET_DIR") "/.claude"))
    (subpath (string-append (param "TARGET_DIR") "/.husky"))
)
(deny network-outbound)
(allow network-outbound (remote tcp "localhost:*"))
